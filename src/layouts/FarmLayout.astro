        <!-- Tab 4: Account -->
        <a href="/farm/account" class={`flex flex-col items-center justify-center py-1 transition-colors ${isAccount ? 'text-[#194622] font-extrabold' : 'text-[#5b6e5d] font-semibold hover:text-[#194622]'}`}>
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width={isAccount ? "2.4" : "1.8"} viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
