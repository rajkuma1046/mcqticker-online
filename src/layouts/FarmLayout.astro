          <span class="text-[8px] opacity-75 leading-none">Produce</span>
        </a>

        <!-- Tab 3: Samples -->
        <a href="/farm/samples" class={`flex flex-col items-center justify-center py-1 transition-colors ${isSamples ? 'text-[#194622] font-extrabold' : 'text-[#5b6e5d] font-semibold hover:text-[#194622]'}`}>
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width={isSamples ? "2.4" : "1.8"} viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
