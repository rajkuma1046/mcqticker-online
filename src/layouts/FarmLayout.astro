---
import '../styles/global.css';

// Farm Direct — Standalone Layout for /farm
// Ultra-modern, mobile-first agricultural e-commerce layout.

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  hideCartBar?: boolean;
}

const {
  title = 'Farm Direct Gwalior | Raw Farm Produce by Pre-Order',
  description = 'Order raw wheat, groundnut, chana, moong, urad and seasonal farm produce with scheduled neighbourhood delivery in selected areas of Gwalior.',
  canonicalPath = '/farm',
  hideCartBar = false,
} = Astro.props;

const SITE_URL = 'https://mcqticker.online';
const canonicalURL = `${SITE_URL}${canonicalPath}`;
const WHATSAPP_NUMBER = '8770767272';
const WHATSAPP_LINK = `https://wa.me/91${WHATSAPP_NUMBER}?text=${encodeURIComponent('Namaste Farm Direct, I have a question about raw farm produce in Gwalior.')}`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}/farm/images/hero-1280.jpg`} />
    <meta property="og:site_name" content="Farm Direct Gwalior" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/farm/images/hero-1280.jpg`} />

    <!-- Premium Google Fonts: Outfit + Plus Jakarta Sans + Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --fd-bg: #fbfbf9;
        --fd-surface: #ffffff;
        --fd-surface-subtle: #f4f6f2;
        --fd-border: #e2e8df;
        --fd-border-subtle: #edf2eb;
        --fd-text: #132215;
        --fd-text-muted: #4e6050;
        --fd-text-subtle: #748776;
        --fd-primary: #194622;
        --fd-primary-hover: #12351a;
        --fd-primary-light: #eaf4ec;
        --fd-accent: #c98528;
        --fd-accent-light: #fef7ec;
        --fd-danger: #c53030;
        --fd-danger-light: #fff5f5;
        --fd-radius: 16px;
        --fd-radius-sm: 10px;
        --fd-shadow-sm: 0 2px 8px -1px rgba(18, 38, 20, 0.04), 0 1px 3px -1px rgba(18, 38, 20, 0.03);
        --fd-shadow: 0 10px 30px -4px rgba(18, 38, 20, 0.07), 0 4px 12px -2px rgba(18, 38, 20, 0.03);
        --fd-shadow-lg: 0 20px 40px -6px rgba(18, 38, 20, 0.12), 0 8px 18px -4px rgba(18, 38, 20, 0.05);
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        background-color: var(--fd-bg);
        color: var(--fd-text);
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      .fd-display {
        font-family: 'Outfit', sans-serif;
        letter-spacing: -0.02em;
      }

      .fd-serif {
        font-family: 'Playfair Display', Georgia, serif;
      }

      /* Bulletproof SVG sizing across all devices and browsers */
      svg {
        display: inline-block;
        vertical-align: middle;
        flex-shrink: 0;
        max-width: 100%;
      }
      svg.w-3, .w-3 { width: 0.75rem !important; height: 0.75rem !important; max-width: 0.75rem !important; max-height: 0.75rem !important; }
      svg.w-3\.5, .w-3\.5 { width: 0.875rem !important; height: 0.875rem !important; max-width: 0.875rem !important; max-height: 0.875rem !important; }
      svg.w-4, .w-4 { width: 1rem !important; height: 1rem !important; max-width: 1rem !important; max-height: 1rem !important; }
      svg.w-5, .w-5 { width: 1.25rem !important; height: 1.25rem !important; max-width: 1.25rem !important; max-height: 1.25rem !important; }
      svg.w-6, .w-6 { width: 1.5rem !important; height: 1.5rem !important; max-width: 1.5rem !important; max-height: 1.5rem !important; }
      svg.w-7, .w-7 { width: 1.75rem !important; height: 1.75rem !important; max-width: 1.75rem !important; max-height: 1.75rem !important; }
      svg.w-8, .w-8 { width: 2rem !important; height: 2rem !important; max-width: 2rem !important; max-height: 2rem !important; }
      header svg, footer svg, nav svg, button svg, a svg {
        max-width: 2.25rem;
        max-height: 2.25rem;
      }

      /* Container */
      .fd-container {
        width: 100%;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1.25rem;
        padding-right: 1.25rem;
      }

      /* Buttons: Modern Gradient & Tactile Feel */
      .fd-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.4rem;
        font-size: 0.925rem;
        font-weight: 600;
        border-radius: var(--fd-radius-sm);
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        text-align: center;
      }
      .fd-btn:active {
        transform: scale(0.98);
      }

      .fd-btn-primary {
        background: linear-gradient(135deg, #1b4522 0%, #296032 100%);
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(27, 69, 34, 0.25);
      }
      .fd-btn-primary:hover {
        background: linear-gradient(135deg, #15371b 0%, #204e28 100%);
        box-shadow: 0 6px 20px rgba(27, 69, 34, 0.35);
        transform: translateY(-1px);
      }

      .fd-btn-secondary {
        background: #ffffff;
        color: var(--fd-text);
        border: 1px solid #d8e2d5;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
      }
      .fd-btn-secondary:hover {
        background: #f4f7f2;
        border-color: #c2d2be;
        transform: translateY(-1px);
      }

      .fd-btn-accent {
        background: linear-gradient(135deg, #d38b28 0%, #b8751c 100%);
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(184, 117, 28, 0.25);
      }
      .fd-btn-accent:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(184, 117, 28, 0.35);
      }

      .fd-btn-outline {
        background: transparent;
        color: var(--fd-primary);
        border: 1.5px solid var(--fd-primary);
      }
      .fd-btn-outline:hover {
        background: var(--fd-primary-light);
      }

      .fd-btn-sm {
        padding: 0.5rem 0.95rem;
        font-size: 0.825rem;
        border-radius: 8px;
      }
      .fd-btn-lg {
        padding: 0.95rem 1.8rem;
        font-size: 1rem;
        border-radius: 12px;
      }

      /* Modern Inputs */
      .fd-input {
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        background-color: #f7faf5;
        border: 1.5px solid #d9e4d5;
        border-radius: var(--fd-radius-sm);
        color: #152317;
        transition: all 0.2s ease;
      }
      .fd-input:focus {
        outline: none;
        background-color: #ffffff;
        border-color: var(--fd-primary);
        box-shadow: 0 0 0 4px rgba(39, 86, 41, 0.1);
      }

      /* Modern Glass Card */
      .fd-glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(215, 228, 212, 0.8);
        border-radius: var(--fd-radius);
        box-shadow: var(--fd-shadow);
      }

      /* Mobile Drawer */
      #fd-mobile-nav {
        transform: translateX(-100%);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      #fd-mobile-nav.open {
        transform: translateX(0);
      }
    </style>
  </head>
  <body class="flex flex-col min-h-screen relative antialiased selection:bg-[#204e28] selection:text-white">
    <!-- Ambient Subtle Warm Glow Background -->
    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[450px] bg-gradient-to-b from-emerald-100/40 via-amber-50/20 to-transparent blur-3xl rounded-full"></div>
      <div class="absolute top-[800px] -left-40 w-[600px] h-[600px] bg-emerald-50/30 blur-3xl rounded-full"></div>
    </div>

    <!-- Announcement & Dispatch Ticker -->
    <div class="bg-gradient-to-r from-[#122815] via-[#1a3d1f] to-[#122815] text-emerald-100 text-xs py-2 px-4 border-b border-emerald-900/50">
      <div class="fd-container flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          <span class="font-medium tracking-wide">
            <strong>Gwalior Delivery Clusters:</strong> Weekly consolidated trips to <span class="underline decoration-emerald-400 font-bold">Pawan Nagar</span> & <span class="underline decoration-emerald-400 font-bold">Chetakpuri</span>
          </span>
        </div>
        <div class="flex items-center gap-4 text-[11px] font-semibold">
          <a href={`https://wa.me/91${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1.5">
            <span class="text-emerald-300">💬 WhatsApp Farmer:</span>
            <strong class="text-white">+91 {WHATSAPP_NUMBER}</strong>
          </a>
        </div>
      </div>
    </div>

    <!-- Modern Floating Glassmorphic Header -->
    <header class="sticky top-0 z-40 bg-white/85 backdrop-blur-xl border-b border-[#e2ece0] transition-all">
      <div class="fd-container flex items-center justify-between h-16 sm:h-20">
        <!-- Logo & Brand -->
        <a href="/farm" class="flex items-center gap-3 group">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-br from-[#1b4522] to-[#296032] flex items-center justify-center text-white shadow-md shadow-emerald-950/15 group-hover:scale-105 transition-transform font-bold text-xl">
            🌾
          </div>
          <div>
            <div class="fd-display text-xl sm:text-2xl font-bold tracking-tight text-[#132215] flex items-center gap-2">
              Farm Direct
              <span class="hidden sm:inline-block text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 tracking-wider">
                Gwalior
              </span>
            </div>
            <div class="text-[10px] sm:text-[11px] text-[#5b6e5d] font-semibold tracking-wide">
              Direct from Village Farm • Zero Middlemen
            </div>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-1 text-xs font-bold text-[#2d3e30]">
          <a href="/farm" class="px-3 py-2 rounded-xl hover:bg-emerald-50 hover:text-[#194622] transition-colors">
            Home
          </a>
          <a href="/farm/products" class="px-3 py-2 rounded-xl hover:bg-emerald-50 hover:text-[#194622] transition-colors">
            Produce Catalogue
          </a>
          <a href="/farm/how-it-works" class="px-3 py-2 rounded-xl hover:bg-emerald-50 hover:text-[#194622] transition-colors">
            How It Works
          </a>
          <a href="/farm/delivery-areas" class="px-3 py-2 rounded-xl hover:bg-emerald-50 hover:text-[#194622] transition-colors">
            Delivery Areas
          </a>
          <a href="/farm/samples" class="px-3 py-2 rounded-xl bg-[#fef7ec] text-[#b8751c] hover:bg-[#fdedd3] border border-[#f5dfb8] transition-colors flex items-center gap-1.5 shadow-xs">
            <span>🎁 Free Samples</span>
            <span class="text-[9px] uppercase px-1.5 py-0.5 bg-amber-500 text-white rounded-full font-extrabold">100g/200g</span>
          </a>
          <a href="/farm/track" class="px-3 py-2 rounded-xl hover:bg-emerald-50 hover:text-[#194622] transition-colors">
            Track Order
          </a>
        </nav>

        <!-- Header Actions: Account + Cart + Mobile Hamburger -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Account Icon/Link -->
          <a href="/farm/account" class="p-2 sm:px-3 sm:py-2 text-xs font-bold rounded-xl text-[#2d3e30] hover:bg-[#f0f4ee] flex items-center gap-1.5 transition-colors border border-transparent hover:border-[#d9e4d5]" title="Customer Account">
            <svg width="20" height="20" class="w-5 h-5 text-[#425544] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="hidden sm:inline" id="fd-account-label">Account</span>
          </a>

          <!-- Cart Link (with dynamic badge) -->
          <a href="/farm/cart" class="relative px-3.5 py-2 sm:px-4 sm:py-2.5 text-xs font-bold rounded-xl bg-gradient-to-r from-[#1b4522] to-[#296032] text-white hover:from-[#15371b] hover:to-[#204e28] flex items-center gap-2 shadow-sm shadow-emerald-950/20 transition-all hover:scale-[1.02] active:scale-[0.98]" title="View Cart">
            <svg width="20" height="20" class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span class="hidden sm:inline">Cart</span>
            <span id="fd-cart-badge" class="min-w-[20px] h-5 px-1.5 rounded-full bg-amber-500 text-white text-[11px] font-extrabold flex items-center justify-center shadow-xs">0</span>
          </a>

          <!-- Mobile Hamburger Button -->
          <button id="fd-mobile-toggle" type="button" class="lg:hidden p-2 text-[#2d3e30] hover:bg-[#f0f4ee] rounded-xl border border-transparent hover:border-[#d9e4d5] transition-colors" aria-label="Toggle navigation menu">
            <svg width="24" height="24" class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Drawer Navigation -->
    <div id="fd-mobile-nav" class="fixed inset-0 z-50 lg:hidden pointer-events-none">
      <div id="fd-mobile-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
      <div class="relative w-76 max-w-[85vw] h-full bg-white shadow-2xl flex flex-col p-6 pointer-events-auto overflow-y-auto">
        <div class="flex items-center justify-between pb-4 border-b border-[#e2ece0]">
          <div class="flex items-center gap-2.5">
            <span class="text-2xl">🌾</span>
            <div>
              <span class="fd-display font-bold text-lg text-[#132215] block leading-tight">Farm Direct</span>
              <span class="text-[10px] text-[#748776] uppercase font-bold tracking-wider">Gwalior Direct Harvest</span>
            </div>
          </div>
          <button id="fd-mobile-close" type="button" class="p-2 rounded-xl text-gray-500 hover:bg-gray-100 transition-colors">
            <svg width="24" height="24" class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav class="flex flex-col gap-2 py-6 text-sm font-bold text-[#2d3e30]">
          <a href="/farm" class="px-3.5 py-2.5 rounded-xl hover:bg-emerald-50 hover:text-[#194622] transition-colors">
            Home
          </a>
          <a href="/farm/products" class="px-3.5 py-2.5 rounded-xl hover:bg-emerald-50 hover:text-[#194622] transition-colors">
            This Week's Produce
          </a>
          <a href="/farm/how-it-works" class="px-3.5 py-2.5 rounded-xl hover:bg-emerald-50 hover:text-[#194622] transition-colors">
            How It Works
          </a>
          <a href="/farm/delivery-areas" class="px-3.5 py-2.5 rounded-xl hover:bg-emerald-50 hover:text-[#194622] transition-colors">
            Delivery Areas
          </a>
          <a href="/farm/samples" class="px-3.5 py-2.5 rounded-xl bg-amber-50 text-amber-900 border border-amber-200/70 flex items-center justify-between">
            <span>Request Free Sample</span>
            <span class="text-[10px] bg-amber-500 text-white px-2 py-0.5 rounded-full font-bold">100g/200g</span>
          </a>
          <a href="/farm/track" class="px-3.5 py-2.5 rounded-xl hover:bg-emerald-50 hover:text-[#194622] transition-colors">
            Track My Order
          </a>
          <div class="border-t border-[#e2ece0] my-3"></div>
          <a href="/farm/account" class="px-3.5 py-2.5 rounded-xl hover:bg-emerald-50 flex items-center gap-2">
            <span>👤 Customer Account</span>
          </a>
          <a href="/farm/admin" class="px-3.5 py-2 rounded-xl text-xs text-[#5b6e5d] hover:bg-gray-100">
            🚜 Operations & Admin
          </a>
        </nav>

        <div class="mt-auto pt-6 border-t border-[#e2ece0]">
          <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="fd-btn w-full py-3 text-xs bg-[#25D366] hover:bg-[#1fa851] text-white font-bold shadow-md shadow-emerald-950/10">
            <span>Chat with Farmer on WhatsApp</span>
          </a>
          <p class="text-[11px] text-[#748776] text-center mt-3">
            Pawan Nagar & Chetakpuri, Gwalior
          </p>
        </div>
      </div>
    </div>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Floating Sticky Bottom Bar for Mobile Cart -->
    {!hideCartBar && (
      <div id="fd-sticky-cart-bar" class="fixed bottom-0 left-0 right-0 z-30 sm:hidden bg-white/90 backdrop-blur-xl border-t border-[#dce7db] px-4 py-3 shadow-[0_-8px_24px_rgba(0,0,0,0.08)] transform translate-y-full transition-transform duration-300">
        <div class="flex items-center justify-between gap-3">
          <div>
            <div class="text-[10px] text-[#5b6e5d] font-bold uppercase tracking-wider">Your Farm Cart</div>
            <div class="text-base font-extrabold text-[#132215] mt-0.5">
              <span id="fd-bar-qty">0 kg</span> produce • <span id="fd-bar-total" class="text-emerald-700">₹0</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <a href="/farm/cart" class="fd-btn fd-btn-primary fd-btn-sm px-4 py-2.5 font-bold shadow-sm">
              Checkout &rarr;
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Floating WhatsApp Button with Glowing Green Ring -->
    <aside aria-label="Support and Enquiries" class="fixed bottom-16 sm:bottom-6 right-4 sm:right-6 z-30">
      <a
        href={WHATSAPP_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-3 bg-[#25D366] hover:bg-[#20ba59] text-white rounded-full shadow-[0_8px_24px_rgba(37,211,102,0.35)] hover:scale-105 active:scale-95 transition-all text-xs sm:text-sm font-bold group"
        title="Chat with Farmer on WhatsApp"
      >
        <svg width="20" height="20" class="w-5 h-5 fill-current flex-shrink-0 group-hover:rotate-12 transition-transform" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.077-2.029-.475-1.706-.706-2.802-2.438-2.887-2.551-.084-.114-.694-.925-.694-1.764s.436-1.25.592-1.424c.156-.174.341-.218.455-.218.113 0 .228.001.327.006.104.005.244-.04.382.291.144.345.49 1.196.533 1.284.043.088.072.19.014.305-.058.115-.087.187-.174.288-.087.102-.183.227-.261.305-.088.087-.18.181-.077.357.103.176.458.756.984 1.224.678.604 1.25.79 1.426.878.176.087.279.073.382-.045.103-.116.438-.509.554-.684.116-.174.232-.145.39-.087.158.058 1.002.472 1.176.559.174.087.29.13.333.203.043.073.043.42-.101.825zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.434 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span class="hidden sm:inline font-bold">WhatsApp Direct</span>
      </a>
    </aside>

    <!-- Luxury Dark Forest Footer -->
    <footer class="bg-[#0e1c10] text-[#c0d4be] pt-16 pb-24 sm:pb-16 border-t border-[#1a341e] mt-20 text-xs">
      <div class="fd-container grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
        <!-- Brand Info -->
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-[#255f34] to-[#194622] flex items-center justify-center text-white text-xl">
              🌾
            </div>
