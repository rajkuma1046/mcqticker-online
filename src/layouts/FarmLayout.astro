        <!-- Tab 5: Cart -->
        <a href="/farm/cart" class={`flex flex-col items-center justify-center py-1 transition-colors relative ${isCart ? 'text-[#194622] font-extrabold' : 'text-[#5b6e5d] font-semibold hover:text-[#194622]'}`}>
          <div class="relative">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width={isCart ? "2.4" : "1.8"} viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <span id="fd-mobile-nav-cart-badge" class="hidden absolute -top-1 -right-2.5 min-w-[18px] h-[18px] px-1 rounded-full bg-[#1b4522] text-white text-[10px] font-black flex items-center justify-center shadow-xs">0</span>
