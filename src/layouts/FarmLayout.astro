    </footer>

    <!-- Fixed Mobile Bottom Navigation Bar (Hindi Primary / English Secondary) -->
    <nav id="fd-bottom-nav" class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-[#f4f7f2]/95 backdrop-blur-lg border-t border-[#d8e3d6] px-2 py-1.5 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] pb-safe">
      <div class="grid grid-cols-5 items-center justify-around text-center max-w-lg mx-auto">
        <!-- Tab 1: Home -->
        <a href="/farm" class={`flex flex-col items-center justify-center py-1 transition-colors ${isHome ? 'text-[#194622] font-extrabold' : 'text-[#5b6e5d] font-semibold hover:text-[#194622]'}`}>
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width={isHome ? "2.4" : "1.8"} viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span class="text-[11px] font-bold leading-tight">होम</span>
          <span class="text-[8px] opacity-75 leading-none">Home</span>
        </a>

        <!-- Tab 2: Produce -->
        <a href="/farm/products" class={`flex flex-col items-center justify-center py-1 transition-colors ${isProduce ? 'text-[#194622] font-extrabold' : 'text-[#5b6e5d] font-semibold hover:text-[#194622]'}`}>
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width={isProduce ? "2.4" : "1.8"} viewBox="0 0 24 24">
