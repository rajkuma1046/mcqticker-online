---
// Farm Direct — Standalone Layout for /farm
// Completely independent mobile-first agricultural layout.

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  hideCartBar?: boolean;
}

const {
  title = 'Farm Direct Gwalior | Raw Farm Produce by Pre-Order',
  description = 'Order raw wheat, groundnut, chana, moong, urad and seasonal farm produce with scheduled neighbourhood delivery in selected areas of Gwalior.',
  canonicalPath = '/farm',
  hideCartBar = false,
} = Astro.props;

const SITE_URL = 'https://mcqticker.online';
const canonicalURL = `${SITE_URL}${canonicalPath}`;
const WHATSAPP_NUMBER = '8770767272';
const WHATSAPP_LINK = `https://wa.me/91${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hello Farm Direct, I have a question about raw produce pre-orders in Gwalior.')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}/farm/images/hero-1280.jpg`} />
    <meta property="og:site_name" content="Farm Direct Gwalior" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/farm/images/hero-1280.jpg`} />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --fd-bg: #f8faf6;
        --fd-surface: #ffffff;
        --fd-surface-subtle: #f0f4ee;
        --fd-border: #e0e8dc;
        --fd-border-subtle: #ebf0e8;
        --fd-text: #1a251b;
        --fd-text-muted: #536354;
        --fd-text-subtle: #798a7a;
        --fd-primary: #275629;
        --fd-primary-hover: #1f4420;
        --fd-primary-light: #eaf3e9;
        --fd-accent: #c48a3f;
        --fd-accent-light: #fdf6ec;
        --fd-danger: #c53030;
        --fd-danger-light: #fff5f5;
        --fd-radius: 12px;
        --fd-radius-sm: 8px;
        --fd-shadow: 0 4px 20px -2px rgba(27, 43, 26, 0.06), 0 2px 6px -1px rgba(27, 43, 26, 0.04);
        --fd-shadow-lg: 0 12px 32px -4px rgba(27, 43, 26, 0.1), 0 4px 12px -2px rgba(27, 43, 26, 0.05);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        background-color: var(--fd-bg);
        color: var(--fd-text);
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button, input, select, textarea {
        font-family: inherit;
      }

      .fd-serif {
        font-family: 'Playfair Display', Georgia, serif;
      }

      /* Container */
      .fd-container {
        width: 100%;
        max-width: 1160px;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1rem;
        padding-right: 1rem;
      }

      /* Buttons */
      .fd-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.4rem;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: var(--fd-radius-sm);
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        text-align: center;
      }

      .fd-btn-primary {
        background-color: var(--fd-primary);
        color: #ffffff;
      }
      .fd-btn-primary:hover {
        background-color: var(--fd-primary-hover);
      }

      .fd-btn-secondary {
        background-color: var(--fd-surface);
        color: var(--fd-text);
        border-color: var(--fd-border);
      }
      .fd-btn-secondary:hover {
        background-color: var(--fd-surface-subtle);
        border-color: var(--fd-text-subtle);
      }

      .fd-btn-accent {
        background-color: var(--fd-accent);
        color: #ffffff;
      }
      .fd-btn-accent:hover {
        background-color: #b07a33;
      }

      .fd-btn-wa {
        background-color: #25d366;
        color: #ffffff;
      }
      .fd-btn-wa:hover {
        background-color: #20ba59;
      }

      .fd-btn-sm {
        padding: 0.5rem 0.9rem;
        font-size: 0.85rem;
      }

      .fd-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.25rem 0.65rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      .fd-badge-raw {
        background-color: var(--fd-primary-light);
        color: var(--fd-primary);
      }

      .fd-badge-seasonal {
        background-color: var(--fd-accent-light);
        color: var(--fd-accent);
      }

      .fd-badge-out {
        background-color: var(--fd-danger-light);
        color: var(--fd-danger);
      }

      /* Card */
      .fd-card {
        background-color: var(--fd-surface);
        border: 1px solid var(--fd-border-subtle);
        border-radius: var(--fd-radius);
        box-shadow: var(--fd-shadow);
        overflow: hidden;
      }

      /* Mobile nav drawer */
      #fd-mobile-nav {
        transform: translateX(-100%);
        transition: transform 0.25s ease-in-out;
      }
      #fd-mobile-nav.open {
        transform: translateX(0);
      }
    </style>
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- Announcement Bar -->
    <div class="bg-[#1f3a21] text-emerald-100 text-xs sm:text-sm py-2 px-4">
      <div class="fd-container flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span><strong>Serving Gwalior:</strong> Pawan Nagar & Chetakpuri scheduled delivery</span>
        </div>
        <div class="flex items-center gap-4">
          <a href={`https://wa.me/91${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-1">
            <span>WhatsApp Orders & Enquiries:</span>
            <strong>+91 {WHATSAPP_NUMBER}</strong>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-[#e5ece2]">
      <div class="fd-container flex items-center justify-between h-16 sm:h-20">
        <!-- Logo & Brand -->
        <a href="/farm" class="flex items-center gap-3">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-[#275629] flex items-center justify-center text-white shadow-sm font-bold text-xl">
            🌾
          </div>
          <div>
            <div class="fd-serif text-xl sm:text-2xl font-bold tracking-tight text-[#1a251b]">
              Farm Direct
            </div>
            <div class="text-[10px] sm:text-xs text-[#536354] uppercase tracking-wider font-semibold">
              Gwalior • Raw Produce
            </div>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-[#2d3a2e]">
          <a href="/farm" class="hover:text-[#275629] transition-colors py-1">Home</a>
          <a href="/farm/products" class="hover:text-[#275629] transition-colors py-1">Produce Catalogue</a>
          <a href="/farm/how-it-works" class="hover:text-[#275629] transition-colors py-1">How It Works</a>
          <a href="/farm/delivery-areas" class="hover:text-[#275629] transition-colors py-1">Delivery Areas</a>
          <a href="/farm/samples" class="hover:text-[#275629] transition-colors py-1 flex items-center gap-1.5">
            <span>Free Samples</span>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-[#fdf6ec] text-[#b07a33]">100g/200g</span>
          </a>
          <a href="/farm/track" class="hover:text-[#275629] transition-colors py-1">Track Order</a>
        </nav>

        <!-- Header Actions: Account + Cart + Mobile Hamburger -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Account Icon/Link -->
          <a href="/farm/account" class="p-2 sm:px-3 sm:py-2 text-xs sm:text-sm font-semibold rounded-lg text-[#2d3a2e] hover:bg-[#f0f4ee] flex items-center gap-1.5" title="My Account">
            <svg class="w-5 h-5 text-[#4a5f4b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="hidden sm:inline" id="fd-account-label">Account</span>
          </a>

          <!-- Cart Link (with dynamic badge) -->
          <a href="/farm/cart" class="relative p-2 sm:px-3 sm:py-2 text-xs sm:text-sm font-semibold rounded-lg bg-[#275629] text-white hover:bg-[#1f4420] flex items-center gap-2 shadow-sm transition-all" title="View Cart">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span class="hidden sm:inline">Cart</span>
            <span id="fd-cart-badge" class="min-w-[20px] h-5 px-1.5 rounded-full bg-[#c48a3f] text-white text-[11px] font-bold flex items-center justify-center">0</span>
          </a>

          <!-- Mobile Hamburger Button -->
          <button id="fd-mobile-toggle" type="button" class="md:hidden p-2 text-[#2d3a2e] hover:bg-[#f0f4ee] rounded-lg" aria-label="Toggle navigation menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Drawer Navigation -->
    <div id="fd-mobile-nav" class="fixed inset-0 z-50 md:hidden pointer-events-none">
      <div id="fd-mobile-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm opacity-0 transition-opacity"></div>
      <div class="relative w-72 max-w-[80vw] h-full bg-white shadow-2xl flex flex-col p-6 pointer-events-auto overflow-y-auto">
        <div class="flex items-center justify-between pb-4 border-b border-[#e5ece2]">
          <div class="flex items-center gap-2">
            <span class="text-2xl">🌾</span>
            <span class="fd-serif font-bold text-lg text-[#1a251b]">Farm Direct</span>
          </div>
          <button id="fd-mobile-close" type="button" class="p-1 rounded-lg text-gray-500 hover:bg-gray-100">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav class="flex flex-col gap-3 py-6 text-base font-semibold text-[#2d3a2e]">
          <a href="/farm" class="px-3 py-2 rounded-lg hover:bg-[#f0f4ee]">Home</a>
          <a href="/farm/products" class="px-3 py-2 rounded-lg hover:bg-[#f0f4ee]">This Week's Produce</a>
          <a href="/farm/how-it-works" class="px-3 py-2 rounded-lg hover:bg-[#f0f4ee]">How It Works</a>
          <a href="/farm/delivery-areas" class="px-3 py-2 rounded-lg hover:bg-[#f0f4ee]">Delivery Areas</a>
          <a href="/farm/samples" class="px-3 py-2 rounded-lg hover:bg-[#f0f4ee] flex items-center justify-between">
            <span>Request Free Sample</span>
            <span class="text-xs bg-[#fdf6ec] text-[#b07a33] px-2 py-0.5 rounded-full font-bold">100g / 200g</span>
          </a>
          <a href="/farm/track" class="px-3 py-2 rounded-lg hover:bg-[#f0f4ee]">Track My Order</a>
          <div class="border-t border-[#e5ece2] my-2"></div>
          <a href="/farm/account" class="px-3 py-2 rounded-lg hover:bg-[#f0f4ee] flex items-center gap-2">
            <span>Customer Account</span>
          </a>
          <a href="/farm/admin" class="px-3 py-2 rounded-lg text-xs text-[#536354] hover:bg-[#f0f4ee]">
            Admin Portal
          </a>
        </nav>

        <div class="mt-auto pt-6 border-t border-[#e5ece2]">
          <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="fd-btn fd-btn-wa w-full py-2.5 text-sm">
            <span>WhatsApp: 8770767272</span>
          </a>
          <p class="text-[11px] text-[#798a7a] text-center mt-3">
            Gwalior Farm-to-Neighbourhood Produce
          </p>
        </div>
      </div>
    </div>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Floating Sticky Bottom Bar for Mobile Cart -->
    {!hideCartBar && (
      <div id="fd-sticky-cart-bar" class="fixed bottom-0 left-0 right-0 z-30 sm:hidden bg-white/95 backdrop-blur-md border-t border-[#e0e8dc] px-4 py-3 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] transform translate-y-full transition-transform duration-200">
        <div class="flex items-center justify-between gap-3">
          <div>
            <div class="text-[11px] text-[#536354] font-medium leading-none">Your Farm Cart</div>
            <div class="text-base font-bold text-[#1a251b] mt-0.5">
              <span id="fd-bar-qty">0 kg</span> produce • <span id="fd-bar-total" class="text-[#275629]">₹0</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <a href="/farm/cart" class="fd-btn fd-btn-primary fd-btn-sm px-4 py-2 font-bold shadow-sm">
              Checkout &rarr;
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Floating WhatsApp Button -->
    <aside aria-label="Support and Enquiries" class="fixed bottom-16 sm:bottom-6 right-4 sm:right-6 z-30">
      <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3.5 py-2.5 bg-[#25d366] text-white rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all text-xs sm:text-sm font-bold" title="Chat with Farm on WhatsApp">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.077-2.029-.475-1.706-.706-2.802-2.438-2.887-2.551-.084-.114-.694-.925-.694-1.764s.436-1.25.592-1.424c.156-.174.341-.218.455-.218.113 0 .228.001.327.006.104.005.244-.04.382.291.144.345.49 1.196.533 1.284.043.088.072.19.014.305-.058.115-.087.187-.174.288-.087.102-.183.227-.261.305-.088.087-.18.181-.077.357.103.176.458.756.984 1.224.678.604 1.25.79 1.426.878.176.087.279.073.382-.045.103-.116.438-.509.554-.684.116-.174.232-.145.39-.087.158.058 1.002.472 1.176.559.174.087.29.13.333.203.043.073.043.42-.101.825zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.434 5.176L2 22l4.981-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span class="hidden sm:inline">WhatsApp Us</span>
      </a>
    </aside>

    <!-- Footer -->
    <footer class="bg-[#152317] text-[#c9d6c8] pt-12 pb-24 sm:pb-12 border-t border-[#233525] mt-16 text-sm">
      <div class="fd-container grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Brand Info -->
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <span class="text-2xl">🌾</span>
            <span class="fd-serif text-xl font-bold text-white tracking-wide">Farm Direct</span>
          </div>
          <p class="text-xs text-[#a0b29e] leading-relaxed">
            Raw, minimally handled agricultural produce supplied directly from our farm and available for pre-order in selected neighbourhoods of Gwalior.
          </p>
          <div class="pt-2 text-xs text-[#829680]">
            Owner WhatsApp: <a href={WHATSAPP_LINK} class="text-[#8cd694] underline font-semibold">+91 {WHATSAPP_NUMBER}</a>
          </div>
        </div>

        <!-- Serving Neighbourhoods -->
        <div>
          <h4 class="text-white font-bold mb-3 uppercase tracking-wider text-xs">Currently Serving</h4>
          <p class="text-xs text-[#a0b29e] mb-2 font-semibold">Gwalior Neighbourhood Clusters:</p>
          <ul class="space-y-1.5 text-xs text-[#c9d6c8]">
            <li class="flex items-center gap-1.5">
              <span class="text-emerald-400">✓</span> Pawan Nagar / Pavan Nagar Colony
            </li>
            <li class="flex items-center gap-1.5">
              <span class="text-emerald-400">✓</span> Chetakpuri, Gwalior
            </li>
          </ul>
          <p class="text-[11px] text-[#798a7a] mt-3">
            Orders are consolidated by locality for scheduled weekend delivery.
          </p>
        </div>

        <!-- Quick Links -->
        <div>
          <h4 class="text-white font-bold mb-3 uppercase tracking-wider text-xs">Explore</h4>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/farm/products" class="hover:text-white transition-colors">Raw Produce Catalogue</a></li>
            <li><a href="/farm/how-it-works" class="hover:text-white transition-colors">How Pre-Order Delivery Works</a></li>
            <li><a href="/farm/samples" class="hover:text-white transition-colors">Request a Free Sample (100g/200g)</a></li>
            <li><a href="/farm/sample-policy" class="hover:text-white transition-colors">Free Sample Policy</a></li>
            <li><a href="/farm/delivery-areas" class="hover:text-white transition-colors">Delivery Charges & Schedule</a></li>
            <li><a href="/farm/track" class="hover:text-white transition-colors">Track Order / Sample Request</a></li>
          </ul>
        </div>

        <!-- Transparency & Legal -->
        <div>
          <h4 class="text-white font-bold mb-3 uppercase tracking-wider text-xs">Farm Transparency</h4>
          <p class="text-xs text-[#a0b29e] leading-relaxed mb-3">
            Product availability and prices depend on current harvest and seasonal supply. We do not make exaggerated health or chemical-free claims.
          </p>
          <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-[#829680]">
            <a href="/farm/privacy" class="hover:underline">Privacy Policy</a>
            <span>•</span>
            <a href="/farm/terms" class="hover:underline">Terms of Service</a>
            <span>•</span>
            <a href="/farm/contact" class="hover:underline">Contact Farm</a>
          </div>
        </div>
      </div>

      <div class="fd-container border-t border-[#233525] mt-10 pt-6 text-center text-xs text-[#6e826c] flex flex-col sm:flex-row items-center justify-between gap-3">
        <div>
          &copy; {new Date().getFullYear()} Farm Direct Gwalior. Raw produce direct from the farm.
        </div>
        <div class="text-[11px]">
          An independent agricultural pre-order platform
        </div>
      </div>
    </footer>

    <!-- Client-side Cart & Auth Synchronizer Script -->
    <script is:inline>
      // Standalone Farm Cart State & Badge Updater
      const FD_CART_KEY = 'fd_cart_v1';

      function getCart() {
        try {
          const raw = localStorage.getItem(FD_CART_KEY);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      }

      function updateCartUI() {
        const cart = getCart();
        const totalKg = cart.reduce((sum, item) => sum + (item.quantity || 0), 0);
        const count = cart.length;

        // Header badge
        const badge = document.getElementById('fd-cart-badge');
        if (badge) {
          badge.textContent = count;
          badge.style.display = count > 0 ? 'flex' : 'none';
        }

        // Mobile sticky bar
        const bar = document.getElementById('fd-sticky-cart-bar');
        const barQty = document.getElementById('fd-bar-qty');
        const barTotal = document.getElementById('fd-bar-total');
        if (bar && barQty && barTotal) {
          if (count > 0 && !window.location.pathname.includes('/farm/cart') && !window.location.pathname.includes('/farm/checkout')) {
            bar.classList.remove('translate-y-full');
            barQty.textContent = `${totalKg} kg`;
            // Calculate approximate total from local items if available
            const approxTotal = cart.reduce((sum, item) => sum + ((item.priceRupees || 0) * (item.quantity || 0)), 0);
            barTotal.textContent = approxTotal > 0 ? `₹${approxTotal}` : '';
          } else {
            bar.classList.add('translate-y-full');
          }
        }
      }

      // Check current auth status on load
      async function checkAuthStatus() {
        try {
          const res = await fetch('/farm/api/auth/me');
          if (res.ok) {
            const data = await res.json();
            const label = document.getElementById('fd-account-label');
            if (data?.user && label) {
              label.textContent = data.user.name.split(' ')[0];
            }
          }
        } catch (_) {}
      }

      // Mobile Menu Toggle
      const mobileToggle = document.getElementById('fd-mobile-toggle');
      const mobileClose = document.getElementById('fd-mobile-close');
      const mobileNav = document.getElementById('fd-mobile-nav');
      const mobileBackdrop = document.getElementById('fd-mobile-backdrop');

      function openMobileMenu() {
        if (mobileNav && mobileBackdrop) {
          mobileNav.classList.add('open');
          mobileBackdrop.classList.remove('opacity-0');
        }
      }

      function closeMobileMenu() {
        if (mobileNav && mobileBackdrop) {
          mobileNav.classList.remove('open');
          mobileBackdrop.classList.add('opacity-0');
        }
      }

      mobileToggle?.addEventListener('click', openMobileMenu);
      mobileClose?.addEventListener('click', closeMobileMenu);
      mobileBackdrop?.addEventListener('click', closeMobileMenu);

      // Expose globally for cart components
      window.fdUpdateCart = updateCartUI;

      // Initialize
      document.addEventListener('DOMContentLoaded', () => {
        updateCartUI();
        checkAuthStatus();
      });
    </script>
  </body>
</html>
