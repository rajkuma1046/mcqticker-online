    <!-- Global Modern Toast Container -->
    <div id="fd-toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none max-w-sm w-full px-4 sm:px-0"></div>

    <!-- Interactive Cart & Navigation Synchronizer Script -->
    <script is:inline>
      const CART_STORAGE_KEY = 'fd_cart_v1';

      // Modern Global Toast Notification (No alerts)
      window.fdToast = function(title, message = '', type = 'success') {
        const container = document.getElementById('fd-toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `pointer-events-auto flex items-start gap-3 p-4 rounded-2xl shadow-2xl border backdrop-blur-md transition-all duration-300 transform translate-y-[-10px] opacity-0 ${
          type === 'error'
            ? 'bg-[#2a0e0e]/95 border-red-500/50 text-white shadow-red-950/40'
            : type === 'info'
            ? 'bg-[#152317]/95 border-emerald-800 text-white shadow-black/30'
            : 'bg-[#112414]/95 border-emerald-500/50 text-white shadow-emerald-950/40'
        }`;
        const icon = type === 'error' ? '⚠️' : type === 'info' ? 'ℹ️' : '🌿';
        toast.innerHTML = `
          <span class="text-xl flex-shrink-0 mt-0.5">${icon}</span>
          <div class="flex-grow pr-2">
            <div class="text-xs font-bold tracking-wide">${title}</div>
            ${message ? `<div class="text-[11px] text-gray-200 mt-0.5 leading-snug">${message}</div>` : ''}
          </div>
        `;
        container.appendChild(toast);
        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-[-10px]', 'opacity-0');
        });
        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-[-10px]');
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      };

      function getCart() {
        try {
          return JSON.parse(localStorage.getItem(CART_STORAGE_KEY) || '[]');
        } catch {
          return [];
        }
      }

      function updateNavCartBadge() {
        const cart = getCart();
        const badge = document.getElementById('fd-cart-badge');
        const stickyBar = document.getElementById('fd-sticky-cart-bar');
        const barQty = document.getElementById('fd-bar-qty');
        const barTotal = document.getElementById('fd-bar-total');

        const totalItemsCount = cart.reduce((acc, it) => acc + (it.quantity || 1), 0);
        const totalKg = cart.reduce((acc, it) => acc + (it.unit === 'kg' ? it.quantity : 0), 0);
        const totalEstimatedRupees = cart.reduce((acc, it) => acc + (it.estimatedPriceRupees ? (it.estimatedPriceRupees * it.quantity) : 0), 0);

        if (badge) {
          badge.textContent = totalItemsCount;
          if (totalItemsCount > 0) {
            badge.classList.remove('hidden');
          }
        }

        if (stickyBar) {
          if (totalItemsCount > 0) {
            stickyBar.classList.remove('translate-y-full');
            if (barQty) barQty.textContent = `${totalKg} kg`;
            if (barTotal) barTotal.textContent = `₹${totalEstimatedRupees}`;
          } else {
            stickyBar.classList.add('translate-y-full');
          }
        }
      }

      async function syncUserAuthNav() {
        try {
          const res = await fetch('/farm/api/auth/me');
          const data = await res.json();
          const label = document.getElementById('fd-account-label');
          if (label && data.success && data.user) {
            label.textContent = data.user.name.split(' ')[0] || 'Account';
          }
        } catch (e) {}
      }

      // Mobile drawer open/close
      const mobileToggle = document.getElementById('fd-mobile-toggle');
      const mobileClose = document.getElementById('fd-mobile-close');
      const mobileBackdrop = document.getElementById('fd-mobile-backdrop');
      const mobileNav = document.getElementById('fd-mobile-nav');

      function openDrawer() {
        if (mobileNav) {
          mobileNav.classList.remove('pointer-events-none');
          mobileNav.classList.add('open');
          if (mobileBackdrop) mobileBackdrop.classList.remove('opacity-0');
        }
      }

      function closeDrawer() {
        if (mobileNav) {
          mobileNav.classList.remove('open');
          if (mobileBackdrop) mobileBackdrop.classList.add('opacity-0');
          setTimeout(() => mobileNav.classList.add('pointer-events-none'), 300);
        }
      }

      if (mobileToggle) mobileToggle.addEventListener('click', openDrawer);
      if (mobileClose) mobileClose.addEventListener('click', closeDrawer);
      if (mobileBackdrop) mobileBackdrop.addEventListener('click', closeDrawer);

      window.addEventListener('storage', (e) => {
        if (e.key === CART_STORAGE_KEY) updateNavCartBadge();
      });

      document.addEventListener('DOMContentLoaded', () => {
        updateNavCartBadge();
        syncUserAuthNav();
      });
    </script>
  </body>
