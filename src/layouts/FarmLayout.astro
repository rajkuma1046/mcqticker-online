---
import '../styles/global.css';

// Farm Direct — Standalone Layout for /farm
// Ultra-modern, mobile-first agricultural e-commerce layout.

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  hideCartBar?: boolean;
}

const {
  title = 'फार्म डायरेक्ट | Farm Direct - सीधे खेत से शुद्ध देशी गेहूँ, दालें व मूँगफली (Gwalior, Shivpuri, Karera)',
  description = 'सीधे गाँव के खेत से 100% शुद्ध बिना पॉलिश का देशी गेहूँ, कच्ची मूँगफली, देशी चना, मूँग व उड़द। ग्वालियर (Pawan Nagar, Chetakpuri), करैरा, सिरसौद और शिवपुरी में ताज़ा होम डिलीवरी। मुफ़्त 100g/200g सैंपल उपलब्ध।',
  canonicalPath = '/farm',
  hideCartBar = false,
} = Astro.props;

const SITE_URL = 'https://mcqticker.online';
const canonicalURL = `${SITE_URL}${canonicalPath}`;
const WHATSAPP_NUMBER = '8770767272';
const WHATSAPP_LINK = `https://wa.me/91${WHATSAPP_NUMBER}?text=${encodeURIComponent('नमस्ते फार्म डायरेक्ट, मुझे खेत की शुद्ध उपज और डिलीवरी के बारे में जानकारी चाहिए।')}`;

const isHome = canonicalPath === '/farm' || canonicalPath === '/farm/';
const isProduce = canonicalPath.startsWith('/farm/products');
const isSamples = canonicalPath.startsWith('/farm/samples') || canonicalPath.startsWith('/farm/sample-policy');
const isAccount = canonicalPath.startsWith('/farm/account');
const isCart = canonicalPath.startsWith('/farm/cart') || canonicalPath.startsWith('/farm/checkout');

// BreadcrumbList data for Google Rich Results
const breadcrumbsList = [
  { '@type': 'ListItem', position: 1, name: 'होम (Home)', item: `${SITE_URL}/farm` }
];
if (canonicalPath.startsWith('/farm/products/') && canonicalPath !== '/farm/products') {
  breadcrumbsList.push({ '@type': 'ListItem', position: 2, name: 'ताज़ा फसलें (Produce)', item: `${SITE_URL}/farm/products` });
  breadcrumbsList.push({ '@type': 'ListItem', position: 3, name: title.split('|')[0].trim(), item: canonicalURL });
} else if (canonicalPath.startsWith('/farm/products')) {
  breadcrumbsList.push({ '@type': 'ListItem', position: 2, name: 'ताज़ा फसलें (Produce)', item: `${SITE_URL}/farm/products` });
} else if (canonicalPath.startsWith('/farm/reviews')) {
  breadcrumbsList.push({ '@type': 'ListItem', position: 2, name: 'ग्राहक समीक्षाएँ (Reviews)', item: `${SITE_URL}/farm/reviews` });
} else if (canonicalPath.startsWith('/farm/samples')) {
  breadcrumbsList.push({ '@type': 'ListItem', position: 2, name: 'मुफ़्त सैंपल (Free Samples)', item: `${SITE_URL}/farm/samples` });
} else if (canonicalPath.startsWith('/farm/delivery-areas')) {
  breadcrumbsList.push({ '@type': 'ListItem', position: 2, name: 'डिलीवरी क्षेत्र (Delivery Areas)', item: `${SITE_URL}/farm/delivery-areas` });
} else if (canonicalPath.startsWith('/farm/how-it-works')) {
  breadcrumbsList.push({ '@type': 'ListItem', position: 2, name: 'कार्यप्रणाली (How It Works)', item: `${SITE_URL}/farm/how-it-works` });
} else if (canonicalPath.startsWith('/farm/track')) {
  breadcrumbsList.push({ '@type': 'ListItem', position: 2, name: 'ऑर्डर ट्रैकिंग (Track Order)', item: `${SITE_URL}/farm/track` });
} else if (canonicalPath.startsWith('/farm/cart')) {
  breadcrumbsList.push({ '@type': 'ListItem', position: 2, name: 'टोकरी (Cart)', item: `${SITE_URL}/farm/cart` });
} else if (canonicalPath.startsWith('/farm/checkout')) {
  breadcrumbsList.push({ '@type': 'ListItem', position: 2, name: 'चेकआउट (Checkout)', item: `${SITE_URL}/farm/checkout` });
}
---

