    <!-- Premium Google Fonts: Noto Sans Devanagari + Outfit + Plus Jakarta Sans + Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />

    <!-- Immediate Farm Direct Dark Mode Initialization (Zero Flash) -->
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('farm_theme') || localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (t === 'dark' || (!t && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Immediate Service Worker & Cache Healing for Farm Direct -->
    <script is:inline>
      (function() {
        // 1. Evict any stale or corrupt caches from root PWA
        if ('caches' in window) {
          caches.keys().then(function(keys) {
            keys.forEach(function(k) {
              if (k.indexOf('mcq-ticker-cache-v1') !== -1 || k.indexOf('mcq-ticker-cache-v2') !== -1) {
                console.log('[FarmDirect] Purging stale PWA cache:', k);
                caches.delete(k);
              }
            });
          });
        }

        // 2. Fallback protection: If Astro hashed stylesheet failed to load due to MIME mismatch or cache corruption, auto-recover
        window.addEventListener('DOMContentLoaded', function() {
          var links = document.querySelectorAll('link[rel="stylesheet"]');
          links.forEach(function(link) {
            var href = link.getAttribute('href');
            if (href && href.indexOf('/_astro/') !== -1) {
              var loaded = false;
              try {
                for (var i = 0; i < document.styleSheets.length; i++) {
                  var s = document.styleSheets[i];
                  if (s.href && s.href.indexOf(href) !== -1) {
                    if (s.cssRules && s.cssRules.length > 0) {
                      loaded = true;
                      break;
                    }
                  }
                }
              } catch(e) {}

              if (!loaded) {
                console.warn('[FarmDirect] CSS failed to apply, injecting cache-busted stylesheet:', href);
                var bustLink = document.createElement('link');
                bustLink.rel = 'stylesheet';
                bustLink.href = href + (href.indexOf('?') === -1 ? '?t=' : '&t=') + Date.now();
                document.head.appendChild(bustLink);
              }
            }
          });
        });
      })();
    </script>

    <style is:global>
