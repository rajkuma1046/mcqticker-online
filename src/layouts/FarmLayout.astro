        --fd-text: #edf6ef;
        --fd-text-muted: #a3c2a9;
        --fd-text-subtle: #76987c;
        --fd-primary: #38a84e;
        --fd-primary-hover: #48c05f;
        --fd-primary-light: #16361e;
        --fd-accent: #f59e0b;
        --fd-accent-light: #382408;
        --fd-danger: #f87171;
        --fd-danger-light: #3f1515;
        --fd-shadow-sm: 0 2px 8px -1px rgba(0, 0, 0, 0.35);
        --fd-shadow: 0 10px 30px -4px rgba(0, 0, 0, 0.5);
        --fd-shadow-lg: 0 20px 40px -6px rgba(0, 0, 0, 0.7);
      }

