---
// src/pages/sitemap.astro
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Schema from '../components/Schema.astro';

const pageTitle = "Sitemap — Site Directory Explorer";
const pageDesc = "Explore all available tools, practice sheets, OMR logs, timers, and info resources on mcqticker.online using our interactive directory tree.";
const canonicalPath = "/sitemap";

const breadcrumbs = [
  { label: "Sitemap Directory", url: "/sitemap" }
];
---

<BaseLayout title={pageTitle} description={pageDesc} canonicalPath={canonicalPath} ogLocale="en_US">
  <SEO title={pageTitle} description={pageDesc} canonicalPath={canonicalPath} ogLocale="en_US" />
  <Schema pageName={pageTitle} pageDescription={pageDesc} pageUrl={`https://mcqticker.online${canonicalPath}`} breadcrumbs={breadcrumbs} />

  <div class="max-w-3xl mx-auto space-y-8 animate-fadeIn">
    <!-- Breadcrumbs -->
    <Breadcrumb items={breadcrumbs} />

    <!-- Hero Header (Directory style) -->
    <div class="bg-gradient-to-br from-zinc-700/10 to-zinc-500/5 dark:from-zinc-900/40 dark:to-zinc-800/10 border border-zinc-500/20 dark:border-zinc-700/30 rounded-3xl p-8 text-center space-y-6 shadow-custom-md">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-500/10 dark:bg-zinc-700/20 border border-zinc-500/20 dark:border-zinc-600/30 text-text-light dark:text-text-dark text-xxs font-bold uppercase tracking-wider">
        <span class="material-symbols-outlined text-sm">code</span>
        File Tree Directory
      </div>
      <h1 class="font-display font-black text-3xl md:text-5xl text-text-light dark:text-text-dark leading-tight">
        mcqticker.online <span class="text-brand-primary dark:text-brand-secondary">Sitemap</span>
      </h1>
      <p class="text-sm md:text-base text-text-light-muted dark:text-text-dark-muted max-w-xl mx-auto leading-relaxed">
        Navigate our entire platform using this interactive, developer-styled directory explorer. Filter items dynamically using the search bar below.
      </p>
    </div>

    <!-- Interactive Directory Container -->
    <section class="bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark rounded-3xl p-6 shadow-custom-md space-y-6">
      <!-- Search Filter Bar -->
      <div class="flex items-center gap-3 bg-bg-light/60 dark:bg-bg-dark/60 border border-border-light dark:border-border-dark rounded-2xl px-4 py-3">
        <span class="material-symbols-outlined text-text-light-muted dark:text-text-dark-muted text-base">search</span>
        <input
          id="sitemap-search"
          type="text"
          placeholder="Filter directories or pages (e.g. OMR, timer, ssc)..."
          class="w-full text-xs bg-transparent border-none text-text-light dark:text-text-dark focus:outline-none placeholder-text-light-muted dark:placeholder-text-dark-muted"
        />
      </div>

      <!-- Root Folder Explorer Layout -->
      <div class="font-mono-custom text-xs space-y-4 border border-border-light dark:border-border-dark rounded-2xl p-5 bg-bg-light/35 dark:bg-bg-dark/35">
        <!-- Root node -->
        <div class="flex items-center gap-2 font-bold text-text-light dark:text-text-dark border-b border-border-light dark:border-border-dark pb-2.5">
          <span class="material-symbols-outlined text-amber-500 text-sm">keyboard_arrow_down</span>
          <span class="material-symbols-outlined text-brand-primary dark:text-brand-secondary text-sm">groups</span>
          mcqticker-online/ <span class="text-3xs px-2 py-0.5 rounded bg-zinc-500/10 text-text-light-muted dark:text-text-dark-muted font-normal ml-2">Root Project</span>
        </div>

        <div class="pl-4 space-y-4">
          <!-- FOLDER 1: Core Pages -->
          <div class="folder-block space-y-2">
            <div class="folder-title flex items-center gap-1.5 font-bold text-text-light dark:text-text-dark">
              <span class="material-symbols-outlined text-zinc-500 dark:text-zinc-400 text-xs">keyboard_arrow_down</span>
              <span class="material-symbols-outlined text-sky-500 text-sm">home</span>
