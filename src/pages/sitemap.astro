            <div class="pl-6 border-l border-border-light dark:border-border-dark space-y-2">
              <div class="file-item flex items-start gap-2 py-0.5" data-search="home index homepage landing main dashboard">
                <span class="text-text-light-muted dark:text-text-dark-muted font-normal">├─</span>
                <span class="material-symbols-outlined text-sky-500 text-xs">description</span>
                <a href="/" class="hover:underline text-text-light dark:text-text-dark font-bold">index.astro</a>
