                <a href="/privacy" class="hover:underline text-text-light dark:text-text-dark font-bold">privacy.astro</a>
                <span class="text-xxs text-text-light-muted dark:text-text-dark-muted italic">— Data privacy documentation</span>
              </div>
              <div class="file-item flex items-start gap-2 py-0.5" data-search="terms conditions requirements rules rules-use">
                <span class="text-text-light-muted dark:text-text-dark-muted font-normal">└─</span>
                <span class="material-symbols-outlined text-purple-500 text-xs">description</span>
                <a href="/terms" class="hover:underline text-text-light dark:text-text-dark font-bold">terms.astro</a>
                <span class="text-xxs text-text-light-muted dark:text-text-dark-muted italic">— Terms and Conditions</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function setupSitemapSearch() {
    const searchInput = document.getElementById('sitemap-search') as HTMLInputElement | null;
    const fileItems = document.querySelectorAll('.file-item');
    const folderBlocks = document.querySelectorAll('.folder-block');

    if (!searchInput) return;

    searchInput.addEventListener('input', function() {
      const filter = searchInput.value.toLowerCase().trim();

      fileItems.forEach(item => {
        const searchData = item.getAttribute('data-search') || '';
        const textContent = item.textContent?.toLowerCase() || '';
        const match = searchData.includes(filter) || textContent.includes(filter);

        if (match || filter === '') {
          item.classList.remove('hidden');
          item.classList.add('flex');
        } else {
          item.classList.add('hidden');
          item.classList.remove('flex');
        }
      });

      // Hide folder block if all files inside are hidden
      folderBlocks.forEach(block => {
        const visibleFiles = block.querySelectorAll('.file-item:not(.hidden)');
        if (visibleFiles.length === 0 && filter !== '') {
          block.classList.add('hidden');
        } else {
          block.classList.remove('hidden');
        }
      });
    });
  }

  setupSitemapSearch();
  document.addEventListener('astro:after-swap', setupSitemapSearch);
</script>
