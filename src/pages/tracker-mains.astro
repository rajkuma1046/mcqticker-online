        if (editId) {
          const t = dayData.tasks.find(x => x.id === editId);
          if (t) {
            t.title = title;
            t.description = elements.taskDescInput.value.trim();
            if (subtasks.length > 0) t.subtasks = subtasks;
            if (links.length > 0) t.links = links;
            showToast('Task updated', 'success');
          }
        } else {
          const newTask = {
            id: `task-${Date.now()}`,
            number: dayData.tasks.length + 1,
