      }

      // Settings Modal (Cloudflare D1)
      if (elements.openSettingsModalBtn) elements.openSettingsModalBtn.addEventListener('click', openSettingsModal);
      if (elements.syncStatusBtn) elements.syncStatusBtn.addEventListener('click', openSettingsModal);
      if (elements.closeSettingsModalBtn) elements.closeSettingsModalBtn.addEventListener('click', closeSettingsModal);
      if (elements.closeSettingsModalFooterBtn) elements.closeSettingsModalFooterBtn.addEventListener('click', closeSettingsModal);

      // Manual Sync Now Button
      if (elements.manualSyncBtn) {
        elements.manualSyncBtn.addEventListener('click', async () => {
          if (!state.currentUser) {
            showToast('Please sign in with your To-Do account to sync.', 'info');
            openAuthModal('login');
            return;
          }
          showToast('Syncing with Cloudflare D1...', 'info');
          await syncWithCloudflare(false);
        });
      }

      // Offline Barrier Overlay
      window.addEventListener('online', checkNetworkStatus);
      window.addEventListener('offline', checkNetworkStatus);
      if (elements.retryConnectionBtn) {
        elements.retryConnectionBtn.addEventListener('click', () => {
          if (navigator.onLine) {
            checkNetworkStatus();
            showToast('Reconnected to internet!', 'success');
            if (state.currentUser) syncWithCloudflare(false);
          } else {
            showToast('Still offline. Please check your network connection.', 'error');
          }
        });
      }

      // Auto-sync on window focus / tab visibility change
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && state.currentUser) {
          syncWithCloudflare(false, true);
        }
      });
      window.addEventListener('focus', () => {
        if (state.currentUser) {
          syncWithCloudflare(false, true);
        }
      });

      // Periodic background silent sync every 12 seconds
      setInterval(() => {
        if (document.visibilityState === 'visible' && state.currentUser) {
          syncWithCloudflare(false, true);
        }
      }, 12000);

      // Export JSON Backup
      elements.exportDataBtn.addEventListener('click', () => {
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state.days, null, 2));
        const dlAnchor = document.createElement('a');
        dlAnchor.setAttribute("href", dataStr);
        dlAnchor.setAttribute("download", `ssc_cgl_tracker_backup_${new Date().toISOString().slice(0, 10)}.json`);
        document.body.appendChild(dlAnchor);
        dlAnchor.click();
        dlAnchor.remove();
        showToast('Backup JSON downloaded successfully!', 'success');
      });

      // Import JSON Backup
      elements.importDataBtn.addEventListener('click', () => {
        elements.importFileInput.click();
      });

      elements.importFileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (event) => {
          try {
            const imported = JSON.parse(event.target.result);
            if (imported && typeof imported === 'object') {
              state.days = imported;
              showToast('Data restored successfully!', 'success');
              queueCloudflarePush();
              renderUI();
            } else {
              showToast('Invalid backup file structure', 'error');
            }
          } catch (err) {
            showToast('Failed to parse backup JSON', 'error');
          }
        };
        reader.readAsText(file);
      });
    }

    // App Initialization
    async function initApp() {
      applyTheme(getSavedThemePreference());
      checkNetworkStatus();
      loadLocalData();
      updateTimerDisplay();
      setupEventListeners();
      renderUI();
      await checkAuthUser();
      if (state.currentUser) {
        await syncWithCloudflare(true);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initApp);
    } else {
      initApp();
    }
  </script>
</body>
</html>
