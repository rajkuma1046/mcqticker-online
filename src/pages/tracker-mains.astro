---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#0f172a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>SSC CGL 2026 Target Tracker | RBE Daily Study Planner</title>
  <meta name="description" content="SSC CGL 2026 Tier-2 daily target tracker & RBE study planner. Parse Telegram target posts, track daily progress, practice typing with built-in timer, and sync with Cloudflare database.">
  <link rel="canonical" href="https://mcqticker.online/tracker-mains">

  <!-- Anti-flicker Theme Initializer -->
  <script is:inline>
    (function() {
      try {
        const savedTheme = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
  <!-- Google Fonts Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script is:inline>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            primary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    };
  </script>
  
  <style is:inline>
    body {
      font-family: 'Inter', sans-serif;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    /* Dark mode scrollbar */
    html.dark .custom-scrollbar::-webkit-scrollbar-track {
      background: #0f172a;
    }
    html.dark .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #334155;
    }
    html.dark .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }
    /* Mobile-first enhancements */
    * {
      -webkit-tap-highlight-color: transparent;
    }
    input, textarea, select {
      font-size: 16px !important; /* Prevents auto-zoom on iOS */
    }
    @media (min-width: 640px) {
      input, textarea, select {
        font-size: 13px !important;
      }
    }
    .touch-target {
      min-height: 44px;
      min-width: 44px;
    }
    .safe-bottom {
      padding-bottom: env(safe-area-inset-bottom, 16px);
    }
  </style>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col antialiased transition-colors duration-200">

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed top-4 right-4 z-50 flex flex-col space-y-2 pointer-events-none"></div>

  <!-- Header & Navbar -->
  <header class="bg-slate-900 text-white sticky top-0 z-40 shadow-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Logo & Title -->
        <div class="flex items-center space-x-4">
          <a href="/tracker-mains" class="flex items-center space-x-3 text-left">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-indigo-600 flex items-center justify-center text-xl shadow-lg shadow-indigo-500/20 shrink-0">
              🎯
            </div>
            <div>
              <h1 class="text-base sm:text-lg font-bold tracking-tight text-white flex items-center gap-2">
                SSC CGL 2026 Tracker
                <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-indigo-500/30 text-indigo-300 border border-indigo-400/30">Tier-2</span>
              </h1>
              <p class="text-xs text-slate-400 hidden sm:block">RBE Daily Study Planner & Target Tracker</p>
            </div>
          </a>
          <nav class="hidden lg:flex items-center space-x-1 border-l border-slate-800 pl-3 text-xs font-medium text-slate-300">
            <a href="/" class="hover:text-white px-2.5 py-1 rounded-lg hover:bg-slate-800 transition">MCQ Ticker</a>
            <a href="/todo" class="hover:text-white px-2.5 py-1 rounded-lg hover:bg-slate-800 transition">To-Do List</a>
            <a href="/practice-mcq-from-book-with-timer" class="hover:text-white px-2.5 py-1 rounded-lg hover:bg-slate-800 transition">Book Practice</a>
            <a href="/pomodoro-timer" class="hover:text-white px-2.5 py-1 rounded-lg hover:bg-slate-800 transition">Pomodoro</a>
          </nav>
        </div>

        <!-- Quick Status & Controls -->
        <div class="flex items-center space-x-2 sm:space-x-3">
          <!-- Cloudflare D1 Sync Indicator Badge -->
          <button id="syncStatusBtn" class="flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-800 hover:bg-slate-700 border border-slate-700 transition" title="Click to view Cloudflare database connection & sync details">
            <span id="syncDot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span id="syncStatusText" class="text-slate-300">Checking DB...</span>
          </button>

          <!-- User Account State / Sign In button (Uses To-Do Credentials) -->
          <div id="authHeaderContainer" class="flex items-center">
            <div id="headerUserBox" class="hidden items-center gap-1.5">
              <div class="hidden md:flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-indigo-950/70 border border-indigo-500/40 text-indigo-200" title="Signed in with To-Do credentials">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span id="headerUserEmail" class="max-w-[130px] truncate font-medium">user@example.com</span>
              </div>
              <button id="logoutBtn" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-rose-900/50 text-slate-300 hover:text-rose-200 border border-slate-700 transition" title="Sign Out">
                Logout
              </button>
            </div>
            <button id="openAuthModalBtn" class="flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 transition shadow-sm">
              <span>🔑</span>
              <span class="hidden sm:inline">Sign In</span>
              <span class="sm:hidden">Login</span>
            </button>
          </div>

          <!-- Study Timer Widget Button -->
          <button id="toggleTimerBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-indigo-500/30 transition shadow-sm">
            <span>⏱️</span>
            <span id="timerDisplay">30:00</span>
          </button>

          <!-- Paste Telegram Post Button -->
          <button id="openPasteModalBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-sm shadow-indigo-600/30">
            <span>📋</span>
            <span class="hidden sm:inline">Paste Schedule</span>
            <span class="sm:hidden">Paste</span>
          </button>

          <!-- Dark / Light Theme Toggle Button -->
          <button id="themeToggleBtn" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition flex items-center justify-center text-sm" title="Toggle Light / Dark Mode" aria-label="Toggle theme">
            <span id="themeToggleIcon" class="select-none">🌙</span>
          </button>

          <!-- Settings Button -->
          <button id="openSettingsModalBtn" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition" title="Cloudflare Database & Sync Settings">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </button>
        </div>

      </div>
    </div>
  </header>

  <!-- Sticky Study Timer Floating Bar (expandable) -->
  <div id="studyTimerBar" class="hidden bg-slate-800 dark:bg-slate-900 text-slate-100 border-b border-slate-700 dark:border-slate-800 px-4 py-2.5 shadow-md">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <span class="text-sm font-semibold text-indigo-300">⏱️ Study Focus Timer</span>
        <span id="activeTimerText" class="text-xl font-mono font-bold text-white tracking-widest">30:00</span>
        <span id="timerStatusLabel" class="text-xs px-2 py-0.5 rounded bg-slate-700 dark:bg-slate-800 text-slate-300">Ready</span>
      </div>
      <div class="flex items-center space-x-2">
        <button id="timerPreset15" class="px-2 py-1 text-xs rounded bg-slate-700 dark:bg-slate-800 hover:bg-slate-600 dark:hover:bg-slate-700 text-slate-200">15m</button>
        <button id="timerPreset30" class="px-2 py-1 text-xs rounded bg-indigo-600 text-white font-medium">30m (Typing)</button>
        <button id="timerPreset60" class="px-2 py-1 text-xs rounded bg-slate-700 dark:bg-slate-800 hover:bg-slate-600 dark:hover:bg-slate-700 text-slate-200">60m (Maths)</button>
        <div class="h-4 w-px bg-slate-600 dark:bg-slate-700 mx-1"></div>
        <button id="startTimerBtn" class="px-3 py-1 text-xs rounded font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition">Start</button>
        <button id="pauseTimerBtn" class="px-3 py-1 text-xs rounded font-semibold bg-amber-600 hover:bg-amber-500 text-white transition hidden">Pause</button>
        <button id="resetTimerBtn" class="px-3 py-1 text-xs rounded font-semibold bg-slate-600 dark:bg-slate-700 hover:bg-slate-500 dark:hover:bg-slate-600 text-slate-200 transition">Reset</button>
        <button id="closeTimerBarBtn" class="p-1 text-slate-400 hover:text-white" title="Hide Timer Bar">✕</button>
      </div>
    </div>
  </div>

  <!-- Main Content Layout -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- Day Navigation Bar -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 shadow-sm border border-slate-200/80 dark:border-slate-800 transition-colors">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        
        <!-- Day Tabs Scrollable -->
        <div class="flex items-center space-x-2 overflow-x-auto pb-1 sm:pb-0 custom-scrollbar" id="dayTabsContainer">
          <!-- Dynamic Day Tabs Inserted Here -->
        </div>

        <!-- Right Action Controls -->
        <div class="flex items-center space-x-2 shrink-0">
          <button id="addNewDayBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition">
            <span>➕</span> Add Day
          </button>
          <button id="shareDayBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-50 dark:bg-emerald-950/40 hover:bg-emerald-100 dark:hover:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 transition" title="Copy progress report for Telegram/WhatsApp group">
            <span>📤</span> Copy Update
          </button>
        </div>

      </div>
    </div>

    <!-- Active Day Banner & Progress Card -->
    <div class="bg-gradient-to-br from-indigo-900 via-indigo-800 to-slate-900 dark:from-slate-900 dark:via-indigo-950 dark:to-slate-950 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden dark:border dark:border-slate-800">
      <!-- Decorative Background Circles -->
      <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute right-1/3 -top-12 w-48 h-48 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 space-y-5">
        
        <!-- Top Row: Title, Date & Streak -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span id="bannerDayBadge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-400 text-slate-950 uppercase tracking-wider">Day 2</span>
              <span id="bannerDate" class="text-xs text-indigo-200 font-medium">Daily Target Schedule</span>
            </div>
            <h2 id="bannerTitle" class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
              SSC CGL 2026 T-2 | RBE Targets
            </h2>
          </div>

          <!-- Quick Stats Pills -->
          <div class="flex items-center gap-3">
            <div class="bg-white/10 dark:bg-white/5 backdrop-blur-md px-4 py-2 rounded-2xl border border-white/10 flex items-center gap-3">
              <div class="text-2xl">🔥</div>
              <div>
                <p class="text-[10px] text-indigo-200 uppercase font-semibold">Consistency</p>
                <p id="streakDisplay" class="text-sm font-bold text-white">2 Days Streak</p>
              </div>
            </div>

            <div class="bg-white/10 dark:bg-white/5 backdrop-blur-md px-4 py-2 rounded-2xl border border-white/10 flex items-center gap-3">
              <div class="text-2xl">⚡</div>
              <div>
                <p class="text-[10px] text-indigo-200 uppercase font-semibold">Completed</p>
                <p id="statRatioDisplay" class="text-sm font-bold text-white">0 / 5 Tasks</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Motivational Quote Banner -->
        <div id="quoteCard" class="bg-white/10 dark:bg-white/5 backdrop-blur-md rounded-2xl p-4 border border-white/10 flex items-start gap-3">
          <span class="text-xl shrink-0">🔥</span>
          <p id="quoteText" class="text-sm italic text-indigo-100 font-medium leading-relaxed">
            “Don’t just count the days—make each day count. Today’s revision is tomorrow’s strength.”
          </p>
        </div>

        <!-- Progress Bar & Actions -->
        <div class="space-y-2 pt-1">
          <div class="flex items-center justify-between text-xs sm:text-sm font-semibold">
            <span class="text-indigo-200">Daily Target Completion</span>
            <span id="progressPercentText" class="text-amber-300 font-bold">0%</span>
          </div>
          <div class="w-full bg-slate-950/50 rounded-full h-3.5 p-0.5 overflow-hidden border border-white/10">
            <div id="progressBarFill" class="bg-gradient-to-r from-amber-400 via-emerald-400 to-indigo-400 h-full rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
          </div>
        </div>

        <!-- Filter & Control Buttons -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-white/10 text-xs">
          <!-- Filter Tabs -->
          <div class="flex items-center space-x-1.5 bg-slate-950/40 dark:bg-slate-950/70 p-1 rounded-xl">
            <button class="filter-btn active px-3 py-1 rounded-lg font-medium transition bg-indigo-600 text-white" data-filter="all">All (<span id="filterAllCount">0</span>)</button>
            <button class="filter-btn px-3 py-1 rounded-lg font-medium transition text-indigo-200 hover:text-white" data-filter="pending">Pending (<span id="filterPendingCount">0</span>)</button>
            <button class="filter-btn px-3 py-1 rounded-lg font-medium transition text-indigo-200 hover:text-white" data-filter="completed">Done (<span id="filterDoneCount">0</span>)</button>
          </div>

          <!-- Batch Action Buttons -->
          <div class="flex items-center space-x-2">
            <button id="addNewTaskBtn" class="px-3 py-1.5 rounded-xl bg-white/15 dark:bg-white/10 hover:bg-white/25 text-white font-semibold transition flex items-center gap-1">
              <span>➕</span> Add Task
            </button>
            <button id="markAllDoneBtn" class="px-3 py-1.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-400/30 font-medium transition">
              Check All
            </button>
            <button id="resetDayTasksBtn" class="px-3 py-1.5 rounded-xl bg-slate-800 dark:bg-slate-800/80 hover:bg-slate-700 text-slate-300 font-medium transition">
              Reset Day
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- Task List Container -->
    <div class="space-y-4">
      <div class="flex items-center justify-between px-1">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-2">
          <span>🎯</span> Daily Target Tasks
          <span id="taskListCountBadge" class="text-xs bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-2 py-0.5 rounded-full font-semibold">5 items</span>
        </h3>
        <span class="text-xs text-slate-400 dark:text-slate-500">Click checkboxes to tick off completed items</span>
      </div>

      <!-- Dynamic Tasks Cards List -->
      <div id="taskList" class="space-y-4">
        <!-- Rendered by JavaScript -->
      </div>

      <!-- Empty State -->
      <div id="emptyTasksState" class="hidden bg-white dark:bg-slate-900 rounded-3xl p-12 text-center border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="w-16 h-16 mx-auto mb-4 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 rounded-2xl flex items-center justify-center text-3xl">
          📝
        </div>
        <h4 class="text-lg font-bold text-slate-800 dark:text-slate-100 mb-1">No tasks found</h4>
        <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mb-6">
          Paste your Telegram target schedule or click below to add targets for today.
        </p>
        <button id="emptyPasteBtn" class="px-4 py-2 bg-indigo-600 text-white rounded-xl text-sm font-semibold hover:bg-indigo-500 transition shadow-sm">
          📋 Paste Schedule from Telegram
        </button>
      </div>
    </div>

    <!-- Extra Study Resources / Books Section (from Telegram post) -->
    <div id="extraResourcesCard" class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4 transition-colors">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">📘</span>
          <div>
            <h4 class="text-sm font-bold text-slate-800 dark:text-slate-100">Recommended Reference & Books</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400">Official RBE Preparation Resources & Test Portals</p>
          </div>
        </div>
        <span class="text-xs bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200/50 dark:border-indigo-800/50 font-semibold px-2.5 py-1 rounded-lg">Quick Links</span>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 pt-2">
        <a href="https://rbelearning.com" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-indigo-300 dark:hover:border-indigo-700 hover:bg-indigo-50/40 dark:hover:bg-slate-800/60 transition group">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-indigo-100 dark:bg-indigo-900/60 text-indigo-700 dark:text-indigo-300 flex items-center justify-center font-bold text-xs">RBE</span>
            <div>
              <p class="text-xs font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">RBE Learning Portal</p>
              <p class="text-[11px] text-slate-400 dark:text-slate-500">Mock Tests & Video Courses</p>
            </div>
          </div>
          <span class="text-xs text-slate-400 dark:text-slate-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">↗</span>
        </a>

        <a href="https://realmocks.com/typing" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-indigo-300 dark:hover:border-indigo-700 hover:bg-indigo-50/40 dark:hover:bg-slate-800/60 transition group">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/60 text-purple-700 dark:text-purple-300 flex items-center justify-center text-sm">⌨️</span>
            <div>
              <p class="text-xs font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">RealMocks Typing</p>
              <p class="text-[11px] text-slate-400 dark:text-slate-500">SSC Pattern Typing Practice</p>
            </div>
          </div>
          <span class="text-xs text-slate-400 dark:text-slate-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">↗</span>
        </a>

