---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#0f172a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>SSC CGL 2026 Target Tracker | RBE Daily Study Planner</title>
  <meta name="description" content="SSC CGL 2026 Tier-2 daily target tracker & RBE study planner. Parse Telegram target posts, track daily progress, practice typing with built-in timer, and sync with Cloudflare database.">
  <link rel="canonical" href="https://mcqticker.online/tracker-mains">

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
  <!-- Google Fonts Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script is:inline>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            primary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    };
  </script>
  
  <style is:inline>
    body {
      font-family: 'Inter', sans-serif;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    /* Mobile-first enhancements */
    * {
      -webkit-tap-highlight-color: transparent;
    }
    input, textarea, select {
      font-size: 16px !important; /* Prevents auto-zoom on iOS */
    }
    @media (min-width: 640px) {
      input, textarea, select {
        font-size: 13px !important;
      }
    }
    .touch-target {
      min-height: 44px;
      min-width: 44px;
    }
    .safe-bottom {
      padding-bottom: env(safe-area-inset-bottom, 16px);
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed top-4 right-4 z-50 flex flex-col space-y-2 pointer-events-none"></div>

  <!-- Header & Navbar -->
  <header class="bg-slate-900 text-white sticky top-0 z-40 shadow-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Logo & Title -->
        <div class="flex items-center space-x-4">
          <a href="/tracker-mains" class="flex items-center space-x-3 text-left">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-indigo-600 flex items-center justify-center text-xl shadow-lg shadow-indigo-500/20 shrink-0">
              🎯
            </div>
            <div>
              <h1 class="text-base sm:text-lg font-bold tracking-tight text-white flex items-center gap-2">
                SSC CGL 2026 Tracker
                <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-indigo-500/30 text-indigo-300 border border-indigo-400/30">Tier-2</span>
              </h1>
              <p class="text-xs text-slate-400 hidden sm:block">RBE Daily Study Planner & Target Tracker</p>
            </div>
          </a>
          <nav class="hidden lg:flex items-center space-x-1 border-l border-slate-800 pl-3 text-xs font-medium text-slate-300">
            <a href="/" class="hover:text-white px-2.5 py-1 rounded-lg hover:bg-slate-800 transition">MCQ Ticker</a>
            <a href="/todo" class="hover:text-white px-2.5 py-1 rounded-lg hover:bg-slate-800 transition">To-Do List</a>
            <a href="/practice-mcq-from-book-with-timer" class="hover:text-white px-2.5 py-1 rounded-lg hover:bg-slate-800 transition">Book Practice</a>
            <a href="/pomodoro-timer" class="hover:text-white px-2.5 py-1 rounded-lg hover:bg-slate-800 transition">Pomodoro</a>
          </nav>
        </div>

        <!-- Quick Status & Controls -->
        <div class="flex items-center space-x-2 sm:space-x-4">
          <!-- Cloudflare D1 Sync Indicator Badge -->
          <button id="syncStatusBtn" class="flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-800 hover:bg-slate-700 border border-slate-700 transition" title="Click to view Cloudflare database connection details">
            <span id="syncDot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span id="syncStatusText" class="text-slate-300">Checking Cloudflare DB...</span>
          </button>

          <!-- Study Timer Widget Button -->
          <button id="toggleTimerBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-indigo-500/30 transition shadow-sm">
            <span>⏱️</span>
            <span id="timerDisplay">30:00</span>
          </button>

          <!-- Paste Telegram Post Button -->
          <button id="openPasteModalBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-sm shadow-indigo-600/30">
            <span>📋</span>
            <span class="hidden sm:inline">Paste Schedule</span>
            <span class="sm:hidden">Paste</span>
          </button>

          <!-- Settings Button -->
          <button id="openSettingsModalBtn" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition" title="Cloudflare Database & Sync Settings">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </button>
        </div>

      </div>
    </div>
  </header>

  <!-- Sticky Study Timer Floating Bar (expandable) -->
  <div id="studyTimerBar" class="hidden bg-slate-800 text-slate-100 border-b border-slate-700 px-4 py-2.5 shadow-md">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <span class="text-sm font-semibold text-indigo-300">⏱️ Study Focus Timer</span>
        <span id="activeTimerText" class="text-xl font-mono font-bold text-white tracking-widest">30:00</span>
        <span id="timerStatusLabel" class="text-xs px-2 py-0.5 rounded bg-slate-700 text-slate-300">Ready</span>
      </div>
      <div class="flex items-center space-x-2">
        <button id="timerPreset15" class="px-2 py-1 text-xs rounded bg-slate-700 hover:bg-slate-600 text-slate-200">15m</button>
        <button id="timerPreset30" class="px-2 py-1 text-xs rounded bg-indigo-600 text-white font-medium">30m (Typing)</button>
        <button id="timerPreset60" class="px-2 py-1 text-xs rounded bg-slate-700 hover:bg-slate-600 text-slate-200">60m (Maths)</button>
        <div class="h-4 w-px bg-slate-600 mx-1"></div>
        <button id="startTimerBtn" class="px-3 py-1 text-xs rounded font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition">Start</button>
        <button id="pauseTimerBtn" class="px-3 py-1 text-xs rounded font-semibold bg-amber-600 hover:bg-amber-500 text-white transition hidden">Pause</button>
        <button id="resetTimerBtn" class="px-3 py-1 text-xs rounded font-semibold bg-slate-600 hover:bg-slate-500 text-slate-200 transition">Reset</button>
        <button id="closeTimerBarBtn" class="p-1 text-slate-400 hover:text-white" title="Hide Timer Bar">✕</button>
      </div>
    </div>
  </div>

  <!-- Main Content Layout -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- Day Navigation Bar -->
    <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200/80">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        
        <!-- Day Tabs Scrollable -->
        <div class="flex items-center space-x-2 overflow-x-auto pb-1 sm:pb-0 custom-scrollbar" id="dayTabsContainer">
          <!-- Dynamic Day Tabs Inserted Here -->
        </div>

        <!-- Right Action Controls -->
        <div class="flex items-center space-x-2 shrink-0">
          <button id="addNewDayBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
            <span>➕</span> Add Day
          </button>
          <button id="shareDayBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 transition" title="Copy progress report for Telegram/WhatsApp group">
            <span>📤</span> Copy Update
          </button>
        </div>

      </div>
    </div>

    <!-- Active Day Banner & Progress Card -->
    <div class="bg-gradient-to-br from-indigo-900 via-indigo-800 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
      <!-- Decorative Background Circles -->
      <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute right-1/3 -top-12 w-48 h-48 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 space-y-5">
        
        <!-- Top Row: Title, Date & Streak -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span id="bannerDayBadge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-400 text-slate-950 uppercase tracking-wider">Day 2</span>
              <span id="bannerDate" class="text-xs text-indigo-200 font-medium">Daily Target Schedule</span>
            </div>
            <h2 id="bannerTitle" class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
              SSC CGL 2026 T-2 | RBE Targets
            </h2>
          </div>

          <!-- Quick Stats Pills -->
          <div class="flex items-center gap-3">
            <div class="bg-white/10 backdrop-blur-md px-4 py-2 rounded-2xl border border-white/10 flex items-center gap-3">
              <div class="text-2xl">🔥</div>
              <div>
                <p class="text-[10px] text-indigo-200 uppercase font-semibold">Consistency</p>
                <p id="streakDisplay" class="text-sm font-bold text-white">2 Days Streak</p>
              </div>
            </div>

            <div class="bg-white/10 backdrop-blur-md px-4 py-2 rounded-2xl border border-white/10 flex items-center gap-3">
              <div class="text-2xl">⚡</div>
              <div>
                <p class="text-[10px] text-indigo-200 uppercase font-semibold">Completed</p>
                <p id="statRatioDisplay" class="text-sm font-bold text-white">0 / 5 Tasks</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Motivational Quote Banner -->
        <div id="quoteCard" class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10 flex items-start gap-3">
          <span class="text-xl shrink-0">🔥</span>
          <p id="quoteText" class="text-sm italic text-indigo-100 font-medium leading-relaxed">
            “Don’t just count the days—make each day count. Today’s revision is tomorrow’s strength.”
          </p>
        </div>

        <!-- Progress Bar & Actions -->
        <div class="space-y-2 pt-1">
          <div class="flex items-center justify-between text-xs sm:text-sm font-semibold">
            <span class="text-indigo-200">Daily Target Completion</span>
            <span id="progressPercentText" class="text-amber-300 font-bold">0%</span>
          </div>
          <div class="w-full bg-slate-950/50 rounded-full h-3.5 p-0.5 overflow-hidden border border-white/10">
            <div id="progressBarFill" class="bg-gradient-to-r from-amber-400 via-emerald-400 to-indigo-400 h-full rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
          </div>
        </div>

        <!-- Filter & Control Buttons -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-white/10 text-xs">
          <!-- Filter Tabs -->
          <div class="flex items-center space-x-1.5 bg-slate-950/40 p-1 rounded-xl">
            <button class="filter-btn active px-3 py-1 rounded-lg font-medium transition bg-indigo-600 text-white" data-filter="all">All (<span id="filterAllCount">0</span>)</button>
            <button class="filter-btn px-3 py-1 rounded-lg font-medium transition text-indigo-200 hover:text-white" data-filter="pending">Pending (<span id="filterPendingCount">0</span>)</button>
            <button class="filter-btn px-3 py-1 rounded-lg font-medium transition text-indigo-200 hover:text-white" data-filter="completed">Done (<span id="filterDoneCount">0</span>)</button>
          </div>

          <!-- Batch Action Buttons -->
          <div class="flex items-center space-x-2">
            <button id="addNewTaskBtn" class="px-3 py-1.5 rounded-xl bg-white/15 hover:bg-white/25 text-white font-semibold transition flex items-center gap-1">
              <span>➕</span> Add Task
            </button>
            <button id="markAllDoneBtn" class="px-3 py-1.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-400/30 font-medium transition">
              Check All
            </button>
            <button id="resetDayTasksBtn" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium transition">
              Reset Day
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- Task List Container -->
    <div class="space-y-4">
      <div class="flex items-center justify-between px-1">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
          <span>🎯</span> Daily Target Tasks
          <span id="taskListCountBadge" class="text-xs bg-slate-200 text-slate-700 px-2 py-0.5 rounded-full font-semibold">5 items</span>
        </h3>
        <span class="text-xs text-slate-400">Click checkboxes to tick off completed items</span>
      </div>

      <!-- Dynamic Tasks Cards List -->
      <div id="taskList" class="space-y-4">
        <!-- Rendered by JavaScript -->
      </div>

      <!-- Empty State -->
      <div id="emptyTasksState" class="hidden bg-white rounded-3xl p-12 text-center border border-slate-200 shadow-sm">
        <div class="w-16 h-16 mx-auto mb-4 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center text-3xl">
          📝
        </div>
        <h4 class="text-lg font-bold text-slate-800 mb-1">No tasks found</h4>
        <p class="text-sm text-slate-500 max-w-md mx-auto mb-6">
          Paste your Telegram target schedule or click below to add targets for today.
        </p>
        <button id="emptyPasteBtn" class="px-4 py-2 bg-indigo-600 text-white rounded-xl text-sm font-semibold hover:bg-indigo-500 transition shadow-sm">
          📋 Paste Schedule from Telegram
        </button>
      </div>
    </div>

    <!-- Extra Study Resources / Books Section (from Telegram post) -->
    <div id="extraResourcesCard" class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">📘</span>
          <div>
            <h4 class="text-sm font-bold text-slate-800">Recommended Reference & Books</h4>
            <p class="text-xs text-slate-500">Official RBE Preparation Resources & Test Portals</p>
          </div>
        </div>
        <span class="text-xs bg-indigo-50 text-indigo-700 font-semibold px-2.5 py-1 rounded-lg">Quick Links</span>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 pt-2">
        <a href="https://rbelearning.com" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/40 transition group">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs">RBE</span>
            <div>
              <p class="text-xs font-semibold text-slate-800 group-hover:text-indigo-600">RBE Learning Portal</p>
              <p class="text-[11px] text-slate-400">Mock Tests & Video Courses</p>
            </div>
          </div>
          <span class="text-xs text-slate-400 group-hover:text-indigo-600">↗</span>
        </a>

        <a href="https://realmocks.com/typing" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/40 transition group">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center text-sm">⌨️</span>
            <div>
              <p class="text-xs font-semibold text-slate-800 group-hover:text-indigo-600">RealMocks Typing</p>
              <p class="text-[11px] text-slate-400">SSC Pattern Typing Practice</p>
            </div>
          </div>
          <span class="text-xs text-slate-400 group-hover:text-indigo-600">↗</span>
        </a>

        <a href="https://www.youtube.com/@RBERevolutionByEducation" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/40 transition group">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-rose-100 text-rose-700 flex items-center justify-center text-sm">🎥</span>
            <div>
              <p class="text-xs font-semibold text-slate-800 group-hover:text-indigo-600">RBE YouTube Channel</p>
              <p class="text-[11px] text-slate-400">Analysis & Solutions</p>
            </div>
          </div>
          <span class="text-xs text-slate-400 group-hover:text-indigo-600">↗</span>
        </a>
      </div>
    </div>

  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 py-6 mb-16 sm:mb-0 text-center text-xs text-slate-500">
    <p class="font-medium text-slate-700 mb-1">🎯 SSC CGL 2026 Tier-2 Daily Target & Study Tracker</p>
    <p>Crafted for continuous revision and high score consistency. Supports Telegram post parsing & Cloudflare D1 Database sync.</p>
  </footer>

  <!-- Mobile Sticky Bottom Action Bar (Thumb-friendly on phones) -->
  <nav class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-slate-900/95 backdrop-blur-md border-t border-slate-800 safe-bottom shadow-2xl">
    <div class="grid grid-cols-4 gap-1 px-2 py-2">
      <button id="mobilePasteBtn" class="flex flex-col items-center justify-center py-1.5 px-1 rounded-xl text-indigo-300 hover:text-white hover:bg-slate-800 transition">
        <span class="text-lg">📋</span>
        <span class="text-[10px] font-semibold mt-0.5">Paste</span>
      </button>
      <button id="mobileTimerBtn" class="flex flex-col items-center justify-center py-1.5 px-1 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition">
        <span class="text-lg">⏱️</span>
        <span class="text-[10px] font-semibold mt-0.5" id="mobileTimerLabel">30m</span>
      </button>
      <button id="mobileAddTaskBtn" class="flex flex-col items-center justify-center py-1.5 px-1 rounded-xl text-emerald-400 hover:text-emerald-300 hover:bg-slate-800 transition">
        <span class="text-lg">➕</span>
        <span class="text-[10px] font-semibold mt-0.5">Add</span>
      </button>
      <button id="mobileShareBtn" class="flex flex-col items-center justify-center py-1.5 px-1 rounded-xl text-amber-400 hover:text-amber-300 hover:bg-slate-800 transition">
        <span class="text-lg">📤</span>
        <span class="text-[10px] font-semibold mt-0.5">Share</span>
      </button>
    </div>
  </nav>

  <!-- ==================== MODALS ==================== -->

  <!-- Modal 1: Smart Paste & Importer Modal -->
  <div id="pasteModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
    <div class="bg-white rounded-3xl max-w-2xl w-full max-h-[90vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden">
      
      <!-- Modal Header -->
      <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-base">📋</div>
          <div>
            <h3 class="text-base font-bold text-white">Import Telegram Target Schedule</h3>
            <p class="text-xs text-slate-300">Paste your daily target post from Telegram</p>
          </div>
        </div>
        <button id="closePasteModalBtn" class="text-slate-400 hover:text-white p-1 rounded-lg">✕</button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 overflow-y-auto space-y-4 custom-scrollbar flex-1">
        <div class="flex items-center justify-between">
          <label for="pasteScheduleInput" class="text-xs font-bold text-slate-700 uppercase tracking-wider">Paste Post Content:</label>
          <button id="loadSampleScheduleBtn" class="text-xs text-indigo-600 hover:text-indigo-700 font-semibold underline">
            Load Sample (Day 2)
          </button>
        </div>

        <textarea id="pasteScheduleInput" rows="10" class="w-full text-xs sm:text-sm font-mono p-3 bg-slate-50 border border-slate-300 rounded-2xl focus:ring-2 focus:ring-indigo-500 focus:outline-none transition leading-relaxed" placeholder="Paste your Telegram post here...
e.g.
🎯 SSC CGL 2026 T-2 | RBE Targets
📅 Day 2

💻 1. Computer — PYQ Sectional Tests
...
⌨️ 2. Typing — 30 Minutes
