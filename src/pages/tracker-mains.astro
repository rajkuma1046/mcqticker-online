    // Helper: Toast Notifications
    function showToast(message, type = 'info') {
      const toast = document.createElement('div');
      const bgColors = {
        success: 'bg-emerald-600 text-white',
        error: 'bg-rose-600 text-white',
        info: 'bg-slate-800 text-white',
        warning: 'bg-amber-600 text-white'
      };
      const icons = {
        success: '✅',
        error: '⚠️',
        info: 'ℹ️',
        warning: '⚡'
      };

      toast.className = `flex items-center gap-2.5 px-4 py-2.5 rounded-xl shadow-lg text-xs font-semibold ${bgColors[type] || bgColors.info} transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto`;
      toast.innerHTML = `<span>${icons[type] || '•'}</span><span>${message}</span>`;
      
      elements.toastContainer.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }

    // Unicode Mathematical Font Normalization to Plain Text
    function normalizeUnicode(text) {
      if (!text) return '';
      return text.normalize('NFKD');
    }

    // Schedule Text Parser (Handles Telegram bold/math symbols and bullet points)
    function parseScheduleText(rawText) {
      const clean = normalizeUnicode(rawText);
      const lines = clean.split('\n').map(l => l.trim());

      let dayNum = 2;
      let title = "SSC CGL 2026 T-2 | RBE Targets";
      let quote = "";

      // 1. Detect Day Number
      for (const line of lines) {
        const match = line.match(/(?:Day|दिन)\s*(\d+)/i);
        if (match) {
          dayNum = parseInt(match[1], 10);
          break;
        }
      }

      // 2. Detect Title
      for (const line of lines) {
        if ((line.includes('SSC') || line.includes('Target') || line.includes('CGL')) && !/(?:Day|दिन)\s*\d+/i.test(line)) {
          title = line.replace(/^[🎯\s]+/, '').trim();
          break;
        }
      }

      // 3. Detect Quote
      for (const line of lines) {
        if ((line.includes('“') || line.includes('"') || line.includes('🔥')) &&
            !/(?:test|pyq|mock|open:|attempt|total)/i.test(line)) {
          quote = line.replace(/^[🔥\s“"]+|[”"\s]+$/g, '').trim();
          break;
        }
      }

      // 4. Extract Tasks
      const taskHeaderRegex = /^([^\w\d\s\(\[\{]*)\s*(\b\d{1,2}\b)[\.\)\:\s]+([^\r\n]+)$/;
      const tasks = [];
      let currentTask = null;

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        if (!line) continue;

        if (quote && line.includes(quote.substring(0, 15))) continue;

        const headerMatch = line.match(taskHeaderRegex);
        if (headerMatch && !line.startsWith('(')) {
          if (currentTask) {
            tasks.push(finalizeTask(currentTask));
          }
          const rawEmoji = headerMatch[1].trim();
          const num = parseInt(headerMatch[2], 10);
          const fullTitle = headerMatch[3].trim();
          
          let subj = "Other";
          let emoji = rawEmoji || "📌";
          const titleLower = fullTitle.toLowerCase();
          if (titleLower.includes('computer')) { subj = 'Computer'; emoji = emoji || '💻'; }
          else if (titleLower.includes('typing')) { subj = 'Typing'; emoji = emoji || '⌨️'; }
          else if (titleLower.includes('maths') || titleLower.includes('math')) { subj = 'Maths'; emoji = emoji || '📐'; }
          else if (titleLower.includes('english')) { subj = 'English'; emoji = emoji || '📚'; }
          else if (titleLower.includes('reasoning')) { subj = 'Reasoning'; emoji = emoji || '🧠'; }
          else if (titleLower.includes('revision')) { subj = 'Revision'; emoji = emoji || '🔄'; }
          else if (titleLower.includes('gk') || titleLower.includes('gs') || titleLower.includes('general')) { subj = 'GK/GS'; emoji = emoji || '🏛️'; }

          currentTask = {
            id: `task-${tasks.length + 1}-${Date.now()}`,
            number: num,
            subject: subj,
            emoji: emoji,
            title: fullTitle,
            descLines: [],
            subtasks: [],
            links: [],
            completed: false,
            score: "",
            notes: ""
          };
          continue;
        }

        if (currentTask) {
          const urlMatch = line.match(/(https?:\/\/[^\s]+)/);
          if (urlMatch) {
            const url = urlMatch[1];
            let label = "🔗 Open Link";
            const lineLower = line.toLowerCase();
            if (url.includes('youtube') || url.includes('youtu.be') || lineLower.includes('discussion')) {
              label = "🎥 Video Discussion";
            } else if (url.includes('test-series') || lineLower.includes('test')) {
              label = "📝 Mock Test";
            } else if (url.includes('typing') || url.includes('realmocks')) {
              label = "⌨️ Typing Practice";
            } else if (lineLower.includes('flipkart')) {
              label = "📘 Flipkart";
            } else if (lineLower.includes('amazon')) {
              label = "📘 Amazon";
            }
            currentTask.links.push({ url, label });

            const preText = line.replace(url, '').replace(/^[🔗📝🎥\s\:\-]+/, '').trim();
            if (preText) {
              currentTask.descLines.push(preText);
            }
            continue;
          }

          if (/^[•\-\*]\s+/.test(line)) {
            const bulletText = line.replace(/^[•\-\*]\s+/, '').trim();
            if (bulletText) {
              currentTask.subtasks.push({
                id: `sub-${currentTask.id}-${currentTask.subtasks.length + 1}`,
                text: bulletText,
                completed: false
              });
            }
            continue;
          }

          currentTask.descLines.push(line);
        }
      }

      if (currentTask) {
        tasks.push(finalizeTask(currentTask));
      }

      return {
        title,
        day: dayNum,
        quote: quote || "Don’t just count the days—make each day count. Today’s revision is tomorrow’s strength.",
        tasks
      };
    }

    function finalizeTask(t) {
      return {
        id: t.id,
        number: t.number,
        subject: t.subject,
        emoji: t.emoji,
        title: t.title,
        description: t.descLines.join('\n').trim(),
        subtasks: t.subtasks,
        links: t.links,
        completed: t.completed,
        score: t.score,
        notes: t.notes
      };
    }

    // Local Storage Operations
    function loadLocalData() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && parsed.days) {
            state.days = parsed.days;
            state.currentDay = parsed.currentDay || 2;
            state.streak = parsed.streak || 2;
            return true;
          }
        }
      } catch (err) {
        console.warn("Error reading localStorage:", err);
      }
      return false;
    }

    function saveLocalData() {
      try {
        const payload = {
          days: state.days,
          currentDay: state.currentDay,
          streak: state.streak,
          updatedAt: new Date().toISOString()
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      } catch (err) {
        console.warn("Error saving to localStorage:", err);
      }
    }

    // Cloudflare D1 Database Sync Engine
    function initUserSyncKey() {
      // 1. Check if URL has ?sync=... parameter (e.g. from sharing or QR code)
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const urlSyncKey = urlParams.get('sync');
        if (urlSyncKey && urlSyncKey.trim().length > 0) {
          const cleanParamKey = urlSyncKey.trim();
          localStorage.setItem(SYNC_KEY_STORAGE, cleanParamKey);
          state.userId = cleanParamKey;
          // Clean URL without reloading page
          const cleanUrl = window.location.origin + window.location.pathname;
          window.history.replaceState({}, document.title, cleanUrl);
          if (elements.syncUserIdInput) elements.syncUserIdInput.value = cleanParamKey;
          return;
        }
      } catch (e) {}

      // 2. Check localStorage
      let key = localStorage.getItem(SYNC_KEY_STORAGE);
      if (!key) {
        // Generate a friendly, clean short key: CGL-XXXX
        const randChars = Math.random().toString(36).substring(2, 6).toUpperCase();
        key = `CGL-${randChars}`;
        localStorage.setItem(SYNC_KEY_STORAGE, key);
      }
      state.userId = key;
      if (elements.syncUserIdInput) {
        elements.syncUserIdInput.value = key;
      }
    }

    function updateSyncStatusUI(status, label) {
      state.dbStatus = status;
      elements.syncStatusText.textContent = label;

      if (status === 'connected') {
        elements.syncDot.className = 'w-2 h-2 rounded-full bg-emerald-400';
        elements.settingsStatusPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800';
        elements.settingsStatusPill.textContent = '🟢 Cloudflare D1 Synced';
        elements.settingsStatusDesc.textContent = `Sync Active for "${state.userId}". Real-time multi-device cloud synchronization enabled.`;
      } else if (status === 'syncing') {
        elements.syncDot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';
        elements.settingsStatusPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800';
        elements.settingsStatusPill.textContent = '🟡 Syncing to Cloudflare D1...';
      } else if (status === 'local') {
        elements.syncDot.className = 'w-2 h-2 rounded-full bg-blue-400';
        elements.settingsStatusPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800';
        elements.settingsStatusPill.textContent = '🔵 Local Cache Mode';
        elements.settingsStatusDesc.textContent = 'Operating locally. All targets are securely cached in your browser storage.';
      } else {
        elements.syncDot.className = 'w-2 h-2 rounded-full bg-rose-400';
        elements.settingsStatusPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800';
        elements.settingsStatusPill.textContent = '⚠️ Offline Cache Active';
        elements.settingsStatusDesc.textContent = 'Operating in offline cache mode. Changes will automatically sync to Cloudflare D1 when connected.';
      }
    }

    async function syncWithCloudflare(isInitial = false, isSilent = false) {
      if (!state.userId) initUserSyncKey();
      if (!isSilent) updateSyncStatusUI('syncing', 'Connecting to Cloudflare D1...');

      try {
        const res = await fetch(`${API_ENDPOINT}?userId=${encodeURIComponent(state.userId)}`, {
          method: 'GET',
          headers: {
            'X-Tracker-User-Id': state.userId,
            'Content-Type': 'application/json'
          }
        });

        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }

        const json = await res.json();

        if (json.data && json.data.days && Object.keys(json.data.days).length > 0) {
          // Cloud has existing data
          const cloudDaysStr = JSON.stringify(json.data.days);
          const localDaysStr = JSON.stringify(state.days);

          if (cloudDaysStr !== localDaysStr || state.currentDay !== json.data.currentDay) {
            state.days = json.data.days;
            if (json.data.currentDay) state.currentDay = json.data.currentDay;
            if (json.data.streak) state.streak = json.data.streak;
            saveLocalData();
            renderUI();
            if (!isSilent) showToast('Cloud data loaded & synchronized!', 'success');
          }
          updateSyncStatusUI('connected', 'Cloudflare D1 Synced');
        } else {
          // No cloud data yet for this user: push current data
          await pushToCloudflare(true);
        }

      } catch (err) {
        console.warn('[Cloudflare D1 sync error]', err);
        updateSyncStatusUI('local', 'Offline / Local Cache');
        if (!isInitial && !isSilent) showToast('Using local cache (Cloudflare offline)', 'info');
      }
    }

    let saveDebounceTimer = null;
    function queueCloudflarePush() {
      saveLocalData();
      if (saveDebounceTimer) clearTimeout(saveDebounceTimer);
      saveDebounceTimer = setTimeout(() => {
        pushToCloudflare();
      }, 700);
    }

    async function pushToCloudflare(isInitial = false) {
      if (!state.userId) initUserSyncKey();

      try {
        const payload = {
          userId: state.userId,
          data: {
            days: state.days,
            currentDay: state.currentDay,
            streak: state.streak,
            lastUpdated: new Date().toISOString()
          }
        };

        const res = await fetch(API_ENDPOINT, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Tracker-User-Id': state.userId
          },
          body: JSON.stringify(payload)
        });

        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }

        updateSyncStatusUI('connected', 'Cloudflare D1 Synced');
        if (!isInitial) {
          // subtle sync indication
        }
      } catch (err) {
        console.warn('[Cloudflare D1 push error]', err);
        updateSyncStatusUI('local', 'Saved to Local Cache');
      }
    }

    // UI Rendering Functions
    function getActiveDayData() {
      if (!state.days[state.currentDay]) {
        state.days[state.currentDay] = {
          title: `SSC CGL 2026 T-2 Targets — Day ${state.currentDay}`,
          day: state.currentDay,
          quote: "Consistency is what transforms average into excellence.",
          tasks: []
        };
      }
      return state.days[state.currentDay];
    }

    function renderUI() {
      renderDayTabs();
      renderBannerAndProgress();
      renderTasksList();
    }

    function renderDayTabs() {
      elements.dayTabsContainer.innerHTML = '';
      const dayNumbers = Object.keys(state.days).map(Number).sort((a, b) => a - b);

      dayNumbers.forEach(dayNum => {
        const dayData = state.days[dayNum];
        const total = dayData.tasks ? dayData.tasks.length : 0;
        const done = dayData.tasks ? dayData.tasks.filter(t => t.completed).length : 0;
        const pct = total > 0 ? Math.round((done / total) * 100) : 0;

        const tabBtn = document.createElement('button');
        const isActive = dayNum === state.currentDay;

        tabBtn.className = `flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold shrink-0 transition ${
          isActive 
            ? 'bg-indigo-600 text-white shadow-sm shadow-indigo-600/30' 
            : 'bg-slate-100 hover:bg-slate-200 text-slate-700'
        }`;

        tabBtn.innerHTML = `
          <span>Day ${dayNum}</span>
          <span class="px-1.5 py-0.5 rounded-md text-[10px] font-bold ${
            isActive ? 'bg-indigo-700 text-indigo-100' : 'bg-slate-200 text-slate-600'
          }">${pct}%</span>
        `;

        tabBtn.addEventListener('click', () => {
          state.currentDay = dayNum;
          renderUI();
          queueCloudflarePush();
        });

        elements.dayTabsContainer.appendChild(tabBtn);
      });
    }

    function renderBannerAndProgress() {
      const dayData = getActiveDayData();
      elements.bannerDayBadge.textContent = `Day ${dayData.day}`;
      elements.bannerTitle.textContent = dayData.title || `SSC CGL 2026 T-2 Targets — Day ${dayData.day}`;
      elements.quoteText.textContent = dayData.quote ? `“${dayData.quote}”` : "“Don’t just count the days—make each day count.”";

      const total = dayData.tasks.length;
      const done = dayData.tasks.filter(t => t.completed).length;
      const pending = total - done;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;

      elements.statRatioDisplay.textContent = `${done} / ${total} Tasks`;
      elements.progressPercentText.textContent = `${pct}%`;
      elements.progressBarFill.style.width = `${pct}%`;
      elements.streakDisplay.textContent = `${state.streak} Days Streak`;

      elements.filterAllCount.textContent = total;
      elements.filterPendingCount.textContent = pending;
      elements.filterDoneCount.textContent = done;
      elements.taskListCountBadge.textContent = `${total} items`;
    }

    function renderTasksList() {
      elements.taskList.innerHTML = '';
      const dayData = getActiveDayData();

      let tasks = dayData.tasks || [];

      // Apply filter
      if (state.activeFilter === 'pending') {
        tasks = tasks.filter(t => !t.completed);
      } else if (state.activeFilter === 'completed') {
        tasks = tasks.filter(t => t.completed);
      }

      if (tasks.length === 0) {
        elements.emptyTasksState.classList.remove('hidden');
        return;
      }
      elements.emptyTasksState.classList.add('hidden');

      tasks.forEach((task, index) => {
        const card = createTaskCardElement(task, index);
        elements.taskList.appendChild(card);
      });
    }

