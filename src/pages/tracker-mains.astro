    // Helper: Toast Notifications
    function showToast(message, type = 'info') {
      const toast = document.createElement('div');
      const bgColors = {
        success: 'bg-emerald-600 text-white',
        error: 'bg-rose-600 text-white',
        info: 'bg-slate-800 text-white',
        warning: 'bg-amber-600 text-white'
      };
      const icons = {
        success: '✅',
        error: '⚠️',
        info: 'ℹ️',
        warning: '⚡'
      };

      toast.className = `flex items-center gap-2.5 px-4 py-2.5 rounded-xl shadow-lg text-xs font-semibold ${bgColors[type] || bgColors.info} transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto`;
      toast.innerHTML = `<span>${icons[type] || '•'}</span><span>${message}</span>`;
      
      elements.toastContainer.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }

    // Unicode Mathematical Font Normalization to Plain Text
    function normalizeUnicode(text) {
      if (!text) return '';
      let norm = text.normalize('NFKD');
      norm = norm.replace(/\u00A0/g, ' ');
      return norm;
    }

    // Schedule Text Parser (Handles Telegram bold/math symbols, workflow arrows, markdown links & checklists)
    function parseScheduleText(rawText) {
      const clean = normalizeUnicode(rawText);
      const rawLines = clean.split(/\r?\n/).map(l => l.trim());

      let dayNum = 2;
      let title = "SSC CGL 2026 T-2 | RBE Targets";
      let quote = "";

      // 1. Detect Day Number (Supports Day 6, Day 𝟲, Day 7, Target Day 7, दिन 7, etc.)
      for (const line of rawLines) {
        const match = line.match(/(?:Day|दिन|Target\s*Day)\s*[-:#]?\s*(\d+)/i);
        if (match) {
          dayNum = parseInt(match[1], 10);
          break;
        }
      }

      // 2. Detect Title
      for (const line of rawLines) {
        if ((line.includes('SSC') || line.includes('Target') || line.includes('CGL') || line.includes('T-2')) && 
            !/(?:Day|दिन)\s*[-:#]?\s*\d+/i.test(line)) {
          title = line.replace(/^[🎯🏆📌⚡🔥\s\W]+/, '').trim();
          if (title) break;
        }
      }

      // 3. Detect Motivational Quote / Signoff (e.g. "Stay consistent—every completed target moves you forward!")
      for (let i = rawLines.length - 1; i >= 0; i--) {
        const line = rawLines[i];
        if (!line) continue;
        if ((line.includes('Stay consistent') || line.includes('moves you forward') || line.startsWith('🔥') || line.startsWith('“') || line.startsWith('"')) &&
            !/(?:test|pyq|mock|subjectId|http|class|chapter)/i.test(line)) {
          quote = line.replace(/^[🔥⚡\s“"']+|[”"'🔥⚡\s]+$/g, '').trim();
          break;
        }
      }

      // 4. Task header regex (Matches e.g. "💻 1. Computer — Class 3", "1. Computer", "1) Computer", "Task 1: Computer")
      const taskHeaderRegex = /^([^\w\d\s\(\[\{]*)\s*(?:Task|Target)?\s*(\b\d{1,2}\b)[\.\)\:\s-]+(.+)$/i;

      const tasks = [];
      let currentTask = null;

      function extractLinksFromLine(line, currentSubject, prevLine) {
        const links = [];
        let cleanedLine = line;

        // Check markdown link: [label](url)
        const mdRegex = /\[([^\]]+)\]\((https?:\/\/[^\s\)]+)\)/g;
        let mdMatch;
        while ((mdMatch = mdRegex.exec(line)) !== null) {
          const labelText = mdMatch[1].trim();
          const rawUrl = mdMatch[2].trim().replace(/[\)\]\.\,]+$/, '');
          const label = formatLinkLabel(rawUrl, labelText, currentSubject, prevLine);
          links.push({ url: rawUrl, label });
          cleanedLine = cleanedLine.replace(mdMatch[0], '').trim();
        }

        // Check bare URLs
        const bareRegex = /(https?:\/\/[^\s\)\>\]]+)/g;
        let bareMatch;
        while ((bareMatch = bareRegex.exec(cleanedLine)) !== null) {
          let rawUrl = bareMatch[1].trim().replace(/[\)\]\.\,]+$/, '');
          if (!links.some(l => l.url === rawUrl)) {
            const label = formatLinkLabel(rawUrl, '', currentSubject, prevLine);
            links.push({ url: rawUrl, label });
          }
          cleanedLine = cleanedLine.replace(bareMatch[0], '').trim();
        }

        return { links, cleanedLine };
      }

      function formatLinkLabel(url, explicitText, subject, prevLine) {
        const urlLower = url.toLowerCase();
        const prevLower = (prevLine || '').toLowerCase();

        if (explicitText && !/^(click\s*here|link|open|here)$/i.test(explicitText)) {
          return explicitText.startsWith('🔗') || explicitText.startsWith('📝') || explicitText.startsWith('🎥') 
            ? explicitText 
            : `🔗 ${explicitText}`;
        }

        // Context from previous line
        if (prevLower.includes('chapter') && prevLower.includes('test')) {
          const chMatch = prevLine.match(/Chapter\s*\d+\s*Test/i);
          if (chMatch) return `📝 ${chMatch[0]}`;
          return `📝 Chapter Test`;
        }

        // RealMocks specific path detection
        if (urlLower.includes('realmocks.com')) {
          if (urlLower.includes('/editorial')) return '📰 RealMocks Editorial';
          if (urlLower.includes('/vocabulary')) return '📖 RealMocks Vocabulary';
          if (urlLower.includes('/typing')) return '⌨️ RealMocks Typing';
          return '📝 RealMocks Portal';
        }

        // YouTube / Video
        if (urlLower.includes('youtube.com') || urlLower.includes('youtu.be')) {
          return '🎥 Video Lecture';
        }

        // RBE courses vs tests
        if (urlLower.includes('rbelearning.com/courses')) {
          if (subject === 'Computer') return '💻 Computer Course 4.0';
          return '🎓 RBE Course / Batch';
        }

        if (urlLower.includes('rbelearning.com/test-series') || urlLower.includes('tests?subjectid=')) {
          if (prevLower.includes('sectional')) return '📝 Sectional Test';
          if (prevLower.includes('pyq')) return '📝 PYQ Mock Test';
          if (subject === 'Maths') return '📝 Maths Mock Tests';
          if (subject === 'English') return '📝 English Tests';
          if (subject === 'Computer') return '📝 Computer Test';
          return '📝 RBE Mock Test';
        }

        // E-commerce books
        if (urlLower.includes('flipkart')) return '📘 Flipkart';
        if (urlLower.includes('amazon')) return '📘 Amazon';

        if (subject === 'Typing') return '⌨️ Typing Practice';
        return '🔗 Open Link';
      }

      for (let i = 0; i < rawLines.length; i++) {
        let line = rawLines[i];
        if (!line) continue;

        // Skip quote line from task body
        if (quote && (line.includes(quote.substring(0, 15)) || line.startsWith('🔥 Stay consistent'))) {
          continue;
        }

        // Skip standalone promotional books section at bottom
        if (/^📘\s*RBE\s+.*Book/i.test(line) || /^📘\s*(Flipkart|Amazon):/i.test(line)) {
          continue;
        }

        // Check Task Header
        const headerMatch = line.match(taskHeaderRegex);
        if (headerMatch && !line.startsWith('(') && !line.toLowerCase().startsWith('complete:')) {
          if (currentTask) {
            tasks.push(finalizeTask(currentTask));
          }

          const rawEmoji = headerMatch[1].trim();
          const num = parseInt(headerMatch[2], 10);
          const fullTitle = headerMatch[3].trim();

          let subj = "Other";
          let emoji = rawEmoji;
          const titleLower = fullTitle.toLowerCase();

          // Priority: check Revision first so "Revision — Yesterday's Maths" is categorized as Revision
          if (titleLower.includes('revision') || titleLower.startsWith('revision')) { subj = 'Revision'; emoji = emoji || '🔄'; }
          else if (titleLower.includes('computer')) { subj = 'Computer'; emoji = emoji || '💻'; }
          else if (titleLower.includes('typing')) { subj = 'Typing'; emoji = emoji || '⌨️'; }
          else if (titleLower.includes('maths') || titleLower.includes('math')) { subj = 'Maths'; emoji = emoji || '📐'; }
          else if (titleLower.includes('english')) { subj = 'English'; emoji = emoji || '📚'; }
          else if (titleLower.includes('reasoning')) { subj = 'Reasoning'; emoji = emoji || '🧠'; }
          else if (titleLower.includes('gk') || titleLower.includes('gs') || titleLower.includes('general')) { subj = 'GK/GS'; emoji = emoji || '🏛️'; }
          else { emoji = emoji || '📌'; }

          currentTask = {
            id: `task-${num}-${Date.now()}`,
            number: num,
            subject: subj,
            emoji: emoji,
            title: fullTitle,
            descLines: [],
            subtasks: [],
            links: [],
            completed: false,
            score: "",
            notes: ""
          };
          continue;
        }

        if (currentTask) {
          const prevLine = rawLines[i - 1] || '';
          
          const { links, cleanedLine } = extractLinksFromLine(line, currentTask.subject, prevLine);
          if (links.length > 0) {
            currentTask.links.push(...links);

            const remaining = cleanedLine.replace(/^[🔗📝🎥\s\:\-]+/, '').trim();
            // Don't keep dangling single label words like "Test:", "Discussion:", "Video:"
            if (remaining && !/^(?:🎥\s*Discussion|🎥\s*Video|📝\s*Tests?|🔗\s*Links?|Test|Discussion)\s*:\s*$/i.test(remaining)) {
              currentTask.descLines.push(remaining);
            }
            continue;
          }

          // Check explicit bullet subtask: •, -, *
          if (/^[•\-\*]\s+/.test(line)) {
            const bulletText = line.replace(/^[•\-\*]\s+/, '').trim();
            if (bulletText) {
              currentTask.subtasks.push({
                id: `sub-${currentTask.id}-${currentTask.subtasks.length + 1}`,
                text: bulletText,
                completed: false
              });
            }
            continue;
          }

          // Skip dangling prefix labels like "🎥 Video:" or "📝 Tests:" before a URL
          const nextLine = rawLines[i + 1] || '';
          if (/^(?:🎥\s*Video|🎥\s*Discussion|📝\s*Tests?|🔗\s*Links?)\s*:\s*$/i.test(line) && /https?:\/\//i.test(nextLine)) {
            continue;
          }

          currentTask.descLines.push(line);
        }
      }

      if (currentTask) {
        tasks.push(finalizeTask(currentTask));
      }

      // Label multiple video links specifically (e.g. Maths Class 3 & 4)
      tasks.forEach(task => {
        const videoLinks = task.links.filter(l => l.url.includes('youtube') || l.url.includes('youtu.be'));
        if (videoLinks.length > 1) {
          const classMatch = task.title.match(/Class\s*(\d+)\s*(?:&|and)\s*(\d+)/i);
          videoLinks.forEach((vl, idx) => {
            if (classMatch && classMatch[idx + 1]) {
              vl.label = `🎥 Video (Class ${classMatch[idx + 1]})`;
            } else {
              vl.label = `🎥 Video Part ${idx + 1}`;
            }
          });
        }
      });

      return {
        title,
        day: dayNum,
        quote: quote || "Stay consistent—every completed target moves you forward!",
        tasks
      };
    }

    function finalizeTask(t) {
      let subtasks = t.subtasks;

      // Auto-generate subtasks only if no explicit bullets were found
      if (subtasks.length === 0) {
        subtasks = generateSmartSubtasks(t);
      }

      const cleanDesc = t.descLines
        .filter(l => !/^(Complete:|\s*)$/i.test(l))
        .join('\n')
        .trim();

      return {
        id: t.id,
        number: t.number,
        subject: t.subject,
        emoji: t.emoji,
        title: t.title,
        description: cleanDesc,
        subtasks: subtasks,
        links: t.links,
        completed: t.completed,
        score: t.score,
        notes: t.notes
      };
    }

    function generateSmartSubtasks(t) {
      const generated = [];
      const addSub = (text) => {
        if (text && !generated.some(s => s.text.toLowerCase() === text.toLowerCase())) {
          generated.push({
            id: `sub-${t.id}-${generated.length + 1}`,
            text: text.trim(),
            completed: false
          });
        }
      };

      const titleLower = t.title.toLowerCase();
      const descFull = t.descLines.join('\n');

      // 1. Action workflow arrows: e.g. "Watch → Revise from the book → Attempt the test"
      // Skip website navigation paths starting with "Open:"
      for (const line of t.descLines) {
        if ((line.includes('→') || line.includes('->')) && !/^open\s*:/i.test(line)) {
          const parts = line.split(/→|->/).map(p => p.trim()).filter(Boolean);
          const hasAction = parts.some(p => /^(watch|revise|attempt|solve|read|practice|complete)/i.test(p));
          if (hasAction && parts.length >= 2) {
            parts.forEach(p => {
              const chMatch = (t.title + ' ' + descFull).match(/Chapter\s*(\d+)|Class\s*(\d+)/i);
              let itemText = p;
              if (/^attempt\s+the\s+test$/i.test(p) && chMatch) {
                itemText = `Attempt Chapter ${chMatch[1] || chMatch[2]} Test`;
              } else if (/^watch$/i.test(p) && chMatch) {
                itemText = `Watch Class ${chMatch[2] || chMatch[1]} Lecture`;
              }
              addSub(itemText);
            });
            return generated;
          }
        }
      }

      // 2. English tasks: Editorials, RC, Cloze, Vocab
      if (t.subject === 'English') {
        for (const line of t.descLines) {
          if (/editorial/i.test(line) && /complete/i.test(line)) {
            const timeMatch = descFull.match(/(?:Editorial task:\s*|⏱️\s*)(\d+\s*minutes|\d+\s*mins)/i);
            const timeStr = timeMatch ? ` (${timeMatch[1]})` : '';
            addSub(line.replace(/^[📰⏱️📝\s]+/, '').trim() + timeStr);
          } else if (/Reading Comprehension/i.test(line) || /Cloze Test/i.test(line)) {
            if (line.includes('&') || line.toLowerCase().includes('and')) {
              const parts = line.replace(/^[📝\s]*also\s+attempt\s+/i, '').replace(/^[📝\s]+/i, '').split(/&|\band\b/i);
              parts.forEach(p => {
                const cleanP = p.trim().replace(/^attempt\s+/i, '');
                if (cleanP) addSub(`Attempt ${cleanP}`);
              });
            } else {
              addSub(line.replace(/^[📝\s]+/, '').trim());
            }
          } else if (/most\s+rep[ie]titive\s+\d+\s+vocab/i.test(line)) {
            const cleanVocab = line.replace(/^[📝\s]*also\s+try\s+/i, '').trim();
            addSub(`Vocab: ${cleanVocab}`);
          } else if (/Ant(?:onyms?)?,\s*syn(?:onyms?)?,\s*OWS,\s*Idioms/i.test(line)) {
            const antSynMatch = line.match(/Attempt\s+([^\.]+?)\s+of\s+Ant(?:onyms?)?,\s*syn(?:onyms?)?,\s*OWS,\s*Idioms(?:\s+each)?/i);
            const testRange = antSynMatch ? antSynMatch[1].trim() : 'tests';
            addSub(`Antonyms (Ant) — ${testRange}`);
            addSub(`Synonyms (Syn) — ${testRange}`);
            addSub(`One Word Substitution (OWS) — ${testRange}`);
            addSub(`Idioms — ${testRange}`);
          } else if (/vocab tests/i.test(line) || /Attempt First [^\.\n]+ tests/i.test(line)) {
            const vocabMatch = line.match(/Attempt First [^\.\n]+/i);
            if (vocabMatch) {
              addSub(`Vocab: ${vocabMatch[0].trim()}`);
            }
          }
        }
        if (generated.length > 0) return generated;
      }

      // 3. Maths: Video lectures + Chapter Tests
      if (t.subject === 'Maths') {
        const classMatch = t.title.match(/Class\s*(\d+)\s*(?:&|and)\s*(\d+)/i);
        if (classMatch) {
          addSub(`Watch Probability Class ${classMatch[1]} Video`);
          addSub(`Watch Probability Class ${classMatch[2]} Video`);
        } else {
          const singleClass = t.title.match(/Class\s*(\d+)/i);
          if (singleClass) {
            addSub(`Watch Maths Class ${singleClass[1]} Video Lecture`);
          } else if (t.links.some(l => l.url.includes('youtube') || l.url.includes('youtu.be'))) {
            addSub(`Watch Video Discussion`);
          }
        }

        if (t.links.some(l => l.url.includes('test-series') || l.url.includes('test')) || /test/i.test(descFull)) {
          addSub(`Attempt Chapter Mock Test Series`);
        }
        if (generated.length > 0) return generated;
      }

      // 4. Typing
      if (t.subject === 'Typing') {
        const minMatch = (t.title + ' ' + descFull).match(/(\d+)\s*Minutes/i);
        const mins = minMatch ? minMatch[1] : '30';
        addSub(`${mins} Minutes typing practice with accuracy`);
        return generated;
      }

      // 5. Revision
      if (t.subject === 'Revision') {
        addSub("Reattempt unsolved Maths questions independently");
        addSub("Reattempt Reasoning doubts from yesterday's set");
        return generated;
      }

      // 6. Generic fallback: if task has links
      if (t.links.length > 0) {
        t.links.forEach(l => {
          addSub(`Complete ${l.label.replace(/^[^\w\d\s]+/, '').trim()}`);
        });
      }

      return generated;
    }

    // Local Storage Operations
    function loadLocalData() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && parsed.days) {
            state.days = parsed.days;
            state.currentDay = parsed.currentDay || 2;
            state.streak = parsed.streak || 2;
            return true;
          }
        }
      } catch (err) {
        console.warn("Error reading localStorage:", err);
      }
      return false;
    }

    function saveLocalData() {
      try {
        const payload = {
          days: state.days,
          currentDay: state.currentDay,
          streak: state.streak,
          updatedAt: new Date().toISOString()
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      } catch (err) {
        console.warn("Error saving to localStorage:", err);
      }
    }

    // Auth Token & API Helpers (Shared with To-Do)
    const AUTH_TOKEN_KEY = 'todo_auth_token';

    function getAuthToken() {
      try {
        return localStorage.getItem(AUTH_TOKEN_KEY);
      } catch {
        return null;
      }
    }

    async function apiFetch(url, options = {}) {
      const token = getAuthToken();
      const headers = new Headers(options.headers || {});
      if (token && !headers.has('Authorization')) {
        headers.set('Authorization', `Bearer ${token}`);
      }
      return fetch(url, {
        ...options,
        headers,
        credentials: 'include'
      });
    }

    function checkNetworkStatus() {
      if (!navigator.onLine) {
        if (elements.offlineOverlay) elements.offlineOverlay.classList.remove('hidden');
      } else {
        if (elements.offlineOverlay) elements.offlineOverlay.classList.add('hidden');
      }
    }

    function updateUserUI() {
      const user = state.currentUser;
      if (user && user.email) {
        // Header
        if (elements.headerUserBox) {
          elements.headerUserBox.classList.remove('hidden');
          elements.headerUserBox.classList.add('flex');
        }
        if (elements.openAuthModalBtn) elements.openAuthModalBtn.classList.add('hidden');
        if (elements.headerUserEmail) elements.headerUserEmail.textContent = user.email;

        // Settings Modal
        if (elements.settingsUserSection) elements.settingsUserSection.classList.remove('hidden');
        if (elements.settingsLoginPrompt) elements.settingsLoginPrompt.classList.add('hidden');
        if (elements.settingsUserEmail) elements.settingsUserEmail.textContent = user.email;

        updateSyncStatusUI('connected', 'Cloud Synced');
      } else {
        // Header
        if (elements.headerUserBox) {
          elements.headerUserBox.classList.add('hidden');
          elements.headerUserBox.classList.remove('flex');
        }
        if (elements.openAuthModalBtn) elements.openAuthModalBtn.classList.remove('hidden');

        // Settings Modal
        if (elements.settingsUserSection) elements.settingsUserSection.classList.add('hidden');
        if (elements.settingsLoginPrompt) elements.settingsLoginPrompt.classList.remove('hidden');

        updateSyncStatusUI('local', 'Local Cache (Sign in)');
      }
    }

    async function checkAuthUser() {
      try {
        const res = await apiFetch('/api/auth/me');
        if (res.ok) {
          const data = await res.json();
          if (data.authenticated && data.user) {
            state.currentUser = data.user;
            updateUserUI();
            return data.user;
          }
        }
      } catch (e) {
        console.warn('Auth check error:', e);
      }
      state.currentUser = null;
      updateUserUI();
      return null;
    }

    function openAuthModal(defaultMode = 'login') {
      setAuthMode(defaultMode);
      if (elements.authErrorBanner) {
        elements.authErrorBanner.classList.add('hidden');
        elements.authErrorBanner.textContent = '';
      }
      if (elements.authEmailInput) elements.authEmailInput.value = '';
      if (elements.authPasswordInput) elements.authPasswordInput.value = '';
      if (elements.authModal) elements.authModal.classList.remove('hidden');
      setTimeout(() => elements.authEmailInput?.focus(), 100);
    }

    function closeAuthModal() {
      if (elements.authModal) elements.authModal.classList.add('hidden');
    }

    function setAuthMode(mode) {
      state.authMode = mode;
      if (mode === 'login') {
        if (elements.authTabLogin) elements.authTabLogin.className = 'flex-1 py-3 text-xs sm:text-sm font-bold text-indigo-600 dark:text-indigo-400 border-b-2 border-indigo-600 dark:border-indigo-400 bg-white dark:bg-slate-900 transition';
        if (elements.authTabRegister) elements.authTabRegister.className = 'flex-1 py-3 text-xs sm:text-sm font-bold text-slate-500 dark:text-slate-400 border-b-2 border-transparent hover:text-slate-800 dark:hover:text-slate-200 transition';
        if (elements.authSubmitText) elements.authSubmitText.textContent = 'Sign In';
        if (elements.authPasswordHelp) elements.authPasswordHelp.classList.add('hidden');
      } else {
        if (elements.authTabRegister) elements.authTabRegister.className = 'flex-1 py-3 text-xs sm:text-sm font-bold text-indigo-600 dark:text-indigo-400 border-b-2 border-indigo-600 dark:border-indigo-400 bg-white dark:bg-slate-900 transition';
        if (elements.authTabLogin) elements.authTabLogin.className = 'flex-1 py-3 text-xs sm:text-sm font-bold text-slate-500 dark:text-slate-400 border-b-2 border-transparent hover:text-slate-800 dark:hover:text-slate-200 transition';
        if (elements.authSubmitText) elements.authSubmitText.textContent = 'Create Study Account';
        if (elements.authPasswordHelp) elements.authPasswordHelp.classList.remove('hidden');
      }
      if (elements.authErrorBanner) {
        elements.authErrorBanner.classList.add('hidden');
        elements.authErrorBanner.textContent = '';
      }
    }

    function showAuthError(msg) {
      if (elements.authErrorBanner) {
        elements.authErrorBanner.textContent = msg;
        elements.authErrorBanner.classList.remove('hidden');
      }
    }

    function setAuthLoading(loading) {
      if (elements.authSubmitBtn) elements.authSubmitBtn.disabled = loading;
      if (elements.authSubmitSpinner) {
        elements.authSubmitSpinner.classList.toggle('hidden', !loading);
      }
      if (elements.authSubmitText) {
        elements.authSubmitText.textContent = loading 
          ? (state.authMode === 'login' ? 'Signing in...' : 'Creating account...')
          : (state.authMode === 'login' ? 'Sign In' : 'Create Study Account');
      }
    }

    async function handleAuthSubmit(e) {
      e.preventDefault();
      const email = elements.authEmailInput?.value.trim() || '';
      const password = elements.authPasswordInput?.value || '';

      if (!email || !password) {
        showAuthError('Please fill in both email and password.');
        return;
      }

      if (state.authMode === 'register' && password.length < 6) {
        showAuthError('Password must be at least 6 characters.');
        return;
      }

      setAuthLoading(true);
      const endpoint = state.authMode === 'login' ? '/api/auth/login' : '/api/auth/register';

      try {
        const res = await apiFetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        const data = await res.json();

        if (!res.ok) {
          showAuthError(data.error || 'Authentication failed. Please check your credentials.');
          return;
        }

        if (data.token) {
          localStorage.setItem(AUTH_TOKEN_KEY, data.token);
        }
        if (data.user) {
          state.currentUser = data.user;
          updateUserUI();
        }

        closeAuthModal();
        showToast(`Welcome! Signed in as ${data.user.email}`, 'success');

        // Trigger immediate sync
        await syncWithCloudflare(false);
      } catch (err) {
        console.error('Auth submit error:', err);
        showAuthError('Network error connecting to auth server. Please try again.');
      } finally {
        setAuthLoading(false);
      }
    }

    async function handleLogout() {
      try {
        await apiFetch('/api/auth/logout', { method: 'POST' });
      } catch (err) {
        console.error('Logout error:', err);
      } finally {
        localStorage.removeItem(AUTH_TOKEN_KEY);
        state.currentUser = null;
        updateUserUI();
        showToast('Signed out from Study Cloud Account. Working locally.', 'info');
      }
    }

    // Cloudflare D1 Database Sync Engine
    function updateSyncStatusUI(status, label) {
      state.dbStatus = status;
      if (elements.syncStatusText) elements.syncStatusText.textContent = label;

      if (status === 'connected') {
        if (elements.syncDot) elements.syncDot.className = 'w-2 h-2 rounded-full bg-emerald-400';
        if (elements.settingsStatusPill) {
          elements.settingsStatusPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800';
          elements.settingsStatusPill.textContent = '🟢 Cloud Synced';
        }
        if (elements.settingsStatusDesc) {
          elements.settingsStatusDesc.textContent = state.currentUser
            ? `Sync Active for "${state.currentUser.email}". Real-time multi-device cloud synchronization enabled.`
            : 'Cloud synchronization active.';
        }
      } else if (status === 'syncing') {
        if (elements.syncDot) elements.syncDot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';
        if (elements.settingsStatusPill) {
          elements.settingsStatusPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800';
          elements.settingsStatusPill.textContent = '🟡 Syncing to Cloudflare D1...';
        }
      } else if (status === 'local') {
        if (elements.syncDot) elements.syncDot.className = 'w-2 h-2 rounded-full bg-blue-400';
        if (elements.settingsStatusPill) {
          elements.settingsStatusPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800';
          elements.settingsStatusPill.textContent = '🔵 Local Cache Mode';
        }
        if (elements.settingsStatusDesc) {
          elements.settingsStatusDesc.textContent = state.currentUser
            ? 'Operating locally. All changes saved in local cache.'
            : 'Operating locally. Sign in with your To-Do account to enable multi-device sync.';
        }
      } else {
        if (elements.syncDot) elements.syncDot.className = 'w-2 h-2 rounded-full bg-rose-400';
        if (elements.settingsStatusPill) {
          elements.settingsStatusPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800';
          elements.settingsStatusPill.textContent = '⚠️ Offline / Disconnected';
        }
        if (elements.settingsStatusDesc) {
          elements.settingsStatusDesc.textContent = 'Network offline. Targets are securely cached and will sync automatically upon reconnection.';
        }
      }
    }

    async function syncWithCloudflare(isInitial = false, isSilent = false) {
      if (!state.currentUser) {
        updateSyncStatusUI('local', 'Local Cache (Sign in)');
        return;
      }

      if (!isSilent) updateSyncStatusUI('syncing', 'Connecting to Cloud...');

      try {
        const res = await apiFetch(API_ENDPOINT, {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' }
        });

        if (res.status === 401) {
          state.currentUser = null;
          localStorage.removeItem(AUTH_TOKEN_KEY);
          updateUserUI();
          return;
        }

        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }

        const json = await res.json();

        if (json.data && json.data.days && Object.keys(json.data.days).length > 0) {
          const cloudDaysStr = JSON.stringify(json.data.days);
          const localDaysStr = JSON.stringify(state.days);

          if (cloudDaysStr !== localDaysStr || state.currentDay !== json.data.currentDay) {
            state.days = json.data.days;
            if (json.data.currentDay) state.currentDay = json.data.currentDay;
            if (json.data.streak) state.streak = json.data.streak;
            saveLocalData();
            renderUI();
            if (!isSilent) showToast('Cloud data loaded & synchronized!', 'success');
          }
          updateSyncStatusUI('connected', 'Cloud Synced');
        } else {
          // No cloud data yet for this account: push local data up to initialize
          await pushToCloudflare(true);
        }
      } catch (err) {
        console.warn('[Cloudflare D1 sync error]', err);
        updateSyncStatusUI('local', 'Offline / Local Cache');
        if (!isInitial && !isSilent) showToast('Using local cache (Server unreachable)', 'info');
      }
    }

    let saveDebounceTimer = null;
    function queueCloudflarePush() {
      saveLocalData();
      if (!state.currentUser) return;
      if (saveDebounceTimer) clearTimeout(saveDebounceTimer);
      saveDebounceTimer = setTimeout(() => {
        pushToCloudflare();
      }, 700);
    }

    async function pushToCloudflare(isInitial = false) {
      if (!state.currentUser) return;

      try {
        const payload = {
          data: {
            days: state.days,
            currentDay: state.currentDay,
            streak: state.streak,
            lastUpdated: new Date().toISOString()
          }
        };

        const res = await apiFetch(API_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.status === 401) {
          state.currentUser = null;
          localStorage.removeItem(AUTH_TOKEN_KEY);
          updateUserUI();
          return;
        }

        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }

        updateSyncStatusUI('connected', 'Cloud Synced');
      } catch (err) {
        console.warn('[Cloudflare D1 push error]', err);
        updateSyncStatusUI('local', 'Saved to Local Cache');
      }
    }

    // UI Rendering Functions
    function getActiveDayData() {
      if (!state.days[state.currentDay]) {
        state.days[state.currentDay] = {
          title: `SSC CGL 2026 T-2 Targets — Day ${state.currentDay}`,
          day: state.currentDay,
          quote: "Consistency is what transforms average into excellence.",
          tasks: []
        };
      }
      return state.days[state.currentDay];
    }

    function renderUI() {
      renderDayTabs();
      renderBannerAndProgress();
      renderTasksList();
    }

    function renderDayTabs() {
      elements.dayTabsContainer.innerHTML = '';
      const dayNumbers = Object.keys(state.days).map(Number).sort((a, b) => a - b);

      dayNumbers.forEach(dayNum => {
        const dayData = state.days[dayNum];
        const total = dayData.tasks ? dayData.tasks.length : 0;
        const done = dayData.tasks ? dayData.tasks.filter(t => t.completed).length : 0;
        const pct = total > 0 ? Math.round((done / total) * 100) : 0;

        const tabBtn = document.createElement('button');
        const isActive = dayNum === state.currentDay;

        tabBtn.className = `flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold shrink-0 transition ${
          isActive 
            ? 'bg-indigo-600 text-white shadow-sm shadow-indigo-600/30' 
            : 'bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 border border-transparent dark:border-slate-700/60'
        }`;

        tabBtn.innerHTML = `
          <span>Day ${dayNum}</span>
          <span class="px-1.5 py-0.5 rounded-md text-[10px] font-bold ${
            isActive ? 'bg-indigo-700 text-indigo-100' : 'bg-slate-200 text-slate-600 dark:bg-slate-700 dark:text-slate-300'
          }">${pct}%</span>
        `;

        tabBtn.addEventListener('click', () => {
          state.currentDay = dayNum;
          renderUI();
          queueCloudflarePush();
        });

        elements.dayTabsContainer.appendChild(tabBtn);
      });
    }

    function renderBannerAndProgress() {
      const dayData = getActiveDayData();
      elements.bannerDayBadge.textContent = `Day ${dayData.day}`;
      elements.bannerTitle.textContent = dayData.title || `SSC CGL 2026 T-2 Targets — Day ${dayData.day}`;
      elements.quoteText.textContent = dayData.quote ? `“${dayData.quote}”` : "“Don’t just count the days—make each day count.”";

      const total = dayData.tasks.length;
      const done = dayData.tasks.filter(t => t.completed).length;
      const pending = total - done;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;

      elements.statRatioDisplay.textContent = `${done} / ${total} Tasks`;
      elements.progressPercentText.textContent = `${pct}%`;
      elements.progressBarFill.style.width = `${pct}%`;
      elements.streakDisplay.textContent = `${state.streak} Days Streak`;

      elements.filterAllCount.textContent = total;
      elements.filterPendingCount.textContent = pending;
      elements.filterDoneCount.textContent = done;
      elements.taskListCountBadge.textContent = `${total} items`;
    }

    function renderTasksList() {
      elements.taskList.innerHTML = '';
      const dayData = getActiveDayData();

      let tasks = dayData.tasks || [];

      // Apply filter
      if (state.activeFilter === 'pending') {
        tasks = tasks.filter(t => !t.completed);
      } else if (state.activeFilter === 'completed') {
        tasks = tasks.filter(t => t.completed);
      }

      if (tasks.length === 0) {
        elements.emptyTasksState.classList.remove('hidden');
        return;
      }
      elements.emptyTasksState.classList.add('hidden');

      tasks.forEach((task, index) => {
        const card = createTaskCardElement(task, index);
        elements.taskList.appendChild(card);
      });
    }

    function createTaskCardElement(task, index) {
      const card = document.createElement('div');
      const isCompleted = task.completed;

      // Subject badge color scheme with dark mode support
      const subjColors = {
        'Maths': 'bg-emerald-100 text-emerald-800 border-emerald-200 dark:bg-emerald-950/70 dark:text-emerald-300 dark:border-emerald-800/80',
        'English': 'bg-rose-100 text-rose-800 border-rose-200 dark:bg-rose-950/70 dark:text-rose-300 dark:border-rose-800/80',
        'Reasoning': 'bg-violet-100 text-violet-800 border-violet-200 dark:bg-violet-950/70 dark:text-violet-300 dark:border-violet-800/80',
        'Computer': 'bg-sky-100 text-sky-800 border-sky-200 dark:bg-sky-950/70 dark:text-sky-300 dark:border-sky-800/80',
        'Typing': 'bg-purple-100 text-purple-800 border-purple-200 dark:bg-purple-950/70 dark:text-purple-300 dark:border-purple-800/80',
        'Revision': 'bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-950/70 dark:text-amber-300 dark:border-amber-800/80',
        'GK/GS': 'bg-teal-100 text-teal-800 border-teal-200 dark:bg-teal-950/70 dark:text-teal-300 dark:border-teal-800/80',
        'Other': 'bg-slate-100 text-slate-800 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700'
      };
      const badgeClass = subjColors[task.subject] || subjColors['Other'];

      card.className = `group bg-white dark:bg-slate-900 rounded-2xl p-5 border transition-all duration-200 shadow-sm hover:shadow-md ${
        isCompleted 
          ? 'border-emerald-200/80 bg-emerald-50/20 dark:border-emerald-500/30 dark:bg-emerald-950/20' 
          : 'border-slate-200/90 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700'
      }`;

      // Build Subtasks HTML
      let subtasksHTML = '';
      if (task.subtasks && task.subtasks.length > 0) {
        subtasksHTML = `
          <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 space-y-1.5">
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400">Subtopics / Checklist:</p>
            <div class="space-y-1">
              ${task.subtasks.map(sub => `
                <label class="flex items-start gap-2 p-1.5 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/70 cursor-pointer text-xs transition">
                  <input type="checkbox" data-task-id="${task.id}" data-sub-id="${sub.id}" class="subtask-checkbox mt-0.5 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 dark:border-slate-600 dark:bg-slate-800 w-3.5 h-3.5" ${sub.completed ? 'checked' : ''}>
                  <span class="${sub.completed ? 'line-through text-slate-400 dark:text-slate-500' : 'text-slate-700 dark:text-slate-200 font-medium'}">${sub.text}</span>
                </label>
              `).join('')}
            </div>
          </div>
        `;
      }

      // Build Links HTML
      let linksHTML = '';
      if (task.links && task.links.length > 0) {
        linksHTML = `
          <div class="flex flex-wrap items-center gap-2 mt-3 pt-2">
            ${task.links.map(l => `
              <a href="${l.url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 text-slate-700 dark:bg-slate-800 dark:hover:bg-indigo-950/60 dark:hover:text-indigo-300 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs font-semibold transition group/link">
                <span>${l.label || '🔗 Open Link'}</span>
                <span class="text-[10px] text-slate-400 group-hover/link:text-indigo-600 dark:group-hover/link:text-indigo-400">↗</span>
              </a>
            `).join('')}
          </div>
        `;
      }

      // Build Score & Notes HTML
      let scoreNotesHTML = '';
      if (task.score || task.notes) {
        scoreNotesHTML = `
          <div class="mt-3 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 text-xs space-y-1">
            ${task.score ? `<div class="font-semibold text-indigo-700 dark:text-indigo-300">🎯 Score / Stats: <span class="font-normal text-slate-700 dark:text-slate-200">${task.score}</span></div>` : ''}
            ${task.notes ? `<div class="font-semibold text-slate-600 dark:text-slate-400">📝 Notes: <span class="font-normal text-slate-700 dark:text-slate-200">${task.notes}</span></div>` : ''}
          </div>
        `;
      }

      card.innerHTML = `
        <div class="flex items-start gap-3 sm:gap-4">
          <!-- Big Checkbox -->
          <div class="pt-0.5">
            <input type="checkbox" data-task-id="${task.id}" class="main-task-checkbox w-6 h-6 rounded-lg text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-slate-600 dark:bg-slate-800 cursor-pointer transition shadow-sm" ${isCompleted ? 'checked' : ''}>
          </div>

          <!-- Content Area -->
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold border ${badgeClass}">
                  ${task.emoji || '📌'} ${task.subject || 'Task'}
                </span>
                <span class="text-xs font-semibold text-slate-400 dark:text-slate-400">#${task.number || (index + 1)}</span>
              </div>

              <!-- Action Menu Buttons -->
              <div class="flex items-center space-x-1 opacity-80 group-hover:opacity-100 transition">
                <button data-action="score" data-task-id="${task.id}" class="p-1.5 text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-xs transition" title="Add Score or Note">
                  ✏️ Score
                </button>
                <button data-action="edit" data-task-id="${task.id}" class="p-1.5 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-xs transition" title="Edit Task">
                  ⚙️
                </button>
                <button data-action="delete" data-task-id="${task.id}" class="p-1.5 text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-xs transition" title="Delete Task">
                  🗑️
                </button>
              </div>
            </div>

            <!-- Title -->
            <h4 class="text-sm sm:text-base font-bold text-slate-800 dark:text-slate-100 mt-1.5 ${isCompleted ? 'line-through text-slate-400 dark:text-slate-500' : ''}">
              ${task.title}
            </h4>

            <!-- Description -->
            ${task.description ? `
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1.5 whitespace-pre-line leading-relaxed ${isCompleted ? 'text-slate-400 dark:text-slate-500' : ''}">
                ${task.description}
              </p>
            ` : ''}

            <!-- Subtasks -->
            ${subtasksHTML}

            <!-- Links -->
            ${linksHTML}

            <!-- Score & Notes -->
            ${scoreNotesHTML}
          </div>
        </div>
      `;

      // Attach Event Listeners
      const mainCheckbox = card.querySelector('.main-task-checkbox');
      mainCheckbox.addEventListener('change', (e) => {
        toggleTaskCompletion(task.id, e.target.checked);
      });

      card.querySelectorAll('.subtask-checkbox').forEach(cb => {
        cb.addEventListener('change', (e) => {
          const subId = e.target.getAttribute('data-sub-id');
          toggleSubtaskCompletion(task.id, subId, e.target.checked);
        });
      });

      card.querySelector('[data-action="score"]').addEventListener('click', () => {
        openScoreModal(task.id);
      });

      card.querySelector('[data-action="edit"]').addEventListener('click', () => {
        openEditTaskModal(task.id);
      });

      card.querySelector('[data-action="delete"]').addEventListener('click', () => {
        deleteTask(task.id);
      });

      return card;
    }

    // Task Actions
    function toggleTaskCompletion(taskId, isCompleted) {
      const dayData = getActiveDayData();
      const task = dayData.tasks.find(t => t.id === taskId);
      if (!task) return;

      task.completed = isCompleted;
      if (task.subtasks) {
        task.subtasks.forEach(s => s.completed = isCompleted);
      }

      if (isCompleted) {
        showToast(`Target Completed: ${task.title.substring(0, 28)}...`, 'success');
      }

      queueCloudflarePush();
      renderUI();
    }

    function toggleSubtaskCompletion(taskId, subId, isCompleted) {
      const dayData = getActiveDayData();
      const task = dayData.tasks.find(t => t.id === taskId);
      if (!task || !task.subtasks) return;

      const sub = task.subtasks.find(s => s.id === subId);
      if (sub) {
        sub.completed = isCompleted;
      }

      const allDone = task.subtasks.every(s => s.completed);
      task.completed = allDone;

      queueCloudflarePush();
      renderUI();
    }

    function deleteTask(taskId) {
      const dayData = getActiveDayData();
      const idx = dayData.tasks.findIndex(t => t.id === taskId);
      if (idx !== -1) {
        dayData.tasks.splice(idx, 1);
        showToast('Task removed', 'info');
        queueCloudflarePush();
        renderUI();
      }
    }

    // Study Timer / Pomodoro Logic
    function updateTimerDisplay() {
      const mins = Math.floor(state.timer.remainingSeconds / 60);
      const secs = state.timer.remainingSeconds % 60;
      const fmt = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      elements.timerDisplay.textContent = fmt;
      elements.activeTimerText.textContent = fmt;
      const mobileLabel = document.getElementById('mobileTimerLabel');
      if (mobileLabel) mobileLabel.textContent = fmt;
    }

    function startTimer() {
      if (state.timer.isRunning) return;
      state.timer.isRunning = true;
      elements.timerStatusLabel.textContent = 'Running';
      elements.timerStatusLabel.className = 'text-xs px-2 py-0.5 rounded bg-emerald-600 text-white animate-pulse';
      elements.startTimerBtn.classList.add('hidden');
      elements.pauseTimerBtn.classList.remove('hidden');

      state.timer.interval = setInterval(() => {
        if (state.timer.remainingSeconds > 0) {
          state.timer.remainingSeconds--;
          updateTimerDisplay();
        } else {
          pauseTimer();
          showToast('⏰ Time is up! Target session completed.', 'success');
          playChime();
        }
      }, 1000);
    }

    function pauseTimer() {
      state.timer.isRunning = false;
      clearInterval(state.timer.interval);
      elements.timerStatusLabel.textContent = 'Paused';
      elements.timerStatusLabel.className = 'text-xs px-2 py-0.5 rounded bg-amber-600 text-white';
      elements.startTimerBtn.classList.remove('hidden');
      elements.pauseTimerBtn.classList.add('hidden');
    }

    function resetTimer(seconds = 1800) {
      pauseTimer();
      state.timer.totalSeconds = seconds;
      state.timer.remainingSeconds = seconds;
      elements.timerStatusLabel.textContent = 'Ready';
      elements.timerStatusLabel.className = 'text-xs px-2 py-0.5 rounded bg-slate-700 text-slate-300';
      updateTimerDisplay();
    }

    function playChime() {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(587.33, audioCtx.currentTime); // D5
        osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.15); // A5
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.6);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.6);
      } catch (e) {
        console.log("Audio not supported or blocked");
      }
    }

    // Modal Operations
    function openPasteModal() {
      elements.pasteModal.classList.remove('hidden');
      elements.targetDayNumInput.value = state.currentDay;
      elements.pasteScheduleInput.focus();
    }

    function closePasteModal() {
      elements.pasteModal.classList.add('hidden');
    }

    function openEditTaskModal(taskId = null) {
      elements.taskModal.classList.remove('hidden');
      const dayData = getActiveDayData();

      if (taskId) {
        const task = dayData.tasks.find(t => t.id === taskId);
        if (task) {
          elements.taskModalTitle.textContent = "Edit Target Task";
          elements.editTaskId.value = task.id;
          elements.taskTitleInput.value = task.title;
          elements.taskDescInput.value = task.description || '';
          elements.taskSubtasksInput.value = (task.subtasks || []).map(s => s.text).join('\n');
          elements.taskLinkUrlInput.value = (task.links && task.links[0]) ? task.links[0].url : '';
          return;
        }
      }

      elements.taskModalTitle.textContent = "Add New Target Task";
      elements.editTaskId.value = '';
      elements.taskTitleInput.value = '';
      elements.taskDescInput.value = '';
      elements.taskSubtasksInput.value = '';
      elements.taskLinkUrlInput.value = '';
    }

    function closeTaskModal() {
      elements.taskModal.classList.add('hidden');
    }

    function openScoreModal(taskId) {
      const dayData = getActiveDayData();
      const task = dayData.tasks.find(t => t.id === taskId);
      if (!task) return;

      elements.scoreTaskId.value = taskId;
      elements.taskScoreInput.value = task.score || '';
      elements.taskNotesInput.value = task.notes || '';
      elements.scoreModal.classList.remove('hidden');
      elements.taskScoreInput.focus();
    }

    function closeScoreModal() {
      elements.scoreModal.classList.add('hidden');
    }

    function openSettingsModal() {
      updateUserUI();
      elements.settingsModal.classList.remove('hidden');
    }

    function closeSettingsModal() {
      elements.settingsModal.classList.add('hidden');
    }

    function openShareModal() {
      const dayData = getActiveDayData();
      const total = dayData.tasks.length;
      const done = dayData.tasks.filter(t => t.completed).length;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;

      let msg = `🎯 ${dayData.title || `SSC CGL 2026 T-2 Targets — Day ${dayData.day}`}\n`;
      msg += `📅 Day ${dayData.day} Progress Update\n`;
      msg += `✅ Status: ${done}/${total} Completed (${pct}%)\n`;
      msg += `━━━━━━━━━━━━━━━━━━━━━\n`;

      dayData.tasks.forEach((t) => {
        const icon = t.completed ? '✅' : '⏳';
        msg += `${icon} ${t.emoji || '📌'} ${t.title}: ${t.completed ? 'Done' : 'Pending'}`;
        if (t.score) msg += ` [Score: ${t.score}]`;
        msg += `\n`;
      });

      msg += `━━━━━━━━━━━━━━━━━━━━━\n`;
      msg += `🔥 Current Streak: ${state.streak} Days\n`;
      msg += `#SSCCGL2026 #RBETargets #StudyDaily`;

      elements.shareTextarea.value = msg;
      elements.shareModal.classList.remove('hidden');
    }

    function closeShareModal() {
      elements.shareModal.classList.add('hidden');
    }

    // Theme Appearance State & Controls (Light, Dark, System)
    const THEME_STORAGE_KEY = 'theme';

    function getSavedThemePreference() {
      try {
        return localStorage.getItem(THEME_STORAGE_KEY) || 'system';
      } catch {
        return 'system';
      }
    }

    function applyTheme(pref) {
      const isDark = pref === 'dark' || (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (isDark) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      updateThemeButtonsUI(pref);
    }

    function setTheme(themeName) {
      try {
        if (themeName === 'system') {
          localStorage.removeItem(THEME_STORAGE_KEY);
        } else {
          localStorage.setItem(THEME_STORAGE_KEY, themeName);
        }
      } catch (e) {
        console.warn('Theme storage failed', e);
      }
      applyTheme(themeName);
    }

    function toggleTheme() {
      const isCurrentlyDark = document.documentElement.classList.contains('dark');
      const nextTheme = isCurrentlyDark ? 'light' : 'dark';
      setTheme(nextTheme);
      showToast(`Switched to ${nextTheme} mode`, 'info');
    }

    function updateThemeButtonsUI(pref) {
      const isDark = document.documentElement.classList.contains('dark');
      if (elements.themeToggleIcon) {
        elements.themeToggleIcon.textContent = isDark ? '☀️' : '🌙';
      }
      if (elements.mobileThemeIcon) {
        elements.mobileThemeIcon.textContent = isDark ? '☀️' : '🌙';
      }

      // Settings modal active button indicator
      const activeClass = 'border-indigo-600 bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 font-bold';
      const inactiveClass = 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200';

      if (elements.themeLightBtn) {
        elements.themeLightBtn.className = `px-3 py-1 rounded-xl border text-xs transition ${pref === 'light' ? activeClass : inactiveClass}`;
      }
      if (elements.themeDarkBtn) {
        elements.themeDarkBtn.className = `px-3 py-1 rounded-xl border text-xs transition ${pref === 'dark' ? activeClass : inactiveClass}`;
      }
      if (elements.themeSystemBtn) {
        elements.themeSystemBtn.className = `px-3 py-1 rounded-xl border text-xs transition ${pref === 'system' ? activeClass : inactiveClass}`;
      }
    }

    // Event Listeners Binding
    function setupEventListeners() {
      // Theme Toggle Buttons
      if (elements.themeToggleBtn) {
        elements.themeToggleBtn.addEventListener('click', toggleTheme);
      }
      if (elements.mobileThemeBtn) {
        elements.mobileThemeBtn.addEventListener('click', toggleTheme);
      }
      if (elements.themeLightBtn) {
        elements.themeLightBtn.addEventListener('click', () => {
          setTheme('light');
          showToast('Theme set to Light', 'info');
        });
      }
      if (elements.themeDarkBtn) {
        elements.themeDarkBtn.addEventListener('click', () => {
          setTheme('dark');
          showToast('Theme set to Dark', 'info');
        });
      }
      if (elements.themeSystemBtn) {
        elements.themeSystemBtn.addEventListener('click', () => {
          setTheme('system');
          showToast('Theme following System preferences', 'info');
        });
      }

      // Listen for OS theme changes
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (getSavedThemePreference() === 'system') {
          applyTheme('system');
        }
      });

      // Mobile Bottom Bar Controls
      const mobilePasteBtn = document.getElementById('mobilePasteBtn');
      if (mobilePasteBtn) mobilePasteBtn.addEventListener('click', openPasteModal);

      const mobileTimerBtn = document.getElementById('mobileTimerBtn');
      if (mobileTimerBtn) mobileTimerBtn.addEventListener('click', () => {
        elements.studyTimerBar.classList.toggle('hidden');
        if (!elements.studyTimerBar.classList.contains('hidden')) {
          elements.studyTimerBar.scrollIntoView({ behavior: 'smooth' });
        }
      });

      const mobileAddTaskBtn = document.getElementById('mobileAddTaskBtn');
      if (mobileAddTaskBtn) mobileAddTaskBtn.addEventListener('click', () => openEditTaskModal(null));

      const mobileShareBtn = document.getElementById('mobileShareBtn');
      if (mobileShareBtn) mobileShareBtn.addEventListener('click', openShareModal);

      // Timer Bar Toggles
      elements.toggleTimerBtn.addEventListener('click', () => {
        elements.studyTimerBar.classList.toggle('hidden');
      });
      elements.closeTimerBarBtn.addEventListener('click', () => {
        elements.studyTimerBar.classList.add('hidden');
      });
      elements.startTimerBtn.addEventListener('click', startTimer);
      elements.pauseTimerBtn.addEventListener('click', pauseTimer);
      elements.resetTimerBtn.addEventListener('click', () => resetTimer(state.timer.totalSeconds));

