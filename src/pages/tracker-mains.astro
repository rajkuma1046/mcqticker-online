      // Live parsing preview
      elements.pasteScheduleInput.addEventListener('input', updatePastePreview);

      function updatePastePreview() {
        const val = elements.pasteScheduleInput.value.trim();
        if (!val) {
          elements.parsePreviewBox.classList.add('hidden');
          return;
        }
        const parsed = parseScheduleText(val);
        elements.targetDayNumInput.value = parsed.day;
        elements.parsePreviewBox.classList.remove('hidden');
        elements.previewTaskCountBadge.textContent = `${parsed.tasks.length} tasks detected`;

        elements.previewTaskList.innerHTML = parsed.tasks.map(t => `
          <div class="flex items-center gap-1.5 py-0.5 text-xs">
            <span>${t.emoji}</span>
            <span class="font-semibold text-slate-800 dark:text-slate-200">${t.title}</span>
            ${t.subtasks && t.subtasks.length > 0 ? `<span class="text-[10px] bg-indigo-100 dark:bg-indigo-900/60 text-indigo-700 dark:text-indigo-300 px-1.5 py-0.2 rounded font-bold">${t.subtasks.length} subtasks</span>` : ''}
          </div>
        `).join('');
      }

      // Confirm Import
      elements.confirmImportBtn.addEventListener('click', () => {
        const text = elements.pasteScheduleInput.value.trim();
        if (!text) {
          showToast('Please paste a schedule first', 'warning');
          return;
        }

        const parsed = parseScheduleText(text);
        const dayNum = parseInt(elements.targetDayNumInput.value, 10) || parsed.day;
        
        parsed.day = dayNum;
        state.days[dayNum] = parsed;

        if (elements.overwriteDayCheckbox.checked) {
          state.currentDay = dayNum;
        }

        closePasteModal();
        showToast(`Successfully imported Day ${dayNum} targets!`, 'success');
        queueCloudflarePush();
        renderUI();
      });

      // Add New Day Button
      elements.addNewDayBtn.addEventListener('click', () => {
        const dayNumbers = Object.keys(state.days).map(Number);
        const nextDay = (Math.max(0, ...dayNumbers) || 0) + 1;
        state.days[nextDay] = {
          title: `SSC CGL 2026 T-2 Targets — Day ${nextDay}`,
          day: nextDay,
          quote: "Consistency is what transforms average into excellence.",
          tasks: []
        };
        state.currentDay = nextDay;
        showToast(`Added Day ${nextDay}`, 'info');
        queueCloudflarePush();
        renderUI();
      });

