            elements.qrCodeContainer.classList.remove('hidden');
            elements.toggleQrLabel.textContent = 'Hide Mobile QR Code';
          } else {
            elements.qrCodeContainer.classList.add('hidden');
            elements.toggleQrLabel.textContent = 'Show Mobile QR Code (Instant Scan)';
          }
        });
      }

      // Pair Device with another key
      elements.applyPairKeyBtn.addEventListener('click', async () => {
        const inputKey = elements.pairKeyInput.value.trim();
        if (!inputKey) {
          showToast('Please enter a valid Sync Key', 'warning');
          return;
        }

        state.userId = inputKey;
        localStorage.setItem(SYNC_KEY_STORAGE, inputKey);
        elements.syncUserIdInput.value = inputKey;
        elements.pairKeyInput.value = '';
        showToast(`Connecting to Cloudflare D1 key: "${inputKey}"...`, 'info');
        await syncWithCloudflare(false);
        closeSettingsModal();
      });

      // Custom Name / Handle
      if (elements.applyCustomKeyBtn) {
        elements.applyCustomKeyBtn.addEventListener('click', async () => {
          const custom = elements.customKeyInput.value.trim();
          if (!custom) {
            showToast('Please enter a custom key name', 'warning');
            return;
          }
          const cleanKey = custom.replace(/[^a-zA-Z0-9_\-\.]/g, '');
          if (cleanKey.length < 3) {
            showToast('Key must be at least 3 characters', 'warning');
            return;
          }
          state.userId = cleanKey;
          localStorage.setItem(SYNC_KEY_STORAGE, cleanKey);
          elements.syncUserIdInput.value = cleanKey;
          elements.customKeyInput.value = '';
          showToast(`Set active Sync Key to "${cleanKey}". Syncing to Cloudflare...`, 'info');
          await pushToCloudflare(false);
          closeSettingsModal();
        });
      }

      // Manual Sync Now Button
      elements.manualSyncBtn.addEventListener('click', async () => {
        showToast('Syncing with Cloudflare D1...', 'info');
        await syncWithCloudflare(false);
      });

      // Generate New Random Sync Key
      elements.resetSyncIdBtn.addEventListener('click', () => {
        const randChars = Math.random().toString(36).substring(2, 6).toUpperCase();
        const newKey = `CGL-${randChars}`;
        state.userId = newKey;
        localStorage.setItem(SYNC_KEY_STORAGE, newKey);
        elements.syncUserIdInput.value = newKey;
        showToast(`Generated new Sync Key: "${newKey}"! Pushing targets...`, 'info');
        pushToCloudflare(true);
      });

      // Auto-sync on window focus / tab visibility change
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          syncWithCloudflare(false, true);
        }
      });
      window.addEventListener('focus', () => {
        syncWithCloudflare(false, true);
      });

      // Periodic background silent sync every 12 seconds
      setInterval(() => {
        if (document.visibilityState === 'visible') {
          syncWithCloudflare(false, true);
        }
      }, 12000);

      // Export JSON Backup
      elements.exportDataBtn.addEventListener('click', () => {
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state.days, null, 2));
        const dlAnchor = document.createElement('a');
        dlAnchor.setAttribute("href", dataStr);
        dlAnchor.setAttribute("download", `ssc_cgl_tracker_backup_${new Date().toISOString().slice(0, 10)}.json`);
        document.body.appendChild(dlAnchor);
        dlAnchor.click();
        dlAnchor.remove();
        showToast('Backup JSON downloaded successfully!', 'success');
      });

      // Import JSON Backup
      elements.importDataBtn.addEventListener('click', () => {
        elements.importFileInput.click();
      });

      elements.importFileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (event) => {
          try {
            const imported = JSON.parse(event.target.result);
            if (imported && typeof imported === 'object') {
              state.days = imported;
              showToast('Data restored successfully!', 'success');
              queueCloudflarePush();
              renderUI();
            } else {
              showToast('Invalid backup file structure', 'error');
            }
          } catch (err) {
            showToast('Failed to parse backup JSON', 'error');
          }
        };
        reader.readAsText(file);
      });
    }

    // App Initialization
    async function initApp() {
      initUserSyncKey();
      loadLocalData();
      updateTimerDisplay();
      setupEventListeners();
      renderUI();
      await syncWithCloudflare(true);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initApp);
    } else {
      initApp();
    }
  </script>
</body>
</html>
