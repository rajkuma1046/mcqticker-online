---
// src/pages/mcq-option-selector-online-free.astro
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Schema from '../components/Schema.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "MCQ Option Selector Online Free — Quick Digital Response Logger";
const pageDesc = "Looking for a free online MCQ option selector? Log your practice sheet answers, select option keys, and export results instantly. Try it free.";
const canonicalPath = "/mcq-option-selector-online-free";

const breadcrumbs = [
  { label: "Option Selector", url: "/mcq-option-selector-online-free" }
];

const faqs = [
  {
    question: "What is an online MCQ option selector?",
    answer: "An online MCQ option selector is a digital response logger that helps you mark answers (like A, B, C, D) on your screen while practicing questions from printed books, PDFs, or worksheets. It replaces physical answer sheets."
  },
  {
    question: "Is this MCQ selector tool completely free to use?",
    answer: "Yes, this tool is 100% free with no registration, email signups, or subscription fees required. It runs directly in your web browser and works offline."
  },
  {
    question: "How do I export my selected MCQ options?",
    answer: "You can copy your selected answers directly to your clipboard in a clean text format (e.g., '1: A, 2: C...') or download them for comparison against your answer keys."
  },
  {
    question: "Does it support 5-option questions like banking exams?",
    answer: "Yes. The tool allows you to customize options between A-D, A-E (5 options), 1-4, or True/False (T/F) formats, making it versatile for all competitive exam models."
  }
];
---

<BaseLayout title={pageTitle} description={pageDesc} canonicalPath={canonicalPath} ogLocale="en_US">
  <SEO title={pageTitle} description={pageDesc} canonicalPath={canonicalPath} ogLocale="en_US" />
  <Schema pageName={pageTitle} pageDescription={pageDesc} pageUrl={`https://mcqticker.online${canonicalPath}`} breadcrumbs={breadcrumbs} faqs={faqs} />

  <div class="max-w-3xl mx-auto space-y-10 animate-fadeIn">
    <!-- Breadcrumbs -->
    <Breadcrumb items={breadcrumbs} />

    <!-- Hero Section (Emerald Theme) -->
    <div class="bg-gradient-to-br from-emerald-600/10 to-teal-500/5 dark:from-emerald-950/20 dark:to-teal-900/10 border border-emerald-500/20 dark:border-emerald-400/20 rounded-3xl p-8 text-center space-y-6 shadow-custom-md">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 dark:bg-emerald-400/10 border border-emerald-500/20 dark:border-emerald-400/20 text-emerald-700 dark:text-emerald-400 text-xxs font-bold uppercase tracking-wider">
        <span class="material-symbols-outlined text-sm">ads_click</span>
        Free Option Selector Tool
      </div>
      <h1 class="font-display font-black text-3xl md:text-5xl text-text-light dark:text-text-dark leading-tight">
        Free Online <span class="text-emerald-600 dark:text-emerald-400">MCQ Option Selector</span>
      </h1>
      <p class="text-sm md:text-base text-text-light-muted dark:text-text-dark-muted max-w-xl mx-auto leading-relaxed">
        Say goodbye to scrap paper. Choose your option format, tap to log your choices, and copy your entire response sheet with one click.
      </p>
    </div>

    <!-- Interactive Option Selector App Widget -->
    <section class="bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark rounded-3xl p-6 shadow-custom-md space-y-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-border-light dark:border-border-dark pb-5">
        <div>
          <h2 class="font-display font-extrabold text-base text-text-light dark:text-text-dark">Digital MCQ Selector Sheet</h2>
          <p class="text-xxs text-text-light-muted dark:text-text-dark-muted mt-0.5">Configure and tap options to log responses</p>
        </div>
        <!-- Theme Accented Badge -->
        <span class="px-2.5 py-1 text-3xs font-bold rounded-lg bg-emerald-500/15 text-emerald-800 dark:text-emerald-400 border border-emerald-500/20">
          Mint Active
        </span>
      </div>

      <!-- Config Panel -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-bg-light/50 dark:bg-bg-dark/50 p-4 rounded-2xl border border-border-light/60 dark:border-border-dark/60">
        <div class="space-y-1.5">
          <label class="text-xxs font-black text-text-light dark:text-text-dark uppercase tracking-wider block">Option Format</label>
          <select id="option-format" class="w-full text-xs p-2 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-text-light dark:text-text-dark focus:outline-none cursor-pointer">
            <option value="A-D">A, B, C, D</option>
            <option value="A-E">A, B, C, D, E (5 Options)</option>
            <option value="1-4">1, 2, 3, 4</option>
            <option value="TF">True / False</option>
          </select>
        </div>
        <div class="space-y-1.5">
          <label class="text-xxs font-black text-text-light dark:text-text-dark uppercase tracking-wider block">Question Count</label>
          <input id="question-count" type="number" min="5" max="100" value="15" class="w-full text-xs p-2 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-text-light dark:text-text-dark focus:outline-none" />
        </div>
      </div>

      <!-- Option Grid -->
      <div id="selector-grid" class="space-y-3 max-h-[350px] overflow-y-auto pr-1">
        <!-- Rows will be injected here -->
      </div>

      <!-- Controls & Clipboard -->
      <div class="flex flex-wrap gap-3 items-center justify-between pt-2 border-t border-border-light dark:border-border-dark">
        <div class="flex items-center gap-2">
          <button id="copy-clipboard-btn" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600 text-white dark:text-bg-dark font-bold text-xs rounded-xl transition-all cursor-pointer flex items-center gap-1.5 shadow-sm">
            <span class="material-symbols-outlined text-sm">edit_note</span>
            Copy Answers
          </button>
          <button id="reset-btn" class="px-4 py-2.5 border border-border-light dark:border-border-dark bg-transparent hover:bg-surface-light-hover dark:hover:bg-surface-dark-hover text-text-light dark:text-text-dark font-bold text-xs rounded-xl transition-colors cursor-pointer">
            Clear Sheet
          </button>
        </div>
        <span id="completion-status" class="text-xxs text-text-light-muted dark:text-text-dark-muted">0/15 marked</span>
      </div>
    </section>

    <!-- Article Content -->
    <article class="prose dark:prose-invert max-w-none text-sm text-text-light dark:text-text-dark leading-relaxed space-y-8">
      <section class="space-y-4">
        <h2 class="font-display font-extrabold text-xl text-text-light dark:text-text-dark border-b border-border-light dark:border-border-dark pb-2">
          Simplify Your Practice with a Digital MCQ Option Selector
        </h2>
        <p>
          Solving Multiple Choice Questions (MCQs) is a cornerstone of competitive exam preparation. Whether you are aiming for JEE, NEET, civil service trials, or university midterms, you spend hours working through books or digital test series. Typically, this involves writing down your chosen options on a scrap piece of paper, leading to cluttered desks and easy mistakes when cross-checking with the answer key.
        </p>
        <p>
          A free online <strong>MCQ option selector</strong> acts as the perfect digital interface. Instead of searching for paper, you configure the total number of questions, select your format, and tap the options directly on your smartphone, tablet, or desktop screen. 
        </p>
      </section>

      <section class="space-y-4">
        <h3 class="font-display font-bold text-lg text-text-light dark:text-text-dark">Benefits of a Touch-to-Select Logger</h3>
        <ul class="list-disc pl-6 space-y-2">
          <li><strong>Zero Mess:</strong> No papers, pencil marks, or eraser crumbs. Keep your workspace neat.</li>
          <li><strong>Highly Portable:</strong> Practice on buses, trains, or library corners. Perfect for mobile study sessions.</li>
          <li><strong>Instant Formats:</strong> Switch instantly between standard 4-option grids, 5-option layouts, numbering systems, or true/false formats.</li>
          <li><strong>Easy Grading:</strong> Copy your logged answers in a single tap and paste them into document checkers or share them with friends.</li>
        </ul>
      </section>
    </article>

    <!-- FAQ Component -->
    <FAQ faqs={faqs} title="MCQ Option Selector FAQs" subtitle="Common questions about using our free digital response selector." />
  </div>
</BaseLayout>

<script>
  function setupOptionSelector() {
    const formatSelect = document.getElementById('option-format') as HTMLSelectElement | null;
    const countInput = document.getElementById('question-count') as HTMLInputElement | null;
    const gridEl = document.getElementById('selector-grid');
    const copyBtn = document.getElementById('copy-clipboard-btn');
    const resetBtn = document.getElementById('reset-btn');
    const statusEl = document.getElementById('completion-status');

    if (!gridEl) return;

    let answers: Record<number, string> = {};

    function renderGrid() {
      if (!gridEl || !formatSelect || !countInput) return;
      
      const count = Math.min(Math.max(parseInt(countInput.value) || 10, 5), 100);
      const format = formatSelect.value;
      gridEl.innerHTML = '';
      
      let optionsList: string[] = [];
      if (format === 'A-D') optionsList = ['A', 'B', 'C', 'D'];
      else if (format === 'A-E') optionsList = ['A', 'B', 'C', 'D', 'E'];
      else if (format === '1-4') optionsList = ['1', '2', '3', '4'];
      else if (format === 'TF') optionsList = ['True', 'False'];

      for (let i = 1; i <= count; i++) {
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between p-3 bg-bg-light/35 dark:bg-bg-dark/35 border border-border-light/40 dark:border-border-dark/40 rounded-xl hover:border-emerald-500/30 dark:hover:border-emerald-400/30 transition-all';
        
        const label = document.createElement('span');
        label.className = 'text-xs font-bold text-text-light dark:text-text-dark min-w-[50px]';
        label.textContent = `Q. ${i}`;
        row.appendChild(label);

        const btnContainer = document.createElement('div');
        btnContainer.className = 'flex items-center gap-1.5 flex-wrap';

        optionsList.forEach(opt => {
          const btn = document.createElement('button');
          btn.className = `px-3.5 py-1.5 rounded-lg border text-xxs font-bold transition-all cursor-pointer ${
            answers[i] === opt
              ? 'bg-emerald-600 border-emerald-600 text-white dark:bg-emerald-500 dark:border-emerald-500 dark:text-bg-dark font-black scale-102 shadow-sm'
              : 'bg-surface-light border-border-light dark:bg-surface-dark dark:border-border-dark text-text-light-muted dark:text-text-dark-muted hover:bg-surface-light-hover dark:hover:bg-surface-dark-hover'
          }`;
          btn.textContent = opt;
          btn.addEventListener('click', () => {
            if (answers[i] === opt) {
              delete answers[i]; // Unselect
            } else {
              answers[i] = opt;
            }
            renderGrid();
            updateStatus();
          });
          btnContainer.appendChild(btn);
        });

        row.appendChild(btnContainer);
        gridEl.appendChild(row);
      }
      updateStatus();
    }

    function updateStatus() {
      if (!statusEl || !countInput) return;
      const count = parseInt(countInput.value) || 15;
      const filled = Object.keys(answers).length;
      statusEl.textContent = `${filled}/${count} marked`;

      // Trigger PWA prompt if session is 100% complete
      if (filled === count && filled > 0) {
        if (typeof (window as any).showPwaInstallPrompt === 'function') {
          setTimeout(() => {
            (window as any).showPwaInstallPrompt(
              "Session Completed! Save App?",
              "You successfully solved all questions. Install MCQTicker on your home screen for offline access and full-screen practice next time!"
            );
          }, 800);
        }
      }
    }

    formatSelect?.addEventListener('change', () => {
      answers = {};
      renderGrid();
    });
    countInput?.addEventListener('input', () => {
      answers = {};
      renderGrid();
    });

    resetBtn?.addEventListener('click', () => {
      if (confirm('Are you sure you want to clear the entire sheet?')) {
        answers = {};
        renderGrid();
      }
    });

    copyBtn?.addEventListener('click', () => {
      if (!countInput) return;
      const count = parseInt(countInput.value) || 15;
      let text = 'Logged MCQ Answers:\n';
      for (let i = 1; i <= count; i++) {
        text += `Q${i}: ${answers[i] || 'Skipped'}\n`;
      }
      navigator.clipboard.writeText(text)
        .then(() => {
          alert('Answers copied to clipboard successfully!');
        })
        .catch(err => {
          console.error('Failed to copy answers:', err);
        });
    });

    renderGrid();
  }

  setupOptionSelector();
  document.addEventListener('astro:after-swap', setupOptionSelector);
</script>
