---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import TodoListPage from '../components/TodoListPage';
---

<BaseLayout
  title="Study To-Do List & Daily Task Planner — tap A B C D | MCQ Practice Goals"
  description="Plan your daily competitive exam study targets, track completed MCQ chapters & tests by date, and stay consistent with our free offline-ready Study Planner & To-Do List."
  canonicalPath="/todo"
  containerClass="w-full max-w-none px-0 py-0 flex-1 flex flex-col min-h-[calc(100vh-64px)]"
  hideFooter={true}
>
  <TodoListPage client:only="react" />
</BaseLayout>
