---
import FarmLayout from '../../layouts/FarmLayout.astro';
---

<FarmLayout
  title="Request a Free Produce Sample | Farm Direct Gwalior"
  description="Request a free 100g or 200g sample of raw wheat, groundnut, chana, moong, or urad before ordering. Scheduled delivery in Gwalior."
  canonicalPath="/farm/samples"
>
  <div class="fd-container py-8 sm:py-14">
    <div class="max-w-3xl mx-auto">
      <!-- Title & Policy Summary -->
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="text-xs uppercase tracking-wider text-[#b07a33] font-bold bg-[#fdf6ec] px-3 py-1 rounded-full border border-[#f5dfb8]">
          ₹0 Quality Verification
        </span>
        <h1 class="fd-serif text-3xl sm:text-4xl font-bold text-[#152317] mt-3">
          Request a Free Farm Sample
        </h1>
        <p class="text-xs sm:text-sm text-[#536354] mt-2 leading-relaxed">
          Inspect our raw grains and pulses before making a larger purchase. Samples are free of cost and delivered during scheduled neighbourhood trips to Gwalior.
        </p>
      </div>

      <!-- Sample Explanation Box -->
      <div class="bg-[#f8faf6] p-5 rounded-2xl border border-[#e0e8dc] mb-8 text-xs text-[#536354] space-y-2">
        <div class="font-bold text-[#152317] flex items-center gap-2 text-sm">
          <span>📦</span>
          <span>Sample Distribution Policy</span>
        </div>
        <p>
          • Allowed quantities: <strong>100 grams</strong> or <strong>200 grams</strong> only.<br />
          • Maximum <strong>2 samples per household</strong> per round.<br />
          • Samples are consolidated and delivered during scheduled neighbourhood rounds in <strong>Pawan Nagar</strong> and <strong>Chetakpuri</strong>. We do not dispatch separate transport for individual sample requests.
        </p>
        <div class="pt-1">
          <a href="/farm/sample-policy" class="text-[#275629] font-bold hover:underline">
            Read complete free sample policy &rarr;
          </a>
        </div>
      </div>

      <!-- Request Form Card -->
      <div class="bg-white p-6 sm:p-10 rounded-2xl border border-[#e0e8dc] shadow-sm">
        <form id="sample-form" onsubmit="handleSampleSubmit(event)" class="space-y-6">
          <!-- Step 1: Select Produce -->
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-2">1. Choose Produce for Sample *</label>
            <div id="sample-product-options" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="p-4 text-center text-xs text-[#798a7a]">Loading eligible products...</div>
            </div>
          </div>

          <!-- Step 2: Choose Grams -->
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-2">2. Sample Quantity *</label>
            <div class="grid grid-cols-2 gap-4">
              <label class="flex items-center gap-3 p-3.5 rounded-xl border border-[#d0ded0] cursor-pointer hover:bg-[#f0f4ee] transition-all has-[:checked]:border-[#275629] has-[:checked]:bg-[#eaf3e9]">
                <input type="radio" name="sample_grams" value="100" class="text-[#275629] focus:ring-0" />
                <div>
                  <strong class="text-sm font-bold text-[#152317] block">100 grams</strong>
                  <span class="text-[11px] text-[#536354]">For visual & quality check</span>
                </div>
              </label>

              <label class="flex items-center gap-3 p-3.5 rounded-xl border border-[#d0ded0] cursor-pointer hover:bg-[#f0f4ee] transition-all has-[:checked]:border-[#275629] has-[:checked]:bg-[#eaf3e9]">
                <input type="radio" name="sample_grams" value="200" checked class="text-[#275629] focus:ring-0" />
                <div>
                  <strong class="text-sm font-bold text-[#152317] block">200 grams</strong>
                  <span class="text-[11px] text-[#536354]">Small trial batch</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Step 3: Customer Details -->
          <div class="space-y-4 pt-2 border-t border-[#f0f4ee]">
            <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block">3. Delivery Details (Gwalior)</label>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="text-xs font-semibold text-[#536354] block mb-1">Your Full Name *</label>
                <input
                  id="sample-name"
                  type="text"
                  required
                  placeholder="e.g. Anand Dubey"
                  class="w-full text-xs font-semibold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
                />
              </div>
              <div>
                <label class="text-xs font-semibold text-[#536354] block mb-1">Mobile Number (WhatsApp) *</label>
                <div class="flex">
                  <span class="inline-flex items-center px-3 text-xs font-bold bg-[#f0f4ee] border border-r-0 border-[#d0ded0] rounded-l-lg text-[#536354]">+91</span>
                  <input
                    id="sample-phone"
                    type="tel"
                    required
                    maxlength="10"
                    pattern="[6-9][0-9]{9}"
                    placeholder="10-digit mobile"
                    class="w-full text-xs font-semibold p-3 rounded-r-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
                  />
                </div>
              </div>
            </div>

            <div>
              <label class="text-xs font-semibold text-[#536354] block mb-1">Target Neighbourhood *</label>
              <select id="sample-area" required class="w-full text-xs font-bold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]">
                <option value="">Select neighbourhood cluster...</option>
              </select>
            </div>

            <div>
              <label class="text-xs font-semibold text-[#536354] block mb-1">Full House Address *</label>
              <textarea
                id="sample-address"
                rows="2"
                required
                placeholder="House / Flat no, Street, Colony, Landmark, Gwalior"
                class="w-full text-xs font-semibold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
              ></textarea>
            </div>

            <div>
              <label class="text-xs font-semibold text-[#536354] block mb-1">Optional Note for Farm Team</label>
              <input
                id="sample-note"
                type="text"
                placeholder="Any special remarks or questions"
                class="w-full text-xs font-semibold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
              />
            </div>
          </div>

          <!-- Error & Success Banners -->
          <div id="sample-error" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-semibold"></div>

          <div id="sample-success" class="hidden p-6 rounded-xl bg-[#eaf8ee] border border-[#b2e5be] text-left space-y-3">
            <div class="flex items-center gap-2 text-base font-bold text-[#185e28]">
              <span>✓</span>
              <span>Sample Request Received</span>
            </div>
            <p class="text-xs text-[#256c35] leading-relaxed">
              Sample distribution is conducted during scheduled sample-delivery rounds in selected areas. Your request will be reviewed and included in the next suitable sample round.
            </p>
            <div class="pt-2 flex flex-wrap gap-3">
              <a id="sample-wa-link" href="#" target="_blank" rel="noopener noreferrer" class="fd-btn fd-btn-wa fd-btn-sm font-bold">
                WhatsApp Notification Link &rarr;
              </a>
              <a href="/farm/products" class="fd-btn fd-btn-secondary fd-btn-sm font-bold">
                Browse Full Produce
              </a>
            </div>
          </div>

          <!-- Submit Button -->
          <button
            id="btn-sample-submit"
            type="submit"
            class="fd-btn bg-[#c48a3f] hover:bg-[#b07a33] text-white w-full py-4 text-sm font-bold shadow-md"
          >
            Submit Free Sample Request (₹0)
          </button>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    let products = [];
    let areas = [];

    async function initSamplePage() {
      const urlParams = new URLSearchParams(window.location.search);
      const preselectedPid = urlParams.get('product_id');

      // Fetch products
      try {
        const pRes = await fetch('/farm/api/products');
        const pData = await pRes.json();
        if (pData.success && pData.products) {
          products = pData.products.filter(p => p.sampleAvailable);
          renderProductOptions(preselectedPid);
        }
      } catch (_) {}

      // Fetch delivery areas
      try {
        const aRes = await fetch('/farm/api/delivery-areas');
        const aData = await aRes.json();
        if (aData.success && aData.deliveryAreas) {
          areas = aData.deliveryAreas;
          const select = document.getElementById('sample-area');
          select.innerHTML = '<option value="">Select neighbourhood cluster...</option>' +
            areas.map(a => `<option value="${a.id}">${a.name}, Gwalior</option>`).join('');
        }
      } catch (_) {}

      // Check logged in user
      try {
        const meRes = await fetch('/farm/api/auth/me');
        const meData = await meRes.json();
        if (meData.success && meData.user) {
          document.getElementById('sample-name').value = meData.user.name || '';
          document.getElementById('sample-phone').value = meData.user.phone || '';
          if (meData.addresses && meData.addresses.length > 0) {
            const def = meData.addresses[0];
            document.getElementById('sample-address').value = `${def.houseNumber}, ${def.street} (${def.deliveryAreaName})`;
            if (def.deliveryAreaId) document.getElementById('sample-area').value = def.deliveryAreaId;
          }
        }
      } catch (_) {}
    }

    function renderProductOptions(preselectedPid) {
      const container = document.getElementById('sample-product-options');
      container.innerHTML = products.map((p, idx) => {
        const isChecked = (preselectedPid && p.id == preselectedPid) || (!preselectedPid && idx === 0);
        return `
          <label class="flex items-center gap-3 p-3 rounded-xl border border-[#d0ded0] cursor-pointer hover:bg-[#f0f4ee] transition-all has-[:checked]:border-[#275629] has-[:checked]:bg-[#eaf3e9]">
            <input type="radio" name="sample_product" value="${p.id}" ${isChecked ? 'checked' : ''} class="text-[#275629] focus:ring-0" />
            <img src="${p.imageUrl || '/farm/images/wheat-500.jpg'}" alt="${p.name}" class="w-12 h-12 rounded-lg object-cover flex-shrink-0" />
            <div>
              <strong class="text-xs font-bold text-[#152317] block">${p.name}</strong>
              <span class="text-[11px] text-[#536354]">${p.label}</span>
            </div>
          </label>
        `;
      }).join('');
    }

    window.handleSampleSubmit = async function(e) {
      e.preventDefault();
      const errBox = document.getElementById('sample-error');
      const succBox = document.getElementById('sample-success');
      const submitBtn = document.getElementById('btn-sample-submit');

      errBox.classList.add('hidden');
      succBox.classList.add('hidden');

      const selectedProdRadio = document.querySelector('input[name="sample_product"]:checked');
      if (!selectedProdRadio) {
        errBox.textContent = 'Please choose a produce item for your sample.';
        errBox.classList.remove('hidden');
        return;
      }

      const productId = Number(selectedProdRadio.value);
      const gramsRadio = document.querySelector('input[name="sample_grams"]:checked');
      const grams = gramsRadio ? Number(gramsRadio.value) : 200;
      const name = document.getElementById('sample-name').value.trim();
      const phone = document.getElementById('sample-phone').value.trim();
      const areaId = document.getElementById('sample-area').value;
      const address = document.getElementById('sample-address').value.trim();
      const note = document.getElementById('sample-note').value.trim();

      if (!areaId) {
        errBox.textContent = 'Please select your neighbourhood in Gwalior.';
        errBox.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting Request...';

      try {
        const res = await fetch('/farm/api/samples', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            product_id: productId,
            sample_quantity_grams: grams,
            customer_name: name,
            customer_phone: phone,
            delivery_area_id: Number(areaId),
            delivery_address: address,
            customer_note: note,
          }),
        });

        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'Failed to submit sample request.';
          errBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Free Sample Request (₹0)';
          return;
        }

        // Success
        succBox.classList.remove('hidden');
        document.getElementById('sample-form').reset();
        submitBtn.classList.add('hidden');

        if (data.sample?.whatsapp?.clickToChatUrl) {
          document.getElementById('sample-wa-link').href = data.sample.whatsapp.clickToChatUrl;
        } else {
          document.getElementById('sample-wa-link').href = `https://wa.me/918770767272`;
        }
      } catch (err) {
        errBox.textContent = 'Network error. Please try again.';
        errBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Free Sample Request (₹0)';
      }
    };

    document.addEventListener('DOMContentLoaded', initSamplePage);
  </script>
</FarmLayout>
