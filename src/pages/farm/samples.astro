---
import FarmLayout from '../../layouts/FarmLayout.astro';
---

<FarmLayout
  title="मुफ़्त खेत सैंपल मँगवाएँ (Free Sample) | खेत से सीधे — Farm Direct"
  description="खेत से सीधे 100g या 200g शुद्ध गेहूँ, मूँगफली, देशी चना, मूँग, उड़द का मुफ़्त सैंपल मँगवाएँ। पहले परखें शुद्धता, फिर करें ऑर्डर। ग्वालियर और शिवपुरी में डिलीवरी।"
  canonicalPath="/farm/samples"
>
  <div class="fd-container py-10 sm:py-16">
    <div class="max-w-3xl mx-auto">
      <!-- Title & Hero Header -->
      <div class="text-center max-w-xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-900 dark:text-amber-300 text-xs font-bold mb-3 shadow-xs">
          <span class="inline-block w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
          <span>मुफ़्त खेत चखनी • ₹0 शुल्क <span class="font-normal opacity-80">(Complimentary Farm Tasting)</span></span>
        </div>
        <h1 class="fd-display text-3xl sm:text-5xl font-extrabold text-[#132215] dark:text-white tracking-tight">
          मुफ़्त खेत सैंपल मँगवाएँ
        </h1>
        <p class="text-xs sm:text-base text-[#5b6e5d] dark:text-gray-300 mt-3 leading-relaxed">
          साल भर का अनाज या दालें मँगवाने से पहले हमारे खेत की फ़सल का स्वाद, दाना और शुद्धता खुद परखें। ग्वालियर और शिवपुरी के तय डिलीवरी राउंड में आपके घर तक वितरण।
        </p>
      </div>

      <!-- Policy Feature Card -->
      <div class="bg-gradient-to-br from-emerald-50/70 via-white to-amber-50/40 dark:from-emerald-950/30 dark:via-[#1a2e1d] dark:to-amber-950/20 p-5 sm:p-6 rounded-2xl border border-emerald-900/10 dark:border-emerald-800/40 shadow-xs mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-emerald-700 text-white flex items-center justify-center text-xl flex-shrink-0 shadow-sm">
            🌾
          </div>
          <div>
            <div class="font-bold text-[#132215] dark:text-white text-sm sm:text-base flex items-center gap-2">
              मुफ़्त सैंपल के नियम <span class="text-xs font-normal text-emerald-800 dark:text-emerald-300">(Sample Guidelines)</span>
              <span class="text-[10px] uppercase font-extrabold px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-200">उचित वितरण</span>
            </div>
            <p class="text-xs text-[#5b6e5d] dark:text-gray-300 mt-1 leading-relaxed">
              <strong>100 ग्राम</strong> या <strong>200 ग्राम</strong> के पैकेट चुनें। प्रति परिवार अधिकतम <strong>500 ग्राम तक कुल मुफ़्त सैंपल</strong>। पवन नगर, चेतकपुरी, लश्कर, सिरसौद, करैरा आदि के तय शेड्यूल्ड राउंड में सीधे घर पर सुपुर्द।
            </p>
          </div>
        </div>
        <a href="/farm/sample-policy" class="fd-btn fd-btn-secondary fd-btn-sm font-bold text-xs whitespace-nowrap self-end sm:self-center">
          नियम पढ़ें &rarr;
        </a>
      </div>

      <!-- Main Form Glass Card -->
      <div class="bg-white dark:bg-[#152317] p-6 sm:p-10 rounded-3xl border border-[#dce7db] dark:border-[#223d26] shadow-xl shadow-emerald-950/[0.04]">
        <form id="sample-form" onsubmit="handleSampleSubmit(event)" class="space-y-8">
          
          <!-- STEP 1: Select Produce Samples with 500g Total Limit Meter -->
          <div class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[#edf2eb] dark:border-[#223d26]">
              <div class="flex items-center gap-2.5">
                <span class="w-7 h-7 rounded-full bg-[#194622] text-white text-xs font-bold flex items-center justify-center shadow-xs">1</span>
                <div>
                  <h3 class="font-bold text-sm text-[#132215] dark:text-white">फ़सलों के सैंपल चुनें (1 या अधिक) *</h3>
                  <p class="text-[11px] text-[#748776] dark:text-gray-400">ऑर्डर देने से पहले स्वाद और गुणवत्ता परखें (कुल 500 ग्राम तक मुफ़्त)</p>
                </div>
              </div>

              <!-- Live Quota Meter (Max 500g) -->
              <div class="bg-[#f4f8f3] dark:bg-[#1b2f1e] px-3.5 py-2 rounded-2xl border border-[#d6e4d4] dark:border-[#2d4d32] flex items-center gap-3 self-start sm:self-auto shadow-xs">
                <div>
                  <div class="text-[10px] font-bold uppercase tracking-wider text-[#5b6e5d] dark:text-gray-400">सैंपल वज़न सीमा</div>
                  <div class="text-xs font-extrabold text-[#194622] dark:text-emerald-400">
                    <span id="selected-grams-count">0</span> / 500g अधिकतम
                  </div>
                </div>
                <div class="w-20 bg-gray-200 dark:bg-gray-700 rounded-full h-2.5 overflow-hidden border border-black/5">
                  <div id="grams-progress-bar" class="bg-[#194622] dark:bg-emerald-500 h-2.5 rounded-full transition-all duration-300 w-0"></div>
                </div>
              </div>
            </div>

            <!-- Limit Warning Banner -->
            <div id="quota-warning" class="hidden p-3 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-900 dark:text-amber-200 text-xs font-bold flex items-center gap-2">
              <span>⚠️</span>
              <span>अधिकतम 500g की सीमा पूरी हो गई है। दूसरा उत्पाद जोड़ने के लिए किसी का वज़न 100g करें या हटाएँ।</span>
            </div>

            <div id="sample-product-options" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div class="p-8 text-center text-xs text-[#748776] dark:text-gray-400 bg-gray-50 dark:bg-[#1a2d1d] rounded-2xl border border-dashed border-gray-200 dark:border-gray-700 col-span-2">
                <div class="inline-block animate-spin w-5 h-5 border-2 border-emerald-600 border-t-transparent rounded-full mb-2"></div>
                <div>खेत से ताज़ा उपलब्ध फ़सलें लोड हो रही हैं...</div>
              </div>
            </div>
          </div>

          <!-- STEP 2: Delivery Details -->
          <div class="space-y-4 pt-4 border-t border-[#edf2eb] dark:border-[#223d26]">
            <div class="flex items-center gap-2.5 mb-2">
              <span class="w-7 h-7 rounded-full bg-[#194622] text-white text-xs font-bold flex items-center justify-center shadow-xs">2</span>
              <div>
                <h3 class="font-bold text-sm text-[#132215] dark:text-white">घर तक डिलीवरी का विवरण (Delivery Details) *</h3>
                <p class="text-[11px] text-[#748776] dark:text-gray-400">ग्वालियर, शिवपुरी, करैरा व सिरसौद में आपके क्षेत्र तक सीधी डिलीवरी</p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="text-xs font-bold text-[#132215] dark:text-gray-200 block mb-1.5">आपका पूरा नाम (Full Name) *</label>
                <input
                  id="sample-name"
                  type="text"
                  required
                  placeholder="उदा. रमेश शर्मा"
                  class="fd-input"
                />
              </div>

              <div>
                <label class="text-xs font-bold text-[#132215] dark:text-gray-200 block mb-1.5">व्हाट्सएप मोबाइल नंबर (WhatsApp 10 Digits) *</label>
                <div class="flex">
                  <span class="inline-flex items-center px-3.5 text-xs font-bold bg-[#edf2eb] dark:bg-[#1b2f1e] border border-r-0 border-[#d9e4d5] dark:border-[#2d4d32] rounded-l-xl text-[#5b6e5d] dark:text-gray-300">+91</span>
                  <input
                    id="sample-phone"
                    type="tel"
                    required
                    maxlength="10"
                    pattern="[6-9][0-9]{9}"
                    placeholder="10 अंकों का मोबाइल नंबर"
                    class="fd-input rounded-l-none"
                  />
                </div>
              </div>
            </div>

            <div>
              <label class="text-xs font-bold text-[#132215] dark:text-gray-200 block mb-1.5">डिलीवरी इलाक़ा / क्लस्टर चुनें (Delivery Cluster) *</label>
              <select id="sample-area" required onchange="onSampleAreaChanged(this.value)" class="fd-input font-bold text-xs">
                <option value="">अपना इलाक़ा / क्लस्टर चुनें...</option>
              </select>
            </div>

            <!-- Custom Cluster Input (Revealed when "+ Other / Custom Colony" is selected) -->
            <div id="sample-custom-cluster-box" class="hidden">
              <label class="text-xs font-bold text-[#194622] dark:text-emerald-400 block mb-1.5 flex items-center gap-1.5">
                <span>📍</span>
                <span>अपनी कॉलोनी / गाँव / इलाक़े का नाम दर्ज करें *</span>
              </label>
              <input
                id="sample-custom-cluster"
                type="text"
                placeholder="उदा. सिरसौद, करैरा, पवन नगर, चेतकपुरी, थाटीपुर, सिटी सेंटर..."
                class="fd-input border-emerald-600 bg-emerald-50/40 dark:bg-emerald-950/30 text-xs font-bold"
              />
              <p class="text-[10px] text-[#5b6e5d] dark:text-gray-400 mt-1">
                🌾 हम कॉलोनी अनुसार अनुरोध एकत्रित करके नियमित होम डिलीवरी का शेड्यूल बनाते हैं।
              </p>
            </div>

            <div>
              <label class="text-xs font-bold text-[#132215] dark:text-gray-200 block mb-1.5">मकान नंबर व पूरा पता (Doorstep Address) *</label>
              <textarea
                id="sample-address"
                rows="2"
                required
                placeholder="मकान/फ्लैट नं., गली/रास्ता, लैंडमार्क, कॉलोनी या गाँव"
                class="fd-input"
              ></textarea>
            </div>

            <div>
              <label class="text-xs font-bold text-[#132215] dark:text-gray-200 block mb-1.5">लैंडमार्क / विशेष निर्देश (वैकल्पिक / Optional)</label>
              <input
                id="sample-note"
                type="text"
                placeholder="उदा. पानी की टंकी के पास, द्वितीय तल, आदि"
                class="fd-input"
              />
            </div>
          </div>

          <!-- Error Alert Banner -->
          <div id="sample-error" class="hidden p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200 text-xs font-semibold leading-relaxed flex items-center gap-3">
            <span class="text-lg">⚠️</span>
            <div id="sample-error-text"></div>
          </div>

          <!-- Submit Button -->
          <div class="pt-4 border-t border-[#edf2eb] dark:border-[#223d26]">
            <button
              id="btn-sample-submit"
              type="submit"
              class="fd-btn fd-btn-primary w-full py-4 text-base font-extrabold rounded-2xl shadow-lg shadow-emerald-950/20 hover:shadow-xl hover:shadow-emerald-950/30 transition-all flex items-center justify-center gap-2"
            >
              <span>मुफ़्त सैंपल बुक करें (Confirm Free Sample) &rarr;</span>
            </button>
            <p class="text-[11px] text-[#748776] dark:text-gray-400 text-center mt-3">
              🌾 100% मुफ़्त सेवा। कोई शुल्क या डिलीवरी चार्ज नहीं। सीधा व्हाट्सएप पर सूचना मिलेगी।
            </p>
          </div>
        </form>

        <!-- Success Alert Screen -->
        <div id="sample-success" class="hidden p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-emerald-50 via-white to-emerald-50/40 dark:from-emerald-950/40 dark:via-[#162719] dark:to-emerald-950/30 border-2 border-emerald-300 dark:border-emerald-700 text-left space-y-5 shadow-xl">
          <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-500 to-[#1b4522] text-white flex items-center justify-center text-2xl font-bold shadow-md shadow-emerald-900/20">
              ✓
            </div>
            <div>
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-800 dark:text-emerald-200 bg-emerald-100/80 dark:bg-emerald-900/60 px-2.5 py-0.5 rounded-full border border-emerald-300 dark:border-emerald-700">
                सैंपल कन्फ़र्म • ₹0 शुल्क
              </span>
              <h4 class="font-extrabold text-xl text-emerald-950 dark:text-white mt-1">सैंपल रिक्वेस्ट दर्ज हो गई!</h4>
              <p class="text-xs text-emerald-800 dark:text-emerald-300">आपका टेस्टिंग पैकेट हमारे खेत प्रेषण रजिस्टर (Dispatch Register) में जोड़ लिया गया है।</p>
            </div>
          </div>

          <div id="sample-summary-details" class="p-5 bg-white dark:bg-[#1a2d1d] rounded-2xl border border-emerald-100 dark:border-emerald-800/40 text-xs text-[#132215] dark:text-gray-200 space-y-2 shadow-xs"></div>

          <div class="flex flex-col sm:flex-row gap-3 pt-2">
            <a id="sample-wa-link" href="#" target="_blank" rel="noopener noreferrer" class="fd-btn w-full sm:w-auto py-3.5 px-6 text-xs bg-[#25D366] hover:bg-[#1fa851] text-white font-bold rounded-xl shadow-md flex items-center justify-center gap-2">
              <span>💬 किसान को व्हाट्सएप पर पर्ची भेजें</span>
            </a>
            <a id="sample-conf-link" href="/farm/sample-confirmation" class="fd-btn fd-btn-primary w-full sm:w-auto text-xs py-3.5 px-6 font-bold rounded-xl">
              कन्फ़र्मेशन पर्ची देखें &rarr;
            </a>
            <a href="/farm/products" class="fd-btn fd-btn-secondary w-full sm:w-auto text-xs py-3.5 px-5 font-bold rounded-xl">
              फ़सल सूची देखें (Catalogue)
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    let productsList = [];
    let areasList = [];

    async function initSamplePage() {
      try {
        // Load products
        const pRes = await fetch('/farm/api/products');
        const pData = await pRes.json();
        if (pData.success) {
          productsList = (pData.products || []).filter(p => p.sampleAvailable && !p.isOutOfStock);
          renderProductOptions(productsList);
        }

        // Load delivery areas
        const aRes = await fetch('/farm/api/delivery-areas');
        const aData = await aRes.json();
        if (aData.success) {
          areasList = aData.deliveryAreas || [];
          renderAreaOptions(areasList);
        }

        // Auto-fill logged-in user details if available
        const meRes = await fetch('/farm/api/auth/me');
        const meData = await meRes.json();
        if (meData.success && meData.user) {
          document.getElementById('sample-name').value = meData.user.name || '';
          document.getElementById('sample-phone').value = meData.user.phone || '';
          if (meData.user.defaultAddress) {
            document.getElementById('sample-address').value = meData.user.defaultAddress.address || '';
            if (meData.user.defaultAddress.deliveryAreaId) {
              document.getElementById('sample-area').value = meData.user.defaultAddress.deliveryAreaId;
            }
          }
        }
      } catch (err) {
        console.error('Failed to init sample form:', err);
      }
    }

    let selectedSamples = {}; // Map of productId -> grams
    let availableProducts = [];
    const MAX_SAMPLE_GRAMS = 500;

    function getTotalSelectedGrams() {
      return Object.values(selectedSamples).reduce((acc, g) => acc + g, 0);
    }

    function updateSelectionUI() {
      const total = getTotalSelectedGrams();
      const countEl = document.getElementById('selected-grams-count');
      const barEl = document.getElementById('grams-progress-bar');
      const warningEl = document.getElementById('quota-warning');

      if (countEl) countEl.textContent = total;
      if (barEl) {
        const pct = Math.min(100, Math.round((total / MAX_SAMPLE_GRAMS) * 100));
        barEl.style.width = `${pct}%`;
        if (total >= MAX_SAMPLE_GRAMS) {
          barEl.className = 'bg-amber-600 h-2.5 rounded-full transition-all duration-300';
        } else {
          barEl.className = 'bg-[#194622] h-2.5 rounded-full transition-all duration-300';
        }
      }

      if (warningEl) {
        if (total >= MAX_SAMPLE_GRAMS) {
          warningEl.classList.remove('hidden');
        } else {
          warningEl.classList.add('hidden');
        }
      }

      availableProducts.forEach(p => {
        const card = document.getElementById(`sample-card-${p.id}`);
        const chk = document.getElementById(`chk-${p.id}`);
        const ctrl = document.getElementById(`weight-ctrl-${p.id}`);
        const btn100 = document.getElementById(`btn-100g-${p.id}`);
        const btn200 = document.getElementById(`btn-200g-${p.id}`);

        const grams = selectedSamples[p.id];
        const isSelected = !!grams;

        if (chk) chk.checked = isSelected;

        if (card) {
          if (isSelected) {
            card.classList.remove('border-[#d9e4d5]', 'bg-white');
            card.classList.add('border-[#194622]', 'bg-[#f2f8f3]', 'ring-2', 'ring-emerald-600/10');
          } else {
            card.classList.remove('border-[#194622]', 'bg-[#f2f8f3]', 'ring-2', 'ring-emerald-600/10');
            card.classList.add('border-[#d9e4d5]', 'bg-white');
          }
        }

        if (ctrl) {
          if (isSelected) {
            ctrl.classList.remove('hidden');
          } else {
            ctrl.classList.add('hidden');
          }
        }

        if (btn100 && btn200 && isSelected) {
          if (grams === 100) {
            btn100.className = 'px-3 py-1 text-xs font-black bg-[#194622] text-white transition-colors';
            btn200.className = 'px-3 py-1 text-xs font-bold text-gray-700 hover:bg-gray-200 transition-colors';
          } else {
            btn100.className = 'px-3 py-1 text-xs font-bold text-gray-700 hover:bg-gray-200 transition-colors';
            btn200.className = 'px-3 py-1 text-xs font-black bg-[#194622] text-white transition-colors';
          }
        }
      });
    }

    function renderProductOptions(products) {
      availableProducts = products;
      const container = document.getElementById('sample-product-options');
      if (products.length === 0) {
        container.innerHTML = `<div class="col-span-2 p-6 text-center text-xs text-amber-800 dark:text-amber-200 bg-amber-50 dark:bg-amber-950/40 rounded-xl">इस सप्ताह के लिए मुफ़्त सैंपल अनुरोध पूरे हो चुके हैं। कृपया अगले राउंड में देखें। (Sample requests paused for this round)</div>`;
        return;
      }

      container.innerHTML = products.map((p) => `
        <div 
          id="sample-card-${p.id}"
          class="sample-prod-card group p-3.5 rounded-2xl border-2 border-[#d9e4d5] dark:border-[#223d26] bg-white dark:bg-[#162719] hover:border-emerald-600 dark:hover:border-emerald-500 transition-all flex flex-col justify-between shadow-xs"
        >
          <div class="flex items-start gap-3 cursor-pointer select-none" onclick="toggleSampleItem(${p.id})">
            <div class="pt-0.5">
              <input type="checkbox" id="chk-${p.id}" class="w-5 h-5 rounded-md text-[#194622] border-gray-300 focus:ring-emerald-600 cursor-pointer pointer-events-none" />
            </div>
            <img src="${p.imageUrl || '/farm/images/wheat-500.jpg'}" alt="${p.name}" class="w-14 h-14 object-cover rounded-xl border border-[#dce7db] dark:border-[#2d4d32] flex-shrink-0 group-hover:scale-105 transition-transform" />
            <div class="flex-grow min-w-0">
              <div class="flex items-center justify-between gap-1">
                <strong class="font-extrabold text-sm text-[#132215] dark:text-white block truncate">
                  ${p.localName || p.name}
                  ${p.localName ? `<span class="text-xs font-normal text-emerald-800 dark:text-emerald-300 ml-1 font-mono">(${p.name})</span>` : ''}
                </strong>
              </div>
              <p class="text-[11px] text-[#5b6e5d] dark:text-gray-300 line-clamp-1 mt-0.5">${p.description}</p>
              <span class="inline-block mt-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-200">
                मुफ़्त सैंपल उपलब्ध • Sample
              </span>
            </div>
          </div>

          <!-- Weight Toggle Selector (shown when selected) -->
          <div id="weight-ctrl-${p.id}" class="hidden mt-3 pt-2.5 border-t border-[#d8e3d6] dark:border-[#223d26] flex items-center justify-between">
            <span class="text-[11px] font-bold text-[#4e6050] dark:text-gray-300">पैकेट वज़न (Weight):</span>
            <div class="inline-flex rounded-lg border border-[#c2d3bf] dark:border-[#2d4d32] overflow-hidden bg-[#f4f7f2] dark:bg-[#1b2f1e]">
              <button
                type="button"
                id="btn-100g-${p.id}"
                class="px-3 py-1 text-xs font-bold text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                onclick="setSampleWeight(${p.id}, 100)"
              >100g</button>
              <button
                type="button"
                id="btn-200g-${p.id}"
                class="px-3 py-1 text-xs font-bold text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                onclick="setSampleWeight(${p.id}, 200)"
              >200g</button>
            </div>
          </div>
        </div>
      `).join('');

      // Pre-select product from URL params or default to first product
      const urlParams = new URLSearchParams(window.location.search);
      const preselectId = Number(urlParams.get('product_id'));
      const preselectSlug = urlParams.get('product');

      let targetProduct = null;
      if (preselectId) {
        targetProduct = products.find(p => p.id === preselectId);
      } else if (preselectSlug) {
        targetProduct = products.find(p => p.slug === preselectSlug);
      }

      if (!targetProduct && products.length > 0) {
        targetProduct = products[0];
      }

      if (targetProduct) {
        selectedSamples[targetProduct.id] = 200;
      }

      updateSelectionUI();
    }

    window.toggleSampleItem = function(productId) {
      if (selectedSamples[productId]) {
        delete selectedSamples[productId];
      } else {
        const currentTotal = getTotalSelectedGrams();
        if (currentTotal + 200 <= MAX_SAMPLE_GRAMS) {
          selectedSamples[productId] = 200;
        } else if (currentTotal + 100 <= MAX_SAMPLE_GRAMS) {
          selectedSamples[productId] = 100;
        } else {
          if (window.fdToast) {
            window.fdToast('500g सीमा पूरी हुई (Limit Reached)', 'मुफ़्त सैंपल की अधिकतम सीमा 500 ग्राम प्रति ग्राहक है। अन्य फ़सल जोड़ने के लिए किसी का वज़न 100g करें या अनचेक करें।', 'error');
          } else {
            alert('अधिकतम 500g सीमा पूरी हुई! Free samples are limited to 500g total per customer.');
          }
          return;
        }
      }
      updateSelectionUI();
    };

    window.setSampleWeight = function(productId, grams) {
      const current = selectedSamples[productId] || 0;
      const totalWithout = getTotalSelectedGrams() - current;
      if (totalWithout + grams > MAX_SAMPLE_GRAMS) {
        if (window.fdToast) {
          window.fdToast('500g सीमा पूरी हुई (Limit Reached)', `${grams}g चुनने से कुल वज़न 500g से अधिक (${totalWithout + grams}g) हो जाएगा। पहले किसी अन्य आइटम का वज़न घटाएँ।`, 'error');
        } else {
          alert(`${grams}g चुनने से कुल 500g सीमा पार हो जाएगी।`);
        }
        return;
      }
      selectedSamples[productId] = grams;
      updateSelectionUI();
    };

    function renderAreaOptions(areas) {
      const select = document.getElementById('sample-area');
      select.innerHTML = '<option value="">अपना इलाक़ा / क्लस्टर चुनें (Select Cluster)...</option>';
      for (const a of areas) {
        const opt = document.createElement('option');
        opt.value = a.id;
        opt.textContent = `${a.name} (${a.city}) — तय दिन: ${a.deliveryDay}`;
        select.appendChild(opt);
      }
      const customOpt = document.createElement('option');
      customOpt.value = 'custom';
      customOpt.textContent = '📍 + अन्य / अपनी कॉलोनी या गाँव का नाम लिखें';
      select.appendChild(customOpt);
    }

    window.onSampleAreaChanged = function(val) {
      const box = document.getElementById('sample-custom-cluster-box');
      const input = document.getElementById('sample-custom-cluster');
      if (val === 'custom') {
        box.classList.remove('hidden');
        input.focus();
      } else {
        box.classList.add('hidden');
      }
    };

    window.handleSampleSubmit = async function(e) {
      e.preventDefault();
      const errBox = document.getElementById('sample-error');
      const errText = document.getElementById('sample-error-text');
      const successBox = document.getElementById('sample-success');
      const submitBtn = document.getElementById('btn-sample-submit');

      errBox.classList.add('hidden');

      const items = Object.entries(selectedSamples).map(([id, grams]) => ({
        product_id: Number(id),
        sample_quantity_grams: grams
      }));

      if (items.length === 0) {
        errText.textContent = 'कृपया चखने के लिए कम से कम 1 फ़सल का सैंपल चुनें। (Please choose at least 1 sample)';
        errBox.classList.remove('hidden');
        return;
      }

      const totalGrams = getTotalSelectedGrams();
      if (totalGrams > MAX_SAMPLE_GRAMS) {
        errText.textContent = `कुल सैंपल वज़न 500 ग्राम से अधिक नहीं हो सकता (वर्तमान: ${totalGrams}g)।`;
        errBox.classList.remove('hidden');
        return;
      }

      const areaVal = document.getElementById('sample-area').value;
      const isCustomCluster = areaVal === 'custom';
      const customClusterInput = document.getElementById('sample-custom-cluster');
      const customCluster = isCustomCluster ? (customClusterInput ? customClusterInput.value.trim() : '') : '';

      if (!areaVal) {
        errText.textContent = 'कृपया डिलीवरी इलाक़ा चुनें या अपनी कॉलोनी का नाम दर्ज करें।';
        errBox.classList.remove('hidden');
        return;
      }

      if (isCustomCluster && !customCluster) {
        errText.textContent = 'कृपया अपने मोहल्ले, कॉलोनी या गाँव का नाम दर्ज करें।';
        errBox.classList.remove('hidden');
        if (customClusterInput) customClusterInput.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <div class="inline-block animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full mr-2"></div>
        मुफ़्त सैंपल दर्ज किया जा रहा है... (Processing...)
      `;

      const name = document.getElementById('sample-name').value.trim();
      const phone = document.getElementById('sample-phone').value.trim();
      const address = document.getElementById('sample-address').value.trim();
      const customerNote = document.getElementById('sample-note').value.trim();

      try {
        const res = await fetch('/farm/api/samples', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items,
            customer_name: name,
            customer_phone: phone,
            phone: phone,
            delivery_area_id: isCustomCluster ? 'custom' : Number(areaVal),
            custom_delivery_area: customCluster || undefined,
            delivery_address: address,
            customer_note: customerNote || undefined,
          }),
        });

        const data = await res.json();
        if (!data.success) {
          errText.textContent = data.error || data.message || 'सैंपल रिक्वेस्ट दर्ज करने में समस्या आई। कृपया विवरण जाँचें।';
          errBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'मुफ़्त सैंपल बुक करें (Confirm Free Sample) →';
          return;
        }

        // Success state: cache in sessionStorage for dedicated confirmation page
        const samplePayload = {
          customerName: name,
          phone: phone,
          deliveryArea: data.sampleRequest?.deliveryArea || '',
          deliveryAddress: address,
          totalGrams: data.totalGrams || totalGrams,
          items: (data.sampleRequests || [data.sampleRequest]).map(s => ({
            productName: s.productName,
            sampleQuantityGrams: s.sampleQuantityGrams
          })),
          whatsappUrl: data.whatsapp?.clickToChatUrl || data.sampleRequest?.whatsappUrl,
          createdAt: new Date().toISOString()
        };

        try {
          sessionStorage.setItem('fd_latest_sample', JSON.stringify(samplePayload));
        } catch (_) {}

        // Populate inline success card in case of delayed redirect
        document.getElementById('sample-form').classList.add('hidden');
        successBox.classList.remove('hidden');

        const detailsBox = document.getElementById('sample-summary-details');
        const itemsListHtml = (data.sampleRequests || [data.sampleRequest]).map(s => `• <strong>${s.productName}</strong> (${s.sampleQuantityGrams}g)`).join('<br/>');

        detailsBox.innerHTML = `
          <div><strong>बुक किए गए सैंपल (${data.totalGrams || totalGrams}g कुल):</strong><br/><div class="mt-1 pl-2 border-l-2 border-emerald-400">${itemsListHtml}</div></div>
          <div class="mt-2"><strong>प्राप्तकर्ता (Recipient):</strong> ${data.sampleRequest.customerName || name} (+91 ${phone})</div>
          <div><strong>डिलीवरी इलाक़ा (Cluster):</strong> ${data.sampleRequest.deliveryArea || ''}</div>
          <div><strong>घर का पता (Address):</strong> ${address}</div>
        `;

        const waLinkEl = document.getElementById('sample-wa-link');
        const confLinkEl = document.getElementById('sample-conf-link');
        const targetConfUrl = `/farm/sample-confirmation?phone=${encodeURIComponent(phone)}`;

        if (confLinkEl) {
          confLinkEl.href = targetConfUrl;
        }

        if (waLinkEl) {
          if (data.sampleRequest.whatsappUrl) {
            waLinkEl.href = data.sampleRequest.whatsappUrl;
          } else {
            const text = encodeURIComponent(`नमस्ते! वेबसाइट से मुफ़्त फ़सल सैंपल रिक्वेस्ट (${totalGrams}g) — ${name}, पता: ${address}।`);
            waLinkEl.href = `https://wa.me/918770767272?text=${text}`;
          }
        }

        // Smoothly redirect to dedicated confirmation page
        setTimeout(() => {
          window.location.href = targetConfUrl;
        }, 150);
      } catch (err) {
        errText.textContent = 'नेटवर्क त्रुटि: कृपया इंटरनेट कनेक्शन जाँचें और पुनः प्रयास करें।';
        errBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'मुफ़्त सैंपल बुक करें (Confirm Free Sample) →';
      }
    };

    document.addEventListener('DOMContentLoaded', initSamplePage);
  </script>
</FarmLayout>
