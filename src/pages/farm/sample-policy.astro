---
import FarmLayout from '../../layouts/FarmLayout.astro';

// Free Sample Policy — Modern Transparency Guide
---

<FarmLayout
  title="मुफ़्त सैंपल नीति (Sample Policy) | खेत से सीधे — Farm Direct"
  description="ग्वालियर और शिवपुरी में मुफ़्त 100g व 200g फ़सल चखनी सैंपल वितरण के नियम व पारदर्शी दिशानिर्देश। शुद्धता की निष्पक्ष परख।"
  canonicalPath="/farm/sample-policy"
>
  <div class="fd-container py-8 sm:py-16">
    <div class="max-w-3xl mx-auto space-y-8">
      <!-- Title Card -->
      <div class="text-center max-w-xl mx-auto space-y-3">
        <span class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-amber-900 dark:text-amber-300 font-extrabold bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 px-3.5 py-1 rounded-full">
          <span>🎁</span>
          <span>गुणवत्ता पारदर्शिता • Quality Transparency</span>
        </span>
        <h1 class="fd-display text-3xl sm:text-5xl font-extrabold text-[#122815] dark:text-white leading-tight">
          मुफ़्त सैंपल नीति
        </h1>
        <p class="text-xs sm:text-sm text-[#5b6e5d] dark:text-gray-300 leading-relaxed">
          ग्वालियर व शिवपुरी के परिवारों के लिए हमारा मुफ़्त 100 ग्राम व 200 ग्राम फ़सल चखनी कार्यक्रम कैसे काम करता है।
        </p>
      </div>

      <!-- Core Principle Box -->
      <div class="relative bg-white dark:bg-[#152317] rounded-3xl border border-[#e2ece0] dark:border-[#223d26] p-6 sm:p-8 shadow-sm space-y-4">
        <div class="p-4 rounded-2xl bg-[#edf5ec] dark:bg-[#1b2f1e] border border-[#d6e5d3] dark:border-[#2d4d32] text-xs sm:text-sm text-[#1b4522] dark:text-emerald-300 font-semibold leading-relaxed">
          🌾 <strong>हमारा संकल्प:</strong> हमारे मुफ़्त सैंपल कार्यक्रम का उद्देश्य परिवारों को 10kg या 25kg की बड़ी बोरी बुक करने से पहले हमारे खेत के बिना पॉलिश अनाज का दाना, स्वाद और शुद्धता परखने का पूरा अवसर देना है।
        </div>

        <!-- Policy Rules Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs text-[#526454] dark:text-gray-300">
          <div class="p-4 rounded-2xl bg-[#f8faf7] dark:bg-[#1a2d1d] border border-[#e8f0e6] dark:border-[#2d4d32] space-y-1">
            <strong class="font-extrabold text-[#122815] dark:text-white block">पात्र फ़सलें (Eligible Produce)</strong>
            <p>मुफ़्त सैंपल शुद्ध सीहोर गेहूँ, कच्ची साबुत मूँगफली, देशी चना, मूँग, उड़द व मौसमी फ़सलों के उपलब्ध स्टॉक के आधार पर दिए जाते हैं।</p>
          </div>

          <div class="p-4 rounded-2xl bg-[#f8faf7] dark:bg-[#1a2d1d] border border-[#e8f0e6] dark:border-[#2d4d32] space-y-1">
            <strong class="font-extrabold text-[#122815] dark:text-white block">मानकीकृत पैकेट वज़न (Pouch Sizes)</strong>
            <p>सैंपल केवल <strong>100 ग्राम</strong> या <strong>200 ग्राम</strong> के विशेष पाउच में ही दिए जाते हैं। व्यावसायिक या थोक मुफ़्त मात्रा उपलब्ध नहीं है।</p>
          </div>

          <div class="p-4 rounded-2xl bg-[#f8faf7] dark:bg-[#1a2d1d] border border-[#e8f0e6] dark:border-[#2d4d32] space-y-1">
            <strong class="font-extrabold text-[#122815] dark:text-white block">शेड्यूल्ड डिलीवरी राउंड</strong>
            <p>अनावश्यक वाहन फेरों से बचने और पर्यावरण की रक्षा हेतु सैंपल का वितरण रविवार के तय डिलीवरी रूट में नियमित ऑर्डर्स के साथ किया जाता है।</p>
          </div>

          <div class="p-4 rounded-2xl bg-[#f8faf7] dark:bg-[#1a2d1d] border border-[#e8f0e6] dark:border-[#2d4d32] space-y-1">
            <strong class="font-extrabold text-[#122815] dark:text-white block">उचित उपयोग सीमा (Fair-Use Limits)</strong>
            <p>प्रति परिवार कुल 500 ग्राम तक अधिकतम मुफ़्त सैंपल। सभी परिवारों को समान अवसर मिले, इसलिए प्रति मोबाइल नंबर 14 दिन का कूलडाउन लागू होता है।</p>
          </div>
        </div>

        <div class="pt-4 border-t border-[#f0f5ee] dark:border-[#223d26] flex items-center justify-between text-xs text-[#667a68] dark:text-gray-400">
          <span>शून्य उत्पाद शुल्क (₹0 Fee)</span>
          <span class="font-bold text-emerald-800 dark:text-emerald-400">100% प्राकृतिक • कोई पॉलिश नहीं</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a href="/farm/samples" class="fd-btn fd-btn-accent w-full sm:w-auto px-6 py-3 font-bold text-sm shadow-md">
          मुफ़्त सैंपल मँगवाएँ (100g/200g) &rarr;
        </a>
        <a href="/farm/products" class="fd-btn fd-btn-secondary w-full sm:w-auto px-6 py-3 font-bold text-sm">
          फ़सल सूची देखें (Catalogue)
        </a>
      </div>
    </div>
  </div>
</FarmLayout>
