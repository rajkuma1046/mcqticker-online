---
import FarmLayout from '../../layouts/FarmLayout.astro';
---

<FarmLayout
  title="Your Farm Cart | Farm Direct"
  description="Review your selected raw agricultural produce pre-order."
  canonicalPath="/farm/cart"
  hideCartBar={true}
>
  <div class="fd-container py-10 sm:py-16">
    <div class="max-w-4xl mx-auto">
      <!-- Title -->
      <div class="flex items-center justify-between pb-6 border-b border-[#e2ece0] mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-[10px] font-extrabold uppercase tracking-wider mb-2">
            Direct Farm Harvest
          </div>
          <h1 class="fd-display text-3xl sm:text-4xl font-extrabold text-[#132215]">
            Your Pre-Order Basket
          </h1>
        </div>
        <button id="btn-clear-cart" type="button" class="text-xs font-bold text-rose-700 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-xl transition-colors" onclick="clearEntireCart()">
          Clear Basket
        </button>
      </div>

      <!-- Live Server Verification Indicator -->
      <div id="cart-loading" class="text-center py-16 text-[#5b6e5d]">
        <div class="inline-block animate-spin w-8 h-8 border-4 border-[#194622] border-t-transparent rounded-full mb-3"></div>
        <p class="text-sm font-semibold">Validating live prices and stock with Cloudflare D1...</p>
      </div>

      <!-- Empty Cart Message -->
      <div id="cart-empty" class="hidden text-center py-20 bg-white rounded-3xl border border-[#dce7db] p-8 shadow-xl shadow-emerald-950/[0.03]">
        <div class="w-16 h-16 rounded-3xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-3xl mx-auto mb-4 shadow-xs">
          🌾
        </div>
        <h2 class="fd-display text-2xl font-extrabold text-[#132215] mb-2">Your basket is currently empty</h2>
        <p class="text-xs sm:text-sm text-[#5b6e5d] max-w-md mx-auto mb-6 leading-relaxed">
          You haven't reserved any raw produce yet. Browse this week's unpolished wheat, pulses, and oilseeds directly from our farm.
        </p>
        <a href="/farm/products" class="fd-btn fd-btn-primary px-7 py-3.5 font-bold text-sm rounded-xl shadow-md">
          Browse Farm Produce &rarr;
        </a>
      </div>

      <!-- Cart Content (Items + Summary) -->
      <div id="cart-content" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Items Table Column -->
        <div class="lg:col-span-8 space-y-4">
          <!-- Stock issue warning banner -->
          <div id="stock-warning" class="hidden p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs font-bold leading-relaxed flex items-center gap-3">
            <span class="text-base">⚠️</span>
            <span>Some quantities were adjusted to match current warehouse stock limits.</span>
          </div>

          <div id="cart-items-list" class="space-y-3.5">
            <!-- Rendered via JS -->
          </div>

          <div class="pt-4 flex justify-between items-center text-xs text-[#5b6e5d]">
            <a href="/farm/products" class="font-bold text-[#194622] hover:underline flex items-center gap-1">
              &larr; Add more produce items
            </a>
            <span class="text-[11px] text-[#748776]">Cloudflare D1 real-time calculation</span>
          </div>
        </div>

        <!-- Order Summary Column -->
        <div class="lg:col-span-4">
          <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#dce7db] shadow-xl shadow-emerald-950/[0.04] space-y-5 sticky top-24">
            <h3 class="fd-display font-extrabold text-lg text-[#132215] pb-3 border-b border-[#edf2eb]">
              Pre-Order Summary
            </h3>

            <!-- Delivery Area Selector for live delivery charge -->
            <div class="space-y-1.5">
              <label class="text-[11px] font-extrabold uppercase tracking-wider text-[#748776] block">Delivery Cluster</label>
              <select id="cart-delivery-area" class="fd-input font-bold text-xs" onchange="recalculateTotals()">
                <option value="">Select Delivery Area in Gwalior</option>
              </select>
            </div>

            <!-- Price Breakdown -->
            <div class="space-y-3 text-xs text-[#5b6e5d] pt-1">
              <div class="flex justify-between">
                <span>Produce Subtotal:</span>
                <strong id="summary-subtotal" class="text-[#132215] font-extrabold text-sm">₹0</strong>
              </div>
              <div class="flex justify-between">
                <span>Cluster Transport Fee:</span>
                <strong id="summary-delivery" class="text-[#132215] font-bold">Select area</strong>
              </div>
              <div id="min-order-note" class="hidden text-[11px] text-amber-800 bg-amber-50 p-2.5 rounded-xl border border-amber-200"></div>
              <div class="border-t border-[#edf2eb] pt-3 flex justify-between items-baseline text-sm">
                <span class="font-extrabold text-[#132215]">Grand Total:</span>
                <strong id="summary-grand-total" class="text-2xl font-extrabold text-[#194622]">₹0</strong>
              </div>
            </div>

            <!-- Pre-Order Notice -->
            <div class="text-[11px] text-[#5b6e5d] bg-[#f7faf5] p-3.5 rounded-xl border border-[#dce7db] leading-relaxed">
              🌾 <strong>Pay on Doorstep Delivery:</strong> Payment via Cash or direct UPI scan at time of delivery.
            </div>

            <button id="btn-proceed-checkout" type="button" class="fd-btn fd-btn-primary w-full py-4 font-extrabold text-sm rounded-2xl shadow-lg shadow-emerald-950/20" onclick="proceedToCheckout()">
              Proceed to Checkout &rarr;
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    let validatedCart = null;
    let deliveryAreas = [];

    async function initCart() {
      try {
        const areaRes = await fetch('/farm/api/delivery-areas');
        const areaData = await areaRes.json();
        if (areaData.success && areaData.deliveryAreas) {
          deliveryAreas = areaData.deliveryAreas;
          const select = document.getElementById('cart-delivery-area');
          select.innerHTML = '<option value="">Select Delivery Area in Gwalior</option>' +
            deliveryAreas.map(a => `
              <option value="${a.id}">${a.name} (Delivery: ₹${a.deliveryChargeRupees})</option>
            `).join('');

          const savedAreaId = localStorage.getItem('fd_selected_area_id');
          if (savedAreaId && deliveryAreas.some(a => a.id == savedAreaId)) {
            select.value = savedAreaId;
          }
        }
      } catch (_) {}

      await validateAndRenderCart();
    }

    async function validateAndRenderCart() {
      const loader = document.getElementById('cart-loading');
      const empty = document.getElementById('cart-empty');
      const content = document.getElementById('cart-content');

      let rawCart = [];
      try {
        rawCart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      if (!rawCart || rawCart.length === 0) {
        loader.classList.add('hidden');
        content.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }

      const selectedAreaId = document.getElementById('cart-delivery-area')?.value || null;

      try {
        const res = await fetch('/farm/api/cart/validate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: rawCart.map(it => ({
              product_id: it.productId,
              quantity: it.quantity,
            })),
            delivery_area_id: selectedAreaId ? Number(selectedAreaId) : null,
          }),
        });

        const data = await res.json();
        if (!data.success) {
          loader.innerHTML = `<p class="text-sm text-red-600">${data.error || 'Failed to validate cart.'}</p>`;
          return;
        }

        validatedCart = data;
        loader.classList.add('hidden');
        empty.classList.add('hidden');
        content.classList.remove('hidden');

        const warning = document.getElementById('stock-warning');
        if (data.hasStockIssues) {
          warning.classList.remove('hidden');
        } else {
          warning.classList.add('hidden');
        }

        renderCartItems(data.items);
        renderSummary(data);
      } catch (err) {
        loader.innerHTML = '<p class="text-sm text-red-600">Failed to connect to farm database. Please check connection.</p>';
      }
    }

    function renderCartItems(items) {
      const list = document.getElementById('cart-items-list');
      if (!items || items.length === 0) {
        document.getElementById('cart-content').classList.add('hidden');
        document.getElementById('cart-empty').classList.remove('hidden');
        return;
      }

      list.innerHTML = items.map(item => {
        const priceDisplay = item.priceRupees !== null ? `₹${item.priceRupees}/kg` : '';
        const lineTotalDisplay = item.lineTotalRupees !== null ? `₹${item.lineTotalRupees}` : '—';
        const hasErr = item.error !== null;

        return `
          <div class="bg-white p-4 sm:p-5 rounded-2xl border border-[#dce7db] shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <img
                src="${item.imageUrl || '/farm/images/wheat-500.jpg'}"
                alt="${item.productName}"
                class="w-16 h-16 rounded-xl object-cover border border-[#dce7db] flex-shrink-0"
              />
              <div>
                <strong class="font-extrabold text-sm sm:text-base text-[#132215] block">${item.productName}</strong>
                <div class="text-xs text-[#5b6e5d] mt-0.5">${priceDisplay}</div>
                ${hasErr ? `
                  <span class="text-[11px] font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded mt-1 inline-block">${item.error}</span>
                ` : ''}
              </div>
            </div>

            <div class="flex items-center justify-between sm:justify-end gap-5 w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-[#edf2eb]">
              <!-- Stepper -->
              <div class="flex items-center gap-1.5 p-1 rounded-xl bg-[#f7faf5] border border-[#dce7db]">
                <button type="button" class="w-7 h-7 rounded-lg bg-white border border-[#d0ded0] text-xs font-bold text-[#194622] hover:bg-[#eaf4ec]" onclick="updateItemQty(${item.productId}, -1)">−</button>
                <span class="w-10 text-center text-xs font-extrabold text-[#132215]">${item.quantity} kg</span>
                <button type="button" class="w-7 h-7 rounded-lg bg-white border border-[#d0ded0] text-xs font-bold text-[#194622] hover:bg-[#eaf4ec]" onclick="updateItemQty(${item.productId}, 1)">+</button>
              </div>

              <strong class="font-extrabold text-sm text-[#194622] min-w-[70px] text-right">${lineTotalDisplay}</strong>

              <button type="button" class="text-xs text-rose-600 hover:text-rose-800 p-1.5 rounded-lg hover:bg-rose-50 transition-colors" title="Remove" onclick="removeItem(${item.productId})">
                ✕
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderSummary(data) {
      document.getElementById('summary-subtotal').textContent = `₹${data.subtotalRupees}`;
      const delEl = document.getElementById('summary-delivery');
      const minNote = document.getElementById('min-order-note');
      const btn = document.getElementById('btn-proceed-checkout');

      if (data.deliveryArea) {
        delEl.textContent = `₹${data.deliveryChargeRupees}`;
        const meetsMin = data.meetsMinimumOrder !== undefined ? data.meetsMinimumOrder : data.minOrderMet;
        const minVal = data.deliveryArea.minimumOrderRupees !== undefined ? data.deliveryArea.minimumOrderRupees : 200;
        if (!meetsMin) {
          minNote.textContent = `Minimum order for ${data.deliveryArea.name} is ₹${minVal}. Please add more items.`;
          minNote.classList.remove('hidden');
          btn.disabled = true;
          btn.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
          minNote.classList.add('hidden');
          btn.disabled = false;
          btn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      } else {
        delEl.textContent = 'Select area';
        minNote.classList.add('hidden');
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
      }

      document.getElementById('summary-grand-total').textContent = `₹${data.grandTotalRupees}`;
    }

    window.updateItemQty = function(productId, delta) {
      let rawCart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      const item = rawCart.find(it => it.productId === productId);
      if (item) {
        item.quantity += delta;
        if (item.quantity <= 0) {
          rawCart = rawCart.filter(it => it.productId !== productId);
        }
      }
      localStorage.setItem('fd_cart_v1', JSON.stringify(rawCart));
      if (typeof updateNavCartBadge === 'function') updateNavCartBadge();
      validateAndRenderCart();
    };

    window.removeItem = function(productId) {
      let rawCart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      rawCart = rawCart.filter(it => it.productId !== productId);
      localStorage.setItem('fd_cart_v1', JSON.stringify(rawCart));
      if (typeof updateNavCartBadge === 'function') updateNavCartBadge();
      validateAndRenderCart();
    };

    window.clearEntireCart = function() {
      if (confirm('Clear all items from your basket?')) {
        localStorage.removeItem('fd_cart_v1');
        if (typeof updateNavCartBadge === 'function') updateNavCartBadge();
        validateAndRenderCart();
      }
    };

    window.recalculateTotals = function() {
      const select = document.getElementById('cart-delivery-area');
      if (select && select.value) {
        localStorage.setItem('fd_selected_area_id', select.value);
      }
      validateAndRenderCart();
    };

    window.proceedToCheckout = function() {
      const area = document.getElementById('cart-delivery-area').value;
      if (area) {
        localStorage.setItem('fd_selected_area_id', area);
      }
      window.location.href = '/farm/checkout';
    };

    document.addEventListener('DOMContentLoaded', initCart);
  </script>
</FarmLayout>
