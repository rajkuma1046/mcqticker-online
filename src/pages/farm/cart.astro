---
import FarmLayout from '../../layouts/FarmLayout.astro';
---

<FarmLayout
  title="Your Farm Cart | Farm Direct Gwalior"
  description="Review your selected raw agricultural produce pre-order."
  canonicalPath="/farm/cart"
  hideCartBar={true}
>
  <div class="fd-container py-8 sm:py-14">
    <div class="max-w-4xl mx-auto">
      <!-- Title -->
      <div class="flex items-center justify-between pb-6 border-b border-[#e0e8dc] mb-8">
        <div>
          <span class="text-xs uppercase tracking-wider text-[#275629] font-bold">Pre-Order Basket</span>
          <h1 class="fd-serif text-3xl sm:text-4xl font-bold text-[#152317] mt-1">
            Your Farm Cart
          </h1>
        </div>
        <button id="btn-clear-cart" type="button" class="text-xs font-semibold text-red-600 hover:underline" onclick="clearEntireCart()">
          Clear Cart
        </button>
      </div>

      <!-- Live Server Verification Indicator -->
      <div id="cart-loading" class="text-center py-16 text-[#536354]">
        <div class="inline-block animate-spin w-8 h-8 border-4 border-[#275629] border-t-transparent rounded-full mb-3"></div>
        <p class="text-sm font-semibold">Validating live prices and stock with the farm database...</p>
      </div>

      <!-- Empty Cart Message -->
      <div id="cart-empty" class="hidden text-center py-16 bg-white rounded-2xl border border-[#e0e8dc] p-8 shadow-sm">
        <div class="text-5xl mb-4">🌾</div>
        <h2 class="fd-serif text-2xl font-bold text-[#152317] mb-2">Your cart is empty</h2>
        <p class="text-sm text-[#536354] max-w-md mx-auto mb-6">
          You haven't added any raw produce to your basket yet. Check out this week's harvest from our farm.
        </p>
        <a href="/farm/products" class="fd-btn fd-btn-primary px-6 py-3 font-bold text-sm shadow-sm">
          Browse Farm Produce &rarr;
        </a>
      </div>

      <!-- Cart Content (Items + Summary) -->
      <div id="cart-content" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Items Table Column -->
        <div class="lg:col-span-8 space-y-4">
          <!-- Stock issue warning banner -->
          <div id="stock-warning" class="hidden p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs sm:text-sm">
            <strong>Stock Adjustment:</strong> Some quantities in your cart were adjusted to match current farm availability.
          </div>

          <div id="cart-items-list" class="space-y-3">
            <!-- Rendered via JS -->
          </div>

          <div class="pt-4 flex justify-between items-center text-xs text-[#536354]">
            <a href="/farm/products" class="font-semibold text-[#275629] hover:underline flex items-center gap-1">
              &larr; Continue browsing produce
            </a>
            <span>Prices verified live from database</span>
          </div>
        </div>

        <!-- Order Summary Column -->
        <div class="lg:col-span-4">
          <div class="bg-white p-6 rounded-2xl border border-[#e0e8dc] shadow-sm space-y-5 sticky top-24">
            <h3 class="font-bold text-base text-[#152317] pb-3 border-b border-[#f0f4ee]">
              Order Summary
            </h3>

            <!-- Delivery Area Selector for live delivery charge -->
            <div class="space-y-1.5">
              <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block">Delivery Neighbourhood</label>
              <select id="cart-delivery-area" class="w-full text-xs font-semibold p-2.5 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]" onchange="recalculateTotals()">
                <option value="">Select Delivery Area in Gwalior</option>
                <!-- Populated via API -->
              </select>
            </div>

            <!-- Price Breakdown -->
            <div class="space-y-2.5 text-xs text-[#536354] pt-2">
              <div class="flex justify-between">
                <span>Subtotal Produce:</span>
                <strong id="summary-subtotal" class="text-[#1a251b] font-bold text-sm">₹0</strong>
              </div>
              <div class="flex justify-between">
                <span>Neighbourhood Delivery:</span>
                <strong id="summary-delivery" class="text-[#1a251b] font-bold">Select area</strong>
              </div>
              <div id="min-order-note" class="hidden text-[11px] text-amber-700 bg-amber-50 p-2 rounded-lg"></div>
              <div class="border-t border-[#f0f4ee] pt-3 flex justify-between items-baseline text-sm">
                <span class="font-bold text-[#152317]">Grand Total:</span>
                <strong id="summary-grand-total" class="text-xl font-bold text-[#275629]">₹0</strong>
              </div>
            </div>

            <!-- Pre-Order Notice -->
            <div class="text-[11px] text-[#798a7a] bg-[#f8faf6] p-3 rounded-lg border border-[#e5ece2] leading-relaxed">
              <strong>Pre-Order Note:</strong> Payment is collected on delivery. Delivery dates are aligned with scheduled neighbourhood rounds.
            </div>

            <button id="btn-proceed-checkout" type="button" class="fd-btn fd-btn-primary w-full py-3.5 font-bold text-sm shadow-md" onclick="proceedToCheckout()">
              Proceed to Checkout &rarr;
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    let validatedCart = null;
    let deliveryAreas = [];

    async function initCart() {
      // 1. Fetch delivery areas
      try {
        const areaRes = await fetch('/farm/api/delivery-areas');
        const areaData = await areaRes.json();
        if (areaData.success && areaData.deliveryAreas) {
          deliveryAreas = areaData.deliveryAreas;
          const select = document.getElementById('cart-delivery-area');
          select.innerHTML = '<option value="">Select Delivery Area in Gwalior</option>' +
            deliveryAreas.map(a => `
              <option value="${a.id}">${a.name} (Delivery: ₹${a.deliveryChargeRupees})</option>
            `).join('');

          // Restore saved delivery area if in localStorage
          const savedAreaId = localStorage.getItem('fd_selected_area_id');
          if (savedAreaId && deliveryAreas.some(a => a.id == savedAreaId)) {
            select.value = savedAreaId;
          }
        }
      } catch (_) {}

      // 2. Validate current cart against DB
      await validateAndRenderCart();
    }

    async function validateAndRenderCart() {
      const loader = document.getElementById('cart-loading');
      const empty = document.getElementById('cart-empty');
      const content = document.getElementById('cart-content');

      let rawCart = [];
      try {
        rawCart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      if (!rawCart || rawCart.length === 0) {
        loader.classList.add('hidden');
        content.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }

      const selectedAreaId = document.getElementById('cart-delivery-area')?.value || null;

      try {
        const res = await fetch('/farm/api/cart/validate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: rawCart.map(it => ({
              product_id: it.productId,
              quantity: it.quantity,
            })),
            delivery_area_id: selectedAreaId ? Number(selectedAreaId) : null,
          }),
        });

        const data = await res.json();
        if (!data.success) {
          loader.innerHTML = `<p class="text-sm text-red-600">${data.error || 'Failed to validate cart.'}</p>`;
          return;
        }

        validatedCart = data;
        loader.classList.add('hidden');
        empty.classList.add('hidden');
        content.classList.remove('hidden');

        // Check stock warnings
        const warning = document.getElementById('stock-warning');
        if (data.hasStockIssues) {
          warning.classList.remove('hidden');
        } else {
          warning.classList.add('hidden');
        }

        renderCartItems(data.items);
        renderSummary(data);
      } catch (err) {
        loader.innerHTML = '<p class="text-sm text-red-600">Failed to connect to farm database. Please check connection.</p>';
      }
    }

    function renderCartItems(items) {
      const list = document.getElementById('cart-items-list');
      if (!items || items.length === 0) {
        document.getElementById('cart-content').classList.add('hidden');
        document.getElementById('cart-empty').classList.remove('hidden');
        return;
      }

      list.innerHTML = items.map(item => {
        const priceDisplay = item.priceRupees !== null ? `₹${item.priceRupees}/kg` : '';
        const lineTotalDisplay = item.lineTotalRupees !== null ? `₹${item.lineTotalRupees}` : '—';
        const hasErr = item.error !== null;

        return `
          <div class="bg-white p-4 sm:p-5 rounded-xl border border-[#e0e8dc] shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <img
                src="${item.imageUrl || '/farm/images/wheat-500.jpg'}"
                alt="${item.productName}"
                class="w-16 h-16 rounded-lg object-cover bg-neutral-100 flex-shrink-0"
              />
              <div>
                <h4 class="font-bold text-sm sm:text-base text-[#152317]">
                  <a href="/farm/products/${item.slug || ''}" class="hover:underline">${item.productName}</a>
                </h4>
                <div class="text-xs text-[#536354] mt-0.5">
                  ${priceDisplay} • Available: ${item.availableQuantity} kg
                </div>
                ${hasErr ? `
                  <div class="text-[11px] font-bold text-red-600 mt-1">${item.error}</div>
                ` : ''}
              </div>
            </div>

            <div class="flex items-center justify-between sm:justify-end w-full sm:w-auto gap-6">
              <!-- Quantity Controls -->
              <div class="flex items-center border border-[#c5d6c4] rounded-lg overflow-hidden bg-white">
                <button type="button" class="px-2.5 py-1 text-sm font-bold text-[#275629] hover:bg-[#f0f4ee]" onclick="updateItemQuantity(${item.productId}, -1)">−</button>
                <span class="w-10 text-center text-xs font-bold py-1 border-x border-[#c5d6c4]">${item.quantity}</span>
                <button type="button" class="px-2.5 py-1 text-sm font-bold text-[#275629] hover:bg-[#f0f4ee]" onclick="updateItemQuantity(${item.productId}, 1, ${item.availableQuantity})">+</button>
              </div>

              <!-- Line Total & Delete -->
              <div class="text-right min-w-[70px]">
                <div class="font-bold text-sm text-[#275629]">${lineTotalDisplay}</div>
                <button type="button" class="text-[11px] text-red-600 hover:underline mt-1" onclick="removeItem(${item.productId})">
                  Remove
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderSummary(data) {
      document.getElementById('summary-subtotal').textContent = `₹${data.subtotalRupees}`;
      const deliveryEl = document.getElementById('summary-delivery');
      const minNote = document.getElementById('min-order-note');
      const checkoutBtn = document.getElementById('btn-proceed-checkout');

      if (data.deliveryArea) {
        deliveryEl.textContent = `₹${data.deliveryChargeRupees}`;
        localStorage.setItem('fd_selected_area_id', data.deliveryArea.id);
      } else {
        deliveryEl.textContent = 'Select area';
      }

      document.getElementById('summary-grand-total').textContent = `₹${data.grandTotalRupees}`;

      if (!data.minOrderMet && data.deliveryArea) {
        minNote.textContent = `Minimum order for ${data.deliveryArea.name} is ₹${(data.deliveryArea.minimumOrderPaise || 20000)/100}. Please add more produce.`;
        minNote.classList.remove('hidden');
        checkoutBtn.disabled = true;
        checkoutBtn.classList.add('opacity-50', 'cursor-not-allowed');
      } else {
        minNote.classList.add('hidden');
        checkoutBtn.disabled = false;
        checkoutBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    }

    window.recalculateTotals = function() {
      validateAndRenderCart();
    };

    window.updateItemQuantity = function(productId, delta, max = 1000) {
      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      const idx = cart.findIndex(it => it.productId === productId);
      if (idx >= 0) {
        cart[idx].quantity += delta;
        if (cart[idx].quantity < 1) {
          cart.splice(idx, 1);
        } else if (cart[idx].quantity > max) {
          cart[idx].quantity = max;
        }
      }

      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      if (window.fdUpdateCart) window.fdUpdateCart();
      validateAndRenderCart();
    };

    window.removeItem = function(productId) {
      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      cart = cart.filter(it => it.productId !== productId);
      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      if (window.fdUpdateCart) window.fdUpdateCart();
      validateAndRenderCart();
    };

    window.clearEntireCart = function() {
      if (confirm('Are you sure you want to clear your cart?')) {
        localStorage.removeItem('fd_cart_v1');
        if (window.fdUpdateCart) window.fdUpdateCart();
        validateAndRenderCart();
      }
    };

    window.proceedToCheckout = function() {
      const areaSelect = document.getElementById('cart-delivery-area');
      if (areaSelect && areaSelect.value) {
        localStorage.setItem('fd_selected_area_id', areaSelect.value);
      }
      window.location.href = '/farm/checkout';
    };

    document.addEventListener('DOMContentLoaded', initCart);
  </script>
</FarmLayout>
