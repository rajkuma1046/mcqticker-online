---
import FarmLayout from '../../layouts/FarmLayout.astro';
---

<FarmLayout
  title="Farm Direct | Raw Farm Produce by Pre-Order"
  description="Order raw wheat, groundnut, chana, moong, urad and seasonal farm produce with scheduled delivery in Gwalior, Karera, and Shivpuri."
  canonicalPath="/farm"
>
  <!-- HERO SECTION -->
  <section class="relative pt-8 pb-16 sm:py-20 lg:py-24 overflow-hidden">
    <div class="fd-container relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Text Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-600/20 text-[#194622] text-xs font-extrabold uppercase tracking-wider shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
            <span>Direct From Village Farm • Zero Middlemen</span>
          </div>

          <h1 class="fd-display text-4xl sm:text-6xl lg:text-7xl font-extrabold text-[#132215] tracking-tight leading-[1.08]">
            Pure Raw Harvest,<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#194622] via-[#2d6f3b] to-[#c98528]">
              Delivered Direct
            </span>
          </h1>

          <p class="text-base sm:text-lg text-[#4a5f4d] leading-relaxed max-w-xl font-medium">
            Raw, unpolished wheat, pulses, and oilseeds threshed on village farmland and delivered fresh to <strong>Gwalior, Karera, Sirsod, and Shivpuri</strong>.
          </p>

          <div class="flex flex-wrap items-center gap-3.5 pt-2">
            <a href="#produce-catalogue" class="fd-btn fd-btn-primary fd-btn-lg text-base shadow-lg shadow-emerald-950/20 hover:shadow-xl hover:shadow-emerald-950/30">
              <span>Explore This Week's Harvest</span>
              <span>&darr;</span>
            </a>
            <a href="/farm/samples" class="fd-btn fd-btn-secondary fd-btn-lg text-base border-emerald-900/15">
              <span>🎁 Request Free Sample</span>
            </a>
          </div>

          <!-- Trust Tags & Cluster Indicator -->
          <div class="pt-4 flex flex-wrap items-center gap-5 text-xs text-[#5b6e5d] font-semibold border-t border-[#e2ece0]/80">
            <div class="flex items-center gap-2">
              <span class="text-emerald-700 font-extrabold text-sm">✓</span>
              <span>100% Unprocessed & Natural</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-700 font-extrabold text-sm">✓</span>
              <span>Authoritative Farm Gate Pricing</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-700 font-extrabold text-sm">✓</span>
              <span>Pay on Doorstep Delivery</span>
            </div>
          </div>
        </div>

        <!-- Hero Image Column with Modern Glass Overlays -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-emerald-950/20 border-4 border-white bg-white group">
            <img
              src="/farm/images/hero-1280.jpg"
              alt="Wheat harvest in Raisen district, Madhya Pradesh"
              class="w-full h-80 sm:h-[440px] object-cover object-center group-hover:scale-105 transition-transform duration-700"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-6 text-white">
              <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-[10px] uppercase font-extrabold tracking-wider w-fit mb-2 text-emerald-200">
                <span>📍 Madhya Pradesh Harvest Belt</span>
              </div>
              <h3 class="font-extrabold text-lg sm:text-xl text-white leading-snug">
                Cleaned & Threshed by Farmers
              </h3>
              <p class="text-xs text-white/80 mt-1 leading-relaxed">
                No chemical bleaching, talc coating, or factory processing. Delivered in eco-sacks on scheduled cluster days.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 VALUE PILLARS -->
  <section class="py-10 bg-white/70 backdrop-blur-md border-y border-[#e2ece0]">
    <div class="fd-container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
        <div class="space-y-2">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-2xl shadow-xs">
            🌾
          </div>
          <h4 class="fd-display font-extrabold text-base text-[#132215]">Raw & Unprocessed</h4>
          <p class="text-xs text-[#5b6e5d] leading-relaxed">Natural whole grains with germ and seed coat intact for peak nutrition.</p>
        </div>

        <div class="space-y-2">
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-800 flex items-center justify-center text-2xl shadow-xs">
            ⚖️
          </div>
          <h4 class="fd-display font-extrabold text-base text-[#132215]">Farm-Gate Pricing</h4>
          <p class="text-xs text-[#5b6e5d] leading-relaxed">Direct ₹/kg rates validated live against our Cloudflare D1 database.</p>
        </div>

        <div class="space-y-2">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-2xl shadow-xs">
            🚚
          </div>
          <h4 class="fd-display font-extrabold text-base text-[#132215]">Scheduled Transport</h4>
          <p class="text-xs text-[#5b6e5d] leading-relaxed">Consolidated weekly trips direct to Sirsod, Karera, Shivpuri, Pawan Nagar & Chetakpuri.</p>
        </div>

        <div class="space-y-2">
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-800 flex items-center justify-center text-2xl shadow-xs">
            🎁
          </div>
          <h4 class="fd-display font-extrabold text-base text-[#132215]">Complimentary Tasting</h4>
          <p class="text-xs text-[#5b6e5d] leading-relaxed">Order 100g or 200g free sample packets before booking seasonal stock.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCE CATALOGUE SECTION -->
  <section id="produce-catalogue" class="py-16 sm:py-24">
    <div class="fd-container">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-[10px] font-extrabold uppercase tracking-wider mb-2">
            Live Warehouse Inventory
          </div>
          <h2 class="fd-display text-3xl sm:text-5xl font-extrabold text-[#132215] tracking-tight">
            This Week's Farm Produce
          </h2>
          <p class="text-xs sm:text-sm text-[#5b6e5d] mt-2 max-w-xl font-medium">
            Live rates and available grain weights retrieved directly from the farm server. All orders are weighed and packed to order.
          </p>
        </div>

        <div class="flex items-center gap-3 self-start sm:self-end">
          <span class="text-xs text-[#748776] font-semibold">Serving Clusters:</span>
          <span class="px-3 py-1.5 rounded-xl bg-white border border-[#d9e4d5] text-[#194622] text-xs font-bold shadow-xs">
            📍 Pawan Nagar & Chetakpuri
          </span>
        </div>
      </div>

      <!-- Live Product Grid Container -->
      <div id="product-grid-loading" class="text-center py-20 text-[#5b6e5d]">
        <div class="inline-block animate-spin w-8 h-8 border-4 border-[#194622] border-t-transparent rounded-full mb-3"></div>
        <p class="text-sm font-semibold">Connecting to Cloudflare D1 and loading live produce...</p>
      </div>

      <div id="product-grid" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"></div>
    </div>
  </section>

  <!-- HOW CONSOLIDATED LOGISTICS WORKS -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-[#122815] to-[#1a3d1f] text-white rounded-3xl mx-4 sm:mx-8 mb-20 shadow-2xl shadow-emerald-950/20 overflow-hidden relative">
    <div class="fd-container relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-[10px] uppercase tracking-widest text-emerald-300 font-extrabold px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/10">
          The Agricultural Pre-Order Model
        </span>
        <h2 class="fd-display text-3xl sm:text-4xl font-extrabold text-white mt-3">
          How Farm-to-Neighbourhood Works
        </h2>
        <p class="text-xs sm:text-sm text-emerald-100/80 mt-2 leading-relaxed">
          We eliminate intermediary mandi commissions and cold-storage delays by consolidating cluster orders before dispatch.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white/10 backdrop-blur-md p-6 sm:p-8 rounded-2xl border border-white/10 space-y-3">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-2xl font-bold font-mono">
            01
          </div>
          <h4 class="font-extrabold text-lg text-white">Place Pre-Order or Sample</h4>
          <p class="text-xs text-emerald-100/70 leading-relaxed">
            Choose your produce and bag weights online or test quality first with a free 100g/200g sample packet.
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-md p-6 sm:p-8 rounded-2xl border border-white/10 space-y-3">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-2xl font-bold font-mono">
            02
          </div>
          <h4 class="font-extrabold text-lg text-white">Farm Threshing & Bagging</h4>
          <p class="text-xs text-emerald-100/70 leading-relaxed">
            Produce is threshed from harvest batches, weighed into breathable eco-sacks, and loaded on consolidated vehicles.
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-md p-6 sm:p-8 rounded-2xl border border-white/10 space-y-3">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-2xl font-bold font-mono">
            03
          </div>
          <h4 class="font-extrabold text-lg text-white">Neighbourhood Drop-Off</h4>
          <p class="text-xs text-emerald-100/70 leading-relaxed">
            Consolidated vehicle arrives in Pawan Nagar or Chetakpuri on scheduled round day. Pay at your doorstep with Cash or UPI.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Real Customer Reviews & Harvest Photos Section -->
  <section class="py-14 sm:py-20 bg-[#f4f7f2] border-t border-[#dce7db]">
    <div class="fd-container space-y-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-xs font-extrabold uppercase tracking-wider mb-2">
            <span>⭐</span>
            <span>Customer Photos & Reviews</span>
          </span>
          <h2 class="fd-display text-2xl sm:text-4xl font-extrabold text-[#122815]">
            Loved by Local Families
          </h2>
          <p class="text-xs sm:text-sm text-[#5b6e5d] mt-1">
            Real feedback and photos from village homes and city kitchens in Sirsod, Gwalior, Karera, and Shivpuri.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/farm/reviews" class="fd-btn fd-btn-secondary px-4 py-2.5 rounded-xl text-xs font-bold flex items-center gap-1">
            <span>View All Reviews & Photos (⭐) &rarr;</span>
          </a>
          <a href="/farm/reviews?write=1" class="fd-btn fd-btn-primary px-4 py-2.5 rounded-xl text-xs font-bold">
            <span>Write a Review</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Review 1 -->
        <div class="bg-white p-6 rounded-3xl border border-[#dce7db] shadow-xs hover:shadow-md transition-shadow space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full bg-[#1b4522] text-white font-extrabold text-xs flex items-center justify-center">
                  R
                </div>
                <div>
                  <strong class="font-extrabold text-xs text-[#122815] block">Ramesh Sharma</strong>
                  <span class="text-[10px] text-[#5b6e5d]">📍 Pawan Nagar, Gwalior</span>
                </div>
              </div>
              <span class="text-amber-400 font-bold text-sm">★★★★★</span>
            </div>
            <p class="text-xs text-[#4a5f4d] leading-relaxed">
              "Rotis are naturally sweet and exceptionally soft. Golden grains, completely clean without stones or dirt, and free from any chemical polish."
            </p>
          </div>
          <div class="pt-3 border-t border-[#f0f5ee] flex items-center gap-3">
            <img src="/farm/images/wheat-500.jpg" alt="Wheat review photo" class="w-12 h-12 rounded-xl object-cover border border-[#dce7db]" />
            <div>
              <span class="text-[10px] font-extrabold text-[#194622] block">🌾 Farm Wheat (Gehu)</span>
              <span class="text-[10px] text-emerald-700 font-bold">✓ Verified Purchase</span>
            </div>
          </div>
        </div>

        <!-- Review 2 -->
        <div class="bg-white p-6 rounded-3xl border border-[#dce7db] shadow-xs hover:shadow-md transition-shadow space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full bg-[#1b4522] text-white font-extrabold text-xs flex items-center justify-center">
                  D
                </div>
                <div>
                  <strong class="font-extrabold text-xs text-[#122815] block">Devendra Rawat</strong>
                  <span class="text-[10px] text-[#5b6e5d]">📍 Village Sirsod</span>
                </div>
              </div>
              <span class="text-amber-400 font-bold text-sm">★★★★★</span>
            </div>
            <p class="text-xs text-[#4a5f4d] leading-relaxed">
              "Native Sirsod village harvest. Desi kala chana is unpolished and natural. Soaked a handful overnight and healthy long sprouts came out within 24 hours."
            </p>
          </div>
          <div class="pt-3 border-t border-[#f0f5ee] flex items-center gap-3">
            <img src="/farm/images/chana-500.jpg" alt="Chana review photo" class="w-12 h-12 rounded-xl object-cover border border-[#dce7db]" />
            <div>
              <span class="text-[10px] font-extrabold text-[#194622] block">🥣 Raw Chana</span>
              <span class="text-[10px] text-emerald-700 font-bold">✓ Verified Purchase</span>
            </div>
          </div>
        </div>

        <!-- Review 3 -->
        <div class="bg-white p-6 rounded-3xl border border-[#dce7db] shadow-xs hover:shadow-md transition-shadow space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full bg-[#1b4522] text-white font-extrabold text-xs flex items-center justify-center">
                  A
                </div>
                <div>
                  <strong class="font-extrabold text-xs text-[#122815] block">Amit Verma</strong>
                  <span class="text-[10px] text-[#5b6e5d]">📍 Karera (Block)</span>
                </div>
              </div>
              <span class="text-amber-400 font-bold text-sm">★★★★★</span>
            </div>
            <p class="text-xs text-[#4a5f4d] leading-relaxed">
              "Whole green moong is clean with zero stones or dust. Direct village farm delivery reached Karera promptly. Clean harvest shine without synthetic polish."
            </p>
          </div>
          <div class="pt-3 border-t border-[#f0f5ee] flex items-center gap-3">
            <img src="/farm/images/moong-500.jpg" alt="Moong review photo" class="w-12 h-12 rounded-xl object-cover border border-[#dce7db]" />
            <div>
              <span class="text-[10px] font-extrabold text-[#194622] block">🌱 Raw Moong</span>
              <span class="text-[10px] text-emerald-700 font-bold">✓ Verified Purchase</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CLIENT-SIDE CATALOGUE LOADER SCRIPT -->
  <script is:inline>
    async function loadProducts() {
      const loader = document.getElementById('product-grid-loading');
      const grid = document.getElementById('product-grid');
      if (!loader || !grid) return;

      try {
        const res = await fetch('/farm/api/products');
        const data = await res.json();

        if (!data.success || !data.products || data.products.length === 0) {
          loader.innerHTML = '<p class="text-sm text-red-600">No produce currently listed. Please check back soon.</p>';
          return;
        }

        loader.classList.add('hidden');
        grid.classList.remove('hidden');

        grid.innerHTML = data.products.map(p => {
          const isOut = p.isOutOfStock;
          const priceDisplay = p.pricePerKgRupees !== null ? `₹${p.pricePerKgRupees}` : 'Seasonal';
          const defaultPreset = p.quantityOptions[0] || 1;

          const price = p.pricePerKgRupees;
          return `
            <div class="bg-white rounded-2xl border border-[#d6e2d4] overflow-hidden shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between ${isOut ? 'opacity-85' : ''}">
              <div>
                <!-- Top Image Area matching Screenshot -->
                <div class="relative w-full h-48 sm:h-52 bg-[#d7e2d5] flex items-center justify-center overflow-hidden">
                  <!-- Top-left pill: Raw / Unprocessed -->
                  <span class="absolute top-3 left-3 bg-[#243527] text-white text-[11px] font-semibold px-2.5 py-1 rounded-md shadow-xs z-10">
                    ${p.label || (p.isSeasonal ? 'Seasonal Harvest' : 'Raw / Unprocessed')}
                  </span>

                  <!-- Bottom-right pill: Available: 85 kg -->
                  <span class="absolute bottom-3 right-3 bg-white/95 text-[#132215] text-[11px] font-bold px-2.5 py-1 rounded-md shadow-xs border border-black/5 z-10">
                    ${isOut ? 'Sold Out' : `Available: ${p.quantityAvailable !== null ? `${p.quantityAvailable} kg` : 'In Stock'}`}
                  </span>

                  <a href="/farm/products/${p.slug}" class="block w-full h-full relative group">
                    <img
                      src="${p.imageUrl || '/farm/images/wheat-960.jpg'}"
                      alt="${p.name}"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-[#1c3820]/15 flex items-center justify-center p-4">
                      <span class="font-extrabold text-[#194622] text-lg sm:text-xl drop-shadow-sm text-center">
                        ${p.name}
                      </span>
                    </div>
                  </a>

                  ${isOut ? `
                    <div class="absolute inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-20">
                      <span class="px-4 py-1.5 rounded-lg bg-red-600 text-white font-black text-xs uppercase tracking-wider shadow-md">
                        Sold Out
                      </span>
                    </div>
                  ` : ''}
                </div>

                <!-- Product Card Body -->
                <div class="p-4 space-y-2">
                  <!-- Title & Hindi Name Line -->
                  <div class="flex items-center justify-between gap-2">
                    <h2 class="text-base sm:text-lg font-black text-[#132215] truncate">
                      <a href="/farm/products/${p.slug}" class="hover:text-[#194622] transition-colors">
                        ${p.name}
                      </a>
                    </h2>
                    ${p.localName ? `
                      <span class="text-xs sm:text-sm font-bold text-[#8c5324] whitespace-nowrap">
                        ${p.localName}
                      </span>
                    ` : ''}
                  </div>

                  <!-- Description -->
                  <p class="text-xs text-[#526454] line-clamp-2 leading-relaxed">
                    ${p.description}
                  </p>

                  <!-- Dotted Divider Line -->
                  <div class="border-t border-dotted border-[#cbd8c9] pt-2"></div>

                  <!-- Price & Stepper Row -->
                  <div class="flex items-center justify-between gap-2 pt-1">
                    <div class="flex items-baseline gap-1">
                      <span class="text-xl sm:text-2xl font-black text-[#132215]">₹${price}</span>
                      <span class="text-xs font-semibold text-[#667a68]">/ kg</span>
                    </div>

                    ${!isOut ? `
                      <div class="inline-flex items-center border border-[#cbd8c9] rounded-lg overflow-hidden bg-[#f4f7f2]">
                        <button
                          type="button"
                          class="w-8 h-8 flex items-center justify-center text-[#1b4522] hover:bg-[#e4ede1] font-black text-base border-r border-[#cbd8c9] transition-colors select-none"
                          onclick="adjustHomeQty('${p.id}', -1)"
                          aria-label="Decrease quantity"
                        >−</button>
                        <input
                          id="qty-${p.id}"
                          type="text"
                          value="${defaultPreset}"
                          class="w-9 h-8 text-center font-bold text-xs text-[#132215] bg-[#f4f7f2] focus:outline-none select-none"
                          readonly
                        />
                        <button
                          type="button"
                          class="w-8 h-8 flex items-center justify-center text-[#1b4522] hover:bg-[#e4ede1] font-black text-base border-l border-[#cbd8c9] transition-colors select-none"
                          onclick="adjustHomeQty('${p.id}', 1, ${p.quantityAvailable || 100})"
                          aria-label="Increase quantity"
                        >+</button>
                      </div>
                    ` : ''}
                  </div>
                </div>
              </div>

              <!-- Card Action Controls -->
              <div class="p-4 pt-0 space-y-2.5 mt-auto">
                ${!isOut ? `
                  <div class="grid grid-cols-2 gap-2.5">
                    <button
                      type="button"
                      class="w-full py-2.5 px-3 rounded-xl border border-[#1b4522] bg-[#f7faf5] hover:bg-[#ebf4e9] text-[#1b4522] font-bold text-xs sm:text-sm transition-all text-center"
                      onclick="addHomeToCart(${p.id}, '${p.name.replace(/'/g, "\\'")}', ${price})"
                    >
                      Add to Cart
                    </button>
                    <button
                      type="button"
                      class="w-full py-2.5 px-3 rounded-xl bg-[#6d4623] hover:bg-[#5a381a] text-white font-bold text-xs sm:text-sm shadow-xs transition-all text-center"
                      onclick="buyNowHome(${p.id}, '${p.name.replace(/'/g, "\\'")}', ${price})"
                    >
                      Buy Now
                    </button>
                  </div>
                ` : `
                  <button type="button" class="w-full py-2.5 rounded-xl bg-gray-100 text-gray-400 font-bold text-xs cursor-not-allowed" disabled>
                    Currently Out of Stock
                  </button>
                `}

                <a
                  href="/farm/samples?product_id=${p.id}"
                  class="block w-full py-2 px-3 rounded-xl border border-dashed border-[#b8751c] bg-[#fef8f0] hover:bg-[#faeedb] text-center text-[11px] sm:text-xs font-semibold text-[#8c5324] transition-colors"
                >
                  Not sure? Request Free Sample (100g/200g)
                </a>
              </div>
            </div>
          `;
        }).join('');
      } catch (err) {
        loader.innerHTML = '<p class="text-sm text-red-600">Failed to connect to database. Please refresh.</p>';
      }
    }

    window.adjustHomeQty = function(productId, delta, maxAvailable = 999) {
      const input = document.getElementById(`qty-${productId}`);
      if (!input) return;
      let val = (Number(input.value) || 1) + delta;
      if (val < 1) val = 1;
      if (val > maxAvailable) val = maxAvailable;
      input.value = val;
    };

    window.addHomeToCart = function(productId, productName, priceRupees) {
      const input = document.getElementById(`qty-${productId}`);
      const qty = input ? Number(input.value) : 1;

      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (e) { cart = []; }

      const existing = cart.find(it => it.productId === productId);
      if (existing) {
        existing.quantity += qty;
      } else {
        cart.push({
          productId,
          name: productName,
          quantity: qty,
          unit: 'kg',
          estimatedPriceRupees: priceRupees,
        });
      }

      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      if (typeof updateNavCartBadge === 'function') updateNavCartBadge();

      // Modern Toast Notification
      showToast(`Added ${qty} kg ${productName} to your farm cart.`);
    };

    window.buyNowHome = function(productId, productName, priceRupees) {
      addHomeToCart(productId, productName, priceRupees);
      window.location.href = '/farm/checkout';
    };

    function showToast(msg) {
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-2xl bg-[#132215] text-white text-xs font-bold shadow-2xl border border-white/10 animate-bounce flex items-center gap-2';
      toast.innerHTML = `<span>✓</span> <span>${msg}</span>`;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2500);
    }

    document.addEventListener('DOMContentLoaded', loadProducts);
  </script>
</FarmLayout>
