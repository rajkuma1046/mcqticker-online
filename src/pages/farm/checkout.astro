---
import FarmLayout from '../../layouts/FarmLayout.astro';
---

<FarmLayout
  title="Checkout Pre-Order | Farm Direct Gwalior"
  description="Finalize your raw farm produce pre-order with neighbourhood delivery in Gwalior."
  canonicalPath="/farm/checkout"
  hideCartBar={true}
>
  <div class="fd-container py-10 sm:py-16">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-[10px] font-extrabold uppercase tracking-wider mb-2">
          Secure Pre-Order
        </div>
        <h1 class="fd-display text-3xl sm:text-4xl font-extrabold text-[#132215]">
          Finalize Your Pre-Order
        </h1>
        <p class="text-xs sm:text-sm text-[#5b6e5d] mt-1.5 leading-relaxed">
          Produce is threshed from harvest batches and prepared for scheduled cluster delivery in Gwalior. Payment is collected on doorstep delivery.
        </p>
      </div>

      <!-- Checkout Loading Container -->
      <div id="checkout-loading" class="text-center py-20 text-[#5b6e5d]">
        <div class="inline-block animate-spin w-8 h-8 border-4 border-[#194622] border-t-transparent rounded-full mb-3"></div>
        <p class="text-sm font-semibold">Preparing your order summary and verifying live stock...</p>
      </div>

      <!-- Empty Cart Redirection -->
      <div id="checkout-empty" class="hidden text-center py-20 bg-white rounded-3xl border border-[#dce7db] p-8 shadow-xl shadow-emerald-950/[0.03]">
        <div class="text-4xl mb-3">🌾</div>
        <h2 class="fd-display text-2xl font-extrabold text-[#132215] mb-2">No items to checkout</h2>
        <p class="text-xs sm:text-sm text-[#5b6e5d] mb-6">Please add raw farm produce to your cart before proceeding.</p>
        <a href="/farm/products" class="fd-btn fd-btn-primary px-7 py-3.5 font-bold text-sm rounded-xl shadow-md">
          Browse Farm Produce &rarr;
        </a>
      </div>

      <!-- Main Checkout Form & Summary Grid -->
      <div id="checkout-grid" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Customer Details & Address Form (Left) -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Auth Status Banner -->
          <div id="auth-status-box" class="p-4 rounded-2xl bg-[#f7faf5] border border-[#dce7db] flex items-center justify-between text-xs">
            <span id="auth-msg" class="text-[#2d3e30] font-bold">Ordering as Guest</span>
            <a id="auth-link" href="/farm/account/login?redirect=/farm/checkout" class="font-extrabold text-[#194622] hover:underline">
              Log in to use saved addresses &rarr;
            </a>
          </div>

          <form id="order-form" onsubmit="handlePlaceOrder(event)" class="space-y-6">
            <!-- Customer Details Card -->
            <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#dce7db] shadow-xl shadow-emerald-950/[0.03] space-y-4">
              <h3 class="fd-display font-extrabold text-base text-[#132215] pb-3 border-b border-[#edf2eb] flex items-center gap-2">
                <span>👤</span>
                <span>Customer Contact Details</span>
              </h3>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="text-xs font-bold text-[#132215] block mb-1.5">Full Name *</label>
                  <input
                    id="cust-name"
                    type="text"
                    required
                    placeholder="e.g. Ramesh Sharma"
                    class="fd-input"
                  />
                </div>
                <div>
                  <label class="text-xs font-bold text-[#132215] block mb-1.5">WhatsApp Mobile (10 Digits) *</label>
                  <div class="flex">
                    <span class="inline-flex items-center px-3.5 text-xs font-bold bg-[#edf2eb] border border-r-0 border-[#d9e4d5] rounded-l-xl text-[#5b6e5d]">+91</span>
                    <input
                      id="cust-phone"
                      type="tel"
                      required
                      maxlength="10"
                      pattern="[6-9][0-9]{9}"
                      placeholder="10-digit mobile"
                      class="fd-input rounded-l-none"
                    />
                  </div>
                </div>
              </div>

              <div>
                <label class="text-xs font-bold text-[#132215] block mb-1.5">Email Address (Optional)</label>
                <input
                  id="cust-email"
                  type="email"
                  placeholder="For pre-order confirmation copy"
                  class="fd-input"
                />
              </div>
            </div>

            <!-- Delivery Address Card -->
            <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#dce7db] shadow-xl shadow-emerald-950/[0.03] space-y-4">
              <h3 class="fd-display font-extrabold text-base text-[#132215] pb-3 border-b border-[#edf2eb] flex items-center gap-2">
                <span>📍</span>
                <span>Delivery Neighbourhood & Address</span>
              </h3>

              <!-- Saved Addresses Picker (if logged in) -->
              <div id="saved-address-picker" class="hidden space-y-2">
                <label class="text-xs font-bold text-[#132215] block">Use Saved Address</label>
                <select id="saved-addresses-select" class="fd-input font-bold text-xs" onchange="applySavedAddress(this.value)">
                  <option value="">Select a saved address...</option>
                </select>
              </div>

              <!-- Delivery Area Selector -->
              <div>
                <label class="text-xs font-bold text-[#132215] block mb-1.5">Target Neighbourhood Cluster in Gwalior *</label>
                <select id="checkout-area" required class="fd-input font-bold text-xs" onchange="onAreaChanged()">
                  <option value="">Select delivery area...</option>
                </select>
                <p id="area-hint" class="text-[11px] text-[#5b6e5d] mt-1 font-medium"></p>
              </div>

              <!-- Custom Cluster Input for Checkout -->
              <div id="checkout-custom-cluster-box" class="hidden">
                <label class="text-xs font-bold text-[#194622] block mb-1.5 flex items-center gap-1.5">
                  <span>📍</span>
                  <span>Enter Your Custom Gwalior Colony / Neighbourhood *</span>
                </label>
                <input
                  id="checkout-custom-cluster"
                  type="text"
                  placeholder="e.g. Thatipur, City Center, Morar, Lashkar, Hazira, etc."
                  class="fd-input border-emerald-600 bg-emerald-50/40 text-xs font-bold"
                  oninput="onCustomClusterInput()"
                />
                <p class="text-[10px] text-[#5b6e5d] mt-1">
                  🌾 Direct doorstep farm dispatch will be scheduled for your colony!
                </p>
              </div>

              <!-- Address Fields -->
              <div>
                <label class="text-xs font-bold text-[#132215] block mb-1.5">House / Flat No. & Building Name *</label>
                <input
                  id="cust-house"
                  type="text"
                  required
                  placeholder="e.g. Flat 204, Shanti Apartments"
                  class="fd-input"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="text-xs font-bold text-[#132215] block mb-1.5">Street / Colony *</label>
                  <input
                    id="cust-street"
                    type="text"
                    required
                    placeholder="e.g. Lane 3, Near Water Tank"
                    class="fd-input"
                  />
                </div>
                <div>
                  <label class="text-xs font-bold text-[#132215] block mb-1.5">Landmark (Optional)</label>
                  <input
                    id="cust-landmark"
                    type="text"
                    placeholder="e.g. Opposite Shiv Temple"
                    class="fd-input"
                  />
                </div>
              </div>

              <div>
                <label class="text-xs font-bold text-[#132215] block mb-1.5">Delivery Instructions / Colony Notes</label>
                <textarea
                  id="cust-notes"
                  rows="2"
                  placeholder="e.g. Please call before vehicle arrival on Sunday morning"
                  class="fd-input"
                ></textarea>
              </div>
            </div>

            <!-- Payment Method Card -->
            <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#dce7db] shadow-xl shadow-emerald-950/[0.03] space-y-3">
              <h3 class="fd-display font-extrabold text-base text-[#132215] pb-3 border-b border-[#edf2eb] flex items-center gap-2">
                <span>💵</span>
                <span>Payment Method</span>
              </h3>
              <div class="p-4 rounded-2xl border-2 border-[#194622] bg-[#eaf4ec] flex items-center justify-between">
                <div>
                  <strong class="text-sm font-extrabold text-[#132215] block">Payment on Delivery (Cash or Direct UPI Scan)</strong>
                  <span class="text-xs text-[#5b6e5d] mt-0.5 block">Pay cash or scan QR when your fresh grain bag arrives at your doorstep.</span>
                </div>
                <div class="w-8 h-8 rounded-full bg-[#194622] text-white flex items-center justify-center font-bold text-sm shadow-xs">
                  ✓
                </div>
              </div>
            </div>

            <!-- Error Banner -->
            <div id="checkout-error" class="hidden p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs sm:text-sm font-bold"></div>

            <!-- Submit Button (Mobile & Desktop) -->
            <button
              id="btn-submit-order"
              type="submit"
              class="fd-btn fd-btn-primary w-full py-4 text-base font-extrabold rounded-2xl shadow-xl shadow-emerald-950/20 hover:shadow-2xl hover:shadow-emerald-950/30 flex items-center justify-center gap-2"
            >
              <span>CONFIRM & PLACE PRE-ORDER</span>
              <span>&rarr;</span>
            </button>
            <p class="text-[11px] text-[#748776] text-center">
              🔒 Authoritative Cloudflare D1 verification. Instant WhatsApp order slip generated upon submission.
            </p>
          </form>
        </div>

        <!-- Order Items Summary Column (Right) -->
        <div class="lg:col-span-5">
          <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#dce7db] shadow-xl shadow-emerald-950/[0.04] space-y-5 sticky top-24">
            <h3 class="fd-display font-extrabold text-lg text-[#132215] pb-3 border-b border-[#edf2eb]">
              Pre-Order Summary
            </h3>

            <!-- Item List -->
            <div id="checkout-items-list" class="space-y-3 max-h-72 overflow-y-auto pr-1"></div>

            <!-- Totals Breakdown -->
            <div class="space-y-2.5 text-xs text-[#5b6e5d] pt-3 border-t border-[#edf2eb]">
              <div class="flex justify-between">
                <span>Produce Subtotal:</span>
                <strong id="chk-subtotal" class="text-[#132215] font-extrabold text-sm">₹0</strong>
              </div>
              <div class="flex justify-between">
                <span>Neighbourhood Transport:</span>
                <strong id="chk-delivery" class="text-[#132215] font-bold">Select area</strong>
              </div>
              <div class="border-t border-[#edf2eb] pt-3 flex justify-between items-baseline text-sm">
                <span class="font-extrabold text-[#132215]">Grand Total:</span>
                <strong id="chk-grand-total" class="text-2xl font-extrabold text-[#194622]">₹0</strong>
              </div>
            </div>

            <!-- Delivery Round Info -->
            <div class="p-3.5 rounded-2xl bg-[#f7faf5] border border-[#dce7db] text-xs text-[#5b6e5d] space-y-1">
              <div class="font-bold text-[#132215] flex items-center gap-1.5">
                <span>🚚</span>
                <span id="chk-round-title">Scheduled Delivery Round</span>
              </div>
              <p class="text-[11px] text-[#748776]" id="chk-round-desc">
                Orders are consolidated by neighbourhood. Produce will be delivered during the upcoming scheduled trip.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    let deliveryAreas = [];
    let savedAddresses = [];
    let currentUser = null;
    let validatedData = null;

    async function initCheckout() {
      const loader = document.getElementById('checkout-loading');
      const empty = document.getElementById('checkout-empty');
      const grid = document.getElementById('checkout-grid');

      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      if (!cart || cart.length === 0) {
        loader.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }

      // Check user session
      try {
        const meRes = await fetch('/farm/api/auth/me');
        const meData = await meRes.json();
        if (meData.success && meData.user) {
          currentUser = meData.user;
          savedAddresses = meData.addresses || [];

          document.getElementById('cust-name').value = currentUser.name || '';
          document.getElementById('cust-phone').value = currentUser.phone || '';
          document.getElementById('cust-email').value = currentUser.email || '';

          document.getElementById('auth-msg').textContent = `Logged in as ${currentUser.name} (${currentUser.phone})`;
          document.getElementById('auth-link').textContent = 'My Account';
          document.getElementById('auth-link').href = '/farm/account';

          if (savedAddresses.length > 0) {
            const picker = document.getElementById('saved-address-picker');
            const select = document.getElementById('saved-addresses-select');
            picker.classList.remove('hidden');
            select.innerHTML = '<option value="">Select a saved address...</option>' +
              savedAddresses.map(a => `
                <option value="${a.id}">${a.fullName} — ${a.houseNumber}, ${a.street} (${a.deliveryAreaName})</option>
              `).join('');

            const def = savedAddresses.find(a => a.isDefault) || savedAddresses[0];
            if (def) { select.value = def.id; applySavedAddress(def.id); }
          }
        }
      } catch (_) {}

      // Fetch delivery areas
      try {
        const areaRes = await fetch('/farm/api/delivery-areas');
        const areaData = await areaRes.json();
        if (areaData.success && areaData.deliveryAreas) {
          deliveryAreas = areaData.deliveryAreas;
          const select = document.getElementById('checkout-area');
          select.innerHTML = '<option value="">Select delivery area...</option>' +
            deliveryAreas.map(a => `
              <option value="${a.id}">${a.name} (Delivery: ₹${a.deliveryChargeRupees})</option>
            `).join('') +
            '<option value="custom">📍 + Other / Custom Gwalior Colony (Enter Name)</option>';

          const storedAreaId = localStorage.getItem('fd_selected_area_id');
          if (storedAreaId && (deliveryAreas.some(a => a.id == storedAreaId) || storedAreaId === 'custom')) {
            select.value = storedAreaId;
          }
        }
      } catch (_) {}

      await revalidateCart();
      loader.classList.add('hidden');
      grid.classList.remove('hidden');
    }

    async function revalidateCart() {
      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      const areaVal = document.getElementById('checkout-area')?.value || null;
      const isCustomArea = areaVal === 'custom';
      const customName = document.getElementById('checkout-custom-cluster')?.value || '';

      const res = await fetch('/farm/api/cart/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cart.map(it => ({ product_id: it.productId, quantity: it.quantity })),
          delivery_area_id: isCustomArea ? 'custom' : (areaVal ? Number(areaVal) : null),
          custom_delivery_area: isCustomArea ? customName : undefined,
        }),
      });

      const data = await res.json();
      if (!data.success) {
        alert(data.error || 'Cart validation error.');
        return;
      }

      validatedData = data;
      renderCheckoutSummary(data);
    }

    function renderCheckoutSummary(data) {
      const list = document.getElementById('checkout-items-list');
      list.innerHTML = data.items.map(it => `
        <div class="flex items-center justify-between text-xs py-2.5 border-b border-[#edf2eb]">
          <div>
            <strong class="font-extrabold text-[#132215] text-sm">${it.productName}</strong>
            <div class="text-[#5b6e5d] mt-0.5">${it.quantity} kg × ₹${it.priceRupees}</div>
          </div>
          <strong class="font-extrabold text-[#194622] text-sm">₹${it.lineTotalRupees}</strong>
        </div>
      `).join('');

      document.getElementById('chk-subtotal').textContent = `₹${data.subtotalRupees}`;
      const delEl = document.getElementById('chk-delivery');
      if (data.deliveryArea) {
        delEl.textContent = `₹${data.deliveryChargeRupees}`;
        document.getElementById('chk-round-title').textContent = `Cluster: ${data.deliveryArea.name}`;
        document.getElementById('chk-round-desc').textContent = `Scheduled vehicle dispatch: ${data.deliveryArea.deliveryDay}. Payment collected on delivery.`;
      } else {
        delEl.textContent = 'Select area';
      }

      document.getElementById('chk-grand-total').textContent = `₹${data.grandTotalRupees}`;
    }

    window.onAreaChanged = function() {
      const areaId = document.getElementById('checkout-area').value;
      const customBox = document.getElementById('checkout-custom-cluster-box');
      const customInput = document.getElementById('checkout-custom-cluster');

      if (areaId === 'custom') {
        customBox.classList.remove('hidden');
        customInput.focus();
        document.getElementById('area-hint').textContent = 'Custom colony pre-order. We consolidate and dispatch direct to your area!';
      } else {
        customBox.classList.add('hidden');
        if (areaId) {
          localStorage.setItem('fd_selected_area_id', areaId);
          const area = deliveryAreas.find(a => a.id == areaId);
          if (area) {
            document.getElementById('area-hint').textContent = `Scheduled dispatch: ${area.deliveryDay} morning. Minimum order: ₹${area.minimumOrderRupees}`;
          }
        }
      }
      revalidateCart();
    };

    window.onCustomClusterInput = function() {
      revalidateCart();
    };

    window.applySavedAddress = function(id) {
      const addr = savedAddresses.find(a => a.id == id);
      if (!addr) return;
      document.getElementById('cust-name').value = addr.fullName;
      document.getElementById('cust-phone').value = addr.phone;
      document.getElementById('cust-house').value = addr.houseNumber;
      document.getElementById('cust-street').value = addr.street;
      document.getElementById('cust-landmark').value = addr.landmark || '';
      document.getElementById('cust-notes').value = addr.deliveryInstructions || '';
      if (addr.deliveryAreaId) {
        document.getElementById('checkout-area').value = addr.deliveryAreaId;
        onAreaChanged();
      }
    };

    window.handlePlaceOrder = async function(e) {
      e.preventDefault();
      const errBox = document.getElementById('checkout-error');
      const submitBtn = document.getElementById('btn-submit-order');

      errBox.classList.add('hidden');
      errBox.textContent = '';

      const name = document.getElementById('cust-name').value.trim();
      const phone = document.getElementById('cust-phone').value.trim();
      const email = document.getElementById('cust-email').value.trim();
      const areaId = document.getElementById('checkout-area').value;
      const isCustomArea = areaId === 'custom';
      const customInput = document.getElementById('checkout-custom-cluster');
      const customCluster = isCustomArea ? (customInput ? customInput.value.trim() : '') : '';
      const house = document.getElementById('cust-house').value.trim();
      const street = document.getElementById('cust-street').value.trim();
      const landmark = document.getElementById('cust-landmark').value.trim();
      const note = document.getElementById('cust-notes').value.trim();

      if (!areaId) {
        errBox.textContent = 'Please select your delivery neighbourhood cluster in Gwalior.';
        errBox.classList.remove('hidden');
        return;
      }

      if (isCustomArea && !customCluster) {
        errBox.textContent = 'Please enter your custom colony or neighbourhood name in Gwalior.';
        errBox.classList.remove('hidden');
        if (customInput) customInput.focus();
        return;
      }

      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      if (cart.length === 0) {
        errBox.textContent = 'Your cart is empty.';
        errBox.classList.remove('hidden');
        return;
      }

      const fullAddress = `${house}, ${street}${landmark ? ` (Landmark: ${landmark})` : ''}, Gwalior`;

      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span class="inline-block animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full mr-2"></span>
        Securing Inventory & Batching Pre-Order...
      `;

      try {
        const res = await fetch('/farm/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            customer_name: name,
            customer_phone: phone,
            customer_email: email,
            delivery_area_id: isCustomArea ? 'custom' : Number(areaId),
            custom_delivery_area: customCluster || undefined,
            delivery_address: fullAddress,
            customer_note: note,
            items: cart.map(it => ({ product_id: it.productId, quantity: it.quantity })),
          }),
        });

        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'Failed to place order. Please review.';
          errBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'CONFIRM & PLACE PRE-ORDER →';
          return;
        }

        // Order placed successfully!
        localStorage.removeItem('fd_cart_v1');
        if (window.updateNavCartBadge) window.updateNavCartBadge();

        sessionStorage.setItem('fd_latest_order', JSON.stringify(data.order));
        window.location.href = `/farm/order-confirmation?order_number=${data.order.orderNumber}`;
      } catch (err) {
        errBox.textContent = 'Network or server error. Please try again.';
        errBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'CONFIRM & PLACE PRE-ORDER →';
      }
    };

    document.addEventListener('DOMContentLoaded', initCheckout);
  </script>
</FarmLayout>
