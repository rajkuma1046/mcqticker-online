---
import FarmLayout from '../../layouts/FarmLayout.astro';
---

<FarmLayout
  title="Checkout Pre-Order | Farm Direct Gwalior"
  description="Finalize your raw farm produce pre-order with neighbourhood delivery in Gwalior."
  canonicalPath="/farm/checkout"
  hideCartBar={true}
>
  <div class="fd-container py-8 sm:py-14">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <span class="text-xs uppercase tracking-wider text-[#275629] font-bold">Secure Farm Pre-Order</span>
        <h1 class="fd-serif text-3xl sm:text-4xl font-bold text-[#152317] mt-1">
          Checkout
        </h1>
        <p class="text-xs sm:text-sm text-[#536354] mt-1.5">
          Produce is harvested and prepared for scheduled neighbourhood delivery in Gwalior. Payment is collected on delivery.
        </p>
      </div>

      <!-- Checkout Container -->
      <div id="checkout-loading" class="text-center py-20 text-[#536354]">
        <div class="inline-block animate-spin w-8 h-8 border-4 border-[#275629] border-t-transparent rounded-full mb-3"></div>
        <p class="text-sm font-semibold">Preparing your order summary and verifying live stock...</p>
      </div>

      <!-- Empty Cart Redirection -->
      <div id="checkout-empty" class="hidden text-center py-16 bg-white rounded-2xl border border-[#e0e8dc] p-8 shadow-sm">
        <h2 class="fd-serif text-2xl font-bold text-[#152317] mb-2">No items to checkout</h2>
        <p class="text-sm text-[#536354] mb-6">Please add raw farm produce to your cart before proceeding.</p>
        <a href="/farm/products" class="fd-btn fd-btn-primary px-6 py-3 font-bold text-sm shadow-sm">
          Browse Farm Produce &rarr;
        </a>
      </div>

      <!-- Main Checkout Form & Summary Grid -->
      <div id="checkout-grid" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Customer Details & Address Form (Left) -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Auth Status Banner -->
          <div id="auth-status-box" class="p-4 rounded-xl bg-[#f0f4ee] border border-[#e0e8dc] flex items-center justify-between text-xs">
            <span id="auth-msg" class="text-[#2d3a2e] font-medium">Ordering as Guest</span>
            <a id="auth-link" href="/farm/account/login?redirect=/farm/checkout" class="font-bold text-[#275629] hover:underline">
              Log in to use saved addresses &rarr;
            </a>
          </div>

          <form id="order-form" onsubmit="handlePlaceOrder(event)" class="space-y-6">
            <!-- Customer Details Card -->
            <div class="bg-white p-6 rounded-2xl border border-[#e0e8dc] shadow-sm space-y-4">
              <h3 class="font-bold text-base text-[#152317] pb-3 border-b border-[#f0f4ee] flex items-center gap-2">
                <span>👤</span>
                <span>Customer Contact</span>
              </h3>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-1">Full Name *</label>
                  <input
                    id="cust-name"
                    type="text"
                    required
                    placeholder="e.g. Ramesh Sharma"
                    class="w-full text-xs font-semibold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
                  />
                </div>
                <div>
                  <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-1">Mobile Number (WhatsApp) *</label>
                  <div class="flex">
                    <span class="inline-flex items-center px-3 text-xs font-bold bg-[#f0f4ee] border border-r-0 border-[#d0ded0] rounded-l-lg text-[#536354]">+91</span>
                    <input
                      id="cust-phone"
                      type="tel"
                      required
                      maxlength="10"
                      pattern="[6-9][0-9]{9}"
                      placeholder="10-digit mobile"
                      class="w-full text-xs font-semibold p-3 rounded-r-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
                    />
                  </div>
                </div>
              </div>

              <div>
                <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-1">Email Address (Optional)</label>
                <input
                  id="cust-email"
                  type="email"
                  placeholder="For pre-order receipt"
                  class="w-full text-xs font-semibold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
                />
              </div>
            </div>

            <!-- Delivery Address Card -->
            <div class="bg-white p-6 rounded-2xl border border-[#e0e8dc] shadow-sm space-y-4">
              <h3 class="font-bold text-base text-[#152317] pb-3 border-b border-[#f0f4ee] flex items-center gap-2">
                <span>📍</span>
                <span>Delivery Neighbourhood & Address</span>
              </h3>

              <!-- Saved Addresses Picker (if logged in) -->
              <div id="saved-address-picker" class="hidden space-y-2">
                <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block">Use Saved Address</label>
                <select id="saved-addresses-select" class="w-full text-xs font-semibold p-2.5 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]" onchange="applySavedAddress(this.value)">
                  <option value="">Select a saved address...</option>
                </select>
              </div>

              <!-- Delivery Area Selector -->
              <div>
                <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-1">Target Neighbourhood Cluster in Gwalior *</label>
                <select id="checkout-area" required class="w-full text-xs font-bold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]" onchange="onAreaChanged()">
                  <option value="">Select delivery area...</option>
                </select>
                <p id="area-hint" class="text-[11px] text-[#536354] mt-1"></p>
              </div>

              <!-- Address Fields -->
              <div>
                <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-1">House / Flat No. & Building Name *</label>
                <input
                  id="cust-house"
                  type="text"
                  required
                  placeholder="e.g. Flat 204, Shanti Apartments"
                  class="w-full text-xs font-semibold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-1">Street / Colony *</label>
                  <input
                    id="cust-street"
                    type="text"
                    required
                    placeholder="e.g. Lane 3, Near Water Tank"
                    class="w-full text-xs font-semibold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
                  />
                </div>
                <div>
                  <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-1">Landmark (Optional)</label>
                  <input
                    id="cust-landmark"
                    type="text"
                    placeholder="e.g. Opposite Shiv Temple"
                    class="w-full text-xs font-semibold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
                  />
                </div>
              </div>

              <div>
                <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-1">Delivery Instructions or Notes</label>
                <textarea
                  id="cust-notes"
                  rows="2"
                  placeholder="e.g. Please call before arriving on delivery day"
                  class="w-full text-xs font-semibold p-3 rounded-lg border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
                ></textarea>
              </div>
            </div>

            <!-- Payment Method Card -->
            <div class="bg-white p-6 rounded-2xl border border-[#e0e8dc] shadow-sm space-y-3">
              <h3 class="font-bold text-base text-[#152317] pb-3 border-b border-[#f0f4ee] flex items-center gap-2">
                <span>💵</span>
                <span>Payment Method</span>
              </h3>
              <div class="p-4 rounded-xl border-2 border-[#275629] bg-[#eaf3e9] flex items-center justify-between">
                <div>
                  <strong class="text-xs sm:text-sm font-bold text-[#152317] block">Payment on Delivery / UPI on Delivery</strong>
                  <span class="text-[11px] text-[#536354]">Pay by cash or scan QR when your harvest batch is delivered.</span>
                </div>
                <span class="text-base font-bold text-[#275629]">✓</span>
              </div>
            </div>

            <!-- Error Banner -->
            <div id="checkout-error" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs sm:text-sm font-semibold"></div>

            <!-- Submit Button (Mobile & Desktop) -->
            <button
              id="btn-submit-order"
              type="submit"
              class="fd-btn fd-btn-primary w-full py-4 text-base font-bold shadow-lg flex items-center justify-center gap-2"
            >
              <span>PLACE FINAL PRE-ORDER</span>
              <span>&rarr;</span>
            </button>
          </form>
        </div>

        <!-- Order Items Summary Column (Right) -->
        <div class="lg:col-span-5">
          <div class="bg-white p-6 rounded-2xl border border-[#e0e8dc] shadow-sm space-y-5 sticky top-24">
            <h3 class="font-bold text-base text-[#152317] pb-3 border-b border-[#f0f4ee]">
              Order Summary
            </h3>

            <!-- Item List -->
            <div id="checkout-items-list" class="space-y-3 max-h-72 overflow-y-auto pr-1"></div>

            <!-- Totals Breakdown -->
            <div class="space-y-2 text-xs text-[#536354] pt-3 border-t border-[#f0f4ee]">
              <div class="flex justify-between">
                <span>Produce Subtotal:</span>
                <strong id="chk-subtotal" class="text-[#1a251b] font-bold text-sm">₹0</strong>
              </div>
              <div class="flex justify-between">
                <span>Neighbourhood Delivery:</span>
                <strong id="chk-delivery" class="text-[#1a251b] font-bold">Select area</strong>
              </div>
              <div class="border-t border-[#f0f4ee] pt-3 flex justify-between items-baseline text-sm">
                <span class="font-bold text-[#152317]">Grand Total:</span>
                <strong id="chk-grand-total" class="text-2xl font-bold text-[#275629]">₹0</strong>
              </div>
            </div>

            <!-- Delivery Round Info -->
            <div class="p-3 rounded-lg bg-[#f0f4ee] border border-[#e0e8dc] text-xs text-[#536354] space-y-1">
              <div class="font-bold text-[#152317] flex items-center gap-1.5">
                <span>🚚</span>
                <span id="chk-round-title">Scheduled Delivery Round</span>
              </div>
              <p class="text-[11px]" id="chk-round-desc">
                Orders are consolidated by locality. Produce will be delivered during the upcoming scheduled trip.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    let deliveryAreas = [];
    let savedAddresses = [];
    let currentUser = null;
    let validatedData = null;

    async function initCheckout() {
      const loader = document.getElementById('checkout-loading');
      const empty = document.getElementById('checkout-empty');
      const grid = document.getElementById('checkout-grid');

      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      if (!cart || cart.length === 0) {
        loader.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }

      // Check user session
      try {
        const meRes = await fetch('/farm/api/auth/me');
        const meData = await meRes.json();
        if (meData.success && meData.user) {
          currentUser = meData.user;
          savedAddresses = meData.addresses || [];

          // Prefill
          document.getElementById('cust-name').value = currentUser.name || '';
          document.getElementById('cust-phone').value = currentUser.phone || '';
          document.getElementById('cust-email').value = currentUser.email || '';

          document.getElementById('auth-msg').textContent = `Logged in as ${currentUser.name} (${currentUser.phone})`;
          document.getElementById('auth-link').textContent = 'My Account';
          document.getElementById('auth-link').href = '/farm/account';

          // Show saved addresses picker if any exist
          if (savedAddresses.length > 0) {
            const picker = document.getElementById('saved-address-picker');
            const select = document.getElementById('saved-addresses-select');
            picker.classList.remove('hidden');
            select.innerHTML = '<option value="">Select a saved address...</option>' +
              savedAddresses.map(a => `
                <option value="${a.id}">${a.fullName} — ${a.houseNumber}, ${a.street} (${a.deliveryAreaName})</option>
              `).join('');

            // If default address, apply it
            const def = savedAddresses.find(a => a.isDefault) || savedAddresses[0];
            if (def) select.value = def.id; applySavedAddress(def.id);
          }
        }
      } catch (_) {}

      // Fetch delivery areas
      try {
        const areaRes = await fetch('/farm/api/delivery-areas');
        const areaData = await areaRes.json();
        if (areaData.success && areaData.deliveryAreas) {
          deliveryAreas = areaData.deliveryAreas;
          const select = document.getElementById('checkout-area');
          select.innerHTML = '<option value="">Select delivery area...</option>' +
            deliveryAreas.map(a => `
              <option value="${a.id}">${a.name} (Delivery: ₹${a.deliveryChargeRupees})</option>
            `).join('');

          // Auto-select from local storage
          const storedAreaId = localStorage.getItem('fd_selected_area_id');
          if (storedAreaId && deliveryAreas.some(a => a.id == storedAreaId)) {
            select.value = storedAreaId;
          }
        }
      } catch (_) {}

      // Validate cart
      await revalidateCart();
      loader.classList.add('hidden');
      grid.classList.remove('hidden');
    }

    async function revalidateCart() {
      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      const areaId = document.getElementById('checkout-area')?.value || null;

      const res = await fetch('/farm/api/cart/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cart.map(it => ({ product_id: it.productId, quantity: it.quantity })),
          delivery_area_id: areaId ? Number(areaId) : null,
        }),
      });

      const data = await res.json();
      if (!data.success) {
        alert(data.error || 'Cart validation error.');
        return;
      }

      validatedData = data;
      renderCheckoutSummary(data);
    }

    function renderCheckoutSummary(data) {
      const list = document.getElementById('checkout-items-list');
      list.innerHTML = data.items.map(it => `
        <div class="flex items-center justify-between text-xs py-2 border-b border-[#f0f4ee]">
          <div>
            <strong class="font-bold text-[#152317]">${it.productName}</strong>
            <div class="text-[#536354] mt-0.5">${it.quantity} kg × ₹${it.priceRupees}</div>
          </div>
          <strong class="font-bold text-[#275629]">₹${it.lineTotalRupees}</strong>
        </div>
      `).join('');

      document.getElementById('chk-subtotal').textContent = `₹${data.subtotalRupees}`;
      const delEl = document.getElementById('chk-delivery');
      if (data.deliveryArea) {
        delEl.textContent = `₹${data.deliveryChargeRupees}`;
        document.getElementById('chk-round-title').textContent = `Scheduled Round: ${data.deliveryArea.name}`;
      } else {
        delEl.textContent = 'Select area';
      }

      document.getElementById('chk-grand-total').textContent = `₹${data.grandTotalRupees}`;
    }

    window.onAreaChanged = function() {
      const areaId = document.getElementById('checkout-area').value;
      if (areaId) {
        localStorage.setItem('fd_selected_area_id', areaId);
        const area = deliveryAreas.find(a => a.id == areaId);
        if (area) {
          document.getElementById('area-hint').textContent = `Delivery day: ${area.deliveryDay}. Minimum order: ₹${area.minimumOrderRupees}`;
        }
      }
      revalidateCart();
    };

    window.applySavedAddress = function(id) {
      const addr = savedAddresses.find(a => a.id == id);
      if (!addr) return;
      document.getElementById('cust-name').value = addr.fullName;
      document.getElementById('cust-phone').value = addr.phone;
      document.getElementById('cust-house').value = addr.houseNumber;
      document.getElementById('cust-street').value = addr.street;
      document.getElementById('cust-landmark').value = addr.landmark || '';
      document.getElementById('cust-notes').value = addr.deliveryInstructions || '';
      if (addr.deliveryAreaId) {
        document.getElementById('checkout-area').value = addr.deliveryAreaId;
        onAreaChanged();
      }
    };

    window.handlePlaceOrder = async function(e) {
      e.preventDefault();
      const errBox = document.getElementById('checkout-error');
      const submitBtn = document.getElementById('btn-submit-order');

      errBox.classList.add('hidden');
      errBox.textContent = '';

      const name = document.getElementById('cust-name').value.trim();
      const phone = document.getElementById('cust-phone').value.trim();
      const email = document.getElementById('cust-email').value.trim();
      const areaId = document.getElementById('checkout-area').value;
      const house = document.getElementById('cust-house').value.trim();
      const street = document.getElementById('cust-street').value.trim();
      const landmark = document.getElementById('cust-landmark').value.trim();
      const note = document.getElementById('cust-notes').value.trim();

      if (!areaId) {
        errBox.textContent = 'Please select your delivery neighbourhood in Gwalior.';
        errBox.classList.remove('hidden');
        return;
      }

      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      if (cart.length === 0) {
        errBox.textContent = 'Your cart is empty.';
        errBox.classList.remove('hidden');
        return;
      }

      const fullAddress = `${house}, ${street}${landmark ? ` (Landmark: ${landmark})` : ''}, Gwalior`;

      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span class="inline-block animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full mr-2"></span>
        Processing Pre-Order...
      `;

      try {
        const res = await fetch('/farm/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            customer_name: name,
            customer_phone: phone,
            customer_email: email,
            delivery_area_id: Number(areaId),
            delivery_address: fullAddress,
            customer_note: note,
            items: cart.map(it => ({ product_id: it.productId, quantity: it.quantity })),
          }),
        });

        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'Failed to place order. Please review.';
          errBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'PLACE FINAL PRE-ORDER →';
          return;
        }

        // Order placed successfully!
        // Clear cart
        localStorage.removeItem('fd_cart_v1');
        if (window.fdUpdateCart) window.fdUpdateCart();

        // Save order details to sessionStorage for the confirmation page
        sessionStorage.setItem('fd_latest_order', JSON.stringify(data.order));

        // Redirect to confirmation
        window.location.href = `/farm/order-confirmation?order_number=${data.order.orderNumber}`;
      } catch (err) {
        errBox.textContent = 'Network or server error. Please try again.';
        errBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'PLACE FINAL PRE-ORDER →';
      }
    };

    document.addEventListener('DOMContentLoaded', initCheckout);
  </script>
</FarmLayout>
