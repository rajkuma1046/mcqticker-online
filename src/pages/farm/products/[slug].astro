  <script is:inline define:vars={{ slug }}>
    const pathParts = window.location.pathname.replace(/\/+$/, '').split('/');
    const pathSlug = pathParts[pathParts.length - 1];
    const activeSlug = slug || pathSlug;
    let currentProduct = null;

    window.selectGalleryImage = function(url, btn) {
      const mainImg = document.getElementById('p-image');
      if (mainImg) mainImg.src = url;
      document.querySelectorAll('#p-gallery-thumbs .thumb-btn').forEach(b => {
        b.className = 'thumb-btn w-16 h-16 rounded-xl overflow-hidden border-2 transition-all shrink-0 border-[#dce7db] opacity-70 hover:opacity-100 cursor-pointer';
      });
      if (btn) {
        btn.className = 'thumb-btn w-16 h-16 rounded-xl overflow-hidden border-2 transition-all shrink-0 border-emerald-600 ring-2 ring-emerald-300 cursor-pointer';
      }
    };

    async function fetchProduct() {
      const loader = document.getElementById('product-loading');
      const content = document.getElementById('product-content');

      try {
        const res = await fetch(`/farm/api/products/${activeSlug}`);
        const data = await res.json();

        if (!data.success || !data.product) {
          loader.innerHTML = '<p class="text-sm text-red-600 font-semibold">Product not found. <a href="/farm/products" class="underline">View all produce</a></p>';
          return;
        }

        currentProduct = data.product;
        loader.classList.add('hidden');
        content.classList.remove('hidden');

        // Populate fields
        const displayName = currentProduct.localName ? `${currentProduct.localName} (${currentProduct.name})` : currentProduct.name;
        document.title = `${displayName} | फार्म डायरेक्ट ग्वालियर`;
        document.getElementById('breadcrumb-title').textContent = currentProduct.localName || currentProduct.name;
        document.getElementById('p-name').textContent = displayName;
        document.getElementById('p-desc').textContent = currentProduct.description;

        const catEl = document.getElementById('p-category');
        if (catEl && currentProduct.category) {
          catEl.textContent = (currentProduct.category.charAt(0).toUpperCase() + currentProduct.category.slice(1)) + ' • खेत की उपज';
        }

        document.getElementById('p-image').src = currentProduct.imageUrl || '/farm/images/wheat-960.jpg';
        document.getElementById('p-image').alt = currentProduct.imageAlt || currentProduct.name;

        // Render gallery thumbnails if multiple images
        const thumbsContainer = document.getElementById('p-gallery-thumbs');
        const images = (Array.isArray(currentProduct.images) && currentProduct.images.length > 0)
          ? currentProduct.images
          : (currentProduct.imageUrl ? [currentProduct.imageUrl] : []);

        if (images.length > 1) {
          thumbsContainer.innerHTML = images.map((img, idx) => `
            <button
              type="button"
              onclick="selectGalleryImage('${img}', this)"
              class="thumb-btn w-16 h-16 rounded-xl overflow-hidden border-2 transition-all shrink-0 cursor-pointer ${idx === 0 ? 'border-emerald-600 ring-2 ring-emerald-300' : 'border-[#dce7db] opacity-70 hover:opacity-100'}"
            >
              <img src="${img}" alt="${currentProduct.name}" class="w-full h-full object-cover" />
            </button>
          `).join('');
          thumbsContainer.classList.remove('hidden');
        } else {
          thumbsContainer.classList.add('hidden');
