---
import FarmLayout from '../../../layouts/FarmLayout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'farm-wheat' } },
    { params: { slug: 'raw-groundnut' } },
    { params: { slug: 'raw-chana' } },
    { params: { slug: 'raw-moong' } },
    { params: { slug: 'raw-urad' } },
    { params: { slug: 'sweet-lime' } },
    { params: { slug: 'guava' } },
    { params: { slug: 'seasonal-farm-produce' } },
  ];
}

const { slug } = Astro.params;

const PRODUCT_SEO_DATA: Record<string, {
  name: string;
  localName: string;
  description: string;
  image: string;
  price: string;
  rating: string;
  reviewCount: string;
  category: string;
}> = {
  'farm-wheat': {
    name: 'शरबती गेहूँ (Desi Sharbati Wheat)',
    localName: 'शरबती गेहूँ',
    description: 'ग्वालियर, शिवपुरी, करैरा और सिरसौद में सीधे खेत से 100% शुद्ध, बिना पॉलिश का देशी शरबती गेहूँ। नरम मीठी रोटियों के लिए सर्वोत्तम।',
    image: '/farm/images/wheat-960.jpg',
    price: '28',
    rating: '4.9',
    reviewCount: '18',
    category: 'अनाज (Grains)'
  },
  'raw-groundnut': {
    name: 'कच्ची मूँगफली (Raw Farm Groundnut)',
    localName: 'कच्ची मूँगफली',
    description: 'खेत से ताज़ा चुनी गई साबुत मूँगफली। भरपूर तेल व प्राकृतिक मिठास, बिना किसी केमिकल वॉश के।',
    image: '/farm/images/groundnut-960.jpg',
    price: '75',
    rating: '4.8',
    reviewCount: '12',
    category: 'तिलहन (Oilseeds)'
  },
  'raw-chana': {
    name: 'देशी चना (Desi Brown Chana)',
    localName: 'देशी चना',
    description: 'सिरसौद-करैरा क्षेत्र का शुद्ध देशी छोटा चना। अंकुरण व दाल हेतु 100% प्राकृतिक व बिना पॉलिश।',
    image: '/farm/images/chana-960.jpg',
    price: '68',
    rating: '4.9',
    reviewCount: '14',
    category: 'दालें (Pulses)'
  },
  'raw-moong': {
    name: 'साबुत हरी मूँग (Raw Green Moong)',
    localName: 'साबुत मूँग',
    description: 'खेत की ताज़ा साबुत मूँग दाल। 24 घंटे में तेज़ी से अंकुरित होने वाली, बिना पॉलिश व पौष्टिक।',
    image: '/farm/images/moong-960.jpg',
    price: '110',
    rating: '5.0',
    reviewCount: '9',
    category: 'दालें (Pulses)'
  },
  'raw-urad': {
    name: 'देशी काली उड़द (Raw Black Urad)',
    localName: 'काली उड़द',
    description: 'बुंदेलखंड की शुद्ध देशी काली उड़द दाल। खिचड़ी, पापड़ व दाल मखनी के लिए पारंपरिक स्वाद।',
    image: '/farm/images/urad-960.jpg',
    price: '115',
    rating: '4.9',
    reviewCount: '8',
    category: 'दालें (Pulses)'
  },
  'sweet-lime': {
    name: 'ताज़ा मौसंबी (Sweet Lime / Mosambi)',
    localName: 'ताज़ा मौसंबी',
    description: 'खेत के बाग से ताज़ा तोड़ी गई रसदार मीठी मौसंबी। सीधे डाल से आपके घर तक।',
    image: '/farm/images/mosambi-960.jpg',
    price: '55',
    rating: '4.7',
    reviewCount: '6',
    category: 'फल (Fruits)'
  },
  'guava': {
    name: 'ग्वालियर अमरूद (Gwalior Desi Guava)',
    localName: 'देशी अमरूद',
    description: 'ग्वालियर अंचल के प्रसिद्ध मीठे व खुशबूदार देशी अमरूद। बिना कार्बाइड, पेड़ पर पके हुए।',
    image: '/farm/images/guava-960.jpg',
    price: '45',
    rating: '4.8',
    reviewCount: '11',
    category: 'फल (Fruits)'
  },
  'seasonal-farm-produce': {
    name: 'मौसमी खेत उपज (Seasonal Farm Harvest)',
    localName: 'मौसमी फसल',
    description: 'खेत में इस मौसम में पकने वाली ताज़ा प्राकृतिक फसलें व फल सीधे आपके घर।',
    image: '/farm/images/farm-hero-1200.jpg',
    price: '40',
    rating: '4.9',
    reviewCount: '7',
    category: 'मौसमी (Seasonal)'
  }
};

const curMeta = PRODUCT_SEO_DATA[slug || 'farm-wheat'] || PRODUCT_SEO_DATA['farm-wheat'];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": curMeta.name,
  "image": [`https://mcqticker.online${curMeta.image}`],
  "description": curMeta.description,
  "sku": `FD-${(slug || 'farm-wheat').toUpperCase()}`,
  "brand": {
    "@type": "Brand",
    "name": "फार्म डायरेक्ट (Farm Direct)"
  },
  "offers": {
    "@type": "Offer",
    "url": `https://mcqticker.online/farm/products/${slug}`,
    "priceCurrency": "INR",
    "price": curMeta.price,
    "availability": "https://schema.org/InStock",
    "priceValidUntil": "2027-12-31",
    "seller": {
      "@type": "Organization",
      "name": "फार्म डायरेक्ट (Farm Direct)"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": curMeta.rating,
    "reviewCount": curMeta.reviewCount,
    "bestRating": "5",
    "worstRating": "1"
  }
};
---

<FarmLayout
  title={`${curMeta.name} | शुद्ध देशी फसल | फार्म डायरेक्ट ग्वालियर`}
  description={curMeta.description}
  canonicalPath={`/farm/products/${slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />

  <div class="fd-container py-8 sm:py-14 max-w-5xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[#5b6e5d] dark:text-[#a3b8a6] mb-6 font-semibold" aria-label="Breadcrumb">
      <a href="/farm" class="hover:text-[#194622] dark:hover:text-[#6ee7b7] transition-colors">मुख्य पृष्ठ (Home)</a>
      <span class="opacity-50">/</span>
      <a href="/farm/products" class="hover:text-[#194622] dark:hover:text-[#6ee7b7] transition-colors">फसल सूची (Produce Catalogue)</a>
      <span class="opacity-50">/</span>
      <span id="breadcrumb-title" class="font-extrabold text-[#132215] dark:text-[#e8f5e9]">{curMeta.localName}</span>
    </nav>

    <!-- Product Detail Container -->
    <div id="product-loading" class="text-center py-20 text-[#5b6e5d] dark:text-[#a3b8a6]">
      <div class="inline-block animate-spin w-8 h-8 border-4 border-[#194622] dark:border-[#4ade80] border-t-transparent rounded-full mb-3"></div>
      <p class="text-sm font-semibold">खेत की ताज़ा पैदावार व भाव लोड हो रहे हैं... (Retrieving live harvest stock and prices...)</p>
    </div>

    <div id="product-content" class="hidden">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 bg-white dark:bg-[#152317] p-6 sm:p-10 rounded-3xl border border-[#dce7db] dark:border-[#223b26] shadow-xl shadow-emerald-950/[0.04]">
        <!-- Image Column -->
        <div class="md:col-span-6 space-y-4">
          <div class="relative rounded-2xl overflow-hidden bg-gray-100 dark:bg-black/20 border border-[#dce7db] dark:border-[#223b26] aspect-square shadow-md shadow-emerald-950/5 group">
            <img
              id="p-image"
              src=""
              alt=""
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute top-3.5 left-3.5 flex flex-col gap-1.5 items-start">
              <span id="p-badge" class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-emerald-900/90 text-emerald-100 backdrop-blur-md border border-emerald-400/30 shadow-xs">100% देशी / बिना पॉलिश • Raw / Unprocessed</span>
              <span id="p-local" class="hidden text-xs font-bold px-2.5 py-0.5 rounded-full bg-black/60 text-white backdrop-blur-md"></span>
            </div>
            <div id="p-out-banner" class="hidden absolute inset-0 bg-black/60 backdrop-blur-[2px] flex items-center justify-center">
              <span class="px-5 py-2 rounded-full bg-rose-600 text-white text-sm font-extrabold shadow-xl uppercase tracking-wider">स्टॉक समाप्त • Out of Stock</span>
            </div>
          </div>

          <!-- Thumbnails Row (when multiple images are available) -->
          <div id="p-gallery-thumbs" class="hidden flex items-center gap-2.5 overflow-x-auto pb-1 scrollbar-none">
            <!-- Rendered via JS -->
          </div>

          <!-- Quality Transparency Card -->
          <div class="p-4 sm:p-5 rounded-2xl bg-[#f7faf5] dark:bg-[#1a2d1d] border border-[#dce7db] dark:border-[#223b26] text-xs space-y-2 text-[#5b6e5d] dark:text-[#a3b8a6]">
            <div class="font-extrabold text-[#132215] dark:text-[#e8f5e9] flex items-center gap-2 text-sm">
              <span>🌾</span>
              <span>100% शुद्ध व प्राकृतिक कृषि उपज • 100% Raw Farm Produce</span>
            </div>
            <p class="leading-relaxed">
              यह अनाज ग्वालियर के पास गाँव सिरसौद के खेतों में काटा और साफ किया गया है। इसमें कोई मशीन पॉलिश, केमिकल या प्रिजर्वेटिव नहीं है। घर में पिसवाने या पकाने से पहले एक बार धूप दिखाना व पारंपरिक धोना उत्तम है। (Direct unpolished village harvest.)
            </p>
          </div>
        </div>

        <!-- Details & Buying Column -->
        <div class="md:col-span-6 flex flex-col justify-between space-y-6">
          <div class="space-y-5">
            <div>
              <span id="p-category" class="inline-block text-[10px] uppercase tracking-wider text-emerald-800 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-950 font-extrabold px-2.5 py-0.5 rounded-full mb-1.5">खेत की देशी उपज • Farm Grain</span>
              <h1 id="p-name" class="fd-display text-3xl sm:text-4xl font-extrabold text-[#132215] dark:text-[#f0f9f1]"></h1>
              
              <!-- Amazon-Style Top Rating Snippet -->
              <div id="p-top-rating-container" class="mt-2.5 flex items-center flex-wrap gap-2.5 text-xs">
                <a href="#reviews-section" class="inline-flex items-center gap-1.5 group cursor-pointer hover:underline">
                  <span id="p-top-stars" class="text-amber-400 text-sm tracking-tighter">★★★★★</span>
                  <span id="p-top-rating-val" class="font-black text-[#132215] dark:text-[#f0f9f1]"></span>
                  <span id="p-top-reviews-count" class="font-bold text-emerald-800 dark:text-emerald-400 group-hover:text-emerald-950 underline decoration-dotted">(0 reviews)</span>
                </a>
                <span class="text-[#cbd8c9] dark:text-white/20">|</span>
                <a href="#reviews-section" class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-md border border-emerald-200/60 dark:border-emerald-800/40 hover:bg-emerald-100 transition-colors">
                  <span class="text-emerald-600 dark:text-emerald-400">✓</span> 100% सत्यापित खरीदार • Verified Buyers
                </a>
              </div>
            </div>

            <div class="flex items-baseline gap-3 p-3.5 rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/40 border border-emerald-100 dark:border-emerald-800/40">
              <span id="p-price" class="text-3xl font-extrabold text-[#194622] dark:text-[#4ade80]"></span>
              <span class="text-xs text-[#5b6e5d] dark:text-[#a3b8a6] font-bold">खेत की सीधी दर • Direct Farm Price</span>
            </div>

            <div class="p-3.5 rounded-xl bg-[#f4f7f2] dark:bg-[#1a2d1d] border border-[#dce7db] dark:border-[#223b26] flex items-center justify-between text-xs sm:text-sm">
              <span class="text-[#5b6e5d] dark:text-[#a3b8a6] font-medium">उपलब्ध स्टॉक (Available Stock):</span>
              <strong id="p-stock" class="text-[#194622] dark:text-[#4ade80] font-extrabold text-sm"></strong>
            </div>

            <div>
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#748776] dark:text-[#8ea290] mb-1.5">फसल का विवरण व स्रोत • Details & Origin</h3>
              <p id="p-desc" class="text-xs sm:text-sm text-[#4a5f4d] dark:text-[#c4d6c6] leading-relaxed"></p>
            </div>

            <!-- Quantity Preset Buttons -->
            <div id="p-presets-container" class="space-y-2 pt-2">
              <label class="text-xs font-extrabold uppercase tracking-wider text-[#748776] dark:text-[#8ea290] block">बोरी का वज़न चुनें • Select Bag Weight</label>
              <div id="p-presets" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Quantity Counter -->
            <div class="flex items-center gap-3 pt-1">
              <span class="text-xs font-bold text-[#5b6e5d] dark:text-[#a3b8a6]">वज़न बदलें (Adjust):</span>
              <div class="flex items-center gap-1.5 p-1 rounded-xl bg-[#f7faf5] dark:bg-[#1a2d1d] border border-[#dce7db] dark:border-[#223b26]">
                <button type="button" class="w-8 h-8 rounded-lg bg-white dark:bg-[#203723] border border-[#d0ded0] dark:border-[#2a4a2f] text-sm font-extrabold text-[#194622] dark:text-[#6ee7b7] hover:bg-[#eaf4ec] active:scale-90 transition-all flex items-center justify-center cursor-pointer" onclick="adjustProductQty(-1)">−</button>
                <input id="product-qty-input" type="number" min="1" value="1" class="w-14 text-center text-xs font-extrabold py-1 bg-transparent border-0 text-[#132215] dark:text-[#f0f9f1] focus:outline-none" readonly />
                <button type="button" class="w-8 h-8 rounded-lg bg-white dark:bg-[#203723] border border-[#d0ded0] dark:border-[#2a4a2f] text-sm font-extrabold text-[#194622] dark:text-[#6ee7b7] hover:bg-[#eaf4ec] active:scale-90 transition-all flex items-center justify-center cursor-pointer" onclick="adjustProductQty(1)">+</button>
              </div>
              <span class="text-xs font-extrabold text-[#132215] dark:text-[#f0f9f1]">किलो (kg)</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-4 pt-4 border-t border-[#edf2eb] dark:border-[#223b26]">
            <div id="action-buttons-group" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <button id="btn-add-cart" type="button" class="fd-btn fd-btn-secondary w-full py-3.5 font-extrabold text-sm rounded-2xl shadow-xs cursor-pointer" onclick="addToCartDetail()">
                🛒 टोकरी में जोड़ें • Add to Cart
              </button>
              <button id="btn-buy-now" type="button" class="fd-btn fd-btn-primary w-full py-3.5 font-extrabold text-sm rounded-2xl shadow-md cursor-pointer" onclick="buyNowDetail()">
                ⚡ तुरंत खरीदें • Buy Now
              </button>
            </div>

            <!-- Free Sample Option Callout -->
            <div id="sample-box" class="hidden p-4 sm:p-5 rounded-2xl bg-amber-50/80 dark:bg-amber-950/30 border border-amber-200/80 dark:border-amber-800/40 space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-extrabold uppercase tracking-wider text-amber-900 dark:text-amber-200 flex items-center gap-1.5">
                  <span>🎁</span> मुफ़्त चखने हेतु सैंपल उपलब्ध • Free Tasting Packet
                </span>
                <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-amber-500 text-white">₹0 मुफ़्त</span>
              </div>
              <p class="text-xs text-amber-950/80 dark:text-amber-200/80 leading-relaxed">
                थोक अनाज या दाल मंगाने से पहले घर पर 100g या 200g सैंपल चखकर देखें। हमारी ग्वालियर व आसपास की नियमित ट्रिप में मुफ़्त होम डिलीवरी।
              </p>
              <a id="btn-sample" href="#" class="fd-btn fd-btn-accent fd-btn-sm w-full font-extrabold rounded-xl mt-1">
                मुफ़्त सैंपल मंगाएँ (100g / 200g) • Request Free Sample &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Customer Reviews & Photos Section -->
      <section id="reviews-section" class="mt-12 sm:mt-16 space-y-8 scroll-mt-24">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[#dce7db] dark:border-[#223b26]">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-900 dark:text-emerald-300 text-xs font-extrabold uppercase tracking-wider mb-2">
              <span>⭐</span>
              <span>सत्यापित ग्राहक समीक्षाएं • Verified Customer Reviews</span>
            </div>
            <h2 class="fd-display text-2xl sm:text-3xl font-extrabold text-[#122815] dark:text-[#f0f9f1]">
              ग्राहक समीक्षाएं: <span id="rev-product-scope-name" class="text-emerald-800 dark:text-emerald-400 underline decoration-emerald-400">इस फसल की</span>
            </h2>
            <p class="text-xs sm:text-sm text-[#5b6e5d] dark:text-[#a3b8a6] mt-1">
              गाँव सिरसौद, ग्वालियर, करैरा और शिवपुरी के सत्यापित खरीदारों द्वारा दी गई वास्तविक राय और खेत की तस्वीरें।
            </p>
          </div>
          <div>
            <button
              type="button"
              onclick="openWriteReviewModal()"
              class="fd-btn fd-btn-primary px-5 py-3 rounded-2xl text-xs sm:text-sm font-extrabold shadow-md flex items-center gap-2 cursor-pointer w-full sm:w-auto justify-center"
            >
              <span>✍️ समीक्षा व फोटो लिखें • Write a Review</span>
            </button>
          </div>
        </div>

        <!-- Rating Breakdown & Summary (Amazon Style) -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 bg-white dark:bg-[#152317] p-6 sm:p-8 rounded-3xl border border-[#dce7db] dark:border-[#223b26] shadow-sm">
          <!-- Score Column (Left) -->
          <div class="md:col-span-5 flex flex-col items-center justify-center text-center p-5 bg-[#f8faf7] dark:bg-[#1a2d1d] rounded-2xl border border-[#e5eee3] dark:border-[#223b26]">
            <div class="text-5xl sm:text-6xl font-black text-[#194622] dark:text-[#4ade80]" id="rev-avg-score">—</div>
            <div class="flex items-center gap-1 text-amber-400 text-2xl my-2" id="rev-avg-stars">
              ★★★★★
            </div>
            <div class="text-xs font-bold text-[#132215] dark:text-[#f0f9f1]" id="rev-total-count-text">
              सत्यापित ग्राहक समीक्षाओं के आधार पर
            </div>
            <div class="text-[11px] text-[#637765] dark:text-[#a3b8a6] mt-1 flex items-center gap-1">
              <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">✓</span> 100% असली स्थानीय गाँव के खरीदारों का फीडबैक
            </div>

            <!-- Amazon-style Review this product box -->
            <div class="mt-5 pt-4 border-t border-[#e2ece0] dark:border-[#2a462f] text-center w-full">
              <h4 class="font-extrabold text-xs sm:text-sm text-[#132215] dark:text-[#f0f9f1]">इस फसल की समीक्षा करें • Review this produce</h4>
              <p class="text-[11px] text-[#5b6e5d] dark:text-[#a3b8a6] mt-0.5 mb-3">अन्य परिवारों के साथ अपना अनुभव साझा करें।</p>
              <button
                type="button"
                onclick="openWriteReviewModal()"
