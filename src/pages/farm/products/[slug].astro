    function formatReviewDate(dateStr) {
      if (!dateStr) return 'हाल ही में';
      try {
        const d = new Date(dateStr);
        return d.toLocaleDateString('hi-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      } catch (_) {
        return 'हाल ही में';
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

