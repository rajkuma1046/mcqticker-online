---
import FarmLayout from '../../../layouts/FarmLayout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'farm-wheat' } },
    { params: { slug: 'raw-groundnut' } },
    { params: { slug: 'raw-chana' } },
    { params: { slug: 'raw-moong' } },
    { params: { slug: 'raw-urad' } },
    { params: { slug: 'seasonal-farm-produce' } },
  ];
}

const { slug } = Astro.params;
---

<FarmLayout
  title={`Farm Direct | Produce Detail`}
  description="Fresh raw agricultural produce directly from our farm for neighbourhood delivery in Gwalior."
  canonicalPath={`/farm/products/${slug}`}
>
  <div class="fd-container py-8 sm:py-14 max-w-5xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[#5b6e5d] mb-6 font-semibold">
      <a href="/farm" class="hover:text-[#194622]">Home</a>
      <span>/</span>
      <a href="/farm/products" class="hover:text-[#194622]">Produce Catalogue</a>
      <span>/</span>
      <span id="breadcrumb-title" class="font-extrabold text-[#132215]">Loading...</span>
    </nav>

    <!-- Product Detail Container -->
    <div id="product-loading" class="text-center py-20 text-[#5b6e5d]">
      <div class="inline-block animate-spin w-8 h-8 border-4 border-[#194622] border-t-transparent rounded-full mb-3"></div>
      <p class="text-sm font-semibold">Retrieving authoritative live harvest stock and prices...</p>
    </div>

    <div id="product-content" class="hidden">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 bg-white p-6 sm:p-10 rounded-3xl border border-[#dce7db] shadow-xl shadow-emerald-950/[0.04]">
        <!-- Image Column -->
        <div class="md:col-span-6 space-y-4">
          <div class="relative rounded-2xl overflow-hidden bg-gray-100 border border-[#dce7db] aspect-square shadow-md shadow-emerald-950/5 group">
            <img
              id="p-image"
              src=""
              alt=""
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute top-3.5 left-3.5 flex flex-col gap-1.5 items-start">
              <span id="p-badge" class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-emerald-900/90 text-emerald-100 backdrop-blur-md border border-emerald-400/30 shadow-xs">Raw / Unprocessed</span>
              <span id="p-local" class="hidden text-xs font-bold px-2.5 py-0.5 rounded-full bg-black/60 text-white backdrop-blur-md"></span>
            </div>
            <div id="p-out-banner" class="hidden absolute inset-0 bg-black/50 backdrop-blur-[2px] flex items-center justify-center">
              <span class="px-5 py-2 rounded-full bg-rose-600 text-white text-sm font-extrabold shadow-xl uppercase tracking-wider">Out of Stock</span>
            </div>
          </div>

          <!-- Thumbnails Row (when multiple images are available) -->
          <div id="p-gallery-thumbs" class="hidden flex items-center gap-2.5 overflow-x-auto pb-1 scrollbar-none">
            <!-- Rendered via JS -->
          </div>

          <!-- Quality Transparency Card -->
          <div class="p-4 sm:p-5 rounded-2xl bg-[#f7faf5] border border-[#dce7db] text-xs space-y-2 text-[#5b6e5d]">
            <div class="font-extrabold text-[#132215] flex items-center gap-2 text-sm">
              <span>🌾</span>
              <span>100% Raw & Unprocessed Agricultural Commodity</span>
            </div>
            <p class="leading-relaxed">
              This grain is cleaned and threshed on village farmland near Gwalior. It has not been subjected to machine polishing, chemical whitening, or shelf-life extenders. A customary rinse and sun-drying before milling or cooking is recommended.
            </p>
          </div>
        </div>

        <!-- Details & Buying Column -->
        <div class="md:col-span-6 flex flex-col justify-between space-y-6">
          <div class="space-y-5">
            <div>
              <span id="p-category" class="inline-block text-[10px] uppercase tracking-wider text-emerald-800 bg-emerald-100 font-extrabold px-2.5 py-0.5 rounded-full mb-1.5">Raw Farm Grain</span>
              <h1 id="p-name" class="fd-display text-3xl sm:text-4xl font-extrabold text-[#132215]"></h1>
            </div>

            <div class="flex items-baseline gap-3 p-3.5 rounded-2xl bg-emerald-50/60 border border-emerald-100">
              <span id="p-price" class="text-3xl font-extrabold text-[#194622]"></span>
              <span class="text-xs text-[#5b6e5d] font-bold">Authoritative Cloudflare D1 Rate</span>
            </div>

            <div class="p-3.5 rounded-xl bg-[#f4f7f2] border border-[#dce7db] flex items-center justify-between text-xs sm:text-sm">
              <span class="text-[#5b6e5d] font-medium">Current Available Stock:</span>
              <strong id="p-stock" class="text-[#194622] font-extrabold text-sm"></strong>
            </div>

            <div>
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#748776] mb-1.5">Produce Description & Origin</h3>
              <p id="p-desc" class="text-xs sm:text-sm text-[#4a5f4d] leading-relaxed"></p>
            </div>

            <!-- Quantity Preset Buttons -->
            <div id="p-presets-container" class="space-y-2 pt-2">
              <label class="text-xs font-extrabold uppercase tracking-wider text-[#748776] block">Select Bag Weight</label>
              <div id="p-presets" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Quantity Counter -->
            <div class="flex items-center gap-3 pt-1">
              <span class="text-xs font-bold text-[#5b6e5d]">Adjust Weight:</span>
              <div class="flex items-center gap-1.5 p-1 rounded-xl bg-[#f7faf5] border border-[#dce7db]">
                <button type="button" class="w-8 h-8 rounded-lg bg-white border border-[#d0ded0] text-sm font-extrabold text-[#194622] hover:bg-[#eaf4ec] active:scale-90 transition-all flex items-center justify-center" onclick="adjustProductQty(-1)">−</button>
                <input id="product-qty-input" type="number" min="1" value="1" class="w-14 text-center text-xs font-extrabold py-1 bg-transparent border-0 focus:outline-none" readonly />
                <button type="button" class="w-8 h-8 rounded-lg bg-white border border-[#d0ded0] text-sm font-extrabold text-[#194622] hover:bg-[#eaf4ec] active:scale-90 transition-all flex items-center justify-center" onclick="adjustProductQty(1)">+</button>
              </div>
              <span class="text-xs font-extrabold text-[#132215]">kg</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-4 pt-4 border-t border-[#edf2eb]">
            <div id="action-buttons-group" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <button id="btn-add-cart" type="button" class="fd-btn fd-btn-secondary w-full py-3.5 font-extrabold text-sm rounded-2xl shadow-xs" onclick="addToCartDetail()">
                Add to Cart
              </button>
              <button id="btn-buy-now" type="button" class="fd-btn fd-btn-primary w-full py-3.5 font-extrabold text-sm rounded-2xl shadow-md" onclick="buyNowDetail()">
                Buy Now
              </button>
            </div>

            <!-- Free Sample Option Callout -->
            <div id="sample-box" class="hidden p-4 sm:p-5 rounded-2xl bg-amber-50/70 border border-amber-200/80 space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-extrabold uppercase tracking-wider text-amber-900 flex items-center gap-1.5">
                  <span>🎁</span> Free Tasting Packet Available
                </span>
                <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-amber-500 text-white">₹0 Free</span>
              </div>
              <p class="text-xs text-amber-950/80 leading-relaxed">
                Test a 100g or 200g sample packet at home before ordering bulk grain. Delivered on our scheduled Gwalior neighbourhood trip.
              </p>
              <a id="btn-sample" href="#" class="fd-btn fd-btn-accent fd-btn-sm w-full font-extrabold rounded-xl mt-1">
                Request Free Sample (100g / 200g) &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ slug }}>
    let currentProduct = null;

    window.selectGalleryImage = function(url, btn) {
      const mainImg = document.getElementById('p-image');
      if (mainImg) mainImg.src = url;
      document.querySelectorAll('#p-gallery-thumbs .thumb-btn').forEach(b => {
        b.className = 'thumb-btn w-16 h-16 rounded-xl overflow-hidden border-2 transition-all shrink-0 border-[#dce7db] opacity-70 hover:opacity-100 cursor-pointer';
      });
      if (btn) {
        btn.className = 'thumb-btn w-16 h-16 rounded-xl overflow-hidden border-2 transition-all shrink-0 border-emerald-600 ring-2 ring-emerald-300 cursor-pointer';
      }
    };

    async function fetchProduct() {
      const loader = document.getElementById('product-loading');
      const content = document.getElementById('product-content');

      try {
        const res = await fetch(`/farm/api/products/${slug}`);
        const data = await res.json();

        if (!data.success || !data.product) {
          loader.innerHTML = '<p class="text-sm text-red-600 font-semibold">Product not found. <a href="/farm/products" class="underline">View all produce</a></p>';
          return;
        }

        currentProduct = data.product;
        loader.classList.add('hidden');
        content.classList.remove('hidden');

        // Populate fields
        document.getElementById('breadcrumb-title').textContent = currentProduct.name;
        document.getElementById('p-name').textContent = currentProduct.name;
        document.getElementById('p-desc').textContent = currentProduct.description;

        const catEl = document.getElementById('p-category');
        if (catEl && currentProduct.category) {
          catEl.textContent = (currentProduct.category.charAt(0).toUpperCase() + currentProduct.category.slice(1)) + ' Harvest';
        }

        document.getElementById('p-image').src = currentProduct.imageUrl || '/farm/images/wheat-960.jpg';
        document.getElementById('p-image').alt = currentProduct.imageAlt || currentProduct.name;

        // Render gallery thumbnails if multiple images
        const thumbsContainer = document.getElementById('p-gallery-thumbs');
        const images = (Array.isArray(currentProduct.images) && currentProduct.images.length > 0)
          ? currentProduct.images
          : (currentProduct.imageUrl ? [currentProduct.imageUrl] : []);

        if (images.length > 1) {
          thumbsContainer.innerHTML = images.map((img, idx) => `
            <button
              type="button"
              onclick="selectGalleryImage('${img}', this)"
              class="thumb-btn w-16 h-16 rounded-xl overflow-hidden border-2 transition-all shrink-0 cursor-pointer ${idx === 0 ? 'border-emerald-600 ring-2 ring-emerald-300' : 'border-[#dce7db] opacity-70 hover:opacity-100'}"
            >
              <img src="${img}" alt="${currentProduct.name}" class="w-full h-full object-cover" />
            </button>
          `).join('');
          thumbsContainer.classList.remove('hidden');
        } else {
          thumbsContainer.classList.add('hidden');
        }

        if (currentProduct.pricePerKgRupees !== null) {
          document.getElementById('p-price').textContent = `₹${currentProduct.pricePerKgRupees}/${currentProduct.unit || 'kg'}`;
        } else {
          document.getElementById('p-price').textContent = 'Seasonal Rate';
        }

        const stockEl = document.getElementById('p-stock');
        const isOut = currentProduct.isOutOfStock;
        if (isOut) {
          stockEl.textContent = 'Out of Stock';
          stockEl.className = 'text-rose-600 font-extrabold text-sm';
          document.getElementById('p-out-banner').classList.remove('hidden');
          document.getElementById('action-buttons-group').innerHTML = `
            <div class="col-span-2 text-center p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 font-bold text-sm">
              This produce is currently sold out. New harvest will be threshed soon.
            </div>
          `;
        } else {
          stockEl.textContent = `${currentProduct.quantityAvailable} kg available`;
        }

        if (currentProduct.localName) {
          const localEl = document.getElementById('p-local');
          localEl.textContent = currentProduct.localName;
          localEl.classList.remove('hidden');
        }

        if (currentProduct.isSeasonal) {
          const badge = document.getElementById('p-badge');
          badge.className = 'text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-amber-500 text-white shadow-xs';
          badge.textContent = 'Seasonal Harvest';
        }

        // Preset buttons
        const presets = currentProduct.quantityOptions || [1, 5, 10];
        const presetsEl = document.getElementById('p-presets');
        presetsEl.innerHTML = presets.map((kg, i) => `
          <button type="button" class="preset-btn px-4 py-2 text-xs font-extrabold rounded-xl border border-[#d9e4d5] bg-white text-[#132215] hover:bg-emerald-50 transition-all ${i === 0 ? 'bg-gradient-to-r from-[#1b4522] to-[#296032] text-white border-transparent shadow-xs' : ''}" onclick="selectPreset(${kg}, this)">
            ${kg} kg
          </button>
        `).join('');

        // Free sample
        if (currentProduct.sampleAvailable) {
          const sampleBox = document.getElementById('sample-box');
          const sampleBtn = document.getElementById('btn-sample');
          sampleBox.classList.remove('hidden');
          sampleBtn.href = `/farm/samples?product=${currentProduct.slug}`;
        }
      } catch (e) {
        loader.innerHTML = '<p class="text-sm text-red-600">Failed to load product details. Please check connection.</p>';
      }
    }

    window.selectPreset = function(kg, btn) {
      document.getElementById('product-qty-input').value = kg;
      document.querySelectorAll('.preset-btn').forEach(b => {
        b.className = 'preset-btn px-4 py-2 text-xs font-extrabold rounded-xl border border-[#d9e4d5] bg-white text-[#132215] hover:bg-emerald-50 transition-all';
      });
      btn.className = 'preset-btn px-4 py-2 text-xs font-extrabold rounded-xl border border-transparent bg-gradient-to-r from-[#1b4522] to-[#296032] text-white shadow-xs transition-all';
    };

    window.adjustProductQty = function(delta) {
      const input = document.getElementById('product-qty-input');
      let val = parseInt(input.value || '1', 10) + delta;
      if (val < 1) val = 1;
      if (currentProduct && val > currentProduct.quantityAvailable) val = currentProduct.quantityAvailable;
      input.value = val;
    };

    window.addToCartDetail = function() {
      if (!currentProduct) return;
      const qty = parseInt(document.getElementById('product-qty-input').value || '1', 10);
      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      const idx = cart.findIndex(it => it.productId === currentProduct.id);
      if (idx >= 0) {
        cart[idx].quantity += qty;
      } else {
        cart.push({
          productId: currentProduct.id,
          name: currentProduct.name,
          estimatedPriceRupees: currentProduct.pricePerKgRupees,
          quantity: qty,
          unit: 'kg',
        });
      }

      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      if (typeof updateNavCartBadge === 'function') updateNavCartBadge();

      showDetailToast(`Added ${qty} kg of ${currentProduct.name} to cart.`);
    };

    window.buyNowDetail = function() {
      if (!currentProduct) return;
      const qty = parseInt(document.getElementById('product-qty-input').value || '1', 10);
      let cart = [{
        productId: currentProduct.id,
        name: currentProduct.name,
        estimatedPriceRupees: currentProduct.pricePerKgRupees,
        quantity: qty,
        unit: 'kg',
      }];
      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      if (typeof updateNavCartBadge === 'function') updateNavCartBadge();
      window.location.href = '/farm/checkout';
    };

    function showDetailToast(msg) {
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-2xl bg-[#132215] text-white text-xs font-bold shadow-2xl border border-white/10 animate-bounce flex items-center gap-2';
      toast.innerHTML = `<span>✓</span> <span>${msg}</span>`;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2500);
    }

    document.addEventListener('DOMContentLoaded', fetchProduct);
  </script>
</FarmLayout>
