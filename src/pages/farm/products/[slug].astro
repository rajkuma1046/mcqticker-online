    async function fetchReviews() {
      const loader = document.getElementById('reviews-loading');
      try {
        const res = await fetch(`/farm/api/reviews?slug=${activeSlug}`);
        const data = await res.json();
        if (loader) loader.classList.add('hidden');

        if (data.success) {
          allReviews = data.reviews || [];
          updateReviewsSummary(data.summary, allReviews);
          renderCustomerPhotos(allReviews);
          applyReviewsFilter();
        }
      } catch (err) {
        if (loader) loader.innerHTML = '<p class="text-xs text-red-500 font-bold">Failed to load reviews.</p>';
      }
    }

    function updateReviewsSummary(summary, reviews) {
      if (!summary) return;
      const total = summary.totalReviews !== undefined ? summary.totalReviews : reviews.length;
      const avg = total > 0 ? Number(summary.averageRating || 0) : 0;
      const scoreEl = document.getElementById('rev-avg-score');
      const starsEl = document.getElementById('rev-avg-stars');
      const countTextEl = document.getElementById('rev-total-count-text');

      if (scoreEl) scoreEl.textContent = total > 0 ? avg.toFixed(1) : '—';
      if (starsEl) starsEl.textContent = '★'.repeat(Math.round(avg)) + '☆'.repeat(5 - Math.round(avg));
      if (countTextEl) countTextEl.textContent = total > 0
        ? `${total} सत्यापित खरीदारों की समीक्षाओं के आधार पर (${total} verified reviews)`
        : 'अभी कोई समीक्षा नहीं — इस फसल की पहली समीक्षा आप लिखें';

      // Synchronize top Amazon badge
      const topStars = document.getElementById('p-top-stars');
      const topNum = document.getElementById('p-top-rating-val');
      const topCount = document.getElementById('p-top-reviews-count');
      if (topStars) topStars.textContent = '★'.repeat(Math.round(avg)) + '☆'.repeat(5 - Math.round(avg));
      if (topNum) topNum.textContent = total > 0 ? avg.toFixed(1) : '';
      if (topCount) topCount.textContent = total > 0 ? `(${total} समीक्षाएं • ${total} reviews)` : 'अभी कोई समीक्षा नहीं — पहली आप लिखें';

      const dist = summary.distribution || {};
      for (let s = 1; s <= 5; s++) {
        const count = dist[s] || 0;
        const pct = total > 0 ? Math.round((count / total) * 100) : 0;
        const barEl = document.getElementById(`bar-star-${s}`);
        const cntEl = document.getElementById(`count-star-${s}`);
        if (barEl) barEl.style.width = `${pct}%`;
        if (cntEl) cntEl.textContent = `${pct}% (${count})`;
      }
    }

