---
import FarmLayout from '../../../layouts/FarmLayout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'farm-wheat' } },
    { params: { slug: 'raw-groundnut' } },
    { params: { slug: 'raw-chana' } },
    { params: { slug: 'raw-moong' } },
    { params: { slug: 'raw-urad' } },
    { params: { slug: 'sweet-lime' } },
    { params: { slug: 'guava' } },
    { params: { slug: 'seasonal-farm-produce' } },
  ];
}

const { slug } = Astro.params;
---

<FarmLayout
  title={`Farm Direct | Produce Detail`}
  description="Fresh raw agricultural produce directly from our farm for neighbourhood delivery in Gwalior."
  canonicalPath={`/farm/products/${slug}`}
>
  <div class="fd-container py-8 sm:py-14 max-w-5xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[#5b6e5d] mb-6 font-semibold">
      <a href="/farm" class="hover:text-[#194622]">Home</a>
      <span>/</span>
      <a href="/farm/products" class="hover:text-[#194622]">Produce Catalogue</a>
      <span>/</span>
      <span id="breadcrumb-title" class="font-extrabold text-[#132215]">Loading...</span>
    </nav>

    <!-- Product Detail Container -->
    <div id="product-loading" class="text-center py-20 text-[#5b6e5d]">
      <div class="inline-block animate-spin w-8 h-8 border-4 border-[#194622] border-t-transparent rounded-full mb-3"></div>
      <p class="text-sm font-semibold">Retrieving authoritative live harvest stock and prices...</p>
    </div>

    <div id="product-content" class="hidden">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 bg-white p-6 sm:p-10 rounded-3xl border border-[#dce7db] shadow-xl shadow-emerald-950/[0.04]">
        <!-- Image Column -->
        <div class="md:col-span-6 space-y-4">
          <div class="relative rounded-2xl overflow-hidden bg-gray-100 border border-[#dce7db] aspect-square shadow-md shadow-emerald-950/5 group">
            <img
              id="p-image"
              src=""
              alt=""
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute top-3.5 left-3.5 flex flex-col gap-1.5 items-start">
              <span id="p-badge" class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-emerald-900/90 text-emerald-100 backdrop-blur-md border border-emerald-400/30 shadow-xs">Raw / Unprocessed</span>
              <span id="p-local" class="hidden text-xs font-bold px-2.5 py-0.5 rounded-full bg-black/60 text-white backdrop-blur-md"></span>
            </div>
            <div id="p-out-banner" class="hidden absolute inset-0 bg-black/50 backdrop-blur-[2px] flex items-center justify-center">
              <span class="px-5 py-2 rounded-full bg-rose-600 text-white text-sm font-extrabold shadow-xl uppercase tracking-wider">Out of Stock</span>
            </div>
          </div>

          <!-- Thumbnails Row (when multiple images are available) -->
          <div id="p-gallery-thumbs" class="hidden flex items-center gap-2.5 overflow-x-auto pb-1 scrollbar-none">
            <!-- Rendered via JS -->
          </div>

          <!-- Quality Transparency Card -->
          <div class="p-4 sm:p-5 rounded-2xl bg-[#f7faf5] border border-[#dce7db] text-xs space-y-2 text-[#5b6e5d]">
            <div class="font-extrabold text-[#132215] flex items-center gap-2 text-sm">
              <span>🌾</span>
              <span>100% Raw & Unprocessed Agricultural Commodity</span>
            </div>
            <p class="leading-relaxed">
              This grain is cleaned and threshed on village farmland near Gwalior. It has not been subjected to machine polishing, chemical whitening, or shelf-life extenders. A customary rinse and sun-drying before milling or cooking is recommended.
            </p>
          </div>
        </div>

        <!-- Details & Buying Column -->
        <div class="md:col-span-6 flex flex-col justify-between space-y-6">
          <div class="space-y-5">
            <div>
              <span id="p-category" class="inline-block text-[10px] uppercase tracking-wider text-emerald-800 bg-emerald-100 font-extrabold px-2.5 py-0.5 rounded-full mb-1.5">Raw Farm Grain</span>
              <h1 id="p-name" class="fd-display text-3xl sm:text-4xl font-extrabold text-[#132215]"></h1>
              
              <!-- Amazon-Style Top Rating Snippet -->
              <div id="p-top-rating-container" class="mt-2.5 flex items-center flex-wrap gap-2.5 text-xs">
                <a href="#reviews-section" class="inline-flex items-center gap-1.5 group cursor-pointer hover:underline">
                  <span id="p-top-stars" class="text-amber-400 text-sm tracking-tighter">★★★★★</span>
                  <span id="p-top-rating-val" class="font-black text-[#132215]"></span>
                  <span id="p-top-reviews-count" class="font-bold text-emerald-800 group-hover:text-emerald-950 underline decoration-dotted">(0 reviews)</span>
                </a>
                <span class="text-[#cbd8c9]">|</span>
                <a href="#reviews-section" class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200/60 hover:bg-emerald-100 transition-colors">
                  <span class="text-emerald-600">✓</span> 100% Verified Farm Buyers
                </a>
              </div>
            </div>

            <div class="flex items-baseline gap-3 p-3.5 rounded-2xl bg-emerald-50/60 border border-emerald-100">
              <span id="p-price" class="text-3xl font-extrabold text-[#194622]"></span>
              <span class="text-xs text-[#5b6e5d] font-bold">Authoritative Cloudflare D1 Rate</span>
            </div>

            <div class="p-3.5 rounded-xl bg-[#f4f7f2] border border-[#dce7db] flex items-center justify-between text-xs sm:text-sm">
              <span class="text-[#5b6e5d] font-medium">Current Available Stock:</span>
              <strong id="p-stock" class="text-[#194622] font-extrabold text-sm"></strong>
            </div>

            <div>
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#748776] mb-1.5">Produce Description & Origin</h3>
              <p id="p-desc" class="text-xs sm:text-sm text-[#4a5f4d] leading-relaxed"></p>
            </div>

            <!-- Quantity Preset Buttons -->
            <div id="p-presets-container" class="space-y-2 pt-2">
              <label class="text-xs font-extrabold uppercase tracking-wider text-[#748776] block">Select Bag Weight</label>
              <div id="p-presets" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Quantity Counter -->
            <div class="flex items-center gap-3 pt-1">
              <span class="text-xs font-bold text-[#5b6e5d]">Adjust Weight:</span>
              <div class="flex items-center gap-1.5 p-1 rounded-xl bg-[#f7faf5] border border-[#dce7db]">
                <button type="button" class="w-8 h-8 rounded-lg bg-white border border-[#d0ded0] text-sm font-extrabold text-[#194622] hover:bg-[#eaf4ec] active:scale-90 transition-all flex items-center justify-center" onclick="adjustProductQty(-1)">−</button>
                <input id="product-qty-input" type="number" min="1" value="1" class="w-14 text-center text-xs font-extrabold py-1 bg-transparent border-0 focus:outline-none" readonly />
                <button type="button" class="w-8 h-8 rounded-lg bg-white border border-[#d0ded0] text-sm font-extrabold text-[#194622] hover:bg-[#eaf4ec] active:scale-90 transition-all flex items-center justify-center" onclick="adjustProductQty(1)">+</button>
              </div>
              <span class="text-xs font-extrabold text-[#132215]">kg</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-4 pt-4 border-t border-[#edf2eb]">
            <div id="action-buttons-group" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <button id="btn-add-cart" type="button" class="fd-btn fd-btn-secondary w-full py-3.5 font-extrabold text-sm rounded-2xl shadow-xs" onclick="addToCartDetail()">
                Add to Cart
              </button>
              <button id="btn-buy-now" type="button" class="fd-btn fd-btn-primary w-full py-3.5 font-extrabold text-sm rounded-2xl shadow-md" onclick="buyNowDetail()">
                Buy Now
              </button>
            </div>

            <!-- Free Sample Option Callout -->
            <div id="sample-box" class="hidden p-4 sm:p-5 rounded-2xl bg-amber-50/70 border border-amber-200/80 space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-extrabold uppercase tracking-wider text-amber-900 flex items-center gap-1.5">
                  <span>🎁</span> Free Tasting Packet Available
                </span>
                <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-amber-500 text-white">₹0 Free</span>
              </div>
              <p class="text-xs text-amber-950/80 leading-relaxed">
                Test a 100g or 200g sample packet at home before ordering bulk grain. Delivered on our scheduled Gwalior neighbourhood trip.
              </p>
              <a id="btn-sample" href="#" class="fd-btn fd-btn-accent fd-btn-sm w-full font-extrabold rounded-xl mt-1">
                Request Free Sample (100g / 200g) &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Customer Reviews & Photos Section -->
      <section id="reviews-section" class="mt-12 sm:mt-16 space-y-8 scroll-mt-24">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[#dce7db]">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-xs font-extrabold uppercase tracking-wider mb-2">
              <span>⭐</span>
              <span>Amazon-Style Verified Reviews</span>
            </div>
            <h2 class="fd-display text-2xl sm:text-3xl font-extrabold text-[#122815]">
              Customer Reviews for <span id="rev-product-scope-name" class="text-emerald-800 underline decoration-emerald-400">This Produce</span>
            </h2>
            <p class="text-xs sm:text-sm text-[#5b6e5d] mt-1">
              Authoritative feedback & harvest photos from verified buyers in Village Sirsod, Gwalior, Karera, and Shivpuri.
            </p>
          </div>
          <div>
            <button
              type="button"
              onclick="openWriteReviewModal()"
              class="fd-btn fd-btn-primary px-5 py-3 rounded-2xl text-xs sm:text-sm font-extrabold shadow-md flex items-center gap-2 cursor-pointer w-full sm:w-auto justify-center"
            >
              <span>✍️ Write a Review & Photos</span>
            </button>
          </div>
        </div>

        <!-- Rating Breakdown & Summary (Amazon Style) -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 bg-white p-6 sm:p-8 rounded-3xl border border-[#dce7db] shadow-sm">
          <!-- Score Column (Left) -->
          <div class="md:col-span-5 flex flex-col items-center justify-center text-center p-5 bg-[#f8faf7] rounded-2xl border border-[#e5eee3]">
            <div class="text-5xl sm:text-6xl font-black text-[#194622]" id="rev-avg-score">—</div>
            <div class="flex items-center gap-1 text-amber-400 text-2xl my-2" id="rev-avg-stars">
              ★★★★★
            </div>
            <div class="text-xs font-bold text-[#132215]" id="rev-total-count-text">
              Based on verified customer reviews
            </div>
            <div class="text-[11px] text-[#637765] mt-1 flex items-center gap-1">
              <span class="text-emerald-600 font-extrabold">✓</span> 100% Authentic Village Farm Customer Feedback
            </div>

            <!-- Amazon-style Review this product box -->
            <div class="mt-5 pt-4 border-t border-[#e2ece0] text-center w-full">
              <h4 class="font-extrabold text-xs sm:text-sm text-[#132215]">Review this produce</h4>
              <p class="text-[11px] text-[#5b6e5d] mt-0.5 mb-3">Share your experience with other village customers.</p>
              <button
                type="button"
                onclick="openWriteReviewModal()"
                class="w-full py-2 px-3 rounded-xl border border-[#b2c8b0] bg-white hover:bg-[#eef5ed] text-[#194622] text-xs font-extrabold transition-all shadow-xs cursor-pointer flex items-center justify-center gap-1.5"
              >
                <span>✍️</span>
                <span>Write a customer review</span>
              </button>
            </div>
          </div>

          <!-- Distribution Bars Column (Right) -->
          <div class="md:col-span-7 flex flex-col justify-center space-y-2.5 text-xs font-semibold text-[#5b6e5d]">
            <div class="text-xs font-extrabold uppercase text-[#718473] mb-1">Rating Breakdown</div>
            <button type="button" class="flex items-center gap-3 w-full text-left group cursor-pointer hover:bg-emerald-50/50 p-1 rounded-lg transition-colors" onclick="filterReviews('5star')">
              <span class="w-12 text-right font-bold text-[#132215] group-hover:text-emerald-800">5 star</span>
              <div class="flex-1 h-3.5 rounded-full bg-[#e9f0e8] overflow-hidden">
                <div id="bar-star-5" class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: 100%;"></div>
              </div>
              <span id="count-star-5" class="w-14 text-right font-bold text-[#132215]">100%</span>
            </button>
            <button type="button" class="flex items-center gap-3 w-full text-left group cursor-pointer hover:bg-emerald-50/50 p-1 rounded-lg transition-colors" onclick="filterReviews('4star')">
              <span class="w-12 text-right font-bold text-[#132215] group-hover:text-emerald-800">4 star</span>
              <div class="flex-1 h-3.5 rounded-full bg-[#e9f0e8] overflow-hidden">
                <div id="bar-star-4" class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
              </div>
              <span id="count-star-4" class="w-14 text-right font-bold text-[#132215]">0%</span>
            </button>
            <button type="button" class="flex items-center gap-3 w-full text-left group cursor-pointer hover:bg-emerald-50/50 p-1 rounded-lg transition-colors" onclick="filterReviews('3star')">
              <span class="w-12 text-right font-bold text-[#132215] group-hover:text-emerald-800">3 star</span>
              <div class="flex-1 h-3.5 rounded-full bg-[#e9f0e8] overflow-hidden">
                <div id="bar-star-3" class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
              </div>
              <span id="count-star-3" class="w-14 text-right font-bold text-[#132215]">0%</span>
            </button>
            <button type="button" class="flex items-center gap-3 w-full text-left group cursor-pointer hover:bg-emerald-50/50 p-1 rounded-lg transition-colors" onclick="filterReviews('2star')">
              <span class="w-12 text-right font-bold text-[#132215] group-hover:text-emerald-800">2 star</span>
              <div class="flex-1 h-3.5 rounded-full bg-[#e9f0e8] overflow-hidden">
                <div id="bar-star-2" class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
              </div>
              <span id="count-star-2" class="w-14 text-right font-bold text-[#132215]">0%</span>
            </button>
            <button type="button" class="flex items-center gap-3 w-full text-left group cursor-pointer hover:bg-emerald-50/50 p-1 rounded-lg transition-colors" onclick="filterReviews('1star')">
              <span class="w-12 text-right font-bold text-[#132215] group-hover:text-emerald-800">1 star</span>
              <div class="flex-1 h-3.5 rounded-full bg-[#e9f0e8] overflow-hidden">
                <div id="bar-star-1" class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
              </div>
              <span id="count-star-1" class="w-14 text-right font-bold text-[#132215]">0%</span>
            </button>
          </div>
        </div>

        <!-- Customer Photos Gallery Strip -->
        <div id="customer-photos-box" class="hidden space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="font-extrabold text-sm sm:text-base text-[#122815] flex items-center gap-2">
              <span>📸</span>
              <span>Photos from Customers</span>
            </h3>
            <span id="photos-count-label" class="text-xs text-[#5b6e5d] font-bold"></span>
          </div>
          <div id="photos-strip" class="flex gap-3 overflow-x-auto pb-2 scrollbar-none">
            <!-- Rendered via JS -->
          </div>
        </div>

        <!-- Filter Tabs -->
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <button
            type="button"
            class="review-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-[#1b4522] text-white shadow-xs cursor-pointer"
            data-filter="all"
            onclick="filterReviews('all', this)"
          >
            All Reviews
          </button>
          <button
            type="button"
            class="review-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer"
            data-filter="photos"
            onclick="filterReviews('photos', this)"
          >
            📸 With Photos
          </button>
          <button
            type="button"
            class="review-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer"
            data-filter="5star"
            onclick="filterReviews('5star', this)"
          >
            ⭐ 5 Stars Only
          </button>
          <button
            type="button"
            class="review-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer"
            data-filter="4star"
            onclick="filterReviews('4star', this)"
          >
            ⭐ 4 Stars
          </button>
        </div>

        <!-- Reviews Feed List -->
        <div id="reviews-loading" class="text-center py-12 text-[#5b6e5d]">
          <div class="inline-block animate-spin w-6 h-6 border-3 border-[#194622] border-t-transparent rounded-full mb-2"></div>
          <p class="text-xs font-bold">Loading community reviews & photos...</p>
        </div>

        <div id="reviews-list" class="space-y-4">
          <!-- Rendered via JS -->
        </div>

        <div id="reviews-empty" class="hidden text-center py-12 bg-white rounded-3xl border border-[#dce7db] p-8 space-y-3">
          <div class="text-4xl">🌾</div>
          <h4 class="font-extrabold text-[#122815] text-base">No reviews in this filter yet</h4>
          <p class="text-xs text-[#5b6e5d] max-w-sm mx-auto">
            Be the first customer to share your thoughts and photos of this harvest!
          </p>
          <button
            type="button"
            onclick="openWriteReviewModal()"
            class="fd-btn fd-btn-primary px-5 py-2.5 rounded-xl text-xs font-bold inline-block cursor-pointer"
          >
            Write the First Review &rarr;
          </button>
        </div>
      </section>
    </div>
  </div>

  <!-- Modal: Write a Review with Photos -->
  <div id="modal-write-review" class="hidden fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-3 sm:p-4 pb-4 overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 pb-10 sm:pb-8 shadow-2xl border border-[#dce7db] space-y-5 animate-in fade-in zoom-in duration-200 max-h-[86dvh] overflow-y-auto overscroll-contain">
      <div class="flex items-start justify-between pb-3 border-b border-[#f0f5ee]">
        <div class="space-y-1">
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-900 text-[10px] font-extrabold uppercase mb-0.5">Authentic Community Feedback</span>
          <h3 class="fd-display font-extrabold text-xl text-[#122815]">Write a Customer Review</h3>
          <div class="flex items-center gap-2.5 pt-1">
            <img id="modal-review-product-img" src="/farm/images/wheat-500.jpg" alt="" class="w-10 h-10 rounded-lg object-cover border border-[#cbd8c9]" />
            <div>
              <span class="text-[10px] uppercase font-bold text-[#5b6e5d] block">Reviewing Produce</span>
              <strong id="modal-review-product-name" class="text-xs sm:text-sm font-extrabold text-[#194622]"></strong>
            </div>
          </div>
        </div>
        <button type="button" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold flex items-center justify-center cursor-pointer" onclick="closeWriteReviewModal()">✕</button>
      </div>

      <form id="review-form" onsubmit="submitCustomerReview(event)" class="space-y-4 text-xs">
        <!-- Interactive Star Rating Picker -->
        <div>
          <label class="font-extrabold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1.5">
            Your Overall Rating *
          </label>
          <div class="flex items-center gap-2">
            <div id="star-picker" class="flex items-center gap-1.5 text-3xl cursor-pointer">
              <span class="star-btn text-amber-400 transition-transform hover:scale-125" data-val="1" onclick="setPickerRating(1)">★</span>
              <span class="star-btn text-amber-400 transition-transform hover:scale-125" data-val="2" onclick="setPickerRating(2)">★</span>
              <span class="star-btn text-amber-400 transition-transform hover:scale-125" data-val="3" onclick="setPickerRating(3)">★</span>
              <span class="star-btn text-amber-400 transition-transform hover:scale-125" data-val="4" onclick="setPickerRating(4)">★</span>
              <span class="star-btn text-amber-400 transition-transform hover:scale-125" data-val="5" onclick="setPickerRating(5)">★</span>
            </div>
            <span id="star-picker-label" class="text-xs font-bold text-[#194622] ml-2">5 - Excellent</span>
          </div>
        </div>

        <!-- Headline / Title -->
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">
            Review Headline (Optional)
          </label>
          <input
            id="rev-input-title"
            type="text"
            maxlength="100"
            class="fd-input font-bold"
            placeholder="e.g. Natural sweet taste, clean unpolished grain"
          />
        </div>

        <!-- Written Review Text -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px]">
              Detailed Written Review *
            </label>
            <span id="rev-char-count" class="text-[10px] text-[#788e7b]">0 / 1000</span>
          </div>
          <textarea
            id="rev-input-text"
            required
            rows="4"
            maxlength="1000"
            class="fd-input"
            placeholder="Tell other families about freshness, grain cleanliness, aroma, softness of rotis, sprouting speed, or delivery experience..."
            oninput="updateReviewCharCount(this)"
          ></textarea>
        </div>

        <!-- Photo Upload Dropzone & Mobile Tap Area -->
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">
            Attach Harvest / Cooking Photo (Optional)
          </label>
          <div
            id="rev-photo-dropzone"
            class="relative border-2 border-dashed border-[#cfe0cc] rounded-2xl p-4 text-center hover:bg-[#f7faf5] transition-colors cursor-pointer bg-[#fafcf9]"
            onclick="document.getElementById('rev-file-input').click()"
          >
            <input
              id="rev-file-input"
              type="file"
              accept="image/*"
              class="hidden"
              onchange="handleReviewPhotoSelect(this)"
            />
            <div id="dropzone-empty-state" class="space-y-1">
              <div class="text-2xl">📸</div>
              <p class="font-bold text-[#132215] text-xs">Tap to choose a photo or take a picture</p>
              <p class="text-[10px] text-[#718573]">PNG, JPG, WEBP — auto-compressed for fast upload</p>
            </div>

            <!-- Preview State -->
            <div id="dropzone-preview-state" class="hidden flex items-center justify-between gap-3 p-2 bg-white rounded-xl border border-[#dce7db]">
              <div class="flex items-center gap-3">
                <img id="rev-preview-img" src="" alt="Review preview" class="w-12 h-12 rounded-lg object-cover border border-[#dce7db]" />
                <div class="text-left">
                  <span id="rev-preview-filename" class="font-bold text-[#132215] text-xs block truncate max-w-[180px]">photo.jpg</span>
                  <span id="rev-preview-filesize" class="text-[10px] text-[#718573]"></span>
                </div>
              </div>
              <button
                type="button"
                onclick="removeReviewPhoto(event)"
                class="px-2.5 py-1 rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 font-bold text-xs cursor-pointer"
              >
                ✕ Remove
              </button>
            </div>
          </div>
        </div>

        <!-- Customer Identity Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <div>
            <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">Your Name *</label>
            <input id="rev-input-name" type="text" required class="fd-input font-bold" placeholder="e.g. Ramesh Sharma" />
          </div>
          <div>
            <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">Neighbourhood / Village *</label>
            <input id="rev-input-city" type="text" required class="fd-input font-bold" placeholder="e.g. Sirsod / Pawan Nagar" />
          </div>
        </div>

        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">WhatsApp Mobile (Optional)</label>
          <input id="rev-input-phone" type="tel" maxlength="10" class="fd-input" placeholder="For verified purchase badge" />
        </div>

        <div id="rev-error-box" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 font-semibold text-xs"></div>

        <div class="pt-3 pb-3">
          <button
            type="submit"
            id="btn-submit-review"
            class="fd-btn fd-btn-primary w-full py-4 font-extrabold text-sm rounded-2xl shadow-lg cursor-pointer transition-transform active:scale-[0.98]"
          >
            Publish Review & Photo &rarr;
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Photo Lightbox -->
  <div id="modal-photo-lightbox" class="hidden fixed inset-0 z-[100] bg-black/85 backdrop-blur-md flex items-center justify-center p-4" onclick="closePhotoLightbox()">
    <div class="relative max-w-2xl w-full bg-white rounded-3xl overflow-hidden shadow-2xl space-y-0" onclick="event.stopPropagation()">
      <button type="button" class="absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-black/50 text-white font-bold flex items-center justify-center hover:bg-black/75 cursor-pointer" onclick="closePhotoLightbox()">✕</button>
      <div class="bg-black flex items-center justify-center max-h-[60vh] overflow-hidden">
        <img id="lightbox-img" src="" alt="Harvest photo" class="w-full h-full object-contain max-h-[60vh]" />
      </div>
      <div class="p-6 space-y-2 bg-white">
        <div class="flex items-center justify-between">
          <strong id="lightbox-author" class="text-sm font-extrabold text-[#122815]"></strong>
          <span id="lightbox-stars" class="text-amber-400 font-bold text-sm"></span>
        </div>
        <p id="lightbox-caption" class="text-xs text-[#5b6e5d] leading-relaxed"></p>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ slug }}>
    const pathParts = window.location.pathname.replace(/\/+$/, '').split('/');
    const pathSlug = pathParts[pathParts.length - 1];
    const activeSlug = slug || pathSlug;
    let currentProduct = null;

    window.selectGalleryImage = function(url, btn) {
      const mainImg = document.getElementById('p-image');
      if (mainImg) mainImg.src = url;
      document.querySelectorAll('#p-gallery-thumbs .thumb-btn').forEach(b => {
        b.className = 'thumb-btn w-16 h-16 rounded-xl overflow-hidden border-2 transition-all shrink-0 border-[#dce7db] opacity-70 hover:opacity-100 cursor-pointer';
      });
      if (btn) {
        btn.className = 'thumb-btn w-16 h-16 rounded-xl overflow-hidden border-2 transition-all shrink-0 border-emerald-600 ring-2 ring-emerald-300 cursor-pointer';
      }
    };

    async function fetchProduct() {
      const loader = document.getElementById('product-loading');
      const content = document.getElementById('product-content');

      try {
        const res = await fetch(`/farm/api/products/${activeSlug}`);
        const data = await res.json();

        if (!data.success || !data.product) {
          loader.innerHTML = '<p class="text-sm text-red-600 font-semibold">Product not found. <a href="/farm/products" class="underline">View all produce</a></p>';
          return;
        }

        currentProduct = data.product;
        loader.classList.add('hidden');
        content.classList.remove('hidden');

        // Populate fields
        document.title = `${currentProduct.name} | Farm Direct`;
        document.getElementById('breadcrumb-title').textContent = currentProduct.name;
        document.getElementById('p-name').textContent = currentProduct.name;
        document.getElementById('p-desc').textContent = currentProduct.description;

        const catEl = document.getElementById('p-category');
        if (catEl && currentProduct.category) {
          catEl.textContent = (currentProduct.category.charAt(0).toUpperCase() + currentProduct.category.slice(1)) + ' Harvest';
        }

        document.getElementById('p-image').src = currentProduct.imageUrl || '/farm/images/wheat-960.jpg';
        document.getElementById('p-image').alt = currentProduct.imageAlt || currentProduct.name;

        // Render gallery thumbnails if multiple images
        const thumbsContainer = document.getElementById('p-gallery-thumbs');
        const images = (Array.isArray(currentProduct.images) && currentProduct.images.length > 0)
          ? currentProduct.images
          : (currentProduct.imageUrl ? [currentProduct.imageUrl] : []);

        if (images.length > 1) {
          thumbsContainer.innerHTML = images.map((img, idx) => `
            <button
              type="button"
              onclick="selectGalleryImage('${img}', this)"
              class="thumb-btn w-16 h-16 rounded-xl overflow-hidden border-2 transition-all shrink-0 cursor-pointer ${idx === 0 ? 'border-emerald-600 ring-2 ring-emerald-300' : 'border-[#dce7db] opacity-70 hover:opacity-100'}"
            >
              <img src="${img}" alt="${currentProduct.name}" class="w-full h-full object-cover" />
            </button>
          `).join('');
          thumbsContainer.classList.remove('hidden');
        } else {
          thumbsContainer.classList.add('hidden');
        }

        if (currentProduct.pricePerKgRupees !== null) {
          document.getElementById('p-price').textContent = `₹${currentProduct.pricePerKgRupees}/${currentProduct.unit || 'kg'}`;
        } else {
          document.getElementById('p-price').textContent = 'Seasonal Rate';
        }

        const stockEl = document.getElementById('p-stock');
        const isOut = currentProduct.isOutOfStock;
        if (isOut) {
          stockEl.textContent = 'Out of Stock';
          stockEl.className = 'text-rose-600 font-extrabold text-sm';
          document.getElementById('p-out-banner').classList.remove('hidden');
          document.getElementById('action-buttons-group').innerHTML = `
            <div class="col-span-2 text-center p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 font-bold text-sm">
              This produce is currently sold out. New harvest will be threshed soon.
            </div>
          `;
        } else {
          stockEl.textContent = `${currentProduct.quantityAvailable} kg available`;
        }

        if (currentProduct.localName) {
          const localEl = document.getElementById('p-local');
          localEl.textContent = currentProduct.localName;
          localEl.classList.remove('hidden');
        }

        if (currentProduct.isSeasonal) {
          const badge = document.getElementById('p-badge');
          badge.className = 'text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-amber-500 text-white shadow-xs';
          badge.textContent = 'Seasonal Harvest';
        }

        // Preset buttons
        const presets = currentProduct.quantityOptions || [1, 5, 10];
        const presetsEl = document.getElementById('p-presets');
        presetsEl.innerHTML = presets.map((kg, i) => `
          <button type="button" class="preset-btn px-4 py-2 text-xs font-extrabold rounded-xl border border-[#d9e4d5] bg-white text-[#132215] hover:bg-emerald-50 transition-all ${i === 0 ? 'bg-gradient-to-r from-[#1b4522] to-[#296032] text-white border-transparent shadow-xs' : ''}" onclick="selectPreset(${kg}, this)">
            ${kg} kg
          </button>
        `).join('');

        // Free sample
        if (currentProduct.sampleAvailable) {
          const sampleBox = document.getElementById('sample-box');
          const sampleBtn = document.getElementById('btn-sample');
          sampleBox.classList.remove('hidden');
          sampleBtn.href = `/farm/samples?product=${currentProduct.slug}`;
        }

        // Sync Product Name and Review Ratings into Amazon Top Snippet & Reviews Section
        const revScopeName = document.getElementById('rev-product-scope-name');
        if (revScopeName) revScopeName.textContent = currentProduct.name;
        const modalProdName = document.getElementById('modal-review-product-name');
        if (modalProdName) modalProdName.textContent = currentProduct.name;
        const modalProdImg = document.getElementById('modal-review-product-img');
        if (modalProdImg) modalProdImg.src = currentProduct.imageUrl || '/farm/images/wheat-500.jpg';

        if (currentProduct.avgRating !== undefined) {
          const avg = Number(currentProduct.avgRating || 0);
          const count = Number(currentProduct.reviewCount || 0);
          const topStars = document.getElementById('p-top-stars');
          const topNum = document.getElementById('p-top-rating-val');
          const topCount = document.getElementById('p-top-reviews-count');
          if (topStars) topStars.textContent = '★'.repeat(Math.round(avg)) + '☆'.repeat(5 - Math.round(avg));
          if (topNum) topNum.textContent = count > 0 ? avg.toFixed(1) : '';
          if (topCount) topCount.textContent = count > 0 ? `(${count} review${count === 1 ? '' : 's'})` : 'No reviews yet — be the first';
        }
      } catch (e) {
        loader.innerHTML = '<p class="text-sm text-red-600">Failed to load product details. Please check connection.</p>';
      }
    }

    window.selectPreset = function(kg, btn) {
      document.getElementById('product-qty-input').value = kg;
      document.querySelectorAll('.preset-btn').forEach(b => {
        b.className = 'preset-btn px-4 py-2 text-xs font-extrabold rounded-xl border border-[#d9e4d5] bg-white text-[#132215] hover:bg-emerald-50 transition-all';
      });
      btn.className = 'preset-btn px-4 py-2 text-xs font-extrabold rounded-xl border border-transparent bg-gradient-to-r from-[#1b4522] to-[#296032] text-white shadow-xs transition-all';
    };

    window.adjustProductQty = function(delta) {
      const input = document.getElementById('product-qty-input');
      let val = parseInt(input.value || '1', 10) + delta;
      if (val < 1) val = 1;
      if (currentProduct && val > currentProduct.quantityAvailable) val = currentProduct.quantityAvailable;
      input.value = val;
    };

    window.addToCartDetail = function() {
      if (!currentProduct) return;
      const qty = parseInt(document.getElementById('product-qty-input').value || '1', 10);
      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      const idx = cart.findIndex(it => it.productId === currentProduct.id);
      if (idx >= 0) {
        cart[idx].quantity += qty;
      } else {
        cart.push({
          productId: currentProduct.id,
          name: currentProduct.name,
          estimatedPriceRupees: currentProduct.pricePerKgRupees,
          quantity: qty,
          unit: 'kg',
        });
      }

      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      if (typeof updateNavCartBadge === 'function') updateNavCartBadge();

      showDetailToast(`Added ${qty} kg of ${currentProduct.name} to cart.`);
    };

    window.buyNowDetail = function() {
      if (!currentProduct) return;
      const qty = parseInt(document.getElementById('product-qty-input').value || '1', 10);
      let cart = [{
        productId: currentProduct.id,
        name: currentProduct.name,
        estimatedPriceRupees: currentProduct.pricePerKgRupees,
        quantity: qty,
        unit: 'kg',
      }];
      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      if (typeof updateNavCartBadge === 'function') updateNavCartBadge();
      window.location.href = '/farm/checkout';
    };

    function showDetailToast(msg) {
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-2xl bg-[#132215] text-white text-xs font-bold shadow-2xl border border-white/10 animate-bounce flex items-center gap-2';
      toast.innerHTML = `<span>✓</span> <span>${msg}</span>`;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2500);
    }
    // ==========================================
    // Customer Reviews & Photos Client Logic
    // ==========================================
    let allReviews = [];
    let currentFilter = 'all';
    let selectedRating = 5;
    let selectedPhotoBase64 = null;
    let selectedPhotoName = 'review.jpg';

    const RATING_LABELS = {
      5: '5 - Excellent, authentic farm quality',
      4: '4 - Very Good harvest',
      3: '3 - Satisfactory',
      2: '2 - Below expectations',
      1: '1 - Poor'
    };

    async function fetchReviews() {
      const loader = document.getElementById('reviews-loading');
      try {
        const res = await fetch(`/farm/api/reviews?slug=${activeSlug}`);
        const data = await res.json();
        if (loader) loader.classList.add('hidden');

        if (data.success) {
          allReviews = data.reviews || [];
          updateReviewsSummary(data.summary, allReviews);
          renderCustomerPhotos(allReviews);
          applyReviewsFilter();
        }
      } catch (err) {
        if (loader) loader.innerHTML = '<p class="text-xs text-red-500 font-bold">Failed to load reviews.</p>';
      }
    }

    function updateReviewsSummary(summary, reviews) {
      if (!summary) return;
      const total = summary.totalReviews !== undefined ? summary.totalReviews : reviews.length;
      const avg = total > 0 ? Number(summary.averageRating || 0) : 0;
      const scoreEl = document.getElementById('rev-avg-score');
      const starsEl = document.getElementById('rev-avg-stars');
      const countTextEl = document.getElementById('rev-total-count-text');

      if (scoreEl) scoreEl.textContent = total > 0 ? avg.toFixed(1) : '—';
      if (starsEl) starsEl.textContent = '★'.repeat(Math.round(avg)) + '☆'.repeat(5 - Math.round(avg));
      if (countTextEl) countTextEl.textContent = total > 0
        ? `Based on ${total} verified customer review${total === 1 ? '' : 's'}`
        : 'No reviews yet — be the first to review this produce';

      // Synchronize top Amazon badge
      const topStars = document.getElementById('p-top-stars');
      const topNum = document.getElementById('p-top-rating-val');
      const topCount = document.getElementById('p-top-reviews-count');
      if (topStars) topStars.textContent = '★'.repeat(Math.round(avg)) + '☆'.repeat(5 - Math.round(avg));
      if (topNum) topNum.textContent = total > 0 ? avg.toFixed(1) : '';
      if (topCount) topCount.textContent = total > 0 ? `(${total} review${total === 1 ? '' : 's'})` : 'No reviews yet — be the first';

      const dist = summary.distribution || {};
      for (let s = 1; s <= 5; s++) {
        const count = dist[s] || 0;
        const pct = total > 0 ? Math.round((count / total) * 100) : 0;
        const barEl = document.getElementById(`bar-star-${s}`);
        const cntEl = document.getElementById(`count-star-${s}`);
        if (barEl) barEl.style.width = `${pct}%`;
        if (cntEl) cntEl.textContent = `${pct}% (${count})`;
      }
    }

    function renderCustomerPhotos(reviews) {
      const photoReviews = reviews.filter(r => r.photoUrl);
      const box = document.getElementById('customer-photos-box');
      const strip = document.getElementById('photos-strip');
      const label = document.getElementById('photos-count-label');

      if (!box || !strip) return;

      if (photoReviews.length > 0) {
        box.classList.remove('hidden');
        if (label) label.textContent = `${photoReviews.length} photo${photoReviews.length === 1 ? '' : 's'}`;

        strip.innerHTML = photoReviews.map(r => `
          <button
            type="button"
            onclick="openPhotoLightbox('${r.photoUrl}', '${escapeHtml(r.customerName)}', ${r.rating}, '${escapeHtml(r.reviewText)}')"
            class="group relative shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden border border-[#dce7db] shadow-xs cursor-pointer hover:scale-105 transition-transform"
          >
            <img src="${r.photoUrl}" alt="${escapeHtml(r.customerName)}" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-2 text-white">
              <span class="text-[10px] font-bold truncate">${escapeHtml(r.customerName)}</span>
              <span class="text-[9px] text-amber-300">★ ${r.rating}</span>
            </div>
          </button>
        `).join('');
      } else {
        box.classList.add('hidden');
      }
    }

    window.filterReviews = function(filter, btn) {
      currentFilter = filter;
      document.querySelectorAll('.review-filter-btn').forEach(b => {
        b.className = 'review-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer';
      });
      if (btn && btn.classList.contains('review-filter-btn')) {
        btn.className = 'review-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-[#1b4522] text-white shadow-xs cursor-pointer';
      } else {
        const targetBtn = document.querySelector(`.review-filter-btn[data-filter="${filter}"]`);
        if (targetBtn) targetBtn.className = 'review-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-[#1b4522] text-white shadow-xs cursor-pointer';
      }
      applyReviewsFilter();
    };

    function applyReviewsFilter() {
      let filtered = allReviews;
      if (currentFilter === 'photos') {
        filtered = allReviews.filter(r => r.photoUrl);
      } else if (currentFilter === '5star') {
        filtered = allReviews.filter(r => r.rating === 5);
      } else if (currentFilter === '4star') {
        filtered = allReviews.filter(r => r.rating === 4);
      } else if (currentFilter === '3star') {
        filtered = allReviews.filter(r => r.rating === 3);
      }

      const listEl = document.getElementById('reviews-list');
      const emptyEl = document.getElementById('reviews-empty');

      if (!listEl || !emptyEl) return;

      if (filtered.length === 0) {
        listEl.innerHTML = '';
        emptyEl.classList.remove('hidden');
        return;
      }

      emptyEl.classList.add('hidden');
      listEl.innerHTML = filtered.map(r => `
        <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#dce7db] shadow-xs hover:shadow-md transition-shadow space-y-3.5">
          <!-- Amazon Header: User Info & Verified Purchase -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2.5 border-b border-[#f0f5ee]">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#1b4522] to-[#2e6d38] text-white font-black text-sm flex items-center justify-center shadow-xs">
                ${r.customerName ? r.customerName.charAt(0).toUpperCase() : 'C'}
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <strong class="font-black text-sm text-[#122815]">${escapeHtml(r.customerName)}</strong>
                  ${r.isVerified ? `
                    <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">
                      <span class="text-emerald-700">✓</span> Verified Purchase
                    </span>
                  ` : ''}
                </div>
                <div class="text-[11px] text-[#5b6e5d] font-semibold mt-0.5">
                  ${r.customerCity ? `<span>📍 Reviewed in ${escapeHtml(r.customerCity)}</span> • ` : '<span>Reviewed in India</span> • '}
                  <span>${formatReviewDate(r.createdAt)}</span>
                </div>
              </div>
            </div>
            <div class="text-amber-400 font-extrabold text-base tracking-wider">
              ${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}
            </div>
          </div>

          <!-- Product Context Tag (Amazon style) -->
          <div class="inline-flex items-center gap-1.5 text-[11px] font-bold text-[#637765] bg-[#f5f8f4] px-2.5 py-1 rounded-md">
            <span>🌾 Harvest:</span>
            <span class="text-[#194622]">${escapeHtml(r.productName || (currentProduct ? currentProduct.name : 'Raw Produce'))}</span>
            <span>• 100% Unprocessed</span>
          </div>

          <!-- Headline & Review Content -->
          <div class="space-y-1.5">
            ${r.title ? `<h4 class="font-extrabold text-sm text-[#122815] leading-snug">${escapeHtml(r.title)}</h4>` : ''}
            <p class="text-xs sm:text-sm text-[#465b49] leading-relaxed whitespace-pre-line">${escapeHtml(r.reviewText)}</p>
          </div>

          <!-- Photo Thumbnail if present -->
          ${r.photoUrl ? `
            <div class="pt-1">
              <button
                type="button"
                onclick="openPhotoLightbox('${r.photoUrl}', '${escapeHtml(r.customerName)}', ${r.rating}, '${escapeHtml(r.reviewText)}')"
                class="group relative inline-block rounded-2xl overflow-hidden border border-[#dce7db] shadow-xs cursor-pointer max-w-[220px]"
              >
                <img src="${r.photoUrl}" alt="Customer harvest photo" class="w-48 h-36 object-cover group-hover:scale-105 transition-transform duration-300" />
                <span class="absolute bottom-2 right-2 px-2 py-0.5 rounded-full bg-black/75 text-white text-[10px] font-bold backdrop-blur-xs flex items-center gap-1">
                  <span>🔍</span> View Full Photo
                </span>
              </button>
            </div>
          ` : ''}

          <!-- Amazon-Style Helpful Action Bar -->
          <div class="flex items-center gap-4 pt-2.5 border-t border-[#f4f7f2] text-xs text-[#5b6e5d]">
            <button type="button" onclick="voteHelpful(this)" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg border border-[#dce7db] bg-white hover:bg-emerald-50 font-bold text-[11px] text-[#194622] transition-colors cursor-pointer shadow-2xs">
              <span>👍</span> Helpful
            </button>
            <span class="text-[11px] text-[#718473]">Direct farm community feedback</span>
          </div>
        </div>
      `).join('');
    }

    window.voteHelpful = function(btn) {
      btn.innerHTML = '<span>✓</span> Marked Helpful';
      btn.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-300');
      btn.disabled = true;
      showDetailToast('Thank you for your feedback!');
    };

    function formatReviewDate(dateStr) {
      if (!dateStr) return 'Recently';
      try {
        const d = new Date(dateStr);
        return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      } catch (_) {
        return 'Recently';
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Modal & Interactive Controls
    window.openWriteReviewModal = function() {
      const modal = document.getElementById('modal-write-review');
      const prodNameEl = document.getElementById('modal-review-product-name');
      const errBox = document.getElementById('rev-error-box');

      if (errBox) errBox.classList.add('hidden');
      if (prodNameEl && currentProduct) {
        prodNameEl.textContent = currentProduct.name;
      }
      const prodImgEl = document.getElementById('modal-review-product-img');
      if (prodImgEl && currentProduct) {
        prodImgEl.src = currentProduct.imageUrl || '/farm/images/wheat-500.jpg';
      }

      // Pre-fill user profile if logged in
      fetch('/farm/api/auth/me').then(r => r.json()).then(data => {
        if (data.success && data.user) {
          const nameInput = document.getElementById('rev-input-name');
          const phoneInput = document.getElementById('rev-input-phone');
          if (nameInput && !nameInput.value) nameInput.value = data.user.name;
          if (phoneInput && !phoneInput.value) phoneInput.value = data.user.phone;
        }
      }).catch(() => {});

      const bottomNav = document.getElementById('fd-bottom-nav');
      if (bottomNav) bottomNav.style.display = 'none';
      if (modal) modal.classList.remove('hidden');
    };

    window.closeWriteReviewModal = function() {
      const modal = document.getElementById('modal-write-review');
      const bottomNav = document.getElementById('fd-bottom-nav');
      if (bottomNav) bottomNav.style.display = '';
      if (modal) modal.classList.add('hidden');
    };

    window.setPickerRating = function(rating) {
      selectedRating = rating;
      const labelEl = document.getElementById('star-picker-label');
      if (labelEl) labelEl.textContent = RATING_LABELS[rating] || `${rating} Stars`;

      document.querySelectorAll('#star-picker .star-btn').forEach(btn => {
        const val = parseInt(btn.getAttribute('data-val') || '1', 10);
        if (val <= rating) {
          btn.className = 'star-btn text-amber-400 transition-transform hover:scale-125';
        } else {
          btn.className = 'star-btn text-gray-300 transition-transform hover:scale-125';
        }
      });
    };

    window.updateReviewCharCount = function(textarea) {
      const countEl = document.getElementById('rev-char-count');
      if (countEl) countEl.textContent = `${textarea.value.length} / 1000`;
    };

    // Downscale + re-encode photos in the browser so phone camera images (3–8MB)
    // become ~150–400KB before upload.
    function compressReviewImage(file, maxDim = 1280, quality = 0.8) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          URL.revokeObjectURL(url);
          const scale = Math.min(1, maxDim / Math.max(img.width, img.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);
          const ctx = canvas.getContext('2d');
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          let dataUrl = canvas.toDataURL('image/jpeg', quality);
          if (dataUrl.length > 1200 * 1024) dataUrl = canvas.toDataURL('image/jpeg', 0.6);
          resolve(dataUrl);
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('decode')); };
        img.src = url;
      });
    }

    window.handleReviewPhotoSelect = async function(input) {
      const file = input.files && input.files[0];
      if (!file) return;

      if (file.size > 20 * 1024 * 1024) {
        alert('Photo is larger than 20MB. Please choose a smaller image.');
        input.value = '';
        return;
      }

      let dataUrl;
      try {
        dataUrl = await compressReviewImage(file);
      } catch (_) {
        alert('This photo format could not be read. Please choose a JPG or PNG photo.');
        input.value = '';
        return;
      }

      selectedPhotoBase64 = dataUrl;
      selectedPhotoName = (file.name || 'review').replace(/\.[^.]+$/, '') + '.jpg';
      const sizeKb = Math.round((dataUrl.length * 3) / 4 / 1024);
      document.getElementById('dropzone-empty-state').classList.add('hidden');
      document.getElementById('dropzone-preview-state').classList.remove('hidden');
      document.getElementById('rev-preview-img').src = dataUrl;
      document.getElementById('rev-preview-filename').textContent = file.name;
      document.getElementById('rev-preview-filesize').textContent = `${sizeKb} KB (optimized)`;
    };

    window.removeReviewPhoto = function(e) {
      if (e) e.stopPropagation();
      selectedPhotoBase64 = null;
      document.getElementById('rev-file-input').value = '';
      document.getElementById('dropzone-preview-state').classList.add('hidden');
      document.getElementById('dropzone-empty-state').classList.remove('hidden');
    };

    window.submitCustomerReview = async function(event) {
      event.preventDefault();
      const btn = document.getElementById('btn-submit-review');
      const errBox = document.getElementById('rev-error-box');
      if (errBox) errBox.classList.add('hidden');

      const name = document.getElementById('rev-input-name').value.trim();
      const city = document.getElementById('rev-input-city').value.trim();
      const phone = document.getElementById('rev-input-phone').value.trim();
      const title = document.getElementById('rev-input-title').value.trim();
      const reviewText = document.getElementById('rev-input-text').value.trim();

      if (!reviewText || reviewText.length < 5) {
        if (errBox) {
          errBox.textContent = 'Please write at least a few words describing your experience.';
          errBox.classList.remove('hidden');
        }
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Submitting Review...';

      try {
        const payload = {
          product_id: currentProduct ? currentProduct.id : null,
          product_slug: activeSlug,
          rating: selectedRating,
          title: title,
          review_text: reviewText,
          customer_name: name,
          customer_city: city,
          customer_phone: phone,
          photo_base64: selectedPhotoBase64,
          photo_name: selectedPhotoName
        };

        const res = await fetch('/farm/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (!data.success) {
          if (errBox) {
            errBox.textContent = data.error || 'Failed to submit review.';
            errBox.classList.remove('hidden');
          }
          btn.disabled = false;
          btn.textContent = 'Publish Review & Photo →';
          return;
        }

        closeWriteReviewModal();
        showDetailToast('Review published! Thank you for supporting village farming.');
        // Reset form
        document.getElementById('review-form').reset();
        removeReviewPhoto();
        setPickerRating(5);
        btn.disabled = false;
        btn.textContent = 'Publish Review & Photo →';

        // Reload reviews feed
        fetchReviews();
      } catch (err) {
        if (errBox) {
          errBox.textContent = 'Network error while submitting review. Please try again.';
          errBox.classList.remove('hidden');
        }
        btn.disabled = false;
        btn.textContent = 'Publish Review & Photo →';
      }
    };

    // Lightbox Controls
    window.openPhotoLightbox = function(url, author, rating, caption) {
      document.getElementById('lightbox-img').src = url;
      document.getElementById('lightbox-author').textContent = author;
      document.getElementById('lightbox-stars').textContent = '★'.repeat(rating || 5);
      document.getElementById('lightbox-caption').textContent = caption || '';
      document.getElementById('modal-photo-lightbox').classList.remove('hidden');
    };

    window.closePhotoLightbox = function() {
      document.getElementById('modal-photo-lightbox').classList.add('hidden');
    };

    function initPage() {
      fetchProduct();
      fetchReviews();
    }

    document.addEventListener('DOMContentLoaded', initPage);
  </script>
</FarmLayout>
