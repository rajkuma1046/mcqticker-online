    // Downscale + re-encode photos in the browser so phone camera images (3–8MB)
    // become ~150–400KB before upload.
    function compressReviewImage(file, maxDim = 1280, quality = 0.8) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          URL.revokeObjectURL(url);
          const scale = Math.min(1, maxDim / Math.max(img.width, img.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);
          const ctx = canvas.getContext('2d');
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          let dataUrl = canvas.toDataURL('image/jpeg', quality);
          if (dataUrl.length > 1200 * 1024) dataUrl = canvas.toDataURL('image/jpeg', 0.6);
          resolve(dataUrl);
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('decode')); };
        img.src = url;
      });
    }

    window.handleReviewPhotoSelect = async function(input) {
      const file = input.files && input.files[0];
      if (!file) return;

      if (file.size > 20 * 1024 * 1024) {
        alert('फोटो 20MB से बड़ी है। कृपया छोटी फोटो चुनें।');
        input.value = '';
        return;
      }

      let dataUrl;
      try {
        dataUrl = await compressReviewImage(file);
      } catch (_) {
        alert('यह फोटो पढ़ी नहीं जा सकी। कृपया JPG या PNG फोटो चुनें।');
        input.value = '';
        return;
      }

      selectedPhotoBase64 = dataUrl;
      selectedPhotoName = (file.name || 'review').replace(/\.[^.]+$/, '') + '.jpg';
      const sizeKb = Math.round((dataUrl.length * 3) / 4 / 1024);
      document.getElementById('dropzone-empty-state').classList.add('hidden');
      document.getElementById('dropzone-preview-state').classList.remove('hidden');
      document.getElementById('rev-preview-img').src = dataUrl;
      document.getElementById('rev-preview-filename').textContent = file.name;
      document.getElementById('rev-preview-filesize').textContent = `${sizeKb} KB (optimized)`;
    };

    window.removeReviewPhoto = function(e) {
      if (e) e.stopPropagation();
      selectedPhotoBase64 = null;
      document.getElementById('rev-file-input').value = '';
      document.getElementById('dropzone-preview-state').classList.add('hidden');
      document.getElementById('dropzone-empty-state').classList.remove('hidden');
    };

    window.submitCustomerReview = async function(event) {
      event.preventDefault();
      const btn = document.getElementById('btn-submit-review');
      const errBox = document.getElementById('rev-error-box');
      if (errBox) errBox.classList.add('hidden');

      const name = document.getElementById('rev-input-name').value.trim();
      const city = document.getElementById('rev-input-city').value.trim();
      const phone = document.getElementById('rev-input-phone').value.trim();
      const title = document.getElementById('rev-input-title').value.trim();
      const reviewText = document.getElementById('rev-input-text').value.trim();

      if (!reviewText || reviewText.length < 5) {
        if (errBox) {
          errBox.textContent = 'कृपया अपने अनुभव का विवरण कम से कम 5 अक्षरों में लिखें।';
          errBox.classList.remove('hidden');
        }
        return;
      }

      btn.disabled = true;
      btn.textContent = 'समीक्षा प्रकाशित हो रही है... (Submitting...)';

      try {
        const payload = {
          product_id: currentProduct ? currentProduct.id : null,
          product_slug: activeSlug,
          rating: selectedRating,
          title: title,
          review_text: reviewText,
          customer_name: name,
          customer_city: city,
          customer_phone: phone,
          photo_base64: selectedPhotoBase64,
          photo_name: selectedPhotoName
        };

        const res = await fetch('/farm/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (!data.success) {
          if (errBox) {
            errBox.textContent = data.error || 'समीक्षा जमा करने में विफलता हुई।';
            errBox.classList.remove('hidden');
          }
          btn.disabled = false;
          btn.textContent = 'समीक्षा व फोटो प्रकाशित करें • Publish Review →';
          return;
        }

        closeWriteReviewModal();
        showDetailToast('समीक्षा प्रकाशित हो गई! गाँव की खेती का समर्थन करने के लिए धन्यवाद।');
        // Reset form
        document.getElementById('review-form').reset();
        removeReviewPhoto();
        setPickerRating(5);
        btn.disabled = false;
        btn.textContent = 'समीक्षा व फोटो प्रकाशित करें • Publish Review →';

        // Reload reviews feed
        fetchReviews();
      } catch (err) {
        if (errBox) {
          errBox.textContent = 'नेटवर्क समस्या। कृपया पुनः प्रयास करें।';
          errBox.classList.remove('hidden');
        }
        btn.disabled = false;
        btn.textContent = 'समीक्षा व फोटो प्रकाशित करें • Publish Review →';
      }
    };

    // Lightbox Controls
    window.openPhotoLightbox = function(url, author, rating, caption) {
      document.getElementById('lightbox-img').src = url;
      document.getElementById('lightbox-author').textContent = author;
      document.getElementById('lightbox-stars').textContent = '★'.repeat(rating || 5);
      document.getElementById('lightbox-caption').textContent = caption || '';
      document.getElementById('modal-photo-lightbox').classList.remove('hidden');
    };

    window.closePhotoLightbox = function() {
      document.getElementById('modal-photo-lightbox').classList.add('hidden');
    };

    function initPage() {
      fetchProduct();
      fetchReviews();
    }

    document.addEventListener('DOMContentLoaded', initPage);
  </script>
</FarmLayout>
