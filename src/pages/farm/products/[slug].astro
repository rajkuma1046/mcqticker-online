---
import FarmLayout from '../../../layouts/FarmLayout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'farm-wheat' } },
    { params: { slug: 'raw-groundnut' } },
    { params: { slug: 'raw-chana' } },
    { params: { slug: 'raw-moong' } },
    { params: { slug: 'raw-urad' } },
    { params: { slug: 'seasonal-farm-produce' } },
  ];
}

const { slug } = Astro.params;
---

<FarmLayout
  title={`Farm Direct | Produce Detail`}
  description="Fresh raw agricultural produce directly from our farm for neighbourhood delivery in Gwalior."
  canonicalPath={`/farm/products/${slug}`}
>
  <div class="fd-container py-8 sm:py-14">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[#536354] mb-6">
      <a href="/farm" class="hover:text-[#275629]">Home</a>
      <span>/</span>
      <a href="/farm/products" class="hover:text-[#275629]">Produce</a>
      <span>/</span>
      <span id="breadcrumb-title" class="font-semibold text-[#1a251b]">Loading...</span>
    </nav>

    <!-- Product Detail Container -->
    <div id="product-loading" class="text-center py-20 text-[#536354]">
      <div class="inline-block animate-spin w-8 h-8 border-4 border-[#275629] border-t-transparent rounded-full mb-3"></div>
      <p class="text-sm font-semibold">Retrieving authoritative live stock and pricing from farm database...</p>
    </div>

    <div id="product-content" class="hidden">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 bg-white p-6 sm:p-10 rounded-2xl border border-[#e0e8dc] shadow-sm">
        <!-- Image Column -->
        <div class="md:col-span-6 space-y-4">
          <div class="relative rounded-xl overflow-hidden bg-[#f0f4ee] border border-[#e0e8dc] aspect-square">
            <img
              id="p-image"
              src=""
              alt=""
              class="w-full h-full object-cover"
            />
            <div class="absolute top-3 left-3 flex flex-col gap-1.5 items-start">
              <span id="p-badge" class="fd-badge fd-badge-raw shadow-sm">Raw / Unprocessed</span>
              <span id="p-local" class="hidden text-xs font-semibold px-2.5 py-0.5 rounded-full bg-black/60 text-white backdrop-blur-sm"></span>
            </div>
            <div id="p-out-banner" class="hidden absolute inset-0 bg-black/40 backdrop-blur-[1px] flex items-center justify-center">
              <span class="fd-badge fd-badge-out px-5 py-2 text-sm font-bold shadow-lg">Out of Stock</span>
            </div>
          </div>

          <!-- Quality Transparency Card -->
          <div class="p-4 rounded-xl bg-[#f8faf6] border border-[#e5ede2] text-xs space-y-2 text-[#536354]">
            <div class="font-bold text-[#152317] flex items-center gap-1.5">
              <span>🌾</span>
              <span>Farm Produce Notice</span>
            </div>
            <p>
              This is raw, minimally handled agricultural produce threshed and sun-dried at our farm. It has not been subjected to industrial polishing, bleaching, or chemical processing.
            </p>
          </div>
        </div>

        <!-- Details & Buying Column -->
        <div class="md:col-span-6 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div>
              <span id="p-category" class="text-xs uppercase tracking-wider text-[#275629] font-bold">Raw Farm Grain</span>
              <h1 id="p-name" class="fd-serif text-3xl sm:text-4xl font-bold text-[#152317] mt-1"></h1>
            </div>

            <div class="flex items-baseline gap-3">
              <span id="p-price" class="text-3xl font-bold text-[#275629]"></span>
              <span class="text-xs text-[#536354] font-medium">Live database rate</span>
            </div>

            <div class="p-3.5 rounded-lg bg-[#f0f4ee] border border-[#e0e8dc] flex items-center justify-between text-xs sm:text-sm">
              <span class="text-[#536354]">Current Farm Availability:</span>
              <strong id="p-stock" class="text-[#275629] font-bold text-sm"></strong>
            </div>

            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-[#536354] mb-1.5">Produce Description</h3>
              <p id="p-desc" class="text-sm text-[#415343] leading-relaxed"></p>
            </div>

            <!-- Quantity Preset Buttons -->
            <div id="p-presets-container" class="space-y-2 pt-2">
              <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block">Select Quantity</label>
              <div id="p-presets" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Quantity Counter -->
            <div class="flex items-center gap-3 pt-2">
              <span class="text-xs font-bold text-[#536354]">Adjust:</span>
              <div class="flex items-center border border-[#c5d6c4] rounded-lg overflow-hidden bg-white">
                <button type="button" class="px-3 py-1.5 text-base font-bold text-[#275629] hover:bg-[#f0f4ee]" onclick="adjustProductQty(-1)">−</button>
                <input id="product-qty-input" type="number" min="1" value="1" class="w-16 text-center text-sm font-bold py-1.5 border-x border-[#c5d6c4] focus:outline-none" readonly />
                <button type="button" class="px-3 py-1.5 text-base font-bold text-[#275629] hover:bg-[#f0f4ee]" onclick="adjustProductQty(1)">+</button>
              </div>
              <span class="text-xs font-bold text-[#536354]">kg</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-4 pt-4 border-t border-[#e8efe6]">
            <div id="action-buttons-group" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <button id="btn-add-cart" type="button" class="fd-btn fd-btn-secondary w-full py-3.5 font-bold text-sm shadow-sm" onclick="addToCartDetail()">
                Add to Cart
              </button>
              <button id="btn-buy-now" type="button" class="fd-btn fd-btn-primary w-full py-3.5 font-bold text-sm shadow-sm" onclick="buyNowDetail()">
                Buy Now
              </button>
            </div>

            <!-- Free Sample Option Callout -->
            <div id="sample-box" class="hidden p-4 rounded-xl bg-[#fdf6ec] border border-[#f5dfb8] space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-[#b07a33]">Not sure about the quality?</span>
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-[#faecd6] text-[#8d5e1b]">₹0 Free Sample</span>
              </div>
              <p class="text-xs text-[#704f1f] leading-relaxed">
                Request a free 100g or 200g sample. Delivered during our scheduled neighborhood sample rounds in Pawan Nagar & Chetakpuri.
              </p>
              <a id="btn-sample" href="#" class="fd-btn bg-[#c48a3f] text-white hover:bg-[#b07a33] fd-btn-sm w-full font-bold mt-1">
                Request Free Sample (100g / 200g) &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ slug }}>
    let currentProduct = null;

    async function fetchProduct() {
      const loader = document.getElementById('product-loading');
      const content = document.getElementById('product-content');

      try {
        const res = await fetch(`/farm/api/products/${slug}`);
        const data = await res.json();

        if (!data.success || !data.product) {
          loader.innerHTML = '<p class="text-sm text-red-600 font-semibold">Product not found. <a href="/farm/products" class="underline">View all produce</a></p>';
          return;
        }

        currentProduct = data.product;
        loader.classList.add('hidden');
        content.classList.remove('hidden');

        // Populate fields
        document.getElementById('breadcrumb-title').textContent = currentProduct.name;
        document.getElementById('p-name').textContent = currentProduct.name;
        document.getElementById('p-desc').textContent = currentProduct.description;
        document.getElementById('p-image').src = currentProduct.imageUrl || '/farm/images/wheat-960.jpg';
        document.getElementById('p-image').alt = currentProduct.imageAlt || currentProduct.name;

        if (currentProduct.pricePerKgRupees !== null) {
          document.getElementById('p-price').textContent = `₹${currentProduct.pricePerKgRupees}/kg`;
        } else {
          document.getElementById('p-price').textContent = 'Configurable Rate';
        }

        const stockEl = document.getElementById('p-stock');
        const isOut = currentProduct.isOutOfStock;
        if (isOut) {
          stockEl.textContent = 'Out of Stock';
          stockEl.classList.add('text-red-600');
          document.getElementById('p-out-banner').classList.remove('hidden');
          document.getElementById('action-buttons-group').innerHTML = `
            <div class="col-span-2 text-center p-3 rounded-lg bg-red-50 text-red-700 font-bold text-sm">
              This produce is currently sold out. New harvest will be updated soon.
            </div>
          `;
        } else {
          stockEl.textContent = `${currentProduct.quantityAvailable} kg available`;
        }

        if (currentProduct.localName) {
          const localEl = document.getElementById('p-local');
          localEl.textContent = currentProduct.localName;
          localEl.classList.remove('hidden');
        }

        if (currentProduct.isSeasonal) {
          const badge = document.getElementById('p-badge');
          badge.className = 'fd-badge fd-badge-seasonal shadow-sm';
          badge.textContent = 'Seasonal Harvest';
        }

        // Preset buttons
        const presets = currentProduct.quantityOptions || [1, 5, 10];
        const presetsEl = document.getElementById('p-presets');
        presetsEl.innerHTML = presets.map((kg, i) => `
          <button type="button" class="preset-btn px-4 py-2 text-xs font-bold rounded-lg border border-[#c5d6c4] bg-white text-[#1a251b] hover:bg-[#eaf3e9] transition-all ${i === 0 ? 'bg-[#275629] text-white border-[#275629]' : ''}" onclick="selectPreset(${kg}, this)">
            ${kg} kg
          </button>
        `).join('');

        // Free sample
        if (currentProduct.sampleAvailable) {
          const sampleBox = document.getElementById('sample-box');
          const sampleBtn = document.getElementById('btn-sample');
          sampleBox.classList.remove('hidden');
          sampleBtn.href = `/farm/samples?product_id=${currentProduct.id}`;
        }
      } catch (e) {
        loader.innerHTML = '<p class="text-sm text-red-600">Failed to load product details. Please check your connection.</p>';
      }
    }

    window.selectPreset = function(kg, btn) {
      document.getElementById('product-qty-input').value = kg;
      document.querySelectorAll('.preset-btn').forEach(b => {
        b.className = 'preset-btn px-4 py-2 text-xs font-bold rounded-lg border border-[#c5d6c4] bg-white text-[#1a251b] hover:bg-[#eaf3e9] transition-all';
      });
      btn.className = 'preset-btn px-4 py-2 text-xs font-bold rounded-lg border border-[#275629] bg-[#275629] text-white transition-all';
    };

    window.adjustProductQty = function(delta) {
      const input = document.getElementById('product-qty-input');
      let val = parseInt(input.value || '1', 10) + delta;
      if (val < 1) val = 1;
      if (currentProduct && val > currentProduct.quantityAvailable) val = currentProduct.quantityAvailable;
      input.value = val;
    };

    window.addToCartDetail = function() {
      if (!currentProduct) return;
      const qty = parseInt(document.getElementById('product-qty-input').value || '1', 10);
      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      const idx = cart.findIndex(it => it.productId === currentProduct.id);
      if (idx >= 0) {
        cart[idx].quantity += qty;
      } else {
        cart.push({
          productId: currentProduct.id,
          productName: currentProduct.name,
          priceRupees: currentProduct.pricePerKgRupees,
          quantity: qty,
        });
      }

      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      if (window.fdUpdateCart) window.fdUpdateCart();
      alert(`Added ${qty} kg of ${currentProduct.name} to your cart.`);
    };

    window.buyNowDetail = function() {
      if (!currentProduct) return;
      const qty = parseInt(document.getElementById('product-qty-input').value || '1', 10);
      let cart = [{
        productId: currentProduct.id,
        productName: currentProduct.name,
        priceRupees: currentProduct.pricePerKgRupees,
        quantity: qty,
      }];
      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      if (window.fdUpdateCart) window.fdUpdateCart();
      window.location.href = '/farm/checkout';
    };

    document.addEventListener('DOMContentLoaded', fetchProduct);
  </script>
</FarmLayout>
