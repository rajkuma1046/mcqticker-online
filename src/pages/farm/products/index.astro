---
import FarmLayout from '../../../layouts/FarmLayout.astro';

// Produce Catalogue — Modern Direct-from-Farm Experience
---

<FarmLayout
  title="Raw Farm Produce Catalogue | Farm Direct"
  description="Order 100% raw, unpolished wheat, raw groundnut, desi chana, whole moong, raw urad, and seasonal farm produce. Direct village harvest delivered to Pawan Nagar & Chetakpuri, Gwalior."
  canonicalPath="/farm/products"
>
  <div class="fd-container py-8 sm:py-16">
    <!-- Editorial Hero Banner -->
    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-[#122815] via-[#1a3f20] to-[#0d1f11] text-white p-6 sm:p-12 mb-10 shadow-xl border border-emerald-900/40">
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold border border-emerald-400/30 mb-4 backdrop-blur-sm">
          <span>🌾</span>
          <span>100% Raw • Naturally Sun-Dried • Zero Polishing</span>
        </div>
        <h1 class="fd-display text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Field-Direct Farm Produce
        </h1>
        <p class="text-sm sm:text-base text-emerald-100/80 mt-3 max-w-2xl leading-relaxed">
          Grown in fertile village soils surrounding Gwalior. Harvested, winnowed, and pre-ordered for scheduled consolidated Sunday delivery in <strong class="text-white underline decoration-emerald-400">Pawan Nagar</strong> and <strong class="text-white underline decoration-emerald-400">Chetakpuri</strong>.
        </p>

        <!-- Fast Guarantees Pill Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-8 pt-6 border-t border-emerald-800/60 text-xs font-semibold text-emerald-200">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span> Direct Village Farm
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span> Authoritative Live Prices
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span> Free 100g/200g Samples
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span> Pay on Delivery (UPI/Cash)
          </div>
        </div>
      </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="bg-white/90 backdrop-blur-md p-4 sm:p-5 rounded-2xl border border-[#e2ece0] shadow-sm mb-8 space-y-4">
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
        <!-- Modern Pill Filter Buttons -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0 scrollbar-none" id="cat-filters">
          <button type="button" class="cat-pill active-pill whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all" onclick="filterCategory('all', this)">
            All Harvest
          </button>
          <button type="button" class="cat-pill inactive-pill whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all" onclick="filterCategory('grain', this)">
            🌾 Grains
          </button>
          <button type="button" class="cat-pill inactive-pill whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all" onclick="filterCategory('pulse', this)">
            🫘 Pulses & Chana
          </button>
          <button type="button" class="cat-pill inactive-pill whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all" onclick="filterCategory('oilseed', this)">
            🥜 Oilseeds (Groundnut)
          </button>
          <button type="button" class="cat-pill inactive-pill whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all" onclick="filterCategory('seasonal', this)">
            🥬 Seasonal
          </button>
        </div>

        <!-- Search Input with Clear Button -->
        <div class="relative w-full lg:w-72">
          <input
            id="search-input"
            type="text"
            placeholder="Search wheat, chana, moong..."
            class="w-full pl-9 pr-8 py-2.5 rounded-xl border border-[#d6e3d4] bg-[#f8faf7] text-xs font-semibold text-[#152317] placeholder:text-[#8ba08c] focus:outline-none focus:bg-white focus:border-[#1b4522] focus:ring-2 focus:ring-[#1b4522]/10 transition-all"
            oninput="handleSearch()"
          />
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#798e7b]">🔍</span>
          <button id="search-clear" type="button" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 text-xs font-bold px-1" onclick="clearSearch()">✕</button>
        </div>
      </div>

      <!-- Live Count Sub-bar -->
      <div class="flex items-center justify-between text-xs text-[#5b6e5d] pt-2 border-t border-[#edf3ec]">
        <div id="results-count" class="font-semibold">Loading available harvest...</div>
        <div class="flex items-center gap-1.5 text-[11px] font-bold text-emerald-800">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Next Scheduled Dispatch: Sunday 8:00 AM</span>
        </div>
      </div>
    </div>

    <!-- Loading Skeleton Grid -->
    <div id="catalog-skeleton" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {[1, 2, 3, 4, 5, 6].map(() => (
        <div class="bg-white rounded-3xl border border-[#e2ece0] p-4 space-y-4 animate-pulse">
          <div class="w-full h-56 bg-neutral-200/70 rounded-2xl"></div>
          <div class="h-6 bg-neutral-200/70 rounded-lg w-3/4"></div>
          <div class="h-4 bg-neutral-200/70 rounded-lg w-1/2"></div>
          <div class="h-10 bg-neutral-200/70 rounded-xl w-full"></div>
        </div>
      ))}
    </div>

    <!-- Active Product Cards Grid -->
    <div id="catalog-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"></div>

    <!-- Empty State -->
    <div id="catalog-empty" class="hidden text-center py-20 bg-white rounded-3xl border border-[#e2ece0] p-8 max-w-lg mx-auto shadow-sm">
      <div class="w-16 h-16 bg-emerald-50 text-[#1b4522] rounded-full flex items-center justify-center text-3xl mx-auto mb-4">🌾</div>
      <h3 class="fd-display text-xl font-bold text-[#152317]">No Matching Produce Found</h3>
      <p class="text-xs text-[#5b6e5d] mt-2 mb-6">
        We could not find any produce matching your current filter. Clear your search or explore other harvest categories.
      </p>
      <button type="button" class="fd-btn fd-btn-primary fd-btn-sm" onclick="clearFilters()">
        Show All Produce
      </button>
    </div>
  </div>

  <style>
    .cat-pill {
      border: 1px solid #d9e6d7;
    }
    .active-pill {
      background: #1b4522;
      color: #ffffff;
      border-color: #1b4522;
      box-shadow: 0 3px 10px rgba(27, 69, 34, 0.2);
    }
    .inactive-pill {
      background: #f4f8f3;
      color: #2e4331;
    }
    .inactive-pill:hover {
      background: #e6efe5;
      color: #152317;
    }
  </style>

  <script is:inline>
    let productsList = [];
    let activeFilter = 'all';

    function renderCategoryFilters() {
      const container = document.getElementById('cat-filters');
      if (!container) return;

      const categoryMeta = {
        grain: { label: 'Grains', icon: '🌾' },
        pulse: { label: 'Pulses & Chana', icon: '🫘' },
        oilseed: { label: 'Oilseeds', icon: '🥜' },
        seasonal: { label: 'Seasonal', icon: '🥬' },
        fruit: { label: 'Fruits', icon: '🍎' },
        fruits: { label: 'Fruits', icon: '🍎' },
        vegetable: { label: 'Vegetables', icon: '🥕' },
        vegetables: { label: 'Vegetables', icon: '🥕' },
        spice: { label: 'Spices', icon: '🌶️' },
        spices: { label: 'Spices', icon: '🌶️' },
        dairy: { label: 'Dairy', icon: '🥛' },
        sweetener: { label: 'Sweeteners', icon: '🍯' },
        herb: { label: 'Herbs', icon: '🌿' },
        herbs: { label: 'Herbs', icon: '🌿' }
      };

      const uniqueCats = new Set();
      const defaultOrder = ['grain', 'pulse', 'oilseed', 'seasonal'];
      productsList.forEach(p => {
        if (p.category) uniqueCats.add(p.category.toLowerCase().trim());
      });

      const orderedCats = [];
      defaultOrder.forEach(c => {
        if (uniqueCats.has(c)) {
          orderedCats.push(c);
          uniqueCats.delete(c);
        }
      });
      uniqueCats.forEach(c => orderedCats.push(c));

      let html = `<button type="button" class="cat-pill ${activeFilter === 'all' ? 'active-pill' : 'inactive-pill'} whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer" onclick="filterCategory('all', this)">All Harvest</button>`;

      orderedCats.forEach(cat => {
        const meta = categoryMeta[cat];
        const label = meta ? `${meta.icon} ${meta.label}` : `🌱 ${cat.charAt(0).toUpperCase() + cat.slice(1)}`;
        const isActive = activeFilter === cat;
        html += `<button type="button" class="cat-pill ${isActive ? 'active-pill' : 'inactive-pill'} whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer" onclick="filterCategory('${cat}', this)">${label}</button>`;
      });

      container.innerHTML = html;
    }

    async function loadProducts() {
      const skeleton = document.getElementById('catalog-skeleton');
      const grid = document.getElementById('catalog-grid');
      const countEl = document.getElementById('results-count');

      try {
        const res = await fetch('/farm/api/products');
        const data = await res.json();

        if (data.success && data.products) {
          productsList = data.products;
          renderCategoryFilters();
          skeleton.classList.add('hidden');
          grid.classList.remove('hidden');
          renderList();
        } else {
          skeleton.innerHTML = '<div class="col-span-full text-center py-12 text-red-600 font-bold">Failed to load harvest catalogue. Please refresh.</div>';
        }
      } catch (err) {
        skeleton.innerHTML = '<div class="col-span-full text-center py-12 text-red-600 font-bold">Network error. Please check your connection.</div>';
      }
    }

    function renderList() {
      const grid = document.getElementById('catalog-grid');
      const empty = document.getElementById('catalog-empty');
      const countEl = document.getElementById('results-count');
      const query = (document.getElementById('search-input')?.value || '').toLowerCase().trim();

      const filtered = productsList.filter(p => {
        const matchCat = activeFilter === 'all'
          ? true
          : (activeFilter === 'seasonal' ? (p.isSeasonal || p.category === 'seasonal') : p.category === activeFilter);
        const matchQuery = !query ||
          p.name.toLowerCase().includes(query) ||
          (p.localName && p.localName.toLowerCase().includes(query)) ||
          p.description.toLowerCase().includes(query);
        return matchCat && matchQuery;
      });

      countEl.textContent = `Showing ${filtered.length} farm harvest ${filtered.length === 1 ? 'item' : 'items'}`;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');

      grid.innerHTML = filtered.map(p => {
        const isSoldOut = p.isOutOfStock || (p.quantityAvailable !== null && p.quantityAvailable <= 0);
        const defaultQty = (p.quantityOptions && p.quantityOptions[0]) || 1;
        const price = p.pricePerKgRupees;
        const lowStock = !isSoldOut && p.quantityAvailable && p.quantityAvailable < 20;

        return `
          <div class="bg-white rounded-2xl border border-[#d6e2d4] overflow-hidden shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between ${isSoldOut ? 'opacity-85' : ''}">
            <div>
              <!-- Top Image Area matching Screenshot -->
              <div class="relative w-full h-48 sm:h-52 bg-[#d7e2d5] flex items-center justify-center overflow-hidden">
                <!-- Top-left pill: Raw / Unprocessed -->
                <span class="absolute top-3 left-3 bg-[#243527] text-white text-[11px] font-semibold px-2.5 py-1 rounded-md shadow-xs z-10">
                  ${p.label || (p.isSeasonal ? 'Seasonal Harvest' : 'Raw / Unprocessed')}
                </span>

                <!-- Bottom-right pill: Available: 85 kg -->
                <span class="absolute bottom-3 right-3 bg-white/95 text-[#132215] text-[11px] font-bold px-2.5 py-1 rounded-md shadow-xs border border-black/5 z-10">
                  ${isSoldOut ? 'Sold Out' : `Available: ${p.quantityAvailable !== null ? `${p.quantityAvailable} kg` : 'In Stock'}`}
                </span>

                <a href="/farm/products/${p.slug}" class="block w-full h-full relative group">
                  <img
                    src="${p.imageUrl || '/farm/images/wheat-960.jpg'}"
                    alt="${p.name}"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                    loading="lazy"
                  />
                  <!-- Subtle centered name overlay matching mobile screenshot -->
                  <div class="absolute inset-0 bg-[#1c3820]/15 flex items-center justify-center p-4">
                    <span class="font-extrabold text-[#194622] text-lg sm:text-xl drop-shadow-sm text-center">
                      ${p.name}
                    </span>
                  </div>
                </a>

                ${isSoldOut ? `
                  <div class="absolute inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-20">
                    <span class="px-4 py-1.5 rounded-lg bg-red-600 text-white font-black text-xs uppercase tracking-wider shadow-md">
                      Sold Out
                    </span>
                  </div>
                ` : ''}
              </div>

              <!-- Product Card Body -->
              <div class="p-4 space-y-2">
                <!-- Title & Hindi Name Line -->
                <div class="flex items-center justify-between gap-2">
                  <h2 class="text-base sm:text-lg font-black text-[#132215] truncate">
                    <a href="/farm/products/${p.slug}" class="hover:text-[#194622] transition-colors">
                      ${p.name}
                    </a>
                  </h2>
                  ${p.localName ? `
                    <span class="text-xs sm:text-sm font-bold text-[#8c5324] whitespace-nowrap">
                      ${p.localName}
                    </span>
                  ` : ''}
                </div>

                <!-- Amazon-Style Rating Snippet -->
                <div class="flex items-center gap-1.5 text-xs">
                  <a href="/farm/products/${p.slug}#reviews-section" class="inline-flex items-center gap-1 group hover:underline">
                    <span class="text-amber-400 text-xs tracking-tight">${'★'.repeat(Math.round(p.avgRating || 5))}${'☆'.repeat(5 - Math.round(p.avgRating || 5))}</span>
                    <span class="font-extrabold text-[#132215] text-[11px]">${(p.avgRating || 5.0).toFixed(1)}</span>
                    <span class="text-emerald-800 font-bold text-[11px] group-hover:text-emerald-950">(${p.reviewCount || 0} reviews)</span>
                  </a>
                  <span class="text-[10px] text-[#8ea490]">•</span>
                  <span class="text-[10px] font-bold text-emerald-800 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200/60">Verified</span>
                </div>

                <!-- Description -->
                <p class="text-xs text-[#526454] line-clamp-2 leading-relaxed">
                  ${p.description}
                </p>

                <!-- Dotted Divider Line -->
                <div class="border-t border-dotted border-[#cbd8c9] pt-2"></div>

                <!-- Price & Stepper Row -->
                <div class="flex items-center justify-between gap-2 pt-1">
                  <div class="flex items-baseline gap-1">
                    <span class="text-xl sm:text-2xl font-black text-[#132215]">₹${price}</span>
                    <span class="text-xs font-semibold text-[#667a68]">/ kg</span>
                  </div>

                  ${!isSoldOut ? `
                    <div class="inline-flex items-center border border-[#cbd8c9] rounded-lg overflow-hidden bg-[#f4f7f2]">
                      <button
                        type="button"
                        class="w-8 h-8 flex items-center justify-center text-[#1b4522] hover:bg-[#e4ede1] font-black text-base border-r border-[#cbd8c9] transition-colors select-none"
                        onclick="adjustQty(${p.id}, -1)"
                        aria-label="Decrease quantity"
                      >−</button>
                      <input
                        id="card-qty-${p.id}"
                        type="text"
                        value="${defaultQty}"
                        class="w-9 h-8 text-center font-bold text-xs text-[#132215] bg-[#f4f7f2] focus:outline-none select-none"
                        readonly
                      />
                      <button
                        type="button"
                        class="w-8 h-8 flex items-center justify-center text-[#1b4522] hover:bg-[#e4ede1] font-black text-base border-l border-[#cbd8c9] transition-colors select-none"
                        onclick="adjustQty(${p.id}, 1, ${p.quantityAvailable || 100})"
                        aria-label="Increase quantity"
                      >+</button>
                    </div>
                  ` : ''}
                </div>
              </div>
            </div>

            <!-- Card Action Controls -->
            <div class="p-4 pt-0 space-y-2.5 mt-auto">
              ${!isSoldOut ? `
                <!-- Dual Action Buttons: Add to Cart + Buy Now -->
                <div class="grid grid-cols-2 gap-2.5">
                  <button
                    type="button"
                    class="w-full py-2.5 px-3 rounded-xl border border-[#1b4522] bg-[#f7faf5] hover:bg-[#ebf4e9] text-[#1b4522] font-bold text-xs sm:text-sm transition-all text-center"
                    onclick="addToBasket(${p.id}, '${p.name.replace(/'/g, "\\'")}', ${price})"
                  >
                    Add to Cart
                  </button>
                  <button
                    type="button"
                    class="w-full py-2.5 px-3 rounded-xl bg-[#6d4623] hover:bg-[#5a381a] text-white font-bold text-xs sm:text-sm shadow-xs transition-all text-center"
                    onclick="buyNowItem(${p.id}, '${p.name.replace(/'/g, "\\'")}', ${price})"
                  >
                    Buy Now
                  </button>
                </div>
              ` : `
                <button type="button" class="w-full py-2.5 rounded-xl bg-gray-100 text-gray-400 font-bold text-xs cursor-not-allowed" disabled>
                  Currently Out of Stock
                </button>
              `}

              <!-- Free Sample Tasting Callout matching screenshot -->
              <a
                href="/farm/samples?product_id=${p.id}"
                class="block w-full py-2 px-3 rounded-xl border border-dashed border-[#b8751c] bg-[#fef8f0] hover:bg-[#faeedb] text-center text-[11px] sm:text-xs font-semibold text-[#8c5324] transition-colors"
              >
                Not sure? Request Free Sample (100g/200g)
              </a>
            </div>
          </div>
        `;
      }).join('');
    }

    window.filterCategory = function(cat, btn) {
      activeFilter = cat;
      document.querySelectorAll('#cat-filters .cat-pill').forEach(b => {
        b.className = 'cat-pill inactive-pill whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all';
      });
      btn.className = 'cat-pill active-pill whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all';
      renderList();
    };

    window.handleSearch = function() {
      const q = document.getElementById('search-input')?.value.trim();
      const clearBtn = document.getElementById('search-clear');
      if (clearBtn) {
        if (q) clearBtn.classList.remove('hidden');
        else clearBtn.classList.add('hidden');
      }
      renderList();
    };

    window.clearSearch = function() {
      const input = document.getElementById('search-input');
      if (input) input.value = '';
      const clearBtn = document.getElementById('search-clear');
      if (clearBtn) clearBtn.classList.add('hidden');
      renderList();
    };

    window.clearFilters = function() {
      clearSearch();
      const firstBtn = document.querySelector('#cat-filters .cat-pill');
      if (firstBtn) filterCategory('all', firstBtn);
    };

    window.adjustQty = function(id, delta, max = 100) {
      const input = document.getElementById('card-qty-' + id);
      if (!input) return;
      let val = parseInt(input.value || '1', 10) + delta;
      if (val < 1) val = 1;
      if (val > max) val = max;
      input.value = val;
    };

    window.addToBasket = function(productId, productName, priceRupees) {
      const input = document.getElementById('card-qty-' + productId);
      const qty = input ? parseInt(input.value || '1', 10) : 1;

      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem('fd_cart_v1') || '[]');
      } catch (_) {}

      const idx = cart.findIndex(it => it.productId === productId);
      if (idx >= 0) {
        cart[idx].quantity += qty;
      } else {
        cart.push({
          productId,
          productName,
          priceRupees,
          quantity: qty,
          unit: 'kg',
          estimatedPriceRupees: priceRupees
        });
      }

      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      window.dispatchEvent(new Event('storage'));

      if (window.fdToast) {
        window.fdToast('Added to Basket!', `${qty} kg of ${productName} added to your Sunday dispatch basket.`, 'success');
      }
    };

    window.buyNowItem = function(productId, productName, priceRupees) {
      const input = document.getElementById('card-qty-' + productId);
      const qty = input ? parseInt(input.value || '1', 10) : 1;

      const cart = [{
        productId,
        productName,
        priceRupees,
        quantity: qty,
        unit: 'kg',
        estimatedPriceRupees: priceRupees
      }];

      localStorage.setItem('fd_cart_v1', JSON.stringify(cart));
      window.dispatchEvent(new Event('storage'));
      window.location.href = '/farm/checkout';
    };

    document.addEventListener('DOMContentLoaded', loadProducts);
  </script>
</FarmLayout>
