---
import FarmLayout from '../../../layouts/FarmLayout.astro';

// Customer Account Dashboard — Modernized Portal
---

<FarmLayout
  title="मेरा फार्म डायरेक्ट खाता (My Account) | ग्वालियर"
  description="ग्वालियर में अपने शुद्ध कृषि प्री-ऑर्डर, मुफ़्त सैंपल और पते प्रबंधित करें।"
  canonicalPath="/farm/account"
>
  <div class="fd-container py-8 sm:py-16">
    <div class="max-w-4xl mx-auto space-y-8">
      <!-- Loading State -->
      <div id="account-loading" class="text-center py-24 text-[#5b6e5d] dark:text-stone-400">
        <div class="inline-block animate-spin w-10 h-10 border-4 border-[#1b4522] dark:border-emerald-500 border-t-transparent rounded-full mb-4"></div>
        <p class="text-sm font-bold text-[#152317] dark:text-stone-100">खाता लोड हो रहा है... (Loading farm account...)</p>
        <p class="text-xs text-[#718573] dark:text-stone-400 mt-1">क्लाउडफ्लेयर सुरक्षित डेटाबेस से कनेक्ट हो रहा है</p>
      </div>

      <!-- Account Dashboard Content Container -->
      <div id="account-content" class="hidden space-y-8">
        <!-- Top Profile Card -->
        <div class="relative bg-white dark:bg-stone-900 rounded-3xl border border-[#e2ece0] dark:border-stone-800 p-6 sm:p-8 shadow-sm overflow-hidden">
          <div class="absolute -right-16 -top-16 w-56 h-56 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

          <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#1b4522] to-[#296032] text-white flex items-center justify-center font-bold text-3xl shadow-md shadow-emerald-950/20">
                🌾
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h1 id="user-name" class="fd-display text-2xl sm:text-3xl font-extrabold text-[#122815] dark:text-stone-100"></h1>
                  <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800/60">
                    सत्यापित • Verified
                  </span>
                </div>
                <div class="text-xs text-[#5b6e5d] dark:text-stone-400 font-semibold mt-1 flex flex-wrap gap-x-3 gap-y-1">
                  <span class="flex items-center gap-1">📱 <strong id="user-phone" class="text-[#152317] dark:text-stone-200"></strong></span>
                  <span>•</span>
                  <span class="flex items-center gap-1">✉️ <strong id="user-email" class="text-[#152317] dark:text-stone-200"></strong></span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2.5 w-full sm:w-auto">
              <a
                id="admin-switch-btn"
                href="/farm/admin"
                class="hidden px-4 py-2.5 rounded-xl bg-[#1b4522] text-white hover:bg-[#14371b] font-bold text-xs shadow-xs transition-colors flex items-center gap-1.5"
              >
                <span>🛠️ एडमिन पोर्टल (Admin) &rarr;</span>
              </a>
              <button
                type="button"
                class="px-4 py-2.5 rounded-xl border border-red-200 dark:border-rose-900/60 text-red-600 dark:text-rose-400 hover:bg-red-50 dark:hover:bg-rose-950/30 font-bold text-xs transition-colors flex items-center gap-1.5"
                onclick="handleLogout()"
              >
                <span>लॉग आउट (Log Out)</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Modern Sliding Tab Navigation -->
        <div class="flex items-center gap-2 border-b border-[#e2ece0] dark:border-stone-800 pb-2 text-xs sm:text-sm font-bold overflow-x-auto scrollbar-none">
          <button id="tab-orders-btn" type="button" class="px-5 py-2.5 rounded-xl bg-[#1b4522] text-white shadow-xs transition-all flex items-center gap-2" onclick="switchTab('orders')">
            <span>📦 मेरे प्री-ऑर्डर (Orders)</span>
            <span id="orders-count-badge" class="hidden px-2 py-0.5 rounded-full bg-white/20 text-[10px] font-extrabold">0</span>
          </button>
          <button id="tab-samples-btn" type="button" class="px-5 py-2.5 rounded-xl bg-[#f2f6f1] dark:bg-stone-800 text-[#2d3e30] dark:text-stone-300 hover:bg-[#e4ede3] dark:hover:bg-stone-700 transition-all flex items-center gap-2" onclick="switchTab('samples')">
            <span>🎁 मुफ़्त सैंपल (Free Samples)</span>
          </button>
          <button id="tab-addresses-btn" type="button" class="px-5 py-2.5 rounded-xl bg-[#f2f6f1] dark:bg-stone-800 text-[#2d3e30] dark:text-stone-300 hover:bg-[#e4ede3] dark:hover:bg-stone-700 transition-all flex items-center gap-2" onclick="switchTab('addresses')">
            <span>📍 सहेजे गए पते (Saved Addresses)</span>
          </button>
        </div>

        <!-- TAB 1: MY PRE-ORDERS -->
        <div id="tab-orders" class="space-y-4">
          <div id="orders-list" class="space-y-4"></div>
          <div id="orders-empty" class="hidden text-center py-16 bg-white dark:bg-stone-900 rounded-3xl border border-[#e2ece0] dark:border-stone-800 p-8 space-y-3">
            <div class="text-4xl">🌾</div>
            <h3 class="fd-display text-xl font-bold text-[#152317] dark:text-stone-100">अभी तक कोई प्री-ऑर्डर नहीं दिया गया</h3>
            <p class="text-xs text-[#5b6e5d] dark:text-stone-400 max-w-sm mx-auto">
              आपने अभी तक किसी शुद्ध अनाज या दाल का ऑर्डर नहीं दिया है। इस सप्ताह की ताज़ा उपज देखें।
            </p>
            <div class="pt-2">
              <a href="/farm/products" class="fd-btn fd-btn-primary fd-btn-sm font-bold">
                फसल और दालें देखें (Browse Produce) &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- TAB 2: MY SAMPLE REQUESTS -->
        <div id="tab-samples" class="hidden space-y-4">
          <div id="samples-list" class="space-y-3"></div>
          <div id="samples-empty" class="hidden text-center py-16 bg-white dark:bg-stone-900 rounded-3xl border border-[#e2ece0] dark:border-stone-800 p-8 space-y-3">
            <div class="text-4xl">🎁</div>
            <h3 class="fd-display text-xl font-bold text-[#152317] dark:text-stone-100">कोई मुफ़्त चखने का सैंपल बुक नहीं है</h3>
            <p class="text-xs text-[#5b6e5d] dark:text-stone-400 max-w-sm mx-auto">
              बड़ी बोरी खरीदने से पहले हमारे गेहूं, दालों या मूंगफली का मुफ़्त १०० ग्राम/२०० ग्राम सैंपल मंगाकर देखें।
            </p>
            <div class="pt-2">
              <a href="/farm/samples" class="fd-btn fd-btn-accent fd-btn-sm font-bold">
                मुफ़्त सैंपल मंगाएं (Request Free Sample) &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- TAB 3: SAVED ADDRESSES -->
        <div id="tab-addresses" class="hidden space-y-6">
          <div class="flex justify-between items-center bg-white dark:bg-stone-900 p-5 rounded-2xl border border-[#e2ece0] dark:border-stone-800">
            <div>
              <h3 class="fd-display text-lg font-bold text-[#122815] dark:text-stone-100">सहेजे गए ग्वालियर पते (Saved Addresses)</h3>
              <p class="text-xs text-[#5b6e5d] dark:text-stone-400">रविवार क्लस्टर डिलीवरी हेतु सुरक्षित पते</p>
            </div>
            <button type="button" class="fd-btn fd-btn-primary fd-btn-sm font-bold shadow-sm" onclick="toggleAddAddressModal(true)">
              + नया पता जोड़ें (Add Address)
            </button>
          </div>

          <div id="addresses-list" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
          <div id="addresses-empty" class="hidden text-center py-12 bg-white dark:bg-stone-900 rounded-3xl border border-[#e2ece0] dark:border-stone-800 p-8 text-xs text-[#5b6e5d] dark:text-stone-400">
            कोई सहेजा गया पता नहीं मिला। तीव्र चेकआउट हेतु अपना पता जोड़ें।
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ADD ADDRESS MODAL -->
  <div id="address-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-stone-900 rounded-3xl max-w-lg w-full p-6 sm:p-8 space-y-5 shadow-2xl border border-[#e2ece0] dark:border-stone-800 max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center pb-3 border-b border-[#e2ece0] dark:border-stone-800">
        <div>
          <h3 class="fd-display font-extrabold text-xl text-[#122815] dark:text-stone-100">डिलीवरी का पता जोड़ें (Add Address)</h3>
          <p class="text-[11px] text-[#5b6e5d] dark:text-stone-400">ग्वालियर क्लस्टर (पवन नगर, चेतकपुरी, सिटी सेंटर, आदि)</p>
        </div>
        <button type="button" class="w-8 h-8 rounded-full bg-gray-100 dark:bg-stone-800 hover:bg-gray-200 dark:hover:bg-stone-700 text-gray-600 dark:text-stone-300 font-bold flex items-center justify-center" onclick="toggleAddAddressModal(false)">✕</button>
      </div>

      <form onsubmit="handleSaveAddress(event)" class="space-y-4 text-xs">
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] dark:text-stone-300 block mb-1">प्राप्तकर्ता का नाम (Recipient Name) *</label>
          <input id="addr-name" type="text" required class="fd-input font-bold" placeholder="जैसे: आनंद शर्मा" />
        </div>
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] dark:text-stone-300 block mb-1">मोबाइल नंबर (WhatsApp Mobile) *</label>
          <input id="addr-phone" type="tel" required maxlength="10" class="fd-input font-bold" placeholder="10 अंकों का मोबाइल नंबर" />
        </div>
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] dark:text-stone-300 block mb-1">ग्वालियर कॉलोनी / क्लस्टर (Delivery Cluster) *</label>
          <select id="addr-area" required class="fd-input font-bold text-xs">
            <option value="">डिलीवरी क्षेत्र चुनें (Select Area)...</option>
          </select>
        </div>
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] dark:text-stone-300 block mb-1">मकान / फ्लैट नंबर व भवन (House / Flat No.) *</label>
          <input id="addr-house" type="text" required class="fd-input" placeholder="जैसे: फ्लैट 302, ग्रीन एन्क्लेव" />
        </div>
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] dark:text-stone-300 block mb-1">सड़क / गली / कॉलोनी मार्ग (Street / Lane) *</label>
          <input id="addr-street" type="text" required class="fd-input" placeholder="जैसे: पानी की टंकी के पास, गली 4" />
        </div>
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] dark:text-stone-300 block mb-1">पहचान चिह्न (Landmark - वैकल्पिक)</label>
          <input id="addr-landmark" type="text" class="fd-input" placeholder="जैसे: शिव मंदिर के सामने" />
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input id="addr-default" type="checkbox" class="w-4 h-4 rounded text-[#1b4522] focus:ring-[#1b4522]" />
          <label for="addr-default" class="font-bold text-[#122815] dark:text-stone-200">डिफ़ॉल्ट पता बनाएं (Set as default address)</label>
        </div>

        <div id="addr-error" class="hidden p-3 rounded-xl bg-red-50 dark:bg-rose-950/40 border border-red-200 dark:border-rose-900/60 text-red-700 dark:text-rose-300 font-semibold text-xs"></div>

        <button type="submit" id="btn-save-addr" class="fd-btn fd-btn-primary w-full py-3.5 font-bold text-sm shadow-md">
          पता सुरक्षित करें (Save Address) &rarr;
        </button>
      </form>
    </div>
  </div>

  <!-- Modal: Cancel Order -->
  <div id="modal-cancel-order" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-3 sm:p-4">
    <div class="bg-white dark:bg-stone-900 rounded-3xl max-w-md w-full p-6 sm:p-7 shadow-2xl border border-rose-100 dark:border-rose-950/60 space-y-5 animate-in fade-in zoom-in duration-200">
      <div class="flex items-start justify-between pb-3 border-b border-[#f0f5ee] dark:border-stone-800">
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-rose-100 dark:bg-rose-950/50 text-rose-800 dark:text-rose-300 text-[10px] font-extrabold uppercase mb-1">स्वयं ऑर्डर रद्द करें • Cancellation</span>
          <h3 class="fd-display font-extrabold text-lg text-[#122815] dark:text-stone-100">ऑर्डर रद्द करें <span id="cancel-modal-order-number" class="font-mono text-rose-700 dark:text-rose-400"></span></h3>
        </div>
        <button type="button" class="w-8 h-8 rounded-full bg-gray-100 dark:bg-stone-800 hover:bg-gray-200 dark:hover:bg-stone-700 text-gray-600 dark:text-stone-300 font-bold flex items-center justify-center" onclick="closeCancelOrderModal()">✕</button>
      </div>

      <p class="text-xs text-[#5b6e5d] dark:text-stone-400 leading-relaxed">
        क्या आप वाकई यह ऑर्डर रद्द करना चाहते हैं? रद्द करने पर आरक्षित फसल स्टॉक तुरंत खेत सूची में वापस लौट जाएगा।
      </p>

      <div class="space-y-3">
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] dark:text-stone-300 text-[11px] block mb-1">रद्द करने का कारण (Reason)</label>
          <select id="cancel-reason-select" class="fd-input font-bold text-xs" onchange="toggleCustomCancelReason(this.value)">
            <option value="तारीख बदल गई / शहर से बाहर हूँ">तारीख बदल गई / शहर से बाहर हूँ (Out of town)</option>
            <option value="गलत उपज या मात्रा चुनी गई">गलत उपज या मात्रा चुनी गई (Wrong produce/qty)</option>
            <option value="नया संयुक्त ऑर्डर देना चाहता हूँ">नया संयुक्त ऑर्डर देना चाहता हूँ (Re-order)</option>
            <option value="अन्य कारण">अन्य कारण (Other reason)</option>
          </select>
        </div>

        <div id="cancel-custom-reason-group" class="hidden">
          <textarea id="cancel-custom-reason" rows="2" class="fd-input text-xs" placeholder="कृपया कारण लिखें (Specify reason)..."></textarea>
        </div>

        <div id="cancel-order-error" class="hidden p-3 rounded-xl bg-red-50 dark:bg-rose-950/40 border border-red-200 dark:border-rose-900/60 text-red-700 dark:text-rose-300 font-semibold text-xs"></div>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button type="button" class="fd-btn fd-btn-secondary w-1/2 py-3 text-xs font-bold border border-[#d6e3d4] dark:border-stone-700" onclick="closeCancelOrderModal()">
          ऑर्डर रखें (Keep Order)
        </button>
        <button type="button" id="btn-confirm-cancel" class="fd-btn bg-rose-600 hover:bg-rose-700 text-white w-1/2 py-3 text-xs font-bold shadow-md shadow-rose-950/20" onclick="submitCancelOrder()">
          रद्द करें (Confirm Cancel)
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    let userData = null;

    async function initAccount() {
      const loader = document.getElementById('account-loading');
      const content = document.getElementById('account-content');

      try {
        const res = await fetch('/farm/api/auth/me');
        const data = await res.json();

        if (!data.success || !data.user) {
          window.location.href = '/farm/account/login';
          return;
        }

        userData = data;
        loader.classList.add('hidden');
        content.classList.remove('hidden');

        document.getElementById('user-name').textContent = data.user.name;
        document.getElementById('user-phone').textContent = data.user.phone;
        document.getElementById('user-email').textContent = data.user.email;

        if (data.user?.role === 'ADMIN') {
          const admBtn = document.getElementById('admin-switch-btn');
          if (admBtn) admBtn.classList.remove('hidden');
        }

        renderAddresses(data.addresses || []);
        loadOrders();
        loadSamples();
        loadDeliveryAreasForModal();
      } catch (err) {
        loader.innerHTML = '<p class="text-sm font-bold text-red-600">Failed to load account. Please refresh.</p>';
      }
    }

    async function loadOrders() {
      const list = document.getElementById('orders-list');
      const empty = document.getElementById('orders-empty');
      const badge = document.getElementById('orders-count-badge');

      try {
        const res = await fetch('/farm/api/orders');
        const data = await res.json();
        if (data.success && data.orders && data.orders.length > 0) {
          empty.classList.add('hidden');
          badge.textContent = data.orders.length;
          badge.classList.remove('hidden');

          list.innerHTML = data.orders.map(o => {
            const statusLabel =
              o.status === 'DELIVERED' ? 'वितरित (Delivered)' :
              o.status === 'CANCELLED' ? 'रद्द (Cancelled)' :
              o.status === 'CONFIRMED' ? 'स्वीकृत (Confirmed)' :
              o.status === 'PACKING' ? 'पैकिंग जारी (Packing)' :
              o.status === 'ON_ROUTE' ? 'रास्ते में (On Route)' : 'प्रतीक्षारत (Pending)';

            return `
            <div class="bg-white dark:bg-stone-900 p-6 rounded-3xl border border-[#e2ece0] dark:border-stone-800 shadow-sm hover:shadow-md transition-shadow space-y-4">
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-[#f0f5ee] dark:border-stone-800">
                <div class="flex items-center gap-3">
                  <span class="font-mono text-sm font-extrabold text-[#122815] dark:text-stone-100 bg-[#edf4ec] dark:bg-stone-800 px-3 py-1 rounded-xl border border-[#d6e3d4] dark:border-stone-700">
                    ${o.orderNumber}
                  </span>
                  <span class="text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wider ${
                    o.status === 'DELIVERED' ? 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300' :
                    o.status === 'CANCELLED' ? 'bg-red-100 dark:bg-rose-950/60 text-red-800 dark:text-rose-300' :
                    'bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300'
                  }">
                    ${statusLabel}
                  </span>
                </div>
                <div class="text-xs text-[#5b6e5d] dark:text-stone-400">
                  ऑर्डर दिनांक: <strong>${new Date(o.createdAt).toLocaleDateString('hi-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</strong>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-[#5b6e5d] dark:text-stone-400">
                <div>
                  <span class="text-[11px] font-bold uppercase text-[#718573] dark:text-stone-500 block">डिलीवरी क्लस्टर (Delivery Cluster)</span>
                  <strong class="text-sm font-bold text-[#122815] dark:text-stone-100">${o.deliveryArea}, ग्वालियर</strong>
                  <p class="text-[11px] text-[#718573] dark:text-stone-400 mt-0.5">${o.deliveryAddress}</p>
                </div>
                <div class="text-left sm:text-right">
                  <span class="text-[11px] font-bold uppercase text-[#718573] dark:text-stone-500 block">कुल देय राशि (डिलीवरी पर भुगतान)</span>
                  <strong class="fd-display text-2xl font-black text-[#1b4522] dark:text-emerald-400">₹${o.grandTotalRupees}</strong>
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[#f0f5ee] dark:border-stone-800">
                <div class="flex flex-wrap items-center gap-2">
                  <a
                    href="https://wa.me/918770767272?text=${encodeURIComponent(`नमस्ते फार्म डायरेक्ट, मेरे ऑर्डर ${o.orderNumber} के संबंध में पूछताछ`)}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-emerald-800 dark:text-emerald-400 hover:text-emerald-950 flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl hover:bg-emerald-50 dark:hover:bg-emerald-950/30 transition-colors"
                  >
                    <span>💬 व्हाट्सएप पूछताछ</span>
                  </a>
                  ${(o.status === 'PENDING' || o.status === 'CONFIRMED') ? `
                    <button
                      type="button"
                      onclick="openCancelOrderModal(${o.id}, '${o.orderNumber}')"
                      class="text-xs font-bold text-rose-700 dark:text-rose-400 hover:text-rose-900 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 px-3 py-1.5 rounded-xl transition-colors flex items-center gap-1 cursor-pointer"
                    >
                      <span>✕ ऑर्डर रद्द करें</span>
                    </button>
                  ` : ''}
                  ${o.status === 'DELIVERED' ? `
                    <a
                      href="/farm/reviews?write=1"
                      class="text-xs font-bold text-amber-900 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 px-3 py-1.5 rounded-xl transition-colors flex items-center gap-1 cursor-pointer"
                    >
                      <span>⭐ रेटिंग व समीक्षा दें</span>
                    </a>
                  ` : ''}
                </div>
                <a href="/farm/track?order_number=${o.orderNumber}" class="fd-btn fd-btn-secondary fd-btn-sm font-bold border border-[#d6e3d4] dark:border-stone-700">
                  डिलीवरी ट्रैक करें (Track) &rarr;
                </a>
              </div>
            </div>
          `;
          }).join('');
        } else {
          list.innerHTML = '';
          empty.classList.remove('hidden');
        }
      } catch (_) {}
    }

    async function loadSamples() {
      const list = document.getElementById('samples-list');
      const empty = document.getElementById('samples-empty');
      try {
        const res = await fetch('/farm/api/samples');
        const data = await res.json();
        if (data.success && data.sampleRequests && data.sampleRequests.length > 0) {
          empty.classList.add('hidden');
          list.innerHTML = data.sampleRequests.map(s => {
            const statusLabel = s.status === 'DELIVERED' ? 'वितरित (Delivered)' : 'प्रतीक्षारत (Pending)';
            return `
            <div class="bg-white dark:bg-stone-900 p-5 rounded-2xl border border-[#e2ece0] dark:border-stone-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <strong class="font-extrabold text-base text-[#122815] dark:text-stone-100">${s.productName}</strong>
                  <span class="px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300 font-extrabold text-xs">
                    ${s.quantityGrams} ग्राम पाउच (Sample)
                  </span>
                </div>
                <div class="text-xs text-[#5b6e5d] dark:text-stone-400 mt-1">
                  <span>${s.deliveryArea}, ग्वालियर</span> • <span>${s.roundName || 'आगामी वीकेंड राउंड'}</span>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="px-3 py-1 rounded-full text-xs font-bold ${
                  s.status === 'DELIVERED' ? 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300' : 'bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300'
                }">
                  ${statusLabel}
                </span>
                <a
                  href="https://wa.me/918770767272?text=${encodeURIComponent(`नमस्ते, मेरे मुफ़्त सैंपल ${s.productName} (${s.quantityGrams}g) की जानकारी चाहिए`)}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="fd-btn fd-btn-secondary fd-btn-sm text-xs font-bold border border-[#d6e3d4] dark:border-stone-700"
                >
                  व्हाट्सएप पर्ची (Slip)
                </a>
              </div>
            </div>
          `;
          }).join('');
        } else {
          list.innerHTML = '';
          empty.classList.remove('hidden');
        }
      } catch (_) {}
    }

    function renderAddresses(addresses) {
      const list = document.getElementById('addresses-list');
      const empty = document.getElementById('addresses-empty');
      if (!addresses || addresses.length === 0) {
        list.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');
      list.innerHTML = addresses.map(a => `
        <div class="bg-white dark:bg-stone-900 p-6 rounded-3xl border border-[#e2ece0] dark:border-stone-800 shadow-sm relative text-xs text-[#5b6e5d] dark:text-stone-300 space-y-2 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
                ${a.deliveryAreaName || 'ग्वालियर क्लस्टर'}
              </span>
              ${a.isDefault ? '<span class="text-[10px] font-extrabold uppercase text-[#1b4522] dark:text-emerald-400 bg-[#eaf4ec] dark:bg-stone-800 px-2 py-0.5 rounded-full">मुख्य पता (Default)</span>' : ''}
            </div>
            <strong class="font-extrabold text-base text-[#122815] dark:text-stone-100 block">${a.fullName}</strong>
            <p class="font-semibold text-emerald-800 dark:text-emerald-400">📱 +91 ${a.phone}</p>
            <p class="mt-2 text-[#334435] dark:text-stone-300 leading-relaxed">${a.houseNumber}, ${a.street}</p>
            ${a.landmark ? `<p class="text-[11px] text-[#718573] dark:text-stone-400">पहचान: ${a.landmark}</p>` : ''}
          </div>

          <div class="pt-3 border-t border-[#f0f5ee] dark:border-stone-800 flex items-center justify-between">
            <span class="text-[11px] text-[#718573] dark:text-stone-400">ग्वालियर, मध्य प्रदेश</span>
            <button type="button" class="text-red-600 dark:text-rose-400 hover:text-red-800 font-bold text-xs" onclick="deleteAddress(${a.id})">
              हटाएं (Delete)
            </button>
          </div>
        </div>
      `).join('');
    }

    async function loadDeliveryAreasForModal() {
      try {
        const res = await fetch('/farm/api/delivery-areas');
        const data = await res.json();
        if (data.success && data.deliveryAreas) {
          const select = document.getElementById('addr-area');
          select.innerHTML = '<option value="">Select delivery area cluster...</option>' +
            data.deliveryAreas.map(a => `<option value="${a.id}">${a.name}, Gwalior (${a.deliveryDay}s)</option>`).join('');
        }
      } catch (_) {}
    }

    window.switchTab = function(tab) {
      document.getElementById('tab-orders').classList.add('hidden');
      document.getElementById('tab-samples').classList.add('hidden');
      document.getElementById('tab-addresses').classList.add('hidden');

      const tabs = ['orders', 'samples', 'addresses'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-${t}-btn`);
        if (t === tab) {
          btn.className = 'px-5 py-2.5 rounded-xl bg-[#1b4522] text-white shadow-xs transition-all flex items-center gap-2';
        } else {
          btn.className = 'px-5 py-2.5 rounded-xl bg-[#f2f6f1] text-[#2d3e30] hover:bg-[#e4ede3] transition-all flex items-center gap-2';
        }
      });

      document.getElementById('tab-' + tab).classList.remove('hidden');
    };

    window.toggleAddAddressModal = function(show) {
      const modal = document.getElementById('address-modal');
      if (show) modal.classList.remove('hidden');
      else modal.classList.add('hidden');
    };

    window.handleSaveAddress = async function(e) {
      e.preventDefault();
      const errBox = document.getElementById('addr-error');
      const submitBtn = document.getElementById('btn-save-addr');
      errBox.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving...';

      const name = document.getElementById('addr-name').value.trim();
      const phone = document.getElementById('addr-phone').value.trim();
      const areaId = document.getElementById('addr-area').value;
      const house = document.getElementById('addr-house').value.trim();
      const street = document.getElementById('addr-street').value.trim();
      const landmark = document.getElementById('addr-landmark').value.trim();
      const isDef = document.getElementById('addr-default').checked;

      try {
        const res = await fetch('/farm/api/account/addresses', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            full_name: name,
            phone,
            delivery_area_id: Number(areaId),
            house_number: house,
            street,
            landmark,
            is_default: isDef,
          }),
        });
        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'Failed to save address.';
          errBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Save Address →';
          return;
        }

        toggleAddAddressModal(false);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Save Address →';
        if (window.fdToast) window.fdToast('Address Saved!', 'Delivery address successfully stored in your account.', 'success');
        initAccount();
      } catch (_) {
        errBox.textContent = 'Network error. Please try again.';
        errBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Save Address →';
      }
    };

    window.deleteAddress = async function(id) {
      if (confirm('Are you sure you want to remove this saved delivery address?')) {
        await fetch(`/farm/api/account/addresses/${id}`, { method: 'DELETE' });
        if (window.fdToast) window.fdToast('Address Removed', 'The address was removed.', 'info');
        initAccount();
      }
    };

    window.handleLogout = async function() {
      await fetch('/farm/api/auth/logout', { method: 'POST' });
      window.location.href = '/farm';
    };

    let orderToCancelId = null;

    window.openCancelOrderModal = function(id, orderNumber) {
      orderToCancelId = id;
      const orderNumEl = document.getElementById('cancel-modal-order-number');
      if (orderNumEl) orderNumEl.textContent = '#' + orderNumber;
      const errBox = document.getElementById('cancel-order-error');
      if (errBox) errBox.classList.add('hidden');
      const customGroup = document.getElementById('cancel-custom-reason-group');
      if (customGroup) customGroup.classList.add('hidden');
      const reasonSelect = document.getElementById('cancel-reason-select');
      if (reasonSelect) reasonSelect.value = 'Changed delivery date / out of town';
      const customInput = document.getElementById('cancel-custom-reason');
      if (customInput) customInput.value = '';
      const modal = document.getElementById('modal-cancel-order');
      if (modal) modal.classList.remove('hidden');
    };

    window.closeCancelOrderModal = function() {
      orderToCancelId = null;
      const modal = document.getElementById('modal-cancel-order');
      if (modal) modal.classList.add('hidden');
    };

    window.toggleCustomCancelReason = function(val) {
      const customGroup = document.getElementById('cancel-custom-reason-group');
      if (customGroup) {
        if (val === 'Other reason') {
          customGroup.classList.remove('hidden');
        } else {
          customGroup.classList.add('hidden');
        }
      }
    };

    window.submitCancelOrder = async function() {
      if (!orderToCancelId) return;
      const btn = document.getElementById('btn-confirm-cancel');
      const errBox = document.getElementById('cancel-order-error');
      if (errBox) errBox.classList.add('hidden');

      const selectVal = document.getElementById('cancel-reason-select')?.value || 'Customer self-cancellation';
      const customVal = document.getElementById('cancel-custom-reason')?.value.trim() || '';
      const reason = selectVal === 'Other reason' && customVal ? customVal : selectVal;

      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Cancelling...';
      }

      try {
        const res = await fetch(`/farm/api/orders/${orderToCancelId}/cancel`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (!data.success) {
          if (errBox) {
            errBox.textContent = data.error || 'Failed to cancel order.';
            errBox.classList.remove('hidden');
          }
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Confirm Cancel';
          }
          return;
        }

        closeCancelOrderModal();
        if (window.fdToast) {
          window.fdToast('Order Cancelled', data.message || 'Order cancelled and harvest inventory released.', 'info');
        } else {
          showAccountToast(data.message || 'Order cancelled successfully.');
        }
        loadOrders();
      } catch (err) {
        if (errBox) {
          errBox.textContent = 'Network error. Please try again.';
          errBox.classList.remove('hidden');
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Confirm Cancel';
        }
      }
    };

    function showAccountToast(msg) {
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-2xl bg-[#132215] text-white text-xs font-bold shadow-2xl border border-white/10 animate-bounce flex items-center gap-2';
      toast.innerHTML = `<span>✓</span> <span>${msg}</span>`;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }

    document.addEventListener('DOMContentLoaded', initAccount);
  </script>
</FarmLayout>
