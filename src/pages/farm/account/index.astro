---
import FarmLayout from '../../../layouts/FarmLayout.astro';

// Customer Account Dashboard — Modernized Portal
---

<FarmLayout
  title="My Farm Direct Account | Gwalior"
  description="Manage your Farm Direct raw produce pre-orders, free tasting samples, and saved delivery addresses in Gwalior."
  canonicalPath="/farm/account"
>
  <div class="fd-container py-8 sm:py-16">
    <div class="max-w-4xl mx-auto space-y-8">
      <!-- Loading State -->
      <div id="account-loading" class="text-center py-24 text-[#5b6e5d]">
        <div class="inline-block animate-spin w-10 h-10 border-4 border-[#1b4522] border-t-transparent rounded-full mb-4"></div>
        <p class="text-sm font-bold text-[#152317]">Loading your farm account dashboard...</p>
        <p class="text-xs text-[#718573] mt-1">Connecting to authoritative Cloudflare database</p>
      </div>

      <!-- Account Dashboard Content Container -->
      <div id="account-content" class="hidden space-y-8">
        <!-- Top Profile Card -->
        <div class="relative bg-white rounded-3xl border border-[#e2ece0] p-6 sm:p-8 shadow-sm overflow-hidden">
          <div class="absolute -right-16 -top-16 w-56 h-56 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

          <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#1b4522] to-[#296032] text-white flex items-center justify-center font-bold text-3xl shadow-md shadow-emerald-950/20">
                🌾
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h1 id="user-name" class="fd-display text-2xl sm:text-3xl font-extrabold text-[#122815]"></h1>
                  <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300">
                    Verified
                  </span>
                </div>
                <div class="text-xs text-[#5b6e5d] font-semibold mt-1 flex flex-wrap gap-x-3 gap-y-1">
                  <span class="flex items-center gap-1">📱 <strong id="user-phone" class="text-[#152317]"></strong></span>
                  <span>•</span>
                  <span class="flex items-center gap-1">✉️ <strong id="user-email" class="text-[#152317]"></strong></span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2.5 w-full sm:w-auto">
              <button
                type="button"
                class="px-4 py-2.5 rounded-xl border border-red-200 text-red-600 hover:bg-red-50 font-bold text-xs transition-colors flex items-center gap-1.5"
                onclick="handleLogout()"
              >
                <span>Log Out</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Modern Sliding Tab Navigation -->
        <div class="flex items-center gap-2 border-b border-[#e2ece0] pb-2 text-xs sm:text-sm font-bold overflow-x-auto scrollbar-none">
          <button id="tab-orders-btn" type="button" class="px-5 py-2.5 rounded-xl bg-[#1b4522] text-white shadow-xs transition-all flex items-center gap-2" onclick="switchTab('orders')">
            <span>📦 My Pre-Orders</span>
            <span id="orders-count-badge" class="hidden px-2 py-0.5 rounded-full bg-white/20 text-[10px] font-extrabold">0</span>
          </button>
          <button id="tab-samples-btn" type="button" class="px-5 py-2.5 rounded-xl bg-[#f2f6f1] text-[#2d3e30] hover:bg-[#e4ede3] transition-all flex items-center gap-2" onclick="switchTab('samples')">
            <span>🎁 Free Sample Rounds</span>
          </button>
          <button id="tab-addresses-btn" type="button" class="px-5 py-2.5 rounded-xl bg-[#f2f6f1] text-[#2d3e30] hover:bg-[#e4ede3] transition-all flex items-center gap-2" onclick="switchTab('addresses')">
            <span>📍 Saved Addresses</span>
          </button>
        </div>

        <!-- TAB 1: MY PRE-ORDERS -->
        <div id="tab-orders" class="space-y-4">
          <div id="orders-list" class="space-y-4"></div>
          <div id="orders-empty" class="hidden text-center py-16 bg-white rounded-3xl border border-[#e2ece0] p-8 space-y-3">
            <div class="text-4xl">🌾</div>
            <h3 class="fd-display text-xl font-bold text-[#152317]">No Pre-Orders Placed Yet</h3>
            <p class="text-xs text-[#5b6e5d] max-w-sm mx-auto">
              You have not placed any raw farm produce orders yet. Explore this week's harvest for Pawan Nagar & Chetakpuri.
            </p>
            <div class="pt-2">
              <a href="/farm/products" class="fd-btn fd-btn-primary fd-btn-sm font-bold">
                Browse Field Produce &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- TAB 2: MY SAMPLE REQUESTS -->
        <div id="tab-samples" class="hidden space-y-4">
          <div id="samples-list" class="space-y-3"></div>
          <div id="samples-empty" class="hidden text-center py-16 bg-white rounded-3xl border border-[#e2ece0] p-8 space-y-3">
            <div class="text-4xl">🎁</div>
            <h3 class="fd-display text-xl font-bold text-[#152317]">No Tasting Samples Requested</h3>
            <p class="text-xs text-[#5b6e5d] max-w-sm mx-auto">
              Taste test our raw wheat, pulses, and groundnut free of cost before ordering bulk bags.
            </p>
            <div class="pt-2">
              <a href="/farm/samples" class="fd-btn fd-btn-accent fd-btn-sm font-bold">
                Request Free 100g/200g Sample &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- TAB 3: SAVED ADDRESSES -->
        <div id="tab-addresses" class="hidden space-y-6">
          <div class="flex justify-between items-center bg-white p-5 rounded-2xl border border-[#e2ece0]">
            <div>
              <h3 class="fd-display text-lg font-bold text-[#122815]">Saved Gwalior Addresses</h3>
              <p class="text-xs text-[#5b6e5d]">Addresses used for scheduled cluster delivery</p>
            </div>
            <button type="button" class="fd-btn fd-btn-primary fd-btn-sm font-bold shadow-sm" onclick="toggleAddAddressModal(true)">
              + Add New Address
            </button>
          </div>

          <div id="addresses-list" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
          <div id="addresses-empty" class="hidden text-center py-12 bg-white rounded-3xl border border-[#e2ece0] p-8 text-xs text-[#5b6e5d]">
            No saved addresses found. Add an address for rapid one-click checkout.
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ADD ADDRESS MODAL -->
  <div id="address-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 space-y-5 shadow-2xl border border-[#e2ece0] max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center pb-3 border-b border-[#e2ece0]">
        <div>
          <h3 class="fd-display font-extrabold text-xl text-[#122815]">Add Delivery Address</h3>
          <p class="text-[11px] text-[#5b6e5d]">Gwalior Delivery Clusters (Pawan Nagar & Chetakpuri)</p>
        </div>
        <button type="button" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold flex items-center justify-center" onclick="toggleAddAddressModal(false)">✕</button>
      </div>

      <form onsubmit="handleSaveAddress(event)" class="space-y-4 text-xs">
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] block mb-1">Recipient Name *</label>
          <input id="addr-name" type="text" required class="fd-input font-bold" placeholder="e.g. Anand Sharma" />
        </div>
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] block mb-1">Mobile Number (WhatsApp) *</label>
          <input id="addr-phone" type="tel" required maxlength="10" class="fd-input font-bold" placeholder="10-digit mobile number" />
        </div>
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] block mb-1">Neighbourhood Cluster in Gwalior *</label>
          <select id="addr-area" required class="fd-input font-bold text-xs">
            <option value="">Select delivery area cluster...</option>
          </select>
        </div>
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] block mb-1">House / Flat / Plot No. & Building *</label>
          <input id="addr-house" type="text" required class="fd-input" placeholder="e.g. Flat 302, Green Enclave" />
        </div>
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] block mb-1">Street / Colony Lane *</label>
          <input id="addr-street" type="text" required class="fd-input" placeholder="e.g. Near Water Tank, Lane 4" />
        </div>
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] block mb-1">Landmark (Optional)</label>
          <input id="addr-landmark" type="text" class="fd-input" placeholder="e.g. Opposite Shiv Mandir" />
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input id="addr-default" type="checkbox" class="w-4 h-4 rounded text-[#1b4522] focus:ring-[#1b4522]" />
          <label for="addr-default" class="font-bold text-[#122815]">Set as default delivery address</label>
        </div>

        <div id="addr-error" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 font-semibold text-xs"></div>

        <button type="submit" id="btn-save-addr" class="fd-btn fd-btn-primary w-full py-3.5 font-bold text-sm shadow-md">
          Save Address &rarr;
        </button>
      </form>
    </div>
  </div>

  <script is:inline>
    let userData = null;

    async function initAccount() {
      const loader = document.getElementById('account-loading');
      const content = document.getElementById('account-content');

      try {
        const res = await fetch('/farm/api/auth/me');
        const data = await res.json();

        if (!data.success || !data.user) {
          window.location.href = '/farm/account/login';
          return;
        }

        userData = data;
        loader.classList.add('hidden');
        content.classList.remove('hidden');

        document.getElementById('user-name').textContent = data.user.name;
        document.getElementById('user-phone').textContent = data.user.phone;
        document.getElementById('user-email').textContent = data.user.email;

        renderAddresses(data.addresses || []);
        loadOrders();
        loadSamples();
        loadDeliveryAreasForModal();
      } catch (err) {
        loader.innerHTML = '<p class="text-sm font-bold text-red-600">Failed to load account. Please refresh.</p>';
      }
    }

    async function loadOrders() {
      const list = document.getElementById('orders-list');
      const empty = document.getElementById('orders-empty');
      const badge = document.getElementById('orders-count-badge');

      try {
        const res = await fetch('/farm/api/orders');
        const data = await res.json();
        if (data.success && data.orders && data.orders.length > 0) {
          empty.classList.add('hidden');
          badge.textContent = data.orders.length;
          badge.classList.remove('hidden');

          list.innerHTML = data.orders.map(o => `
            <div class="bg-white p-6 rounded-3xl border border-[#e2ece0] shadow-sm hover:shadow-md transition-shadow space-y-4">
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-[#f0f5ee]">
                <div class="flex items-center gap-3">
                  <span class="font-mono text-sm font-extrabold text-[#122815] bg-[#edf4ec] px-3 py-1 rounded-xl border border-[#d6e3d4]">
                    ${o.orderNumber}
                  </span>
                  <span class="text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wider ${
                    o.status === 'DELIVERED' ? 'bg-emerald-100 text-emerald-800' :
                    o.status === 'CANCELLED' ? 'bg-red-100 text-red-800' :
                    'bg-amber-100 text-amber-800'
                  }">
                    ${o.status}
                  </span>
                </div>
                <div class="text-xs text-[#5b6e5d]">
                  Placed on <strong>${new Date(o.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</strong>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-[#5b6e5d]">
                <div>
                  <span class="text-[11px] font-bold uppercase text-[#718573] block">Delivery Cluster</span>
                  <strong class="text-sm font-bold text-[#122815]">${o.deliveryArea}, Gwalior</strong>
                  <p class="text-[11px] text-[#718573] mt-0.5">${o.deliveryAddress}</p>
                </div>
                <div class="text-left sm:text-right">
                  <span class="text-[11px] font-bold uppercase text-[#718573] block">Order Amount (Pay on Delivery)</span>
                  <strong class="fd-display text-2xl font-black text-[#1b4522]">₹${o.grandTotalRupees}</strong>
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[#f0f5ee]">
                <a
                  href="https://wa.me/918770767272?text=${encodeURIComponent(`Namaste Farm Direct, enquiry regarding my pre-order ${o.orderNumber}`)}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-bold text-emerald-800 hover:text-emerald-950 flex items-center gap-1.5"
                >
                  <span>💬 Enquire on WhatsApp</span>
                </a>
                <a href="/farm/track?order_number=${o.orderNumber}" class="fd-btn fd-btn-secondary fd-btn-sm font-bold">
                  Track Delivery Status &rarr;
                </a>
              </div>
            </div>
          `).join('');
        } else {
          list.innerHTML = '';
          empty.classList.remove('hidden');
        }
      } catch (_) {}
    }

    async function loadSamples() {
      const list = document.getElementById('samples-list');
      const empty = document.getElementById('samples-empty');
      try {
        const res = await fetch('/farm/api/samples');
        const data = await res.json();
        if (data.success && data.sampleRequests && data.sampleRequests.length > 0) {
          empty.classList.add('hidden');
          list.innerHTML = data.sampleRequests.map(s => `
            <div class="bg-white p-5 rounded-2xl border border-[#e2ece0] shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <strong class="font-extrabold text-base text-[#122815]">${s.productName}</strong>
                  <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 font-extrabold text-xs">
                    ${s.quantityGrams}g pouch
                  </span>
                </div>
                <div class="text-xs text-[#5b6e5d] mt-1">
                  <span>${s.deliveryArea}, Gwalior</span> • <span>${s.roundName || 'Scheduled Weekend Round'}</span>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="px-3 py-1 rounded-full text-xs font-bold ${
                  s.status === 'DELIVERED' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'
                }">
                  ${s.status}
                </span>
                <a
                  href="https://wa.me/918770767272?text=${encodeURIComponent(`Namaste, checking on my free sample for ${s.productName} (${s.quantityGrams}g)`)}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="fd-btn fd-btn-secondary fd-btn-sm text-xs font-bold"
                >
                  WhatsApp Slip
                </a>
              </div>
            </div>
          `).join('');
        } else {
          list.innerHTML = '';
          empty.classList.remove('hidden');
        }
      } catch (_) {}
    }

    function renderAddresses(addresses) {
      const list = document.getElementById('addresses-list');
      const empty = document.getElementById('addresses-empty');
      if (!addresses || addresses.length === 0) {
        list.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');
      list.innerHTML = addresses.map(a => `
        <div class="bg-white p-6 rounded-3xl border border-[#e2ece0] shadow-sm relative text-xs text-[#5b6e5d] space-y-2 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-50 text-emerald-800 border border-emerald-200">
                ${a.deliveryAreaName || 'Gwalior Cluster'}
              </span>
              ${a.isDefault ? '<span class="text-[10px] font-extrabold uppercase text-[#1b4522] bg-[#eaf4ec] px-2 py-0.5 rounded-full">Default Address</span>' : ''}
            </div>
            <strong class="font-extrabold text-base text-[#122815] block">${a.fullName}</strong>
            <p class="font-semibold text-emerald-800">📱 +91 ${a.phone}</p>
            <p class="mt-2 text-[#334435] leading-relaxed">${a.houseNumber}, ${a.street}</p>
            ${a.landmark ? `<p class="text-[11px] text-[#718573]">Landmark: ${a.landmark}</p>` : ''}
          </div>

          <div class="pt-3 border-t border-[#f0f5ee] flex items-center justify-between">
            <span class="text-[11px] text-[#718573]">Gwalior, MP</span>
            <button type="button" class="text-red-600 hover:text-red-800 font-bold text-xs" onclick="deleteAddress(${a.id})">
              Delete
            </button>
          </div>
        </div>
      `).join('');
    }

    async function loadDeliveryAreasForModal() {
      try {
        const res = await fetch('/farm/api/delivery-areas');
        const data = await res.json();
        if (data.success && data.deliveryAreas) {
          const select = document.getElementById('addr-area');
          select.innerHTML = '<option value="">Select delivery area cluster...</option>' +
            data.deliveryAreas.map(a => `<option value="${a.id}">${a.name}, Gwalior (${a.deliveryDay}s)</option>`).join('');
        }
      } catch (_) {}
    }

    window.switchTab = function(tab) {
      document.getElementById('tab-orders').classList.add('hidden');
      document.getElementById('tab-samples').classList.add('hidden');
      document.getElementById('tab-addresses').classList.add('hidden');

      const tabs = ['orders', 'samples', 'addresses'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-${t}-btn`);
        if (t === tab) {
          btn.className = 'px-5 py-2.5 rounded-xl bg-[#1b4522] text-white shadow-xs transition-all flex items-center gap-2';
        } else {
          btn.className = 'px-5 py-2.5 rounded-xl bg-[#f2f6f1] text-[#2d3e30] hover:bg-[#e4ede3] transition-all flex items-center gap-2';
        }
      });

      document.getElementById('tab-' + tab).classList.remove('hidden');
    };

    window.toggleAddAddressModal = function(show) {
      const modal = document.getElementById('address-modal');
      if (show) modal.classList.remove('hidden');
      else modal.classList.add('hidden');
    };

    window.handleSaveAddress = async function(e) {
      e.preventDefault();
      const errBox = document.getElementById('addr-error');
      const submitBtn = document.getElementById('btn-save-addr');
      errBox.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving...';

      const name = document.getElementById('addr-name').value.trim();
      const phone = document.getElementById('addr-phone').value.trim();
      const areaId = document.getElementById('addr-area').value;
      const house = document.getElementById('addr-house').value.trim();
      const street = document.getElementById('addr-street').value.trim();
      const landmark = document.getElementById('addr-landmark').value.trim();
      const isDef = document.getElementById('addr-default').checked;

      try {
        const res = await fetch('/farm/api/account/addresses', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            full_name: name,
            phone,
            delivery_area_id: Number(areaId),
            house_number: house,
            street,
            landmark,
            is_default: isDef,
          }),
        });
        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'Failed to save address.';
          errBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Save Address →';
          return;
        }

        toggleAddAddressModal(false);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Save Address →';
        if (window.fdToast) window.fdToast('Address Saved!', 'Delivery address successfully stored in your account.', 'success');
        initAccount();
      } catch (_) {
        errBox.textContent = 'Network error. Please try again.';
        errBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Save Address →';
      }
    };

    window.deleteAddress = async function(id) {
      if (confirm('Are you sure you want to remove this saved delivery address?')) {
        await fetch(`/farm/api/account/addresses/${id}`, { method: 'DELETE' });
        if (window.fdToast) window.fdToast('Address Removed', 'The address was removed.', 'info');
        initAccount();
      }
    };

    window.handleLogout = async function() {
      await fetch('/farm/api/auth/logout', { method: 'POST' });
      window.location.href = '/farm';
    };

    document.addEventListener('DOMContentLoaded', initAccount);
  </script>
</FarmLayout>
