---
import FarmLayout from '../../../layouts/FarmLayout.astro';

// Customer Login — Modern Farm Portal
---

<FarmLayout
  title="Customer Login | Farm Direct"
  description="Log into your Farm Direct customer account to manage raw agricultural produce pre-orders and saved addresses in Gwalior."
  canonicalPath="/farm/account/login"
>
  <div class="fd-container py-12 sm:py-24">
    <div class="max-w-md mx-auto relative">
      <!-- Ambient Glow Behind Form -->
      <div class="absolute -top-10 -left-10 w-64 h-64 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative bg-white/95 backdrop-blur-xl p-8 sm:p-10 rounded-3xl border border-[#e2ece0] shadow-xl space-y-6">
        <div class="text-center">
          <div class="w-14 h-14 bg-gradient-to-br from-[#1b4522] to-[#296032] text-white rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-md shadow-emerald-950/20 font-bold">
            🌾
          </div>
          <span id="login-badge" class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
            Farm Direct
          </span>
          <h1 id="login-title" class="fd-display text-2xl sm:text-3xl font-extrabold text-[#122815] mt-2">
            Customer Login
          </h1>
          <p id="login-desc" class="text-xs text-[#5b6e5d] mt-1.5 leading-relaxed">
            Manage your Sunday cluster pre-orders, tasting samples, and saved delivery addresses.
          </p>
        </div>

        <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
          <div>
            <label id="login-id-label" class="text-xs font-bold uppercase tracking-wider text-[#495c4b] block mb-1.5">
              10-Digit Mobile or Email *
            </label>
            <input
              id="login-id"
              type="text"
              required
              placeholder="e.g. 8770767272 or your email"
              class="fd-input font-bold"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b]">
                Password *
              </label>
              <a href="/farm/account/forgot-password" class="text-xs font-bold text-emerald-800 hover:text-emerald-950 underline">
                Forgot Password?
              </a>
            </div>
            <input
              id="login-pw"
              type="password"
              required
              placeholder="Your account password"
              class="fd-input font-bold"
            />
          </div>

          <div id="login-error" class="hidden p-3.5 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs font-semibold text-center"></div>

          <button
            id="btn-login-submit"
            type="submit"
            class="fd-btn fd-btn-primary w-full py-3.5 font-bold text-sm shadow-md"
          >
            Log In to Account &rarr;
          </button>
        </form>

        <!-- Guest Checkout Option -->
        <div id="guest-divider" class="relative flex py-2 items-center">
          <div class="flex-grow border-t border-[#e2ece0]"></div>
          <span class="flex-shrink mx-4 text-xs font-bold text-[#718573] uppercase tracking-wider">or</span>
          <div class="flex-grow border-t border-[#e2ece0]"></div>
        </div>

        <a
          id="guest-btn"
          href="/farm/products"
          class="fd-btn fd-btn-secondary w-full py-3.5 font-bold text-xs flex items-center justify-center gap-2 border border-[#d6e3d4]"
        >
          <span>🛒 Continue as Guest (No Login Required) &rarr;</span>
        </a>

        <div id="register-prompt" class="pt-6 border-t border-[#edf4ec] text-center text-xs text-[#5b6e5d] space-y-2">
          <p>
            Don't have a customer account?
            <a href="/farm/account/register" class="font-extrabold text-[#1b4522] hover:underline">
              Register here
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    // If arriving here with an admin redirect, immediately route to dedicated farm admin portal
    const urlParams = new URLSearchParams(window.location.search);
    const redirect = urlParams.get('redirect') || '';
    if (redirect.startsWith('/farm/admin')) {
      window.location.replace(`/farm/admin/login?redirect=${encodeURIComponent(redirect)}`);
    }
  </script>
  <script is:inline>
    async function handleLogin(e) {
      e.preventDefault();
      const errBox = document.getElementById('login-error');
      const submitBtn = document.getElementById('btn-login-submit');

      errBox.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Logging in...';

      const identifier = document.getElementById('login-id').value.trim();
      const password = document.getElementById('login-pw').value;

      try {
        const res = await fetch('/farm/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier, password }),
        });

        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'Invalid phone/email or password.';
          errBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Log In to Account →';
          return;
        }

        const urlParams = new URLSearchParams(window.location.search);
        const redirect = urlParams.get('redirect');

        if (data.user?.role === 'ADMIN') {
          window.location.href = '/farm/admin';
        } else if (redirect) {
          window.location.href = redirect;
        } else {
          window.location.href = '/farm/account';
        }
      } catch (err) {
        errBox.textContent = 'Network error. Please try again.';
        errBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Log In to Account →';
      }
    }
  </script>
</FarmLayout>
