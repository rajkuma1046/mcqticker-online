---
import FarmLayout from '../../../layouts/FarmLayout.astro';

// Customer Registration with Email OTP Verification
---

<FarmLayout
  title="नया ग्राहक खाता बनाएं (Create Account) | फार्म डायरेक्ट ग्वालियर"
  description="फार्म डायरेक्ट पर मुफ़्त ग्राहक खाता बनाएं। ग्वालियर में शुद्ध ग्रामीण अनाज के प्री-ऑर्डर और मुफ़्त सैंपल प्राप्त करें।"
  canonicalPath="/farm/account/register"
>
  <div class="fd-container py-12 sm:py-24">
    <div class="max-w-md mx-auto relative">
      <!-- Ambient Glow Behind Form -->
      <div class="absolute -top-10 -right-10 w-64 h-64 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -left-10 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative bg-white/95 dark:bg-stone-900/95 backdrop-blur-xl p-8 sm:p-10 rounded-3xl border border-[#e2ece0] dark:border-stone-800 shadow-xl space-y-6">
        <!-- Header -->
        <div class="text-center">
          <div class="w-14 h-14 bg-gradient-to-br from-[#1b4522] to-[#296032] text-white rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-md shadow-emerald-950/20 font-bold">
            🌱
          </div>
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/50 px-3 py-1 rounded-full border border-emerald-200 dark:border-emerald-800/60">
            सीधे खेत से ताज़ा • Gwalior Direct Harvest
          </span>
          <h1 id="reg-title" class="fd-display text-2xl sm:text-3xl font-extrabold text-[#122815] dark:text-stone-100 mt-2">
            नया ग्राहक खाता बनाएं <span class="text-base font-normal text-[#5b6e5d] dark:text-stone-400 block sm:inline sm:ml-1">Register Account</span>
          </h1>
          <p id="reg-subtitle" class="text-xs text-[#5b6e5d] dark:text-stone-400 mt-1.5 leading-relaxed">
            अपना ग्वालियर डिलीवरी पता सुरक्षित करें, रविवार डिलीवरी ट्रैक करें और मुफ़्त सैंपल बुक करें।
          </p>
        </div>

        <!-- STEP 1: Registration Form -->
        <form id="reg-form" onsubmit="handleInitialRegister(event)" class="space-y-4">
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b] dark:text-stone-300 block mb-1.5">
              पूरा नाम <span class="text-[11px] font-normal text-stone-500">(Full Name) *</span>
            </label>
            <input
              id="reg-name"
              type="text"
              required
              placeholder="जैसे: आनंद शर्मा"
              class="fd-input font-bold"
            />
          </div>

          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b] dark:text-stone-300 block mb-1.5">
              मोबाइल नंबर <span class="text-[11px] font-normal text-stone-500">(WhatsApp Mobile) *</span>
            </label>
            <div class="flex">
              <span class="inline-flex items-center px-3.5 text-xs font-black bg-[#edf4ec] dark:bg-stone-800 border border-r-0 border-[#d9e4d5] dark:border-stone-700 rounded-l-xl text-[#1b4522] dark:text-emerald-400">+91</span>
              <input
                id="reg-phone"
                type="tel"
                required
                maxlength="10"
                pattern="[6-9][0-9]{9}"
                placeholder="10 अंकों का मोबाइल"
                class="fd-input rounded-l-none font-bold"
              />
            </div>
            <span class="text-[11px] text-[#718573] dark:text-stone-400 mt-1 block">रविवार डिलीवरी समन्वय एवं ऑर्डर ट्रैकिंग हेतु।</span>
          </div>

          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b] dark:text-stone-300 block mb-1.5">
              ईमेल पता <span class="text-[11px] font-normal text-stone-500">(Email Address) *</span>
            </label>
            <input
              id="reg-email"
              type="email"
              required
              placeholder="name@example.com"
              class="fd-input font-bold"
            />
          </div>

          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b] dark:text-stone-300 block mb-1.5">
              गुप्त पासवर्ड <span class="text-[11px] font-normal text-stone-500">(Password - कम से कम 8 अक्षर) *</span>
            </label>
            <input
              id="reg-pw"
              type="password"
              required
              minlength="8"
              placeholder="••••••••"
              class="fd-input font-bold"
            />
          </div>

          <div id="reg-error" class="hidden p-3.5 rounded-2xl bg-red-50 dark:bg-rose-950/40 border border-red-200 dark:border-rose-900/60 text-red-700 dark:text-rose-300 text-xs font-semibold text-center"></div>

          <button
            id="btn-reg-submit"
            type="submit"
            class="fd-btn fd-btn-primary w-full py-3.5 font-bold text-sm shadow-md"
          >
            वेरिफिकेशन कोड भेजें (Send OTP Code) &rarr;
          </button>
        </form>

        <!-- STEP 2: Email OTP Verification Card (Hidden initially) -->
        <div id="otp-container" class="hidden space-y-5">
          <div class="p-4 rounded-2xl bg-[#f4f9f4] dark:bg-stone-800/80 border border-[#cde4d0] dark:border-stone-700 text-center space-y-2">
            <span class="text-2xl">📩</span>
            <h3 class="font-extrabold text-sm text-[#132215] dark:text-stone-100">अपना ईमेल इनबॉक्स चेक करें (Check Email)</h3>
            <p class="text-xs text-[#556957] dark:text-stone-300 leading-relaxed">
              हमने ६-अंकों का सत्यापन कोड इस ईमेल पर भेजा है:
              <br/><strong id="otp-target-email" class="text-[#194622] dark:text-emerald-400 font-black break-all"></strong>
            </p>
          </div>

          <form id="otp-form" onsubmit="handleVerifyOtp(event)" class="space-y-4">
            <div>
              <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b] dark:text-stone-300 block mb-2 text-center">
                ६-अंकों का वेरिफिकेशन कोड दर्ज करें <span class="text-[11px] font-normal text-stone-500">(6-Digit Code) *</span>
              </label>
              <input
                id="otp-code"
                type="text"
                required
                maxlength="6"
                pattern="[0-9]{6}"
                placeholder="000000"
                autocomplete="one-time-code"
                class="fd-input text-center text-2xl tracking-[8px] font-black py-3 rounded-2xl text-[#18421f] dark:text-emerald-300 border-2 border-[#b2d5b6] dark:border-stone-700 focus:border-[#1b4522]"
              />
              <p class="text-[11px] text-[#718573] dark:text-stone-400 text-center mt-1.5">⏱️ कोड १० मिनट के लिए मान्य है</p>
            </div>

            <div id="otp-error" class="hidden p-3 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 text-rose-700 dark:text-rose-300 text-xs font-semibold text-center"></div>
            <div id="otp-success" class="hidden p-3 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800/60 text-emerald-800 dark:text-emerald-300 text-xs font-bold text-center"></div>

            <button
              id="btn-otp-submit"
              type="submit"
              class="fd-btn fd-btn-primary w-full py-3.5 font-bold text-sm shadow-md"
            >
              सत्यापित कर खाता पूरा करें (Verify & Register) &rarr;
            </button>
          </form>

          <div class="flex items-center justify-between pt-2 text-xs">
            <button
              id="btn-resend-otp"
              type="button"
              onclick="handleResendCode()"
              class="font-bold text-[#1b4522] dark:text-emerald-400 hover:underline disabled:opacity-50 disabled:no-underline"
            >
              कोड पुनः भेजें (Resend Code)
            </button>
            <button
              type="button"
              onclick="backToStep1()"
              class="text-[#687d6a] dark:text-stone-400 hover:text-[#1b4522] dark:hover:text-emerald-400 font-bold"
            >
              &larr; विवरण बदलें (Edit Details)
            </button>
          </div>
        </div>

        <!-- Guest Checkout Option -->
        <div id="guest-option-section">
          <div class="relative flex py-2 items-center">
            <div class="flex-grow border-t border-[#e2ece0] dark:border-stone-800"></div>
            <span class="flex-shrink mx-4 text-xs font-bold text-[#718573] dark:text-stone-500 uppercase tracking-wider">या • OR</span>
            <div class="flex-grow border-t border-[#e2ece0] dark:border-stone-800"></div>
          </div>

          <a
            href="/farm/products"
            class="fd-btn fd-btn-secondary w-full py-3.5 font-bold text-xs flex items-center justify-center gap-2 border border-[#d6e3d4] dark:border-stone-700"
          >
            <span>🛒 बिना खाते के सीधे ऑर्डर करें (Continue as Guest) &rarr;</span>
          </a>

          <div class="pt-6 border-t border-[#edf4ec] dark:border-stone-800 text-center text-xs text-[#5b6e5d] dark:text-stone-400">
            पहले से ग्राहक खाता मौजूद है?
            <a href="/farm/account/login" class="font-extrabold text-[#1b4522] dark:text-emerald-400 hover:underline ml-1">
              यहाँ लॉगिन करें (Log In)
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    let registeredEmail = '';
    let resendCountdown = 0;
    let resendTimer = null;

    async function handleInitialRegister(e) {
      e.preventDefault();
      const errBox = document.getElementById('reg-error');
      const submitBtn = document.getElementById('btn-reg-submit');

      errBox.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'सत्यापन कोड भेजा जा रहा है... (Sending code...)';

      const name = document.getElementById('reg-name').value.trim();
      const phone = document.getElementById('reg-phone').value.trim();
      const email = document.getElementById('reg-email').value.trim();
      const password = document.getElementById('reg-pw').value;

      registeredEmail = email;

      try {
        const res = await fetch('/farm/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, phone, email, password }),
        });

        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'खाता बनाने में त्रुटि हुई। कृपया पुनः प्रयास करें।';
          errBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'वेरिफिकेशन कोड भेजें (Send OTP Code) →';
          return;
        }

        // Check if server auto-verified or requested email OTP verification
        if (data.requireVerification) {
          switchToOtpStep(email, data.message);
          startResendCountdown(60);
          return;
        }

        window.location.href = '/farm/account';
      } catch (err) {
        errBox.textContent = 'नेटवर्क त्रुटि। कृपया दोबारा प्रयास करें। (Network error)';
        errBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'वेरिफिकेशन कोड भेजें (Send OTP Code) →';
      }
    }

    function switchToOtpStep(email, note) {
      document.getElementById('reg-form').classList.add('hidden');
      document.getElementById('otp-container').classList.remove('hidden');
      document.getElementById('otp-target-email').textContent = email;
      document.getElementById('reg-title').textContent = 'ईमेल सत्यापित करें (Verify Email)';
      document.getElementById('reg-subtitle').textContent = 'खाता सक्रिय करने के लिए अपने ईमेल पर भेजा गया ६-अंकों का कोड दर्ज करें।';
      document.getElementById('guest-option-section').classList.add('hidden');
      document.getElementById('otp-code').focus();
    }

    function backToStep1() {
      document.getElementById('otp-container').classList.add('hidden');
      document.getElementById('reg-form').classList.remove('hidden');
      document.getElementById('reg-title').textContent = 'नया ग्राहक खाता बनाएं';
      document.getElementById('reg-subtitle').textContent = 'अपना ग्वालियर डिलीवरी पता सुरक्षित करें, रविवार डिलीवरी ट्रैक करें और मुफ़्त सैंपल बुक करें।';
      document.getElementById('guest-option-section').classList.remove('hidden');
      const submitBtn = document.getElementById('btn-reg-submit');
      submitBtn.disabled = false;
      submitBtn.textContent = 'वेरिफिकेशन कोड भेजें (Send OTP Code) →';
    }

    async function handleVerifyOtp(e) {
      e.preventDefault();
      const errBox = document.getElementById('otp-error');
      const succBox = document.getElementById('otp-success');
      const btn = document.getElementById('btn-otp-submit');
      const code = document.getElementById('otp-code').value.trim();

      errBox.classList.add('hidden');
      succBox.classList.add('hidden');
      btn.disabled = true;
      btn.textContent = 'कोड सत्यापित किया जा रहा है... (Verifying...)';

      try {
        const res = await fetch('/farm/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: registeredEmail, code }),
        });

        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'अमान्य कोड। कृपया सही कोड दर्ज करें।';
          errBox.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'सत्यापित कर खाता पूरा करें (Verify & Register) →';
          return;
        }

        succBox.textContent = 'ईमेल सत्यापित हो गया! लॉगिन हो रहा है... (Verified! Logging in...)';
        succBox.classList.remove('hidden');

        setTimeout(() => {
          window.location.href = '/farm/account';
        }, 800);
      } catch (err) {
        errBox.textContent = 'नेटवर्क त्रुटि। कृपया दोबारा प्रयास करें।';
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'सत्यापित कर खाता पूरा करें (Verify & Register) →';
      }
    }

    async function handleResendCode() {
      if (resendCountdown > 0) return;
      const resendBtn = document.getElementById('btn-resend-otp');
      const errBox = document.getElementById('otp-error');
      const succBox = document.getElementById('otp-success');

      errBox.classList.add('hidden');
      resendBtn.disabled = true;
      resendBtn.textContent = 'Sending...';

      try {
        const res = await fetch('/farm/api/auth/resend-code', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: registeredEmail, purpose: 'register' }),
        });
        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'Failed to resend code.';
          errBox.classList.remove('hidden');
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend Code';
          return;
        }

        succBox.textContent = 'New code sent! Please check your email inbox.';
        succBox.classList.remove('hidden');
        startResendCountdown(60);
      } catch (err) {
        errBox.textContent = 'Network error. Please try again.';
        errBox.classList.remove('hidden');
        resendBtn.disabled = false;
        resendBtn.textContent = 'Resend Code';
      }
    }

    function startResendCountdown(seconds) {
      resendCountdown = seconds;
      const btn = document.getElementById('btn-resend-otp');
      btn.disabled = true;
      if (resendTimer) clearInterval(resendTimer);

      resendTimer = setInterval(() => {
        resendCountdown--;
        if (resendCountdown <= 0) {
          clearInterval(resendTimer);
          btn.disabled = false;
          btn.textContent = 'Resend Code';
        } else {
          btn.textContent = `Resend in ${resendCountdown}s`;
        }
      }, 1000);
    }
  </script>
</FarmLayout>
