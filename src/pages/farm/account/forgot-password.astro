---
import FarmLayout from '../../../layouts/FarmLayout.astro';

// Password Reset / Account Recovery with Email OTP Verification
---

<FarmLayout
  title="पासवर्ड रीसेट करें (Reset Password) | फार्म डायरेक्ट ग्वालियर"
  description="ईमेल वेरिफिकेशन कोड या सीधे व्हाट्सएप सहायता द्वारा अपना फार्म डायरेक्ट पासवर्ड रीसेट करें।"
  canonicalPath="/farm/account/forgot-password"
>
  <div class="fd-container py-12 sm:py-24">
    <div class="max-w-md mx-auto relative">
      <!-- Ambient Glow Behind Form -->
      <div class="absolute -top-10 -left-10 w-64 h-64 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative bg-white/95 dark:bg-stone-900/95 backdrop-blur-xl p-8 sm:p-10 rounded-3xl border border-[#e2ece0] dark:border-stone-800 shadow-xl space-y-6">
        <div class="text-center">
          <div class="w-14 h-14 bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 border border-amber-200 dark:border-amber-800/60 font-bold">
            🔑
          </div>
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/50 px-3 py-1 rounded-full border border-emerald-200 dark:border-emerald-800/60">
            खाता सुरक्षा • Account Recovery
          </span>
          <h1 id="forgot-title" class="fd-display text-2xl sm:text-3xl font-extrabold text-[#122815] dark:text-stone-100 mt-2">
            पासवर्ड रीसेट करें <span class="text-base font-normal text-[#5b6e5d] dark:text-stone-400 block sm:inline sm:ml-1">Reset Password</span>
          </h1>
          <p id="forgot-subtitle" class="text-xs text-[#5b6e5d] dark:text-stone-400 mt-1.5 leading-relaxed">
            सत्यापन कोड पाने के लिए अपना पंजीकृत ईमेल या १०-अंकों का मोबाइल नंबर दर्ज करें।
          </p>
        </div>

        <!-- STEP 1: Enter Email / Mobile -->
        <form id="step1-form" onsubmit="handleRequestResetCode(event)" class="space-y-4">
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b] dark:text-stone-300 block mb-1.5">
              पंजीकृत ईमेल या १०-अंकों का मोबाइल <span class="text-[11px] font-normal text-stone-500">(Email or Mobile) *</span>
            </label>
            <input
              id="reset-identifier"
              type="text"
              required
              placeholder="जैसे: name@example.com या 9876543210"
              class="fd-input font-bold"
            />
            <p class="text-[11px] text-[#718573] dark:text-stone-400 mt-1">
              आपके पंजीकृत जीमेल पर ६-अंकों का गुप्त रीसेट कोड भेजा जाएगा।
            </p>
          </div>

          <div id="step1-error" class="hidden p-3.5 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 text-rose-700 dark:text-rose-300 text-xs font-semibold text-center"></div>

          <button
            id="btn-step1-submit"
            type="submit"
            class="fd-btn fd-btn-primary w-full py-3.5 font-bold text-sm shadow-md"
          >
            वेरिफिकेशन कोड भेजें (Send OTP Code) &rarr;
          </button>
        </form>

        <!-- STEP 2: Enter Code & New Password -->
        <form id="step2-form" onsubmit="handleResetPassword(event)" class="hidden space-y-4">
          <div class="p-3.5 rounded-2xl bg-[#f4f9f4] dark:bg-stone-800/80 border border-[#cde4d0] dark:border-stone-700 text-center space-y-1">
            <span class="text-xl">📩</span>
            <p class="text-xs text-[#556957] dark:text-stone-300">
              रीसेट कोड इस ईमेल पर भेजा गया है:
              <br/><strong id="step2-masked-email" class="text-[#194622] dark:text-emerald-400 font-black break-all"></strong>
            </p>
          </div>

          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b] dark:text-stone-300 block mb-1.5 text-center">
              ६-अंकों का वेरिफिकेशन कोड <span class="text-[11px] font-normal text-stone-500">(6-Digit Code) *</span>
            </label>
            <input
              id="reset-code"
              type="text"
              required
              maxlength="6"
              pattern="[0-9]{6}"
              placeholder="000000"
              autocomplete="one-time-code"
              class="fd-input text-center text-2xl tracking-[8px] font-black py-3 rounded-2xl text-[#18421f] dark:text-emerald-300 border-2 border-[#b2d5b6] dark:border-stone-700 focus:border-[#1b4522]"
            />
          </div>

          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b] dark:text-stone-300 block mb-1.5">
              नया पासवर्ड <span class="text-[11px] font-normal text-stone-500">(New Password - कम से कम 8 अक्षर) *</span>
            </label>
            <input
              id="reset-new-pw"
              type="password"
              required
              minlength="8"
              placeholder="••••••••"
              class="fd-input font-bold"
            />
          </div>

          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b] dark:text-stone-300 block mb-1.5">
              नया पासवर्ड दोबारा दर्ज करें <span class="text-[11px] font-normal text-stone-500">(Confirm Password) *</span>
            </label>
            <input
              id="reset-confirm-pw"
              type="password"
              required
              minlength="8"
              placeholder="••••••••"
              class="fd-input font-bold"
            />
          </div>

          <div id="step2-error" class="hidden p-3.5 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 text-rose-700 dark:text-rose-300 text-xs font-semibold text-center"></div>
          <div id="step2-success" class="hidden p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800/60 text-emerald-800 dark:text-emerald-300 text-xs font-bold text-center"></div>

          <button
            id="btn-step2-submit"
            type="submit"
            class="fd-btn fd-btn-primary w-full py-3.5 font-bold text-sm shadow-md"
          >
            पासवर्ड बदलें और लॉगिन करें (Reset & Log In) &rarr;
          </button>

          <div class="flex items-center justify-between pt-2 text-xs">
            <button
              id="btn-resend-reset-otp"
              type="button"
              onclick="handleResendResetCode()"
              class="font-bold text-[#1b4522] dark:text-emerald-400 hover:underline disabled:opacity-50 disabled:no-underline"
            >
              कोड पुनः भेजें (Resend Code)
            </button>
            <button
              type="button"
              onclick="backToStep1()"
              class="text-[#687d6a] dark:text-stone-400 hover:text-[#1b4522] dark:hover:text-emerald-400 font-bold"
            >
              &larr; ईमेल या मोबाइल बदलें (Change)
            </button>
          </div>
        </form>

        <!-- Divider -->
        <div class="relative flex py-2 items-center">
          <div class="flex-grow border-t border-[#e2ece0] dark:border-stone-800"></div>
          <span class="flex-shrink mx-4 text-xs font-bold text-[#718573] dark:text-stone-500 uppercase tracking-wider">या व्हाट्सएप सहायता • WhatsApp Help</span>
          <div class="flex-grow border-t border-[#e2ece0] dark:border-stone-800"></div>
        </div>

        <!-- WhatsApp Fallback Button -->
        <button
          type="button"
          onclick="handleWhatsAppHelp()"
          class="fd-btn bg-[#25D366] hover:bg-[#1fa851] text-white w-full py-3 font-bold text-xs shadow-sm flex items-center justify-center gap-2"
        >
          <span>💬 व्हाट्सएप पर किसान सहायता प्राप्त करें &rarr;</span>
        </button>

        <div class="space-y-2.5 pt-2">
          <a
            href="/farm/products"
            class="fd-btn fd-btn-secondary w-full py-3 font-bold text-xs flex items-center justify-center gap-2 border border-[#d6e3d4] dark:border-stone-700"
          >
            <span>🛒 बिना लॉगिन सीधे उपज देखें (Browse as Guest) &rarr;</span>
          </a>
          <a
            href="/farm/account/login"
            class="block text-center text-xs font-bold text-[#1b4522] dark:text-emerald-400 hover:underline pt-2"
          >
            &larr; वापस लॉगिन पर जाएं (Back to Login)
          </a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    let resetEmail = '';
    let resendCountdown = 0;
    let resendTimer = null;

    async function handleRequestResetCode(e) {
      e.preventDefault();
      const identifier = document.getElementById('reset-identifier').value.trim();
      const errBox = document.getElementById('step1-error');
      const btn = document.getElementById('btn-step1-submit');

      errBox.classList.add('hidden');
      btn.disabled = true;
      btn.textContent = 'Sending reset code...';

      try {
        const res = await fetch('/farm/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier }),
        });

        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'Failed to send reset code.';
          errBox.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Send Verification Code →';
          return;
        }

        resetEmail = data.email;
        switchToStep2(data.maskedEmail);
        startResendCountdown(60);
      } catch (err) {
        errBox.textContent = 'Network error. Please try again.';
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Send Verification Code →';
      }
    }

    function switchToStep2(masked) {
      document.getElementById('step1-form').classList.add('hidden');
      document.getElementById('step2-form').classList.remove('hidden');
      document.getElementById('step2-masked-email').textContent = masked;
      document.getElementById('forgot-title').textContent = 'Enter Verification Code';
      document.getElementById('forgot-subtitle').textContent = 'Enter the code sent to your email and choose your new password.';
      document.getElementById('reset-code').focus();
    }

    function backToStep1() {
      document.getElementById('step2-form').classList.add('hidden');
      document.getElementById('step1-form').classList.remove('hidden');
      document.getElementById('forgot-title').textContent = 'Reset Password';
      document.getElementById('forgot-subtitle').textContent = 'Enter your registered email address or 10-digit mobile number to receive an automated verification code.';
      const btn = document.getElementById('btn-step1-submit');
      btn.disabled = false;
      btn.textContent = 'Send Verification Code →';
    }

    async function handleResetPassword(e) {
      e.preventDefault();
      const errBox = document.getElementById('step2-error');
      const succBox = document.getElementById('step2-success');
      const btn = document.getElementById('btn-step2-submit');

      const code = document.getElementById('reset-code').value.trim();
      const newPw = document.getElementById('reset-new-pw').value;
      const confirmPw = document.getElementById('reset-confirm-pw').value;

      errBox.classList.add('hidden');
      succBox.classList.add('hidden');

      if (newPw !== confirmPw) {
        errBox.textContent = 'Passwords do not match. Please re-enter.';
        errBox.classList.remove('hidden');
        return;
      }

      if (newPw.length < 8) {
        errBox.textContent = 'Password must be at least 8 characters long.';
        errBox.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Updating password...';

      try {
        const res = await fetch('/farm/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: resetEmail,
            code,
            password: newPw,
          }),
        });

        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'Failed to reset password.';
          errBox.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Reset Password & Log In →';
          return;
        }

        succBox.textContent = 'Password updated! Redirecting to your account...';
        succBox.classList.remove('hidden');

        setTimeout(() => {
          window.location.href = '/farm/account';
        }, 1000);
      } catch (err) {
        errBox.textContent = 'Network error. Please try again.';
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Reset Password & Log In →';
      }
    }

    async function handleResendResetCode() {
      if (resendCountdown > 0) return;
      const resendBtn = document.getElementById('btn-resend-reset-otp');
      const errBox = document.getElementById('step2-error');
      const succBox = document.getElementById('step2-success');

      errBox.classList.add('hidden');
      resendBtn.disabled = true;
      resendBtn.textContent = 'Sending...';

      try {
        const res = await fetch('/farm/api/auth/resend-code', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: resetEmail, purpose: 'reset_password' }),
        });
        const data = await res.json();
        if (!data.success) {
          errBox.textContent = data.error || 'Failed to resend code.';
          errBox.classList.remove('hidden');
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend Code';
          return;
        }

        succBox.textContent = 'New reset code sent! Please check your email inbox.';
        succBox.classList.remove('hidden');
        startResendCountdown(60);
      } catch (err) {
        errBox.textContent = 'Network error. Please try again.';
        errBox.classList.remove('hidden');
        resendBtn.disabled = false;
        resendBtn.textContent = 'Resend Code';
      }
    }

    function startResendCountdown(seconds) {
      resendCountdown = seconds;
      const btn = document.getElementById('btn-resend-reset-otp');
      btn.disabled = true;
      if (resendTimer) clearInterval(resendTimer);

      resendTimer = setInterval(() => {
        resendCountdown--;
        if (resendCountdown <= 0) {
          clearInterval(resendTimer);
          btn.disabled = false;
          btn.textContent = 'Resend Code';
        } else {
          btn.textContent = `Resend in ${resendCountdown}s`;
        }
      }, 1000);
    }

    function handleWhatsAppHelp() {
      const identifier = document.getElementById('reset-identifier')?.value.trim() || '';
      const msg = encodeURIComponent(`Namaste Farm Direct! I need help resetting my customer account password. My registered email/mobile is: ${identifier}`);
      window.open(`https://wa.me/918770767272?text=${msg}`, '_blank');
    }
  </script>
</FarmLayout>
