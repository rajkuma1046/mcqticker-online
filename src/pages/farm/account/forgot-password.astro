---
import FarmLayout from '../../../layouts/FarmLayout.astro';

// Password Reset / Account Recovery
---

<FarmLayout
  title="Forgot Password | Farm Direct Gwalior"
  description="Recover your Farm Direct account password via direct WhatsApp or phone verification."
  canonicalPath="/farm/account/forgot-password"
>
  <div class="fd-container py-12 sm:py-24">
    <div class="max-w-md mx-auto relative">
      <!-- Ambient Glow Behind Form -->
      <div class="absolute -top-10 -left-10 w-64 h-64 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative bg-white/95 backdrop-blur-xl p-8 sm:p-10 rounded-3xl border border-[#e2ece0] shadow-xl space-y-6">
        <div class="text-center">
          <div class="w-14 h-14 bg-amber-50 text-amber-700 rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 border border-amber-200 font-bold">
            🔑
          </div>
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
            Account Recovery
          </span>
          <h1 class="fd-display text-2xl sm:text-3xl font-extrabold text-[#122815] mt-2">
            Reset Password
          </h1>
          <p class="text-xs text-[#5b6e5d] mt-1.5 leading-relaxed">
            Enter your registered 10-digit mobile number to request an instant password reset via WhatsApp directly from the farmer.
          </p>
        </div>

        <form id="forgot-form" onsubmit="handleForgot(event)" class="space-y-4">
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#495c4b] block mb-1.5">
              Registered 10-Digit Mobile Number *
            </label>
            <div class="flex">
              <span class="inline-flex items-center px-3.5 text-xs font-black bg-[#edf4ec] border border-r-0 border-[#d9e4d5] rounded-l-xl text-[#1b4522]">+91</span>
              <input
                id="reset-phone"
                type="tel"
                required
                maxlength="10"
                pattern="[6-9][0-9]{9}"
                placeholder="10-digit mobile"
                class="fd-input rounded-l-none font-bold"
              />
            </div>
          </div>

          <button
            type="submit"
            class="fd-btn bg-[#25D366] hover:bg-[#1fa851] text-white w-full py-3.5 font-bold text-sm shadow-md flex items-center justify-center gap-2"
          >
            <span>💬 Request Reset on WhatsApp &rarr;</span>
          </button>
        </form>

        <div class="relative flex py-2 items-center">
          <div class="flex-grow border-t border-[#e2ece0]"></div>
          <span class="flex-shrink mx-4 text-xs font-bold text-[#718573] uppercase tracking-wider">or</span>
          <div class="flex-grow border-t border-[#e2ece0]"></div>
        </div>

        <div class="space-y-2.5">
          <a
            href="/farm/products"
            class="fd-btn fd-btn-secondary w-full py-3 font-bold text-xs flex items-center justify-center gap-2"
          >
            <span>🛒 Continue as Guest (No Login Required) &rarr;</span>
          </a>
          <a
            href="/farm/account/login"
            class="block text-center text-xs font-bold text-[#1b4522] hover:underline pt-2"
          >
            &larr; Back to Login
          </a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function handleForgot(e) {
      e.preventDefault();
      const phone = document.getElementById('reset-phone').value.trim();
      const msg = encodeURIComponent(`Namaste Farm Direct! I need to reset my account password for my registered mobile number: ${phone}. Please verify my account and send instructions.`);
      window.open(`https://wa.me/918770767272?text=${msg}`, '_blank');
    }
  </script>
</FarmLayout>
