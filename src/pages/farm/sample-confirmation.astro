---
import FarmLayout from '../../layouts/FarmLayout.astro';

// Free Sample Request Confirmation — Post-Request Tasting Slip
---

<FarmLayout
  title="मुफ़्त सैंपल कन्फ़र्म (Sample Confirmed) | खेत से सीधे — Farm Direct"
  description="आपके मुफ़्त खेत सैंपल टेस्टिंग का अनुरोध दर्ज हो चुका है। ग्वालियर व शिवपुरी में आगामी शेड्यूल्ड डिलीवरी राउंड में वितरण।"
  canonicalPath="/farm/sample-confirmation"
  hideCartBar={true}
>
  <div class="fd-container py-12 sm:py-20">
    <div class="max-w-xl mx-auto relative">
      <!-- Ambient Glow Behind Confirmation -->
      <div class="absolute -top-10 -left-10 w-72 h-72 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative bg-white/95 dark:bg-[#152317]/95 backdrop-blur-xl p-8 sm:p-12 rounded-3xl border border-[#e2ece0] dark:border-[#223d26] shadow-xl text-center space-y-6">
        <!-- Success Badge -->
        <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-[#1b4522] text-white rounded-2xl flex items-center justify-center text-3xl mx-auto shadow-lg shadow-emerald-900/20 font-bold">
          ✓
        </div>

        <div>
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-800 dark:text-emerald-200 bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 rounded-full border border-emerald-200 dark:border-emerald-800">
            मुफ़्त खेत चखनी • ₹0 शुल्क
          </span>
          <h1 class="fd-display text-2xl sm:text-4xl font-extrabold text-[#122815] dark:text-white mt-2">
            सैंपल पैकेट आरक्षित हो गया!
          </h1>
          <p class="text-xs sm:text-sm text-[#5b6e5d] dark:text-gray-300 mt-2 max-w-sm mx-auto leading-relaxed">
            आपका मुफ़्त टेस्टिंग पैकेट हमारे खेत प्रेषण रजिस्टर (Dispatch Register) में आगामी ग्वालियर व शिवपुरी डिलीवरी राउंड हेतु दर्ज कर लिया गया है।
          </p>
        </div>

        <!-- Sample Details Summary Card -->
        <div class="p-6 rounded-2xl bg-[#f8faf7] dark:bg-[#1a2d1d] border border-[#e2ece0] dark:border-[#2d4d32] text-left space-y-3.5 text-xs">
          <div class="flex items-center justify-between pb-3 border-b border-[#edf3ec] dark:border-[#244229]">
            <span class="text-[#5b6e5d] dark:text-gray-400 font-bold">प्राप्तकर्ता (Recipient):</span>
            <strong id="conf-recipient" class="font-bold text-[#122815] dark:text-white">लोड हो रहा है...</strong>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-[#5b6e5d] dark:text-gray-400">डिलीवरी इलाक़ा (Cluster):</span>
            <strong id="conf-cluster" class="font-bold text-[#152317] dark:text-gray-200">—</strong>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-[#5b6e5d] dark:text-gray-400">घर का पता (Address):</span>
            <span id="conf-address" class="font-semibold text-[#152317] dark:text-gray-200 text-right max-w-[60%] truncate">—</span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-[#5b6e5d] dark:text-gray-400">कुल सैंपल वज़न:</span>
            <strong id="conf-weight" class="font-extrabold text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-md border border-emerald-200 dark:border-emerald-800">0g / 500g अधिकतम</strong>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-[#5b6e5d] dark:text-gray-400">कुल शुल्क:</span>
            <strong class="fd-display text-lg font-black text-[#1b4522] dark:text-emerald-400">₹0 (मुफ़्त चखनी • Free)</strong>
          </div>

          <div class="pt-3 border-t border-[#edf3ec] dark:border-[#244229]">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#526454] dark:text-gray-400 block mb-2">आरक्षित फ़सल सैंपल:</span>
            <div id="conf-samples-list" class="space-y-1.5 text-[#132215] dark:text-gray-200">
              <div class="animate-pulse text-[#748776] dark:text-gray-400">सैंपल आइटम लोड हो रहे हैं...</div>
            </div>
          </div>
        </div>

        <!-- WhatsApp Dispatch Notice -->
        <div class="p-4 rounded-2xl bg-[#edf5ee] dark:bg-[#1b2f1e] border border-[#cbe4d0] dark:border-[#2d4d32] text-left flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
          <div>
            <strong class="font-bold text-[#1b4522] dark:text-emerald-300 block">किसान व्हाट्सएप पर्ची (WhatsApp Slip)</strong>
            <p class="text-[11px] text-[#335e3b] dark:text-gray-300 mt-0.5">
              अपनी सैंपल पर्ची सीधे हमारे किसान व्हाट्सएप पर भेजें: <strong>8770767272</strong>
            </p>
          </div>
          <a
            id="btn-wa-sample"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="fd-btn bg-[#25D366] hover:bg-[#1fa851] text-white font-bold text-xs py-2.5 px-4 rounded-xl shadow-xs whitespace-nowrap flex items-center justify-center gap-1.5"
          >
            <span>💬 व्हाट्सएप पर भेजें &rarr;</span>
          </a>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <a id="btn-track-sample" href="/farm/track" class="fd-btn fd-btn-primary w-full sm:w-auto px-6 py-3 font-bold text-xs shadow-md">
            सैंपल स्थिति ट्रैक करें &rarr;
          </a>
          <a href="/farm/products" class="fd-btn fd-btn-secondary w-full sm:w-auto px-6 py-3 font-bold text-xs">
            फ़सल सूची देखें (Catalogue)
          </a>
        </div>

        <!-- Guest Account Conversion Card -->
        <div id="guest-signup-box" class="pt-6 border-t border-[#edf4ec] dark:border-[#244229] text-xs text-[#5b6e5d] dark:text-gray-400">
          <p class="font-bold text-[#152317] dark:text-gray-200">पूरे साल के राशन का प्री-ऑर्डर करने की योजना है?</p>
          <p class="text-[11px] text-[#718573] dark:text-gray-400 mt-0.5 mb-3">भविष्य में तुरंत बुकिंग हेतु अपना पता सहेजने के लिए ग्राहक खाता बनाएँ।</p>
          <a href="/farm/account/register" class="fd-btn fd-btn-secondary fd-btn-sm font-bold inline-flex">
            ग्राहक खाता बनाएँ &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const phoneParam = urlParams.get('phone') || '';

      let cached = null;
      try {
        cached = JSON.parse(sessionStorage.getItem('fd_latest_sample') || 'null');
      } catch (_) {}

      if (cached && (!phoneParam || cached.phone === phoneParam)) {
        renderSampleData(cached);
      } else if (phoneParam) {
        // Fetch tracking info for this phone
        fetch(`/farm/api/orders/track?phone=${encodeURIComponent(phoneParam)}`)
          .then(r => r.json())
          .then(data => {
            if (data.success && data.sampleRequests && data.sampleRequests.length > 0) {
              const sr = data.sampleRequests[0];
              const totalGrams = data.sampleRequests.reduce((acc, s) => acc + (s.quantityGrams || 0), 0);
              renderSampleData({
                customerName: 'सम्मानित ग्राहक',
                phone: phoneParam,
                deliveryArea: sr.areaName || 'ग्वालियर क्लस्टर',
                deliveryAddress: 'पंजीकृत कॉलोनी का पता',
                totalGrams: totalGrams,
                items: data.sampleRequests.map(s => ({
                  productName: s.productName,
                  sampleQuantityGrams: s.quantityGrams
                })),
                roundInfo: sr.roundName || 'आगामी टेस्टिंग राउंड'
              });
            } else {
              fallbackUI(phoneParam);
            }
          })
          .catch(() => fallbackUI(phoneParam));
      } else {
        fallbackUI('');
      }

      function renderSampleData(data) {
        const recipEl = document.getElementById('conf-recipient');
        const clusterEl = document.getElementById('conf-cluster');
        const addrEl = document.getElementById('conf-address');
        const weightEl = document.getElementById('conf-weight');
        const listEl = document.getElementById('conf-samples-list');
        const waBtn = document.getElementById('btn-wa-sample');
        const trackBtn = document.getElementById('btn-track-sample');

        if (recipEl) recipEl.textContent = `${data.customerName || 'ग्राहक'} (+91 ${data.phone || ''})`;
        if (clusterEl) clusterEl.textContent = `${data.deliveryArea || 'ग्वालियर क्लस्टर'}`;
        if (addrEl) {
          addrEl.textContent = data.deliveryAddress || 'ग्वालियर पता';
          addrEl.title = data.deliveryAddress || '';
        }
        if (weightEl) weightEl.textContent = `${data.totalGrams || 0}g / 500g अधिकतम`;

        if (listEl && data.items && data.items.length > 0) {
          listEl.innerHTML = data.items.map(it => `
            <div class="flex items-center justify-between py-1.5 px-3 rounded-xl bg-white dark:bg-[#152317] border border-[#e5eee3] dark:border-[#223d26]">
              <span class="font-bold text-[#122815] dark:text-white">🌾 ${it.productName || it.name}</span>
              <strong class="text-emerald-800 dark:text-emerald-400 font-extrabold">${it.sampleQuantityGrams || it.quantityGrams || it.quantity}g</strong>
            </div>
          `).join('');
        }

        // WhatsApp link
        if (waBtn) {
          if (data.whatsappUrl) {
            waBtn.href = data.whatsappUrl;
          } else {
            const itemsText = (data.items || []).map(i => `${i.productName} (${i.sampleQuantityGrams}g)`).join(', ');
            const msg = encodeURIComponent(`नमस्ते Farm Direct! मैंने मुफ़्त सैंपल का अनुरोध किया है: ${itemsText} (कुल ${data.totalGrams}g), प्राप्तकर्ता: ${data.customerName || 'ग्राहक'}, क्षेत्र: ${data.deliveryArea || 'ग्वालियर'}। कृपया पुष्टि करें।`);
            waBtn.href = `https://wa.me/918770767272?text=${msg}`;
          }
        }

        if (trackBtn) {
          trackBtn.href = `/farm/track?phone=${encodeURIComponent(data.phone || phoneParam)}`;
        }
      }

      function fallbackUI(phone) {
        document.getElementById('conf-recipient').textContent = phone ? `ग्राहक (+91 ${phone})` : 'सैंपल प्राप्तकर्ता';
        document.getElementById('conf-cluster').textContent = 'ग्वालियर / शिवपुरी क्लस्टर';
        document.getElementById('conf-address').textContent = 'दर्ज घर का पता';
        document.getElementById('conf-weight').textContent = '500g सीमा तक';
        document.getElementById('conf-samples-list').innerHTML = `
          <div class="p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-900 dark:text-emerald-300 font-semibold text-xs border border-emerald-200 dark:border-emerald-800">
            ✓ आपके सैंपल अनुरोध खेत प्रेषण कतार में दर्ज हो चुके हैं।
          </div>
        `;
        const trackBtn = document.getElementById('btn-track-sample');
        if (trackBtn && phone) {
          trackBtn.href = `/farm/track?phone=${encodeURIComponent(phone)}`;
        }
        const waBtn = document.getElementById('btn-wa-sample');
        if (waBtn) {
          const msg = encodeURIComponent(`नमस्ते Farm Direct! कृपया मेरे हाल के मुफ़्त सैंपल अनुरोध (+91 ${phone}) की स्थिति बताएँ।`);
          waBtn.href = `https://wa.me/918770767272?text=${msg}`;
        }
      }

      // Check if logged in to hide guest prompt
      fetch('/farm/api/auth/me')
        .then(r => r.json())
        .then(d => {
          if (d.success && d.user) {
            const guestBox = document.getElementById('guest-signup-box');
            if (guestBox) guestBox.classList.add('hidden');
          }
        })
        .catch(() => {});
    });
  </script>
</FarmLayout>
