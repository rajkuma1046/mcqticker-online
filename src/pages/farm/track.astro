---
import FarmLayout from '../../layouts/FarmLayout.astro';
---

<FarmLayout
  title="Track Pre-Order & Sample Requests | Farm Direct Gwalior"
  description="Check live status and delivery updates for your Farm Direct produce pre-order or sample request."
  canonicalPath="/farm/track"
>
  <div class="fd-container py-8 sm:py-16">
    <div class="max-w-2xl mx-auto space-y-8">
      <div class="text-center">
        <span class="text-xs uppercase tracking-wider text-[#275629] font-bold bg-[#eaf3e9] px-3 py-1 rounded-full">
          Live Status Tracker
        </span>
        <h1 class="fd-serif text-3xl sm:text-4xl font-bold text-[#152317] mt-3">
          Track Your Pre-Order
        </h1>
        <p class="text-xs sm:text-sm text-[#536354] mt-2">
          Enter your Order Number or registered Mobile Number to see current delivery updates.
        </p>
      </div>

      <!-- Search Box Card -->
      <div class="bg-white p-6 sm:p-8 rounded-2xl border border-[#e0e8dc] shadow-sm">
        <form onsubmit="handleTrack(event)" class="space-y-4">
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-[#536354] block mb-1">
              Order Number or Mobile Number *
            </label>
            <input
              id="track-input"
              type="text"
              required
              placeholder="e.g. FD-GWL-20261004-0012 or 8770767272"
              class="w-full text-sm font-semibold p-3.5 rounded-xl border border-[#d0ded0] bg-white focus:outline-none focus:border-[#275629]"
            />
          </div>

          <button
            id="btn-track-submit"
            type="submit"
            class="fd-btn fd-btn-primary w-full py-3.5 font-bold text-sm shadow-md"
          >
            Track Status &rarr;
          </button>
        </form>
      </div>

      <!-- Result Container -->
      <div id="track-result" class="hidden space-y-6"></div>
      <div id="track-error" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs sm:text-sm font-semibold text-center"></div>
    </div>
  </div>

  <script is:inline>
    const STATUS_MAP = {
      'PENDING': { label: 'Pre-Order Received', color: 'bg-amber-100 text-amber-800' },
      'CONFIRMED': { label: 'Confirmed & Reserved', color: 'bg-blue-100 text-blue-800' },
      'PREPARING': { label: 'Packing at Farm', color: 'bg-indigo-100 text-indigo-800' },
      'READY_FOR_DELIVERY': { label: 'Ready for Transport', color: 'bg-purple-100 text-purple-800' },
      'OUT_FOR_DELIVERY': { label: 'Out for Delivery in Gwalior', color: 'bg-emerald-100 text-emerald-800' },
      'DELIVERED': { label: 'Delivered', color: 'bg-green-100 text-green-800' },
      'CANCELLED': { label: 'Cancelled', color: 'bg-red-100 text-red-800' },
      'REQUESTED': { label: 'Sample Requested', color: 'bg-amber-100 text-amber-800' },
      'APPROVED': { label: 'Sample Approved', color: 'bg-blue-100 text-blue-800' },
      'SCHEDULED': { label: 'Scheduled for Round', color: 'bg-purple-100 text-purple-800' },
    };

    async function handleTrack(e) {
      if (e) e.preventDefault();
      const input = document.getElementById('track-input').value.trim();
      if (!input) return;

      const resBox = document.getElementById('track-result');
      const errBox = document.getElementById('track-error');
      const btn = document.getElementById('btn-track-submit');

      resBox.classList.add('hidden');
      errBox.classList.add('hidden');
      btn.disabled = true;
      btn.textContent = 'Searching...';

      const isPhone = /^\d{10}$/.test(input.replace(/\D/g, ''));
      const param = isPhone ? `phone=${encodeURIComponent(input)}` : `order_number=${encodeURIComponent(input)}`;

      try {
        const res = await fetch(`/farm/api/orders/track?${param}`);
        const data = await res.json();

        btn.disabled = false;
        btn.textContent = 'Track Status →';

        if (!data.success) {
          errBox.textContent = data.error || 'No records found matching your query.';
          errBox.classList.remove('hidden');
          return;
        }

        renderTracking(data);
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'Track Status →';
        errBox.textContent = 'Failed to connect. Please check your network.';
        errBox.classList.remove('hidden');
      }
    }

    function renderTracking(data) {
      const resBox = document.getElementById('track-result');
      let html = '';

      if (data.order) {
        const o = data.order;
        const st = STATUS_MAP[o.status] || { label: o.status, color: 'bg-gray-100 text-gray-800' };

        html += `
          <div class="bg-white p-6 sm:p-8 rounded-2xl border border-[#e0e8dc] shadow-sm space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-[#f0f4ee]">
              <div>
                <span class="text-xs text-[#536354]">Order Number</span>
                <h3 class="font-bold text-lg text-[#152317]">${o.orderNumber}</h3>
              </div>
              <span class="px-3 py-1 rounded-full text-xs font-bold ${st.color}">
                ${st.label}
              </span>
            </div>

            <div class="grid grid-cols-2 gap-4 text-xs text-[#536354]">
              <div>
                <span>Customer:</span>
                <strong class="text-[#152317] block font-semibold">${o.customerName} (${o.maskedPhone})</strong>
              </div>
              <div>
                <span>Delivery Cluster:</span>
                <strong class="text-[#152317] block font-semibold">${o.deliveryArea}, Gwalior</strong>
              </div>
              <div>
                <span>Delivery Address:</span>
                <strong class="text-[#152317] block font-semibold">${o.deliveryAddress}</strong>
              </div>
              <div>
                <span>Grand Total (Pay on Delivery):</span>
                <strong class="text-[#275629] block font-bold text-sm">₹${o.grandTotalRupees}</strong>
              </div>
            </div>

            <!-- Items -->
            <div class="pt-3 border-t border-[#f0f4ee]">
              <h4 class="text-xs font-bold uppercase tracking-wider text-[#536354] mb-2">Reserved Items</h4>
              <div class="space-y-1 text-xs">
                ${o.items.map(it => `
                  <div class="flex justify-between py-1 border-b border-neutral-100 last:border-b-0">
                    <span class="font-medium text-[#152317]">${it.name} (${it.quantity} ${it.unit})</span>
                    <strong class="text-[#275629]">₹${it.lineTotalRupees}</strong>
                  </div>
                `).join('')}
              </div>
            </div>

            <!-- Timeline -->
            ${o.timeline && o.timeline.length > 0 ? `
              <div class="pt-3 border-t border-[#f0f4ee]">
                <h4 class="text-xs font-bold uppercase tracking-wider text-[#536354] mb-2">Order Activity Timeline</h4>
                <div class="space-y-2 text-xs">
                  ${o.timeline.map(t => `
                    <div class="flex items-start gap-2 text-[#536354]">
                      <span class="text-[#275629] font-bold">•</span>
                      <div>
                        <strong>${t.to_status}</strong>: ${t.note || ''}
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>
            ` : ''}

            <!-- Direct WhatsApp Help -->
            <div class="pt-3 border-t border-[#f0f4ee] flex justify-between items-center text-xs">
              <span class="text-[#536354]">Need help or address update?</span>
              <a href="https://wa.me/918770767272?text=Hello%20Farm%20Direct,%20checking%20on%20my%20order%20${o.orderNumber}" target="_blank" rel="noopener noreferrer" class="text-[#25d366] font-bold hover:underline flex items-center gap-1">
                WhatsApp Us (8770767272) &rarr;
              </a>
            </div>
          </div>
        `;
      }

      // If sample requests exist
      if (data.sampleRequests && data.sampleRequests.length > 0) {
        html += `
          <div class="bg-white p-6 sm:p-8 rounded-2xl border border-[#e0e8dc] shadow-sm space-y-4">
            <h3 class="font-bold text-base text-[#152317] pb-2 border-b border-[#f0f4ee]">
              Sample Requests (${data.sampleRequests.length})
            </h3>
            <div class="space-y-3">
              ${data.sampleRequests.map(s => {
                const sst = STATUS_MAP[s.status] || { label: s.status, color: 'bg-gray-100 text-gray-800' };
                return `
                  <div class="p-3.5 rounded-xl bg-[#f8faf6] border border-[#e0e8dc] flex items-center justify-between text-xs">
                    <div>
                      <strong class="text-sm font-bold text-[#152317] block">${s.productName} (${s.quantityGrams} g)</strong>
                      <span class="text-[#536354]">${s.areaName} • ${s.roundName || 'Pending next round schedule'}</span>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold ${sst.color}">
                      ${sst.label}
                    </span>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }

      resBox.innerHTML = html;
      resBox.classList.remove('hidden');
    }

    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const initialNum = urlParams.get('order_number') || urlParams.get('phone');
      if (initialNum) {
        document.getElementById('track-input').value = initialNum;
        handleTrack();
      }
    });
  </script>
</FarmLayout>
