---
import FarmLayout from '../../layouts/FarmLayout.astro';
---

<FarmLayout
  title="Customer Reviews & Harvest Photos | Farm Direct"
  description="Read verified customer reviews and view authentic harvest photos from families across Village Sirsod, Naya Amola, Karera, Shivpuri, and Gwalior."
  canonicalPath="/farm/reviews"
>
  <div class="fd-container py-8 sm:py-14 max-w-5xl space-y-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[#5b6e5d] font-semibold">
      <a href="/farm" class="hover:text-[#194622]">Home</a>
      <span>/</span>
      <span class="font-extrabold text-[#132215]">Customer Reviews & Photos</span>
    </nav>

    <!-- Hero Header -->
    <div class="bg-gradient-to-br from-[#184420] via-[#21572c] to-[#123318] text-white rounded-3xl p-8 sm:p-12 shadow-xl relative overflow-hidden">
      <div class="absolute -right-12 -bottom-12 w-64 h-64 bg-emerald-400/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="max-w-2xl space-y-4 relative z-10">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-400/20 text-emerald-200 border border-emerald-400/30 text-xs font-extrabold uppercase tracking-wider">
          <span>🌾</span>
          <span>100% Real Customer Photos & Feedback</span>
        </span>
        <h1 class="fd-display text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight">
          Community Reviews & Farm Harvest Photos
        </h1>
        <p class="text-xs sm:text-sm text-[#d0e5d3] leading-relaxed">
          See unfiltered feedback and cooking results directly from families in Village Sirsod, Naya Amola, Karera, Shivpuri, and Gwalior who cook with our unpolished harvest.
        </p>
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <button
            type="button"
            onclick="openWriteReviewModal()"
            class="fd-btn bg-white hover:bg-emerald-50 text-[#194622] px-6 py-3.5 rounded-2xl text-xs sm:text-sm font-extrabold shadow-lg hover:scale-102 active:scale-98 transition-all cursor-pointer flex items-center gap-2"
          >
            <span>✍️ Write a Review & Upload Photo</span>
          </button>
          <a
            href="/farm/products"
            class="px-5 py-3 rounded-2xl text-xs font-bold text-emerald-200 hover:text-white border border-emerald-400/40 hover:bg-white/10 transition-colors"
          >
            Browse Harvest Produce &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Rating Summary Dashboard -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 bg-white p-6 sm:p-8 rounded-3xl border border-[#dce7db] shadow-sm">
      <!-- Big Score -->
      <div class="md:col-span-5 flex flex-col items-center justify-center text-center p-6 bg-[#f8faf7] rounded-2xl border border-[#e5eee3] space-y-2">
        <div class="text-5xl sm:text-6xl font-black text-[#194622]" id="rev-avg-score">—</div>
        <div class="flex items-center gap-1 text-amber-400 text-2xl" id="rev-avg-stars">
          ★★★★★
        </div>
        <div class="text-xs font-bold text-[#132215]" id="rev-total-count-text">
          Loading verified community reviews...
        </div>
        <div class="text-[11px] text-[#637765] flex items-center gap-1 font-semibold">
          <span class="text-emerald-600 font-extrabold">✓</span> Verified Village Farm Direct Deliveries
        </div>
      </div>

      <!-- Rating Breakdown Bars -->
      <div class="md:col-span-7 flex flex-col justify-center space-y-2.5 text-xs font-semibold text-[#5b6e5d]">
        <div class="flex items-center gap-3">
          <span class="w-12 text-right font-bold text-[#132215]">5 ★</span>
          <div class="flex-1 h-3 rounded-full bg-[#e9f0e8] overflow-hidden">
            <div id="bar-star-5" class="h-full bg-emerald-600 rounded-full transition-all duration-500" style="width: 100%;"></div>
          </div>
          <span id="count-star-5" class="w-8 text-right font-bold text-[#132215]">0</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="w-12 text-right font-bold text-[#132215]">4 ★</span>
          <div class="flex-1 h-3 rounded-full bg-[#e9f0e8] overflow-hidden">
            <div id="bar-star-4" class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width: 0%;"></div>
          </div>
          <span id="count-star-4" class="w-8 text-right font-bold text-[#132215]">0</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="w-12 text-right font-bold text-[#132215]">3 ★</span>
          <div class="flex-1 h-3 rounded-full bg-[#e9f0e8] overflow-hidden">
            <div id="bar-star-3" class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
          </div>
          <span id="count-star-3" class="w-8 text-right font-bold text-[#132215]">0</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="w-12 text-right font-bold text-[#132215]">2 ★</span>
          <div class="flex-1 h-3 rounded-full bg-[#e9f0e8] overflow-hidden">
            <div id="bar-star-2" class="h-full bg-orange-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
          </div>
          <span id="count-star-2" class="w-8 text-right font-bold text-[#132215]">0</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="w-12 text-right font-bold text-[#132215]">1 ★</span>
          <div class="flex-1 h-3 rounded-full bg-[#e9f0e8] overflow-hidden">
            <div id="bar-star-1" class="h-full bg-rose-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
          </div>
          <span id="count-star-1" class="w-8 text-right font-bold text-[#132215]">0</span>
        </div>
      </div>
    </div>

    <!-- Community Harvest Photos Strip -->
    <div id="customer-photos-box" class="space-y-3 hidden">
      <div class="flex items-center justify-between">
        <h3 class="font-extrabold text-base text-[#122815] flex items-center gap-2">
          <span>📸</span>
          <span>Customer Harvest & Cooking Photos</span>
        </h3>
        <span id="photos-count-label" class="text-xs text-[#5b6e5d] font-bold"></span>
      </div>
      <div id="photos-strip" class="flex gap-3 overflow-x-auto pb-3 scrollbar-none">
        <!-- Rendered via JS -->
      </div>
    </div>

    <!-- Produce & Filter Tabs -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          class="produce-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-[#1b4522] text-white shadow-xs cursor-pointer"
          data-prod="all"
          onclick="filterProduce('all', this)"
        >
          All Produce
        </button>
        <button
          type="button"
          class="produce-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer"
          data-prod="1"
          onclick="filterProduce('1', this)"
        >
          🌾 Farm Wheat
        </button>
        <button
          type="button"
          class="produce-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer"
          data-prod="2"
          onclick="filterProduce('2', this)"
        >
          🥜 Raw Groundnut
        </button>
        <button
          type="button"
          class="produce-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer"
          data-prod="3"
          onclick="filterProduce('3', this)"
        >
          🥣 Raw Chana
        </button>
        <button
          type="button"
          class="produce-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer"
          data-prod="4"
          onclick="filterProduce('4', this)"
        >
          🌱 Raw Moong
        </button>
        <button
          type="button"
          class="produce-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer"
          data-prod="5"
          onclick="filterProduce('5', this)"
        >
          🌾 Raw Urad
        </button>
        <button
          type="button"
          class="produce-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer"
          data-prod="6"
          onclick="filterProduce('6', this)"
        >
          🥕 Seasonal Produce
        </button>
      </div>

      <!-- Secondary filter: photos / 5 stars -->
      <div class="flex items-center gap-2 pt-1 text-xs">
        <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-[#dce7db] cursor-pointer hover:bg-emerald-50">
          <input type="checkbox" id="chk-photos-only" class="rounded text-emerald-800 focus:ring-emerald-800" onchange="togglePhotoFilter(this.checked)" />
          <span class="font-bold text-[#132215]">📸 Photos Only</span>
        </label>
        <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-[#dce7db] cursor-pointer hover:bg-emerald-50">
          <input type="checkbox" id="chk-five-stars" class="rounded text-emerald-800 focus:ring-emerald-800" onchange="toggleStarFilter(this.checked)" />
          <span class="font-bold text-[#132215]">⭐ 5 Stars Only</span>
        </label>
      </div>
    </div>

    <!-- Reviews Loading -->
    <div id="reviews-loading" class="text-center py-16 text-[#5b6e5d]">
      <div class="inline-block animate-spin w-8 h-8 border-4 border-[#194622] border-t-transparent rounded-full mb-3"></div>
      <p class="text-sm font-bold text-[#132215]">Loading customer reviews and harvest photos...</p>
    </div>

    <!-- Reviews Grid Feed -->
    <div id="reviews-feed" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Rendered via JS -->
    </div>

    <!-- Empty State -->
    <div id="reviews-empty" class="hidden text-center py-16 bg-white rounded-3xl border border-[#dce7db] p-8 space-y-4">
      <div class="text-5xl">🌾</div>
      <h3 class="font-extrabold text-[#122815] text-lg">No reviews found for this selection</h3>
      <p class="text-xs text-[#5b6e5d] max-w-sm mx-auto">
        Have you received our harvest produce? Be the first to share your experience with other families!
      </p>
      <button
        type="button"
        onclick="openWriteReviewModal()"
        class="fd-btn fd-btn-primary px-6 py-3 rounded-2xl text-xs font-bold inline-block cursor-pointer"
      >
        Write a Review &rarr;
      </button>
    </div>
  </div>

  <!-- Modal: Write a Review with Photos -->
  <div id="modal-write-review" class="hidden fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-3 sm:p-4 pb-4 overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 pb-10 sm:pb-8 shadow-2xl border border-[#dce7db] space-y-5 animate-in fade-in zoom-in duration-200 max-h-[86dvh] overflow-y-auto overscroll-contain">
      <div class="flex items-start justify-between pb-3 border-b border-[#f0f5ee]">
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-900 text-[10px] font-extrabold uppercase mb-1">Authentic Community Feedback</span>
          <h3 class="fd-display font-extrabold text-xl text-[#122815]">Write a Review</h3>
          <p class="text-xs text-[#5b6e5d]">Share your cooking experience, aroma, and photos</p>
        </div>
        <button type="button" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold flex items-center justify-center cursor-pointer" onclick="closeWriteReviewModal()">✕</button>
      </div>

      <form id="review-form" onsubmit="submitCustomerReview(event)" class="space-y-4 text-xs">
        <!-- Produce Select -->
        <div>
          <label class="font-extrabold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">Select Farm Produce *</label>
          <select id="rev-input-product" required class="fd-input font-bold text-xs">
            <option value="1">Farm Wheat (Gehu)</option>
            <option value="2">Raw Groundnut / Peanut (Mungphali)</option>
            <option value="3">Raw Chana (Desi Kala Chana)</option>
            <option value="4">Raw Moong (Sabut Moong)</option>
            <option value="5">Raw Urad (Sabut Urad)</option>
            <option value="6">Seasonal Farm Produce (Mausami Upaj)</option>
          </select>
        </div>

        <!-- Rating Picker -->
        <div>
          <label class="font-extrabold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1.5">
            Your Overall Rating *
          </label>
          <div class="flex items-center gap-2">
            <div id="star-picker" class="flex items-center gap-1.5 text-3xl cursor-pointer">
              <span class="star-btn text-amber-400 transition-transform hover:scale-125" data-val="1" onclick="setPickerRating(1)">★</span>
              <span class="star-btn text-amber-400 transition-transform hover:scale-125" data-val="2" onclick="setPickerRating(2)">★</span>
              <span class="star-btn text-amber-400 transition-transform hover:scale-125" data-val="3" onclick="setPickerRating(3)">★</span>
              <span class="star-btn text-amber-400 transition-transform hover:scale-125" data-val="4" onclick="setPickerRating(4)">★</span>
              <span class="star-btn text-amber-400 transition-transform hover:scale-125" data-val="5" onclick="setPickerRating(5)">★</span>
            </div>
            <span id="star-picker-label" class="text-xs font-bold text-[#194622] ml-2">5 - Excellent</span>
          </div>
        </div>

        <!-- Headline / Title -->
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">
            Review Headline (Optional)
          </label>
          <input
            id="rev-input-title"
            type="text"
            maxlength="100"
            class="fd-input font-bold"
            placeholder="e.g. Pure village fragrance, soft rotis"
          />
        </div>

        <!-- Written Review Text -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px]">
              Detailed Written Review *
            </label>
            <span id="rev-char-count" class="text-[10px] text-[#788e7b]">0 / 1000</span>
          </div>
          <textarea
            id="rev-input-text"
            required
            rows="4"
            maxlength="1000"
            class="fd-input"
            placeholder="Share your thoughts on taste, purity, cleanliness, freshness, or delivery speed..."
            oninput="updateReviewCharCount(this)"
          ></textarea>
        </div>

        <!-- Photo Upload Dropzone -->
        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">
            Attach Harvest / Cooking Photo (Optional)
          </label>
          <div
            id="rev-photo-dropzone"
            class="relative border-2 border-dashed border-[#cfe0cc] rounded-2xl p-4 text-center hover:bg-[#f7faf5] transition-colors cursor-pointer bg-[#fafcf9]"
            onclick="document.getElementById('rev-file-input').click()"
          >
            <input
              id="rev-file-input"
              type="file"
              accept="image/*"
              class="hidden"
              onchange="handleReviewPhotoSelect(this)"
            />
            <div id="dropzone-empty-state" class="space-y-1">
              <div class="text-2xl">📸</div>
              <p class="font-bold text-[#132215] text-xs">Tap to choose a photo or snap a picture</p>
              <p class="text-[10px] text-[#718573]">PNG, JPG, WEBP — auto-compressed for fast upload</p>
            </div>

            <!-- Preview State -->
            <div id="dropzone-preview-state" class="hidden flex items-center justify-between gap-3 p-2 bg-white rounded-xl border border-[#dce7db]">
              <div class="flex items-center gap-3">
                <img id="rev-preview-img" src="" alt="Review preview" class="w-12 h-12 rounded-lg object-cover border border-[#dce7db]" />
                <div class="text-left">
                  <span id="rev-preview-filename" class="font-bold text-[#132215] text-xs block truncate max-w-[180px]">photo.jpg</span>
                  <span id="rev-preview-filesize" class="text-[10px] text-[#718573]"></span>
                </div>
              </div>
              <button
                type="button"
                onclick="removeReviewPhoto(event)"
                class="px-2.5 py-1 rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 font-bold text-xs cursor-pointer"
              >
                ✕ Remove
              </button>
            </div>
          </div>
        </div>

        <!-- Customer Identity Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <div>
            <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">Your Name *</label>
            <input id="rev-input-name" type="text" required class="fd-input font-bold" placeholder="e.g. Ramesh Sharma" />
          </div>
          <div>
            <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">Neighbourhood / Village *</label>
            <input id="rev-input-city" type="text" required class="fd-input font-bold" placeholder="e.g. Sirsod / Gwalior" />
          </div>
        </div>

        <div>
          <label class="font-bold uppercase tracking-wider text-[#5b6e5d] text-[11px] block mb-1">WhatsApp Mobile (Optional)</label>
          <input id="rev-input-phone" type="tel" maxlength="10" class="fd-input" placeholder="For verified purchase badge" />
        </div>

        <div id="rev-error-box" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 font-semibold text-xs"></div>

        <div class="pt-3 pb-3">
          <button
            type="submit"
            id="btn-submit-review"
            class="fd-btn fd-btn-primary w-full py-4 font-extrabold text-sm rounded-2xl shadow-lg cursor-pointer transition-transform active:scale-[0.98]"
          >
            Publish Review & Photo &rarr;
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Photo Lightbox -->
  <div id="modal-photo-lightbox" class="hidden fixed inset-0 z-[100] bg-black/85 backdrop-blur-md flex items-center justify-center p-4" onclick="closePhotoLightbox()">
    <div class="relative max-w-2xl w-full bg-white rounded-3xl overflow-hidden shadow-2xl space-y-0" onclick="event.stopPropagation()">
      <button type="button" class="absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-black/50 text-white font-bold flex items-center justify-center hover:bg-black/75 cursor-pointer" onclick="closePhotoLightbox()">✕</button>
      <div class="bg-black flex items-center justify-center max-h-[60vh] overflow-hidden">
        <img id="lightbox-img" src="" alt="Harvest photo" class="w-full h-full object-contain max-h-[60vh]" />
      </div>
      <div class="p-6 space-y-2 bg-white">
        <div class="flex items-center justify-between">
          <strong id="lightbox-author" class="text-sm font-extrabold text-[#122815]"></strong>
          <span id="lightbox-stars" class="text-amber-400 font-bold text-sm"></span>
        </div>
        <p id="lightbox-caption" class="text-xs text-[#5b6e5d] leading-relaxed"></p>
      </div>
    </div>
  </div>

  <script is:inline>
    let allReviews = [];
    let selectedProduce = 'all';
    let filterPhotosOnly = false;
    let filter5StarsOnly = false;
    let selectedRating = 5;
    let selectedPhotoBase64 = null;
    let selectedPhotoName = 'review.jpg';

    const RATING_LABELS = {
      5: '5 - Excellent, authentic farm quality',
      4: '4 - Very Good harvest',
      3: '3 - Satisfactory',
      2: '2 - Below expectations',
      1: '1 - Poor'
    };

    async function loadReviews() {
      const loader = document.getElementById('reviews-loading');
      try {
        const res = await fetch('/farm/api/reviews');
        const data = await res.json();
        if (loader) loader.classList.add('hidden');

        if (data.success) {
          allReviews = data.reviews || [];
          updateReviewsSummary(data.summary, allReviews);
          renderCustomerPhotos(allReviews);
          renderFilteredReviews();
        }
      } catch (err) {
        if (loader) loader.innerHTML = '<p class="text-xs text-red-500 font-bold">Failed to load reviews. Please refresh.</p>';
      }
    }

    function updateReviewsSummary(summary, reviews) {
      if (!summary) return;
      const total = summary.totalReviews || reviews.length;
      const avg = total > 0 ? (summary.averageRating || 0) : 0;
      const scoreEl = document.getElementById('rev-avg-score');
      const starsEl = document.getElementById('rev-avg-stars');
      const countTextEl = document.getElementById('rev-total-count-text');

      if (scoreEl) scoreEl.textContent = total > 0 ? avg.toFixed(1) : '—';
      if (starsEl) starsEl.textContent = '★'.repeat(Math.round(avg)) + '☆'.repeat(5 - Math.round(avg));
      if (countTextEl) countTextEl.textContent = total > 0
        ? `Based on ${total} verified community review${total === 1 ? '' : 's'}`
        : 'No reviews yet — be the first to share your experience';

      const dist = summary.distribution || {};
      for (let s = 1; s <= 5; s++) {
        const count = dist[s] || 0;
        const pct = total > 0 ? Math.round((count / total) * 100) : 0;
        const barEl = document.getElementById(`bar-star-${s}`);
        const cntEl = document.getElementById(`count-star-${s}`);
        if (barEl) barEl.style.width = `${pct}%`;
        if (cntEl) cntEl.textContent = count;
      }
    }

    function renderCustomerPhotos(reviews) {
      const photoReviews = reviews.filter(r => r.photoUrl);
      const box = document.getElementById('customer-photos-box');
      const strip = document.getElementById('photos-strip');
      const label = document.getElementById('photos-count-label');

      if (!box || !strip) return;

      if (photoReviews.length > 0) {
        box.classList.remove('hidden');
        if (label) label.textContent = `${photoReviews.length} community photo${photoReviews.length === 1 ? '' : 's'}`;

        strip.innerHTML = photoReviews.map(r => `
          <button
            type="button"
            onclick="openPhotoLightbox('${r.photoUrl}', '${escapeHtml(r.customerName)}', ${r.rating}, '${escapeHtml(r.reviewText)}')"
            class="group relative shrink-0 w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden border border-[#dce7db] shadow-xs cursor-pointer hover:scale-105 transition-transform"
          >
            <img src="${r.photoUrl}" alt="${escapeHtml(r.customerName)}" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-2.5 text-white">
              <span class="text-[11px] font-bold truncate">${escapeHtml(r.customerName)}</span>
              <span class="text-[10px] text-amber-300">★ ${r.rating} • ${escapeHtml(r.productName || 'Harvest')}</span>
            </div>
          </button>
        `).join('');
      } else {
        box.classList.add('hidden');
      }
    }

    window.filterProduce = function(prodId, btn) {
      selectedProduce = prodId;
      document.querySelectorAll('.produce-filter-btn').forEach(b => {
        b.className = 'produce-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-[#132215] border border-[#dce7db] hover:bg-emerald-50 cursor-pointer';
      });
      if (btn) {
        btn.className = 'produce-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-[#1b4522] text-white shadow-xs cursor-pointer';
      }
      renderFilteredReviews();
    };

    window.togglePhotoFilter = function(checked) {
      filterPhotosOnly = checked;
      renderFilteredReviews();
    };

    window.toggleStarFilter = function(checked) {
      filter5StarsOnly = checked;
      renderFilteredReviews();
    };

    function renderFilteredReviews() {
      let filtered = allReviews;

      if (selectedProduce !== 'all') {
        const pId = Number(selectedProduce);
        filtered = filtered.filter(r => r.productId === pId);
      }

      if (filterPhotosOnly) {
        filtered = filtered.filter(r => r.photoUrl);
      }

      if (filter5StarsOnly) {
        filtered = filtered.filter(r => r.rating === 5);
      }

      const feedEl = document.getElementById('reviews-feed');
      const emptyEl = document.getElementById('reviews-empty');

      if (!feedEl || !emptyEl) return;

      if (filtered.length === 0) {
        feedEl.innerHTML = '';
        emptyEl.classList.remove('hidden');
        return;
      }

      emptyEl.classList.add('hidden');
      feedEl.innerHTML = filtered.map(r => `
        <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#dce7db] shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between space-y-4">
          <div class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-[#f0f5ee]">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#1b4522] to-[#2e6d38] text-white font-extrabold text-sm flex items-center justify-center shadow-xs">
                  ${r.customerName ? r.customerName.charAt(0).toUpperCase() : 'C'}
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <strong class="font-extrabold text-sm text-[#122815]">${escapeHtml(r.customerName)}</strong>
                    ${r.isVerified ? `
                      <span class="inline-flex items-center gap-1 text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">
                        <span>✓</span> Verified Buyer
                      </span>
                    ` : ''}
                  </div>
                  <div class="text-[11px] text-[#5b6e5d] font-semibold mt-0.5">
                    ${r.customerCity ? `<span>📍 ${escapeHtml(r.customerCity)}</span> • ` : ''}
                    <span>${formatReviewDate(r.createdAt)}</span>
                  </div>
                </div>
              </div>
              <div class="text-amber-400 font-extrabold text-base tracking-wider">
                ${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}
              </div>
            </div>

            <!-- Product Tag -->
            ${r.productName ? `
              <div class="inline-block px-2.5 py-0.5 rounded-full bg-[#f4f8f3] text-[#194622] font-extrabold text-[10px] border border-[#dce7db]">
                🌾 ${escapeHtml(r.productName)}
              </div>
            ` : ''}

            <div class="space-y-2">
              ${r.title ? `<h4 class="font-bold text-sm text-[#122815]">${escapeHtml(r.title)}</h4>` : ''}
              <p class="text-xs sm:text-sm text-[#465b49] leading-relaxed whitespace-pre-line">${escapeHtml(r.reviewText)}</p>
            </div>
          </div>

          ${r.photoUrl ? `
            <div class="pt-2 border-t border-[#f4f7f2]">
              <button
                type="button"
                onclick="openPhotoLightbox('${r.photoUrl}', '${escapeHtml(r.customerName)}', ${r.rating}, '${escapeHtml(r.reviewText)}')"
                class="group relative inline-block rounded-2xl overflow-hidden border border-[#dce7db] shadow-xs cursor-pointer max-w-full"
              >
                <img src="${r.photoUrl}" alt="Customer photo" class="w-full sm:w-60 h-40 object-cover group-hover:scale-105 transition-transform" />
                <span class="absolute bottom-2 right-2 px-2.5 py-1 rounded-full bg-black/70 text-white text-[10px] font-bold backdrop-blur-xs flex items-center gap-1">
                  <span>🔍</span> View Harvest Photo
                </span>
              </button>
            </div>
          ` : ''}
        </div>
      `).join('');
    }

    function formatReviewDate(dateStr) {
      if (!dateStr) return 'Recently';
      try {
        const d = new Date(dateStr);
        return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      } catch (_) {
        return 'Recently';
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Modal & Interactive Controls
    window.openWriteReviewModal = function() {
      const modal = document.getElementById('modal-write-review');
      const errBox = document.getElementById('rev-error-box');
      if (errBox) errBox.classList.add('hidden');

      // Pre-fill user profile if logged in
      fetch('/farm/api/auth/me').then(r => r.json()).then(data => {
        if (data.success && data.user) {
          const nameInput = document.getElementById('rev-input-name');
          const phoneInput = document.getElementById('rev-input-phone');
          if (nameInput && !nameInput.value) nameInput.value = data.user.name;
          if (phoneInput && !phoneInput.value) phoneInput.value = data.user.phone;
        }
      }).catch(() => {});

      const bottomNav = document.getElementById('fd-bottom-nav');
      if (bottomNav) bottomNav.style.display = 'none';
      if (modal) modal.classList.remove('hidden');
    };

    window.closeWriteReviewModal = function() {
      const modal = document.getElementById('modal-write-review');
      const bottomNav = document.getElementById('fd-bottom-nav');
      if (bottomNav) bottomNav.style.display = '';
      if (modal) modal.classList.add('hidden');
    };

    window.setPickerRating = function(rating) {
      selectedRating = rating;
      const labelEl = document.getElementById('star-picker-label');
      if (labelEl) labelEl.textContent = RATING_LABELS[rating] || `${rating} Stars`;

      document.querySelectorAll('#star-picker .star-btn').forEach(btn => {
        const val = parseInt(btn.getAttribute('data-val') || '1', 10);
        if (val <= rating) {
          btn.className = 'star-btn text-amber-400 transition-transform hover:scale-125';
        } else {
          btn.className = 'star-btn text-gray-300 transition-transform hover:scale-125';
        }
      });
    };

    window.updateReviewCharCount = function(textarea) {
      const countEl = document.getElementById('rev-char-count');
      if (countEl) countEl.textContent = `${textarea.value.length} / 1000`;
    };

    // Downscale + re-encode photos in the browser so phone camera images (3–8MB)
    // become ~150–400KB before upload.
    function compressReviewImage(file, maxDim = 1280, quality = 0.8) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          URL.revokeObjectURL(url);
          const scale = Math.min(1, maxDim / Math.max(img.width, img.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);
          const ctx = canvas.getContext('2d');
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          let dataUrl = canvas.toDataURL('image/jpeg', quality);
          if (dataUrl.length > 1200 * 1024) dataUrl = canvas.toDataURL('image/jpeg', 0.6);
          resolve(dataUrl);
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('decode')); };
        img.src = url;
      });
    }

    window.handleReviewPhotoSelect = async function(input) {
      const file = input.files && input.files[0];
      if (!file) return;

      if (file.size > 20 * 1024 * 1024) {
        alert('Photo is larger than 20MB. Please choose a smaller image.');
        input.value = '';
        return;
      }

      let dataUrl;
      try {
        dataUrl = await compressReviewImage(file);
      } catch (_) {
        alert('This photo format could not be read. Please choose a JPG or PNG photo.');
        input.value = '';
        return;
      }

      selectedPhotoBase64 = dataUrl;
      selectedPhotoName = (file.name || 'review').replace(/\.[^.]+$/, '') + '.jpg';
      const sizeKb = Math.round((dataUrl.length * 3) / 4 / 1024);
      document.getElementById('dropzone-empty-state').classList.add('hidden');
      document.getElementById('dropzone-preview-state').classList.remove('hidden');
      document.getElementById('rev-preview-img').src = dataUrl;
      document.getElementById('rev-preview-filename').textContent = file.name;
      document.getElementById('rev-preview-filesize').textContent = `${sizeKb} KB (optimized)`;
    };

    window.removeReviewPhoto = function(e) {
      if (e) e.stopPropagation();
      selectedPhotoBase64 = null;
      document.getElementById('rev-file-input').value = '';
      document.getElementById('dropzone-preview-state').classList.add('hidden');
      document.getElementById('dropzone-empty-state').classList.remove('hidden');
    };

    window.submitCustomerReview = async function(event) {
      event.preventDefault();
      const btn = document.getElementById('btn-submit-review');
      const errBox = document.getElementById('rev-error-box');
      if (errBox) errBox.classList.add('hidden');

      const productId = parseInt(document.getElementById('rev-input-product').value, 10);
      const name = document.getElementById('rev-input-name').value.trim();
      const city = document.getElementById('rev-input-city').value.trim();
      const phone = document.getElementById('rev-input-phone').value.trim();
      const title = document.getElementById('rev-input-title').value.trim();
      const reviewText = document.getElementById('rev-input-text').value.trim();

      if (!reviewText || reviewText.length < 5) {
        if (errBox) {
          errBox.textContent = 'Please write at least a few words describing your experience.';
          errBox.classList.remove('hidden');
        }
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Submitting Review...';

      try {
        const payload = {
          product_id: productId,
          rating: selectedRating,
          title: title,
          review_text: reviewText,
          customer_name: name,
          customer_city: city,
          customer_phone: phone,
          photo_base64: selectedPhotoBase64,
          photo_name: selectedPhotoName
        };

        const res = await fetch('/farm/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (!data.success) {
          if (errBox) {
            errBox.textContent = data.error || 'Failed to submit review.';
            errBox.classList.remove('hidden');
          }
          btn.disabled = false;
          btn.textContent = 'Publish Review & Photo →';
          return;
        }

        closeWriteReviewModal();
        alert('Thank you! Your review and photo have been published.');
        document.getElementById('review-form').reset();
        removeReviewPhoto();
        setPickerRating(5);
        btn.disabled = false;
        btn.textContent = 'Publish Review & Photo →';

        loadReviews();
      } catch (err) {
        if (errBox) {
          errBox.textContent = 'Network error while submitting review. Please try again.';
          errBox.classList.remove('hidden');
        }
        btn.disabled = false;
        btn.textContent = 'Publish Review & Photo →';
      }
    };

    // Lightbox Controls
    window.openPhotoLightbox = function(url, author, rating, caption) {
      document.getElementById('lightbox-img').src = url;
      document.getElementById('lightbox-author').textContent = author;
      document.getElementById('lightbox-stars').textContent = '★'.repeat(rating || 5);
      document.getElementById('lightbox-caption').textContent = caption || '';
      document.getElementById('modal-photo-lightbox').classList.remove('hidden');
    };

    window.closePhotoLightbox = function() {
      document.getElementById('modal-photo-lightbox').classList.add('hidden');
    };

    document.addEventListener('DOMContentLoaded', () => {
      loadReviews();
      const params = new URLSearchParams(window.location.search);
      if (params.get('write') === '1') {
        openWriteReviewModal();
      }
    });
  </script>
</FarmLayout>
