---
import FarmLayout from '../../layouts/FarmLayout.astro';

// Farmer Direct Contact & Coordinates — Modern UI
---

<FarmLayout
  title="Contact the Farm & Delivery Coordinator | Gwalior"
  description="Connect directly with our village farm coordinator on WhatsApp at +91 8770767272. Weekly raw farm produce delivery in Pawan Nagar, Chetakpuri, and Gwalior."
  canonicalPath="/farm/contact"
>
  <div class="fd-container py-8 sm:py-16 max-w-5xl">
    <div class="mb-10 text-center max-w-2xl mx-auto space-y-3">
      <span class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-emerald-800 font-extrabold bg-emerald-50 border border-emerald-200 px-3.5 py-1 rounded-full">
        <span>💬</span>
        <span>Zero Intermediaries</span>
      </span>
      <h1 class="fd-display text-3xl sm:text-5xl font-extrabold text-[#122815] leading-tight">
        Connect Directly with the Farm
      </h1>
      <p class="text-xs sm:text-sm text-[#5b6e5d] leading-relaxed">
        Questions about this season's wheat crop, booking 25kg/50kg family grain bags, or requesting scheduled delivery in your Gwalior society?
      </p>
    </div>

    <!-- 3 Action Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <!-- Card 1: WhatsApp -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#e2ece0] shadow-sm flex flex-col justify-between space-y-6">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#25D366]/10 text-[#25D366] flex items-center justify-center text-2xl mb-4 font-bold">
            💬
          </div>
          <h3 class="fd-display text-lg font-extrabold text-[#122815]">WhatsApp Operations</h3>
          <p class="text-xs text-[#5b6e5d] mt-1.5 leading-relaxed">
            Fastest response for pre-order confirmations, sample inquiries, or Sunday vehicle ETA in your colony.
          </p>
          <div class="fd-display text-xl font-black text-[#1b4522] mt-3">
            +91 8770767272
          </div>
        </div>

        <div class="pt-4 border-t border-[#f0f5ee]">
          <a
            href="https://wa.me/918770767272?text=Namaste%20Farm%20Direct,%20I%20have%20an%20inquiry%20about%20farm%20produce%20in%20Gwalior."
            target="_blank"
            rel="noopener noreferrer"
            class="fd-btn bg-[#25D366] hover:bg-[#1fa851] text-white w-full text-center font-bold text-xs py-3 rounded-xl shadow-sm"
          >
            Chat on WhatsApp &rarr;
          </a>
        </div>
      </div>

      <!-- Card 2: Farmland Origin -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#e2ece0] shadow-sm flex flex-col justify-between space-y-6">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-700 flex items-center justify-center text-2xl mb-4 font-bold">
            🌾
          </div>
          <h3 class="fd-display text-lg font-extrabold text-[#122815]">Farm Origin & Land</h3>
          <p class="text-xs text-[#5b6e5d] mt-1.5 leading-relaxed">
            All produce is cultivated in village agricultural land in the rural belts surrounding Gwalior, Madhya Pradesh.
          </p>
          <div class="text-xs font-bold text-[#152317] mt-3">
            Village Farmland, Gwalior Rural Belt, MP 474001
          </div>
        </div>

        <div class="pt-4 border-t border-[#f0f5ee]">
          <a
            href="/farm/how-it-works"
            class="fd-btn fd-btn-secondary w-full text-center font-bold text-xs py-3 rounded-xl"
          >
            How Pre-Orders Work &rarr;
          </a>
        </div>
      </div>

      <!-- Card 3: Active Delivery Clusters -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#e2ece0] shadow-sm flex flex-col justify-between space-y-6">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-800 flex items-center justify-center text-2xl mb-4 font-bold">
            📍
          </div>
          <h3 class="fd-display text-lg font-extrabold text-[#122815]">Active Clusters</h3>
          <p class="text-xs text-[#5b6e5d] mt-1.5 leading-relaxed">
            Consolidated Sunday morning trips with ₹30 delivery (Free over ₹500):
          </p>
          <ul class="text-xs text-[#152317] font-bold mt-2 space-y-1">
            <li class="flex items-center gap-1.5">
              <span class="text-emerald-600 font-extrabold">✓</span> Pawan Nagar / Pavan Nagar Colony
            </li>
            <li class="flex items-center gap-1.5">
              <span class="text-emerald-600 font-extrabold">✓</span> Chetakpuri & nearby lanes
            </li>
          </ul>
        </div>

        <div class="pt-4 border-t border-[#f0f5ee]">
          <a
            href="/farm/delivery-areas"
            class="fd-btn fd-btn-secondary w-full text-center font-bold text-xs py-3 rounded-xl"
          >
            Delivery Clusters & Rates &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Quick WhatsApp Inquiry Form -->
    <div class="bg-white p-6 sm:p-10 rounded-3xl border border-[#e2ece0] shadow-sm">
      <div class="max-w-xl mx-auto space-y-6">
        <div class="text-center space-y-1">
          <h2 class="fd-display text-2xl font-extrabold text-[#122815]">Send a Message to the Farmer</h2>
          <p class="text-xs text-[#5b6e5d]">
            Bulk grain orders, society group supply, or questions about unpolished harvest.
          </p>
        </div>

        <form id="contact-form" class="space-y-4 text-xs">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold text-[#3d503f] mb-1.5">Your Name *</label>
              <input type="text" id="c-name" class="fd-input font-bold" placeholder="e.g. Ramesh Sharma" required />
            </div>

            <div>
              <label class="block font-bold text-[#3d503f] mb-1.5">Mobile / WhatsApp *</label>
              <input type="tel" id="c-phone" maxlength="10" class="fd-input font-bold" placeholder="10-digit mobile" required />
            </div>
          </div>

          <div>
            <label class="block font-bold text-[#3d503f] mb-1.5">Your Locality / Society in Gwalior *</label>
            <input type="text" id="c-locality" class="fd-input font-bold" placeholder="e.g. Pawan Nagar, Chetakpuri, City Center, Thatipur..." required />
          </div>

          <div>
            <label class="block font-bold text-[#3d503f] mb-1.5">Message or Produce Requirements *</label>
            <textarea id="c-message" rows="4" class="fd-input font-semibold" placeholder="Specify produce items (wheat, chana, groundnut), approximate kilograms, or questions..." required></textarea>
          </div>

          <button type="submit" class="fd-btn fd-btn-primary w-full font-bold text-sm py-3.5 shadow-md flex items-center justify-center gap-2">
            <span>Send Direct to Farmer WhatsApp &rarr;</span>
          </button>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    document.getElementById('contact-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('c-name').value.trim();
      const phone = document.getElementById('c-phone').value.trim();
      const locality = document.getElementById('c-locality').value.trim();
      const msg = document.getElementById('c-message').value.trim();

      const text = encodeURIComponent(
        `Namaste Farm Direct! Inquiry from Website:\n*Name:* ${name}\n*Phone:* ${phone}\n*Colony/Locality:* ${locality}\n*Requirements:* ${msg}`
      );

      window.open(`https://wa.me/918770767272?text=${text}`, '_blank');
    });
  </script>
</FarmLayout>
