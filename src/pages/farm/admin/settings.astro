---
import FarmLayout from '../../../layouts/FarmLayout.astro';
---

<FarmLayout
  title="System Settings | Admin | Farm Direct Gwalior"
  description="Configure WhatsApp notification target, inventory alert thresholds, and sample policy rules."
  canonicalPath="/farm/admin/settings"
  hideCartBar={true}
>
  <div class="fd-container py-8 sm:py-14">
    <!-- Admin Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-[#e0e8dc] mb-8">
      <div>
        <div class="flex items-center gap-2">
          <a href="/farm/admin" class="text-xs text-[#275629] font-bold hover:underline">&larr; Back to Dashboard</a>
          <span class="text-xs text-[#798a7a]">•</span>
          <span class="text-xs uppercase tracking-wider text-[#c48a3f] font-bold bg-[#fdf6ec] px-3 py-0.5 rounded-full">
            Configuration
          </span>
        </div>
        <h1 class="fd-serif text-3xl sm:text-4xl font-bold text-[#152317] mt-1.5">
          Farm Operational Settings
        </h1>
        <p class="text-xs sm:text-sm text-[#536354] mt-1">
          WhatsApp numbers, low stock alert limits, and sample anti-abuse policies.
        </p>
      </div>

      <!-- Quick Nav -->
      <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
        <a href="/farm/admin/orders" class="px-3 py-2 rounded-lg bg-white border border-[#d0ded0] text-[#152317] hover:bg-[#f0f4ee]">
          Orders
        </a>
        <a href="/farm/admin/products" class="px-3 py-2 rounded-lg bg-white border border-[#d0ded0] text-[#152317] hover:bg-[#f0f4ee]">
          Products
        </a>
        <a href="/farm/admin/inventory" class="px-3 py-2 rounded-lg bg-white border border-[#d0ded0] text-[#152317] hover:bg-[#f0f4ee]">
          Inventory
        </a>
      </div>
    </div>

    <!-- Loading State -->
    <div id="admin-loading" class="text-center py-20 text-[#536354]">
      <div class="inline-block animate-spin w-8 h-8 border-4 border-[#275629] border-t-transparent rounded-full mb-3"></div>
      <p class="text-sm font-semibold">Loading system configuration...</p>
    </div>

    <!-- Main Content -->
    <div id="admin-content" class="hidden max-w-2xl">
      <form id="settings-form" class="bg-white p-6 sm:p-8 rounded-2xl border border-[#e0e8dc] shadow-sm space-y-6 text-xs">
        <!-- Section: WhatsApp & Communications -->
        <div>
          <h2 class="font-bold text-sm text-[#152317] flex items-center gap-2 mb-1">
            <span class="text-[#25D366] text-base">💬</span> WhatsApp & Communications
          </h2>
          <p class="text-[#536354] text-[11px] mb-4">
            This number receives instant order notifications and is presented on customer checkout receipts for inquiries.
          </p>

          <div>
            <label class="block font-bold text-[#152317] mb-1">Owner WhatsApp Number (10 digits) *</label>
            <div class="flex items-center gap-2">
              <span class="px-3 py-2 bg-[#f0f4ee] border border-[#d0ded0] rounded-xl text-[#536354] font-bold">+91</span>
              <input type="text" id="setting-whatsapp" class="fd-input text-xs" maxlength="10" placeholder="8770767272" required />
            </div>
            <p class="text-[10px] text-[#798a7a] mt-1">Default: 8770767272 (Gwalior Farm Direct)</p>
          </div>
        </div>

        <hr class="border-[#f0f4ee]" />

        <!-- Section: Farm Details -->
        <div>
          <h2 class="font-bold text-sm text-[#152317] flex items-center gap-2 mb-1">
            <span class="text-amber-700 text-base">🌾</span> Farm Identity & Origin
          </h2>
          <p class="text-[#536354] text-[11px] mb-4">
            Displayed on order slips and customer transparency cards.
          </p>

          <div class="space-y-3">
            <div>
              <label class="block font-bold text-[#152317] mb-1">Farm Origin & Location Description</label>
              <input type="text" id="setting-origin" class="fd-input text-xs" placeholder="Village Farm near Gwalior, Madhya Pradesh" />
            </div>
          </div>
        </div>

        <hr class="border-[#f0f4ee]" />

        <!-- Section: Stock & Inventory Alerts -->
        <div>
          <h2 class="font-bold text-sm text-[#152317] flex items-center gap-2 mb-1">
            <span class="text-red-600 text-base">⚠️</span> Inventory Alerts
          </h2>
          <p class="text-[#536354] text-[11px] mb-4">
            Threshold to trigger low-stock warning indicators on dashboard.
          </p>

          <div>
            <label class="block font-bold text-[#152317] mb-1">Low Stock Warning Threshold (kg) *</label>
            <input type="number" id="setting-threshold" min="1" max="500" class="fd-input text-xs" value="15" required />
            <p class="text-[10px] text-[#798a7a] mt-1">Produces with available stock below this value show in red.</p>
          </div>
        </div>

        <hr class="border-[#f0f4ee]" />

        <!-- Section: Free Sample Anti-Abuse Rules -->
        <div>
          <h2 class="font-bold text-sm text-[#152317] flex items-center gap-2 mb-1">
            <span class="text-emerald-700 text-base">🛡️</span> Free Sample Anti-Abuse Rules
          </h2>
          <p class="text-[#536354] text-[11px] mb-4">
            Enforced server-side in Cloudflare D1 before sample requests are accepted.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold text-[#152317] mb-1">Max Samples Per Customer Per Round</label>
              <input type="number" id="setting-max-samples" min="1" max="10" class="fd-input text-xs" value="2" required />
              <p class="text-[10px] text-[#798a7a] mt-1">Default: 2 sample packets (e.g. 1 Wheat + 1 Chana)</p>
            </div>

            <div>
              <label class="block font-bold text-[#152317] mb-1">Sample Cooldown Period (days)</label>
              <input type="number" id="setting-cooldown" min="1" max="90" class="fd-input text-xs" value="14" required />
              <p class="text-[10px] text-[#798a7a] mt-1">Same phone number cannot re-request same produce within this window.</p>
            </div>
          </div>
        </div>

        <div id="settings-status" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

        <div class="pt-4 border-t border-[#f0f4ee] flex justify-end">
          <button type="submit" id="btn-save-settings" class="fd-btn fd-btn-primary fd-btn-md font-bold">
            Save Operational Settings
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    async function initSettings() {
      const loader = document.getElementById('admin-loading');
      const content = document.getElementById('admin-content');

      try {
        const meRes = await fetch('/farm/api/auth/me');
        const meData = await meRes.json();
        if (!meData.success || !meData.user || meData.user.role !== 'ADMIN') {
          window.location.href = '/farm/account/login?redirect=/farm/admin/settings';
          return;
        }

        const res = await fetch('/farm/api/admin/settings');
        const data = await res.json();

        if (data.success && data.settings) {
          const s = data.settings;
          document.getElementById('setting-whatsapp').value = s.adminWhatsappNumber || '8770767272';
          document.getElementById('setting-origin').value = s.farmOrigin || 'Village Farm near Gwalior, Madhya Pradesh';
          document.getElementById('setting-threshold').value = s.lowStockThresholdKg || 15;
          document.getElementById('setting-max-samples').value = s.maxSamplesPerCustomerPerRound || 2;
          document.getElementById('setting-cooldown').value = s.sampleCooldownDays || 14;
        }

        loader.classList.add('hidden');
        content.classList.remove('hidden');
      } catch (err) {
        loader.innerHTML = '<p class="text-sm text-red-600">Failed to load system settings.</p>';
      }
    }

    document.getElementById('settings-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const statusBox = document.getElementById('settings-status');
      statusBox.classList.add('hidden');

      const payload = {
        adminWhatsappNumber: document.getElementById('setting-whatsapp').value.trim(),
        farmOrigin: document.getElementById('setting-origin').value.trim(),
        lowStockThresholdKg: Number(document.getElementById('setting-threshold').value),
        maxSamplesPerCustomerPerRound: Number(document.getElementById('setting-max-samples').value),
        sampleCooldownDays: Number(document.getElementById('setting-cooldown').value),
      };

      try {
        const res = await fetch('/farm/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (data.success) {
          statusBox.textContent = 'Settings updated successfully.';
          statusBox.className = 'p-3 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 block';
        } else {
          statusBox.textContent = data.message || 'Failed to update settings.';
          statusBox.className = 'p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-800 border border-red-200 block';
        }
      } catch (err) {
        statusBox.textContent = 'Network error saving settings.';
        statusBox.className = 'p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-800 border border-red-200 block';
      }
    });

    document.addEventListener('DOMContentLoaded', initSettings);
  </script>
</FarmLayout>
