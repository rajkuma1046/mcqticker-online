# Caching for versioned static assets (JS, CSS, optimized images)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Caching for unversioned public brand assets and icons
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon-96x96.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/logo-light.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/logo-dark.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/site.webmanifest
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Do not cache Service Worker to ensure instant PWA updates
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Apply noindex rule for the default pages.dev staging domain
https://mcqticker-online.pages.dev/*
  X-Robots-Tag: noindex